        set:
          statement: "<<the requirement, in a sentence or two>>"
      - title: "<a short label for the next requirement>"
        set:
          statement: "<<the next requirement, in a sentence or two>>"
  - id: context
    set:
      context: "<<why it is needed and the constraints that shape it>>"
EOF

