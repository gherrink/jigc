---
source: crates/engine/src/schema.rs
expression: json
---
{
  "type": "commit",
  "sections": [
    {
      "id": "header",
      "header": true,
      "fields": [
        {
          "id": "type",
          "type": "enum",
          "of": [
            "feat",
            "fix",
            "docs",
            "style",
            "refactor",
            "perf",
            "test",
            "build",
            "ci",
            "chore",
            "revert"
          ]
        },
        {
          "id": "scope",
          "type": "string"
        }
      ]
    },
    {
      "id": "summary",
      "slot": {
        "hint": "The subject line — what changed, imperative mood, <=50 chars."
      }
    },
    {
      "id": "body",
      "slot": {
        "hint": "Why this change — the motivation and any notable context."
      }
    },
    {
      "id": "trailers",
      "repeatable": {
        "id-from": "key",
        "block": [
          {
            "id": "key",
            "type": "string"
          },
          {
            "id": "value",
            "type": "string"
          }
        ]
      }
    }
  ]
}
