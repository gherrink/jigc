---
source: crates/engine/src/schema.rs
expression: json
---
{
  "type": "commit",
  "description": "A Conventional-Commits message — a typed, scoped header over a subject line, an optional body, and trailers — rendered into the git commit rather than persisted as a repo file.",
  "usage": "you need to record what a change does and why at the moment it lands, in the form git and reviewers already read.",
  "sections": [
    {
      "id": "header",
      "header": true,
      "fields": [
        {
          "id": "type",
          "type": "enum",
          "of": [
            "feat",
            "fix",
            "docs",
            "style",
            "refactor",
            "perf",
            "test",
            "build",
            "ci",
            "chore",
            "revert"
          ]
        },
        {
          "id": "scope",
          "type": "string",
          "optional": true
        },
        {
          "id": "implements",
          "type": "ref",
          "to": "spec",
          "card": "0..1",
          "inverse": "implemented-by"
        }
      ]
    },
    {
      "id": "summary",
      "slot": {
        "hint": "The subject line — what changed, imperative mood, <=50 chars."
      }
    },
    {
      "id": "body",
      "slot": {
        "hint": "Why this change — the motivation and any notable context.",
        "optional": true
      }
    },
    {
      "id": "trailers",
      "repeatable": {
        "id-from": "key",
        "block": [
          {
            "id": "key",
            "type": "string"
          },
          {
            "id": "value",
            "type": "string"
          }
        ]
      }
    }
  ]
}
