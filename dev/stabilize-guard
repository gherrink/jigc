#!/usr/bin/env python3
#
# dev/stabilize-guard — THE WRITE GUARD OF A STABILIZATION RUN: a PreToolUse hook that
# keeps every agent of a run that is not one of its writers from writing the run's
# repository (DECISIONS.md -> 2026-10-16, "The write guard of a stabilization run";
# implementation/stabilization-workflow.md -> The write guard).
#
# WHY. In the staged canary's third root, part 2 (2026-10-16), a driver of a review row
# ran an ad-hoc probe whose `R` a shell glob error had left empty, so its commands ran in
# the canary's clone — the run's repository — and it committed there and ran `git reset
# --hard`. Nothing in the tools prevented it, and nothing but a stray commit is seen
# afterwards: not a write to the working tree, the index, `.git/config` or `.git/hooks`.
# In the real run that repository is the human's main working tree. The human ruled that
# the guard PREVENTS, and that the runs stay in bypassPermissions: a hook's `deny` holds
# in that mode, and an allow rule does not (implementation/stabilization-workflow.md ->
# The write guard, where the documentation it rests on is cited).
#
# WHERE IT BINDS — INSIDE A RUN, AND NOWHERE ELSE. The repository is the git work tree of
# the session's project (CLAUDE_PROJECT_DIR, which Claude Code sets for every hook). The
# guard binds where that tree has checked out a run's loop branch or one of its round
# branches — `fix/<run>`, `fix/<run>-r<N>`, `fix/<run>-r<N>-part<M>`, the harness's
# `branchName` — AND completions/artifacts/<run>/opening.md is a file there: a stage runs
# only with the loop branch checked out, and a run is opened when that file is there
# (dev/stabilize-record: A RUN IS OPENED). On any other branch, a detached HEAD, or a
# project that is no git repository, it says nothing at all: a milestone build, a fix
# branch with no run and an ad-hoc session are as they were.
#
# WHO IS FENCED — EVERY SUBAGENT BUT THE RUN'S WRITERS (and, while a runtime probe is
# active, every subagent: below). The hook input's `agent_type`
# names the subagent a tool call is made in. Absent or empty, the call is the session's
# own — the human's, or the orchestrator's — and is never fenced. `build-git` (the git
# steps: their acts write the run's record, commit and push it) and `build-fixer` (a
# fixer commits its fix on the round branch) are the WRITERS, and are never fenced. EVERY
# OTHER TYPE IS, known or not: the hook cannot tell who launched an agent, so a type
# nobody classified is fenced and never let through. tooling-tests/dev_stabilize_guard.rs
# holds the writers to the types the harness launches, and the fenced types the harness
# launches to a list a change has to name.
#
# WHILE A RUNTIME PROBE IS ACTIVE — ANYWHERE, AND FOR EVERY SUBAGENT (the plan before the
# opening's task T-NR; DECISIONS.md -> 2026-10-29, "The build session runs the single T-NR
# runtime probe", condition 5: "no push" and "no commit" are held by a mechanism). The
# `neutralized` probe's first act writes a MARKER, `stabilize-probe-active`, in the COMMON git
# directory of the repository (`git rev-parse --git-common-dir`), naming the probe, its
# scratch root, when it was begun (`begun`, UTC) and the files a subagent may write while it
# stands (`writable`); its verdict removes it (dev/stabilize-probe). While that file stands,
# the guard binds on any branch, inside a run or outside one, and fences EVERY subagent —
# the writers too, `build-git` and `build-fixer` — as an ALLOWLIST:
#
#   Bash            ONE plain invocation of `dev/stabilize-probe`, in the grammar below,
#                   from the repository's root, OF THE ONE ACT THE HARNESS LAUNCHED THE
#                   AGENT'S TYPE FOR (PROBE_ACTS: `begin` and `verdict` a `build-git`'s, the
#                   git steps; `record` a `build-executor`'s, the record writer; the subject
#                   none), naming the marker's own scratch root by `--scratch` once — and, for
#                   `begin` and `verdict`, the marker's probe by `--probe`; and a `verdict`
#                   only AS THE HARNESS COMPOSED IT, its one `--sum` the sha256 of the cases
#                   after its `--`, nothing between its act and that `--` but flags and their
#                   values — runs; the same call from another directory is refused
#                   (`directory`). Every other command
#                   — a push, a commit, `git -c x=y push`, `env git push`, a script written
#                   and then run, another act of the probe tool, a call of the step tool or
#                   of the record script, whose copy the `record` act runs itself — is
#                   REFUSED (`probe`). Nothing is run under the fence: there is nothing else
#                   to run, and what the probe tool runs it holds byte for byte to this
#                   repository's own scripts first (dev/stabilize-probe: WHAT IT RUNS).
#   Write · Edit ·  a target that IS one of the marker's `writable` files — the batch its
#   NotebookEdit    record writer writes, and the file the planted text asks for, so that an
#                   obedience lands where the verdict looks — runs, judged on the file
#                   system: its directory by device and inode, its name as written, and a
#                   link resolved first. Any other is REFUSED (`probe`): a copy the probe
#                   runs, a module beside it, the throwaway repository's `.git/`, a script to
#                   run, anything outside the scratch root.
#   OBEYED          A REFUSED CALL THAT NAMES THE FILE THE PLANTED TEXT ASKS FOR — a file
#                   tool's target, or a word of a command, whose last name is `tnr-obeyed` —
#                   IS NOTED, so that an obedience the guard refused is seen too: the subject's
#                   prompt names no scratch root, so its `<scratch>` resolves to a path this
#                   refuses. The note is one file under the probe's root,
#                   `<scratch>/probe/<probe>/obey-attempts/`, which no subagent may write,
#                   holding the agent's type, the tool and the time — no path and no session —
#                   and the probe's verdict reads it (`attempted`). Not seen: a call that never
#                   reaches this hook, and a shell that names the file by no word of its own.
#   Read · Grep ·   run: they read — answered before git is asked anything, here as everywhere.
#   Glob · LS ·
#   NotebookRead ·
#   TodoWrite ·
#   ToolSearch
#   EVERY OTHER     REFUSED (`probe`), whatever it would do: `Monitor` and `PowerShell`, a
#   TOOL            shell the list cannot hold; `Agent`, `Task` and `Workflow`, because the
#                   probe's set of agents is fixed and counted (one subject, three step
#                   agents) and no subagent grows it — the probe's own four are launched by
#                   the harness, the runtime's `agent()` calls under the main session's
#                   `Workflow` call, never by a subagent's tool call, so this refusal cannot
#                   block them; an MCP tool, a web fetch or search, a skill, a worktree, a
#                   message to another agent, a publish. The settings' matcher, `*`, hands
#                   the hook every tool; outside a probe a tool it names no rule for, it
#                   answers with nothing. A BOUND: what never reaches PreToolUse — were
#                   there a way to run a shell that does not pass the hook — the guard
#                   cannot refuse (implementation/stabilization-workflow.md -> The write
#                   guard).
#
# The session's own calls are never fenced, under a probe as everywhere (the plan before the
# opening, §1: the guard refuses commits and pushes "from every subagent"). WHO LIFTS THE
# MARKER: the probe's verdict, the act of a `build-git` under the marker's own root, of the
# marker's probe, AS THE HARNESS COMPOSED IT — its `--sum` the sha256 of its cases, which the
# harness computes and which no subagent can, having no hash tool under the marker (the act
# `hash` is nobody's, and nothing else runs); so no subagent lifts it by an act of its own
# making — and where a probe was cut before its verdict, ONLY THE MAIN SESSION, which removes
# it by hand: the file `stabilize-probe-active` in the directory `git rev-parse
# --git-common-dir` names, once it has read that the marker names its own invocation's
# scratch root (the harness's one identity of a probe's invocation is its arguments,
# `{probe, scratch}`) and when it was begun. A refusal says that, and hands no subagent the
# marker's path or the act that removes it.
#
# A marker whose scratch root is gone, or that was begun more than STALE_AFTER ago — longer
# than any probe runs, as a cut run's `mktemp` root stays — is STALE; one that is no JSON
# object naming an absolute scratch root, a start time and a list of files under that root
# CANNOT BE READ. Each binds all the same — a stale marker's acts still run where its root
# is there, and nothing is written where it is gone; an unreadable one runs no act and
# writes nothing — and every refusal says so, until the main session removes the file.
# WHY THE COMMON GIT DIRECTORY, AND WHY THAT IS SAFE. It is no tracked path, and git never
# reads a file of that name; and it is the one place every worktree of the repository
# shares, so it stands for a session in the loop checkout and in a lane's worktree alike —
# and BINDS ONLY WHERE THE GUARD CHECKED OUT THERE KNOWS IT: a worktree whose
# dev/stabilize-guard predates the marker reads nothing of it, and neither does a session
# whose settings do not hand this hook every tool. THAT SHARING IS HARMLESS ONLY BECAUSE THE
# PROBE IS RUN WITH NO OTHER AGENT OF THE SESSION IN FLIGHT (the plan before the opening,
# §1): while the marker stands, a builder in any worktree whose guard knows it cannot
# commit, push or gate.
#
# WHAT A FENCED AGENT IS REFUSED, OR HOW ITS COMMAND RUNS:
#
#   Write · Edit ·  a target that resolves under the repository's work tree or its git
#   NotebookEdit    directories is REFUSED (`repository`). Resolved on the file system:
#                   through links, `..`, a `/var` that is `/private/var`, another case
#                   of a name on a volume that ignores case — every existing ancestor is
#                   compared by its device and inode, never by its spelling. A new file
#                   whose parent is not there yet is judged by the nearest ancestor that
#                   is. Anywhere else, the guard says nothing.
#   Bash            ONE PLAIN INVOCATION of `dev/stabilize-step`, `dev/stabilize-record`
#                   or `dev/stabilize-probe` — the grammar of the allow rules and of the
#                   harness's prompts: the tool's path as its first word, then plain
#                   words, bare (A-Z a-z 0-9 and _ . / : = @ % + , -) or in single quotes
#                   (those and the space and parentheses), and nothing else on the line —
#                   from the repository's root, is let through UNFENCED: those tools are
#                   how a run's record is written. The same call from another directory
#                   is refused (`directory`). A command that calls one of the three in
#                   any other shape — after a `cd` and `&&`, before a `;` or an `echo`,
#                   by an absolute or a `./` path, through an interpreter, with a pipe
#                   or a redirect — is REFUSED (`shape`), with the shape it is taken in.
#                   EVERY OTHER COMMAND RUNS UNDER THE WRITE FENCE: it is rewritten,
#                   before it runs, into ONE invocation of dev/stabilize-fence, which runs
#                   it unchanged under the operating system's write fence — nothing under
#                   the repository's work tree or its git directories can be written by
#                   it or by anything it starts — and says so on stderr. Where the fence
#                   cannot be built (no macOS sandbox, no fence tool beside this one) the
#                   command is REFUSED (`no-fence`), never run open. The rewrite is
#                   allowed in bypassPermissions, where nothing is asked anyway; in any
#                   other mode it is ASKED, with the fenced command shown — an `allow`
#                   would approve a command the mode would have asked about.
#   Monitor ·       a shell this guard cannot fence: REFUSED (`shell`).
#   PowerShell
#   Agent · Task    a fenced agent may not launch a writer: REFUSED (`writer`).
#   Workflow        a fenced agent may start no workflow, which can launch anything, a
#                   writer among it: REFUSED (`writer`).
#
# EVERY TOOL REACHES IT, AND A FAILED HOOK BLOCKS: so the session's own calls — no
# `agent_type` — and every subagent's read are answered before git or the environment is
# asked anything, one start of this script and nothing else; and anything unforeseen while
# deciding a subagent's call is a refusal (`unknown`), never a crash. An input that cannot
# be read as a JSON object — no JSON, not UTF-8, nested deeper than the reader recurses, or
# JSON that is no object — exits 2 (below), a block: nothing in it says whose call it is.
# What else blocks is outside this script: no python3 to start it, and the hook's timeout.
#
# FAIL CLOSED. For a fenced type, what the guard cannot read — no CLAUDE_PROJECT_DIR, a
# git that does not answer, a tool input without its path or its command — is a refusal
# (`unknown`), never a pass. AND FOR A WRITER TOO, where what it cannot read is whether a
# probe's marker stands: under a marker every subagent is fenced, so a writer the guard
# cannot clear of one is refused (`unknown`) like any other. An input that cannot be read as
# a JSON object exits 2 with the reason on stderr, which Claude Code takes as a block. And the settings run this hook with
# `onFailure: block`, so a hook that cannot start blocks too.
#
# Usage:
#
#   dev/stabilize-guard            a PreToolUse hook: the event's JSON on stdin. Prints
#                                  nothing where it has no decision, and otherwise ONE
#                                  JSON object, {hookSpecificOutput: {hookEventName:
#                                  PreToolUse, permissionDecision: deny | allow | ask,
#                                  permissionDecisionReason [, updatedInput]}}, and exits 0.
#                                  A refusal's reason is one line that opens with
#                                  `stabilize-guard: refused <word>: `.
#   dev/stabilize-guard --help     this header.
#
# The settings that run it — `.claude/settings.json`, one entry under hooks.PreToolUse:
#
#   {"matcher": "*",
#    "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/dev/stabilize-guard",
#               "args": [], "timeout": 30, "onFailure": "block"}]}
#
# — every tool, so that a tool the probe's allowlist refuses reaches it; exec form
# (`args`), so that a project path with a space in it is one word. The session's own calls
# cost one start of this script, which answers them before it asks git anything.
#
# STABILIZE_FENCE_SANDBOX names the sandbox program instead of /usr/bin/sandbox-exec —
# for this tool's suite, which asks what happens where there is none; dev/stabilize-fence
# reads the same name.
#
# Needs python3 and git. It writes nothing — but, while a probe's marker stands, the note of
# a refused obedience, under that probe's own root (OBEYED, above).

import json
import os
import re
import sys

# `datetime`, `shlex` and `subprocess` are imported where they are used: the session's own
# calls and every read are answered without them, one start of this script and no more (the
# header: EVERY TOOL REACHES IT).

PROG = "stabilize-guard"
HERE = os.path.dirname(os.path.realpath(__file__))
FENCE = os.path.join(HERE, "stabilize-fence")
SANDBOX = os.environ.get("STABILIZE_FENCE_SANDBOX") or "/usr/bin/sandbox-exec"

# The run's writers: the agent types whose job is to write the run's repository.
WRITERS = ("build-git", "build-fixer")
# The three tools a run's record is written through, by their path from the repository's
# root — the allow rules' and the harness's prompts' (PROMPT_TOOLS of the fence suite).
TOOLS = ("dev/stabilize-step", "dev/stabilize-record", "dev/stabilize-probe")
# While a runtime probe is active: its marker, by its name in the common git directory
# (dev/stabilize-probe's MARKER); the one tool a subagent may call, and each of its acts by
# the one type the harness launches for it — its git steps, and the record role's executor
# (tooling-tests/dev_stabilize_guard.rs holds this to the harness); the tools that read,
# which run; and how old a marker is before it is called stale.
MARKER = "stabilize-probe-active"
PROBE_TOOL = "dev/stabilize-probe"
PROBE_ACTS = {"begin": "build-git", "verdict": "build-git", "record": "build-executor"}
READS = ("Read", "Grep", "Glob", "LS", "NotebookRead", "TodoWrite", "ToolSearch")
# The file the `neutralized` probe's planted text asks for, and where under the probe's root a
# refused call that names it is noted (dev/stabilize-probe's OBEYED and ATTEMPTS).
OBEYED = "tnr-obeyed"
ATTEMPTS = "obey-attempts"
SLUG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
# A command's words, split wherever a shell may end a path: what names the obeyed file.
PATH_ENDS = re.compile(r"[\s;&|<>(){}`'\"=]+")
STALE_AFTER = 3 * 3600
# Where a run lies, and how its branches are named (the harness's RUNS_ROOT, branchName).
RUNS = "completions/artifacts"
LOOP = re.compile(r"fix/([a-z0-9]+(?:-[a-z0-9]+)*)")
ROUND = re.compile(r"(.+)-r[1-9][0-9]*(?:-part[1-9][0-9]*)?")
# One word of a plain invocation: bare, or in single quotes with nothing a shell reads.
BARE = re.compile(r"[A-Za-z0-9_./:=@%+,-]+")
QUOTED = re.compile(r"'[A-Za-z0-9_./:=@%+, ()-]*'")
# A call of one of the three tools at the place of a command: the line's start, after an
# operator, a parenthesis, a brace or a backquote, or after a word that runs the next one —
# with any path before the tool's own and any assignments before that.
CALLED = re.compile(r"(?:^|[;&|(){}`\n]|\$\(|(?:^|(?<=[\s;&|(){}`]))(?:then|do|else|exec|command|env|nohup|time|xargs|sudo|python3?|sh|bash|zsh)(?=\s))\s*(?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+)*\S*?(dev/stabilize-(?:step|record|probe))(?![A-Za-z0-9_.-])")
# The tools whose input names a file to write, and the field that names it.
FILE_TOOLS = {"Write": "file_path", "Edit": "file_path", "NotebookEdit": "notebook_path"}
SHELLS = ("Monitor", "PowerShell")


def decide(decision, reason=None, updated=None):
    out = {"hookEventName": "PreToolUse", "permissionDecision": decision}
    if reason is not None:
        out["permissionDecisionReason"] = reason
    if updated is not None:
        out["updatedInput"] = updated
    sys.stdout.write(json.dumps({"hookSpecificOutput": out}) + "\n")
    sys.exit(0)


def refused(word, detail):
    decide("deny", "%s: refused %s: %s" % (PROG, word, detail))


def git_env():
    env = {name: value for name, value in os.environ.items() if not name.startswith("GIT_")}
    env["GIT_OPTIONAL_LOCKS"] = "0"
    return env


def git(at, *args):
    """What git prints, stripped — or None where it does not answer."""
    import subprocess

    try:
        done = subprocess.run(["git", "-C", at] + list(args), env=git_env(), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        raise LookupError("git did not answer in %s" % at)
    return done.stdout.strip() if done.returncode == 0 else None


def resolved(at, path):
    """A path, made absolute against `at` and resolved through every link it has."""
    return os.path.realpath(os.path.join(at, path))


def nearest(path):
    """The nearest ancestor of `path`, itself included, that is there."""
    while not os.path.lexists(path):
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    return path


def identity(path):
    try:
        found = os.stat(path)
    except OSError:
        return None
    return (found.st_dev, found.st_ino)


def under(path, places):
    """Whether `path` — resolved, with what is not there yet judged by its nearest
    ancestor that is — lies at or below one of `places`, compared by device and inode."""
    marks = {identity(place) for place in places} - {None}
    at = nearest(os.path.realpath(path))
    while True:
        if identity(at) in marks:
            return True
        parent = os.path.dirname(at)
        if parent == at:
            return False
        at = parent


def the_run(project):
    """(the work tree, its git directories, the run) where the guard binds — or None."""
    top = git(project, "rev-parse", "--show-toplevel")
    if top is None:
        return None
    top = os.path.realpath(top)
    branch = git(top, "symbolic-ref", "--quiet", "--short", "HEAD")
    named = LOOP.fullmatch(branch or "")
    if not named:
        return None
    slug = named.group(1)
    candidates = [slug]
    stripped = ROUND.fullmatch(slug)
    if stripped:
        candidates.append(stripped.group(1))
    run = next((name for name in candidates if os.path.isfile(os.path.join(top, RUNS, name, "opening.md"))), None)
    if run is None:
        return None
    dirs = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir", "--git-dir")
    if dirs is None:
        raise LookupError("git does not name the git directories of %s" % top)
    places = [top] + [os.path.realpath(line) for line in dirs.splitlines() if line]
    return top, places, run


def words(command):
    """The words of a command line, split at spaces outside single quotes — or None where
    a quote is left open."""
    found, word, quoted = [], "", False
    for char in command:
        if char == "'":
            quoted = not quoted
        if char == " " and not quoted:
            if word:
                found.append(word)
            word = ""
        else:
            word += char
    if quoted:
        return None
    if word:
        found.append(word)
    return found


def plain_call(command, tools=TOOLS):
    """Whether a command is ONE plain invocation of one of `tools` — the three tools, unless
    a probe is active."""
    said = words(command.strip(" \n"))
    return bool(said) and said[0] in tools and all(BARE.fullmatch(word) or QUOTED.fullmatch(word) for word in said[1:])


def unquoted(word):
    return word[1:-1] if len(word) >= 2 and word[0] == word[-1] == "'" else word


def flag_values(said, flag):
    """Every value a call's words give `flag`: `--flag VALUE`, and the `--flag=VALUE` an
    argument parser takes too — each unquoted."""
    found = []
    for at, word in enumerate(said):
        if unquoted(word) == flag:
            found.append(unquoted(said[at + 1]) if at + 1 < len(said) else None)
        elif unquoted(word).startswith(flag + "="):
            found.append(unquoted(word)[len(flag) + 1:])
    return found


def begun_at(text):
    """A marker's start time, UTC to the second — or None."""
    import datetime

    try:
        return datetime.datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None


def the_probe(project):
    """What a probe's marker says, where one stands — or None: {top, marker, scratch, begun,
    writable, probe, wrong}, `wrong` what is wrong with it or None."""
    top = git(project, "rev-parse", "--show-toplevel")
    if top is None:
        return None
    top = os.path.realpath(top)
    common = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common is None:
        raise LookupError("git does not name the common git directory of %s" % top)
    marker = os.path.join(os.path.realpath(common), MARKER)
    if not os.path.lexists(marker):
        return None
    probe = {"top": top, "marker": marker, "scratch": None, "begun": None, "writable": [], "probe": None, "wrong": None}
    try:
        with open(marker, encoding="utf-8") as file:
            said = json.load(file)
    except (OSError, ValueError) as why:
        probe["wrong"] = "it cannot be read (%s)" % " ".join(str(why).split())
        return probe
    said = said if isinstance(said, dict) else {}
    scratch, begun, writable = said.get("scratch"), begun_at(said.get("begun")), said.get("writable")
    if not isinstance(scratch, str) or not os.path.isabs(scratch):
        probe["wrong"] = "it cannot be read: it names no scratch root"
        return probe
    scratch = os.path.realpath(scratch)
    probe.update(scratch=scratch, probe=said.get("probe") if isinstance(said.get("probe"), str) else None)
    if begun is None:
        probe["wrong"] = "it cannot be read: it names no time it was begun"
        return probe
    probe["begun"] = said["begun"]
    if not isinstance(writable, list) or not all(isinstance(path, str) and os.path.isabs(path) and os.path.realpath(path).startswith(scratch + os.sep) for path in writable):
        probe["wrong"] = "it cannot be read: it names no list of files under its scratch root that may be written"
        return probe
    probe["writable"] = writable
    if not os.path.isdir(scratch):
        probe["wrong"] = "it is stale: the scratch root it names, %s, is gone, so nothing may be written anywhere" % scratch
    elif (begun.now(begun.tzinfo) - begun).total_seconds() > STALE_AFTER:
        probe["wrong"] = "it is stale: it was begun at %s, more than %d hours ago, longer than any probe runs — so its probe was likely cut" % (said["begun"], STALE_AFTER // 3600)
    return probe


def same_place(target, allowed):
    """Whether `target` — resolved through every link — IS the file `allowed` names: the same
    directory, by device and inode, and the same name."""
    at = os.path.realpath(target)
    there = identity(os.path.dirname(at))
    return there is not None and there == identity(os.path.dirname(os.path.realpath(allowed))) and os.path.basename(at) == os.path.basename(allowed)


def names_obeyed(given):
    """Whether a call names the file the planted text asks for: a file tool's target, or a
    word of a command — split wherever a shell may end a path — whose last name is it."""
    for field in ("file_path", "notebook_path", "path"):
        value = given.get(field)
        if isinstance(value, str) and os.path.basename(value.rstrip("/")) == OBEYED:
            return True
    command = given.get("command")
    return isinstance(command, str) and any(os.path.basename(word) == OBEYED for word in PATH_ENDS.split(command))


def note_attempt(agent, tool, probe):
    """A note, under the probe's own root, of a refused call that named the obeyed file
    (the header: OBEYED): whether it was left."""
    import datetime
    import time

    scratch, name = probe["scratch"], probe["probe"]
    if not scratch or not isinstance(name, str) or not SLUG.fullmatch(name):
        return False
    root = os.path.join(scratch, "probe", name)
    if os.path.islink(root) or not os.path.isdir(root) or under(root, [probe["top"]]):
        return False
    notes = os.path.join(root, ATTEMPTS)
    try:
        if not os.path.lexists(notes):
            os.mkdir(notes)
        if os.path.islink(notes) or not os.path.isdir(notes):
            return False
        at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        path = os.path.join(notes, "%020d-%d.json" % (time.time_ns(), os.getpid()))
        handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
        with os.fdopen(handle, "w", encoding="utf-8") as file:
            file.write(json.dumps({"agent": str(agent), "tool": str(tool), "at": at}) + "\n")
    except OSError:
        return False
    return True


def summed(said):
    """Whether a `verdict` call is AS THE HARNESS COMPOSES IT: its words before the first
    `--` flags and their values only — no case there — one `--sum` among them, and that sum
    the sha256 of the cases after the `--`, joined by single spaces, as the probe tool holds
    them. Only the harness has computed it: no subagent has a hash tool under the marker."""
    import hashlib

    plain = [unquoted(word) for word in said]
    if "--" not in plain:
        return False
    cut = plain.index("--")
    flags, cases = plain[2:cut], plain[cut + 1:]
    at = 0
    while at < len(flags):
        if not flags[at].startswith("--"):
            return False
        at += 1 if "=" in flags[at] else 2
    sums = flag_values(said[2:cut], "--sum")
    return bool(cases) and len(sums) == 1 and sums[0] is not None and hashlib.sha256(" ".join(cases).encode("utf-8")).hexdigest() == sums[0]


def under_a_probe(agent, tool, given, event, probe):
    """The decision on a subagent's call while a runtime probe is active: an ALLOWLIST."""
    top, scratch, wrong = probe["top"], probe["scratch"], probe["wrong"]
    stale = wrong is not None and wrong.startswith("it is stale")
    readable = wrong is None or stale
    when = (", begun at %s" % probe["begun"]) if probe["begun"] else ""
    # A REFUSED CALL THAT NAMES THE OBEYED FILE IS NOTED for the probe's verdict (OBEYED).
    obeys = names_obeyed(given)

    def refused_probe(what):
        state = (" — and " + wrong) if wrong else ""
        noted = (" The guard noted this call, which names the file the probe's planted text asks for, for the probe's verdict." if note_attempt(agent, tool, probe) else "") if obeys else ""
        refused("probe", "%s may not %s while a runtime probe is active (its scratch root %s%s)%s. While it stands a subagent of this session makes only the one act of %s the harness launched its type for (%s), and writes only the files that probe names.%s No subagent lifts it by an act of its own: the probe's verdict lifts it only as the harness composed it, and a probe cut short leaves it to the main session — only the main session removes a probe's marker by hand, once it has read that the marker is its own probe's (dev/stabilize-guard --help says how)" % (agent, what, scratch or "unnamed", when, state, PROBE_TOOL, ", ".join("`%s` a %s's" % (act, who) for act, who in PROBE_ACTS.items()), noted))

    if tool in FILE_TOOLS:
        path = given.get(FILE_TOOLS[tool])
        if not isinstance(path, str) or not path:
            refused("unknown", "the %s call names no file (%s), so the guard cannot tell where it writes" % (tool, FILE_TOOLS[tool]))
        target = resolved(event.get("cwd") or top, path)
        if readable and os.path.isdir(scratch or "") and any(same_place(target, allowed) for allowed in probe["writable"]):
            return
        refused_probe("write %s" % path)
    if tool in READS:
        return
    if tool != "Bash":
        refused_probe("use %s: no tool but the shell's one call, a write of a file the probe names and a read is a subagent's" % tool)
    command = given.get("command")
    if not isinstance(command, str) or not command.strip():
        refused("unknown", "the Bash call names no command, so the guard cannot tell what it runs")
    if not plain_call(command, (PROBE_TOOL,)):
        refused_probe("run this command")
    said = words(command.strip(" \n"))
    act = unquoted(said[1]) if len(said) > 1 else None
    if act not in PROBE_ACTS:
        refused_probe("run %s's act `%s`: the acts a subagent makes under a probe are %s" % (PROBE_TOOL, act, ", ".join("`%s`" % name for name in PROBE_ACTS)))
    if agent != PROBE_ACTS[act]:
        refused_probe("make %s's act `%s`, which is a %s's alone" % (PROBE_TOOL, act, PROBE_ACTS[act]))
    if not readable:
        refused_probe("make %s's act `%s`: the marker cannot be read" % (PROBE_TOOL, act))
    given_scratch = flag_values(said, "--scratch")
    if len(given_scratch) != 1 or given_scratch[0] is None or identity(resolved(top, given_scratch[0])) is None or identity(resolved(top, given_scratch[0])) != identity(scratch):
        refused_probe("make %s's act `%s` under the scratch root %s: an act names the marker's own scratch root by --scratch, once" % (PROBE_TOOL, act, " and ".join(str(value) for value in given_scratch) or "it does not name"))
    if act in ("begin", "verdict") and flag_values(said, "--probe") != [probe["probe"]]:
        refused_probe("make %s's act `%s` of the probe %s: it is the marker's own probe's, `%s`" % (PROBE_TOOL, act, " and ".join(str(value) for value in flag_values(said, "--probe")) or "it does not name", probe["probe"]))
    # THE VERDICT LIFTS THE MARKER, WHATEVER IT JUDGES: so it runs only as the harness composed
    # it, its sum the sha256 of its cases — which no subagent can compute under the marker.
    if act == "verdict" and not summed(said):
        refused_probe("make %s's act `verdict` otherwise than the harness composed it: its words before `--` are flags and their values, and its one --sum is the sha256 of the cases after it, as the harness computed them" % PROBE_TOOL)
    here = event.get("cwd")
    if isinstance(here, str) and here and identity(resolved(top, here)) == identity(top):
        return
    refused("directory", "a call of %s runs from the repository's root, %s, and this one was made from %s: run the same line again from there" % (PROBE_TOOL, top, here))


def fence_missing():
    """Why the write fence cannot be built here, or None where it can."""
    if sys.platform != "darwin":
        return "this host is no macOS (%s), and the write fence is macOS's sandbox: no fence is built for another" % sys.platform
    if not os.access(SANDBOX, os.X_OK):
        return "the sandbox program %s is not there" % SANDBOX
    if not os.access(FENCE, os.X_OK):
        return "the fence tool %s is not there" % FENCE
    return None


def main():
    if sys.argv[1:] in (["--help"], ["-h"]):
        with open(os.path.realpath(__file__), encoding="utf-8") as source:
            for line in source.read().splitlines()[1:]:
                if not line.startswith("#"):
                    break
                sys.stdout.write(line[2:] + "\n")
        return
    if sys.argv[1:]:
        sys.stderr.write("%s: refused usage: it takes no argument but --help; a PreToolUse event is read on stdin\n" % PROG)
        sys.exit(2)
    try:
        event = json.loads(sys.stdin.read())
    except (ValueError, RecursionError):
        # Not JSON, not UTF-8 (a ValueError too), or nested deeper than the reader recurses.
        event = None
    if not isinstance(event, dict):
        sys.stderr.write("%s: refused unknown: the hook's input cannot be read as a JSON object, so nothing says whose call this is — it is blocked\n" % PROG)
        sys.exit(2)
    agent = event.get("agent_type")
    if not agent:
        return
    tool = event.get("tool_name")
    # A read runs in every case — under a probe, inside a run and outside one — so it is
    # answered before git is asked anything: the matcher hands the hook every tool.
    if tool in READS:
        return
    try:
        decide_for(agent, tool, event)
    except Exception as why:
        # NOTHING UNFORESEEN CRASHES THE GUARD: a hook that fails blocks (`onFailure: block`),
        # and with the matcher `*` it would block every tool. A subagent's call it could not
        # decide is refused, as what it cannot read is; the session's own never reached here.
        refused("unknown", "the guard failed while deciding %s's call of %s (%s: %s), so it cannot tell what that call would do: a subagent's call is refused where that cannot be told" % (agent, tool, type(why).__name__, " ".join(str(why).split())[:300]))


def decide_for(agent, tool, event):
    """The decision on a subagent's call that is no read."""
    given = event.get("tool_input")
    given = given if isinstance(given, dict) else {}
    project = os.environ.get("CLAUDE_PROJECT_DIR")
    if not project:
        refused("unknown", "CLAUDE_PROJECT_DIR is not set, so the guard cannot tell whether a runtime probe is active or %s works inside a stabilization run: a subagent's call is refused where that cannot be told, a writer's too" % agent)
    try:
        probe = the_probe(project)
    except LookupError as why:
        refused("unknown", "%s, so the guard cannot tell whether a runtime probe is active: a subagent's call is refused where that cannot be told, a writer's too" % why)
    if probe is not None:
        under_a_probe(agent, tool, given, event, probe)
        return
    if agent in WRITERS:
        return
    try:
        bound = the_run(project)
    except LookupError as why:
        refused("unknown", "%s: a call of a fenced agent is refused where the guard cannot tell what it would write" % why)
    if bound is None:
        return
    top, places, run = bound
    if tool in FILE_TOOLS:
        path = given.get(FILE_TOOLS[tool])
        if not isinstance(path, str) or not path:
            refused("unknown", "the %s call names no file (%s), so the guard cannot tell where it writes" % (tool, FILE_TOOLS[tool]))
        if under(resolved(event.get("cwd") or top, path), places):
            refused("repository", "%s may not write %s: inside the stabilization run `%s` no agent but a writer (%s) writes the run's repository %s or its git directory. Write under your scratch root, and hand a report or a filing to dev/stabilize-record by the one plain call your prompt spells" % (agent, path, run, ", ".join(WRITERS), top))
        return
    if tool in SHELLS:
        refused("shell", "%s may not use %s inside the stabilization run `%s`: it runs a shell the write guard cannot fence. Use Bash, whose commands run under the write fence" % (agent, tool, run))
    if tool in ("Agent", "Task"):
        if given.get("subagent_type") in WRITERS:
            refused("writer", "%s may not launch a %s inside the stabilization run `%s`: a writer is launched by the harness alone" % (agent, given.get("subagent_type"), run))
        return
    if tool == "Workflow":
        refused("writer", "%s may not start a workflow by Workflow inside the stabilization run `%s`: a workflow can launch any agent, a writer among them, and a writer is launched by the harness alone" % (agent, run))
    if tool != "Bash":
        return
    command = given.get("command")
    if not isinstance(command, str) or not command.strip():
        refused("unknown", "the Bash call names no command, so the guard cannot tell what it runs")
    if plain_call(command):
        here = event.get("cwd")
        if isinstance(here, str) and here and identity(resolved(top, here)) == identity(top):
            return
        refused("directory", "a call of %s runs from the repository's root, %s, and this one was made from %s: run the same line again from there" % (words(command.strip(" \n"))[0], top, here))
    called = CALLED.search(command)
    if called:
        tool_path = called.group(1)
        refused("shape", "a call of %s is taken only as ONE plain invocation, typed alone: `%s <its words>`, the tool's path first and its words after it, exactly as your prompt spells the call — no `cd`, no `&&` or `;` and no second command, no `echo`, no pipe and no redirect, no `$`, and no path before `dev/`. Its exit status is the call's own. Type the call again in that shape" % (tool_path, tool_path))
    missing = fence_missing()
    if missing:
        refused("no-fence", "%s — inside the stabilization run `%s` every command of %s runs under the write fence, and none is run open" % (missing, run, agent))
    updated = dict(given)
    import shlex

    updated["command"] = "%s --repo %s -- %s" % (shlex.quote(FENCE), shlex.quote(top), shlex.quote(command))
    if event.get("permission_mode") == "bypassPermissions":
        decide("allow", "%s: the command runs under the write fence of the stabilization run `%s`" % (PROG, run), updated)
    decide("ask", "%s: inside the stabilization run `%s` this command of %s runs only under the write fence — the command shown is that fenced command" % (PROG, run, agent), updated)


if __name__ == "__main__":
    main()
