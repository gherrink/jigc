    (in repo)  read notes.md          - ... and the file is gone

Confirmed: the verb exits 0 and notes.md is gone. Refuted: it stands, as written.
"""


class Refusal(Exception):
    def __init__(self, kind, detail, evidence, recommendation):
        super().__init__(detail)
        self.kind = kind
        self.detail = detail
        self.evidence = evidence
        self.recommendation = recommendation


def refuse(kind, detail, evidence="", recommendation="nothing of the repository was written; a setup is asked for again under a root that is not there yet"):
    raise Refusal(kind, detail, evidence, recommendation)


