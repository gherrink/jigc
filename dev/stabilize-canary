            named["verdicts"] = os.path.join(root, DIRS[1], RUNS, run_name, "r1", "verdicts")
        acts.append(named)
    # THE RULINGS OFF THE MAIN LINE, each with a prompt file of its own beside the acts' —
    # under a name no act has — and no count: nobody counted an invocation off the line.
    rulings = [{"ruling": ruling, "args": {"stage": "test", "run": run_name, "scratch": os.path.join(root, "scratch"), "rulings": [said[what]]}, "prompt": os.path.join(root, PROMPTS, ruling + ".md"), "return": os.path.join(root, "results", ruling + ".json"), "when": when} for ruling, what, when in OFF_LINE]
    for act in acts + rulings:
        with open(act["prompt"], "x", encoding="ascii") as file:
            file.write(PROMPT % {"script": script, "args": json.dumps(act["args"]), "returns": act["return"]})
    return acts, rulings


def snapshot_of(clone, env):
    """THE CLONE AS THE WRITE GUARD'S PROBE MUST LEAVE IT, read with no lock: its head, its
    tree and index as `git status` sees them, its configuration, its hooks, every ref that is
    no remote-tracking ref, and its reflogs — each a hash. Read at the setup, and by `check`
    for as long as the run shows nothing done."""
    git_dir = os.path.join(clone, ".git")

    def hashed(*paths):
        digest = hashlib.sha256()
        for path in paths:
            for directory, subdirectories, files in os.walk(path) if os.path.isdir(path) else [(os.path.dirname(path), [], [os.path.basename(path)])]:
                subdirectories.sort()
                for name in sorted(files):
                    at = os.path.join(directory, name)
                    if os.path.isfile(at) and not os.path.islink(at):
                        with open(at, "rb") as file:
                            digest.update(os.path.relpath(at, git_dir).encode("utf-8") + b"\0" + oct(os.lstat(at).st_mode).encode("ascii") + b"\0" + hashlib.sha256(file.read()).digest())
        return digest.hexdigest()

    said = lambda *argv: made(["git"] + list(argv), clone, env=env, advice=CHECK_ADVICE)
    refs = "\n".join(line for line in lines(said("for-each-ref", "--format=%(refname) %(objectname)")) if not line.startswith("refs/remotes/"))
    return {
        "head": said("rev-parse", "HEAD"),
        "status": hashlib.sha256(said(*STATUS_READ).encode("utf-8")).hexdigest(),
        "config": hashed(os.path.join(git_dir, "config")),
        "hooks": hashed(os.path.join(git_dir, "hooks")),
        "refs": hashlib.sha256(refs.encode("utf-8")).hexdigest(),
        "reflog": hashed(os.path.join(git_dir, "logs", "HEAD"), os.path.join(git_dir, "logs", "refs", "heads")),
    }


def guard_of(run_name, root, clone, scratch):
    """THE WRITE GUARD'S PROBE, as the line names it — act `part-0` — and its prompt file,
    WRITTEN: the probe's script by its path in the clone, its argument object, its prompt
    file and its return file, how many agents it launches, what the human does around it,
    and the clone's snapshot it is held to."""
    guard = {
        "act": GUARD_ACT,
        "script": os.path.join(clone, GUARD_SCRIPT),
        "args": {"run": run_name, "clone": clone, "scratch": scratch},
        "prompt": os.path.join(root, PROMPTS, GUARD_ACT + ".md"),
        "return": os.path.join(root, "results", GUARD_ACT + ".json"),
        "expect": dict(GUARD_EXPECT),
        "human": GUARD_HUMAN,
        "snapshot": snapshot_of(clone, callers_env()),
    }
    with open(guard["prompt"], "x", encoding="ascii") as file:
        file.write(PROMPT % {"script": guard["script"], "args": json.dumps(guard["args"]), "returns": guard["return"]})
    return guard


def guard_read(kept, clone, env, scratch, unmoved):
    """WHAT `check` SAYS OF THE WRITE GUARD'S PROBE (`guard`): its return, and what the clone
    shows — each write by what it would have left, the scratch file by whether it is there,
    and, while the run shows nothing done (`unmoved`), the clone's snapshot against the
    setup's. `fenced`: true where the clone holds no write of the probe's, the snapshot is
    the same, the scratch file was written and the agent says its plain call ran with no
    fence; false where a write landed or the snapshot moved; null otherwise. None for a
    root set up before the guard."""
    guard = kept.get("guard")
    if not isinstance(guard, dict) or not isinstance(guard.get("snapshot"), dict):
        return None
    there, status, _, _ = returned(guard["return"])
    attempts = None
    if status == "probed":
        with open(guard["return"], encoding="utf-8") as file:
            said = json.load(file).get("attempts")
        if isinstance(said, list):
            attempts = [{name: entry.get(name) for name in ("attempt", "exit", "refused_by", "banner", "said")} for entry in said if isinstance(entry, dict)]
    logged = b""
    for log in (os.path.join(clone, ".git", "logs", "HEAD"),):
        if os.path.isfile(log):
            with open(log, "rb") as file:
                logged = file.read()
    configured = run(["git", "config", "--local", "--get", GUARD_KEY], clone, env)
    scratched = any(GUARD_SCRATCH in files for _, _, files in os.walk(scratch))
    disk = {
        "write": "landed" if os.path.lexists(os.path.join(clone, GUARD_WRITE)) else "refused",
        "echo": "landed" if os.path.lexists(os.path.join(clone, GUARD_ECHO)) else "refused",
        "commit": "landed" if GUARD_SUBJECT in logged else "refused",
        "config": "landed" if configured.code == 0 else "refused",
        "scratch": "written" if scratched else "absent",
    }
    snapshot = None
    if unmoved:
        now = snapshot_of(clone, env)
        snapshot = {"same": now == guard["snapshot"], "moved": [name for name in sorted(now) if now[name] != guard["snapshot"].get(name)]}
    landed = [name for name in ("write", "echo", "commit", "config") if disk[name] == "landed"]
    plain = next((entry for entry in attempts or [] if entry.get("attempt") == "record"), None)
    if landed or (snapshot and not snapshot["same"]):
        fenced = False
    elif snapshot and disk["scratch"] == "written" and plain and plain.get("exit") == 0 and plain.get("refused_by") == "none" and plain.get("banner") is False:
        fenced = True
    else:
        fenced = None
    return {"act": GUARD_ACT, "returned": there, "status": status, "own": None if status is None else status in GUARD_OWN, "attempts": attempts, "disk": disk, "landed": landed, "snapshot": snapshot, "fenced": fenced}


def expected(items):
    """How many agents the first invocation launches where each ends well, and how many
    of them are one-command steps of the step tool."""
    second = 1 if any(row.get("image") for row in items) else 0
    default = [row["item"] for row in items] == [row["item"] for row in ITEMS if row["default"]]
    return {"agents": STAGE_AGENTS + second + sum(row["agents"] for row in items), "tool_steps": STAGE_TOOL_STEPS + sum(row.get("steps", 0) for row in items), "wall_minutes": WALL_MINUTES if default else None}


# --- setup ----------------------------------------------------------------------


def setup(args, facts):
    # EVERYTHING IS ASKED BEFORE ANYTHING IS MADE.
    root = unused(args.root)
    # THE SWITCH: `queue` is the facts of a run with a queue — and None without it, where
    # every line below makes what it always made.
    queue = queued(args)
    run_name, items = args.run, chosen(args.items, ITEMS if queue is None else PARTS_ITEMS)
    door = DOOR if queue is None else PARTS_DOOR
    loop, run_dir = LOOP % run_name, "%s/%s" % (RUNS, run_name)
    candidate = commit_of(args.commit, "the candidate")
    previous = commit_of(args.previous_commit, "the previous release's commit")
    lacks = [path for path in NEEDS if not holds(candidate, path)]
    if lacks:
        refuse("unfit", "the commit named, %s, lacks %s: a stage has nothing to run there" % (candidate, ", ".join(lacks)), "", "name a commit that holds the two scripts of a run and the harness")
    if queue is not None:
        wrote = the_commits_tool(candidate)
        queue["condition"] = stated(candidate)
        # THE WRITE GUARD, AND ITS PROBE: a root of the parts runs act `part-0` first.
        lacks = [path for path in GUARD_NEEDS if not holds(candidate, path)]
        if lacks:
            refuse("unfit", "the commit named, %s, lacks %s: a root of the parts runs the write guard's probe first, and that commit cannot run it" % (candidate, ", ".join(lacks)), "", "name a commit that holds the write guard, the fence and its probe")
        # THE ANSWER KEY, WITHHELD IN THE CLONE: what the clone holds in its place.
        withheld = answer_key(candidate)
    if os.path.lexists(os.path.join(ROOT, run_dir)) or holds(candidate, run_dir):
        refuse("taken", "the repository holds `%s`: the canary's run exists in its clone only, so that a stage launched from the wrong directory finds no such run" % run_dir, "", "name a run the repository does not hold")
    branches = lines(source("for-each-ref", "--format=%(refname)", "refs/heads/" + loop, "refs/remotes/*/" + loop).out)
    if branches:
        refuse("taken", "the repository holds the branch `%s` (%s): the canary's loop branch exists in its clone only" % (loop, ", ".join(branches)), "", "name a run whose loop branch the repository does not hold")

    # THE ROOT, AND ITS FOUR DIRECTORIES — made here, each once.
    if not os.path.isdir(root):
        os.mkdir(root)
    origin, clone, scratch, results = (os.path.join(root, name) for name in DIRS)
    for path in (origin, clone, scratch, results):
        os.mkdir(path)

    # THE BARE REMOTE, AND THE CLONE — a repository of its own, which fetches the two
    # commits from this one BY PATH: no remote of it names this repository.
    made(["git", "init", "-q", "--bare", origin], root)
    made(["git", "init", "-q", clone], root)
    # THE CANARY'S IDENTITY, in the clone's own configuration: it outranks the machine's, so
    # a commit a stage's step makes there carries it. Nothing commits in the bare remote.
    made(["git", "config", "user.name", NAME], clone)
    made(["git", "config", "user.email", EMAIL], clone)
    made(["git", "fetch", "-q", "--no-tags", ROOT, candidate, previous], clone)
    made(["git", "switch", "-q", "-c", loop, candidate], clone)
    if queue is not None and withheld:
        # THE ANSWER KEY, WITHHELD: one commit on the commit named, before the bare remote
        # holds the loop branch — so the tree every verifier works in, and every copy a held
        # build unpacks of a commit of the run, holds no planted row beside how it falls.
        for path in sorted(withheld):
            with open(os.path.join(clone, path), "wb") as file:
                file.write(withheld[path])
        made(["git", "add", "--"] + sorted(withheld), clone)
        made(["git", "commit", "-q", "-m", SUBJECT_WITHHELD % len(withheld)], clone)
    made(["git", "remote", "add", "origin", origin], clone)
    # What the bare remote holds before the opening: the loop branch at the commit named,
    # as a real remote holds a run's branch before the run is opened. Pushed by name.
    made(["git", "push", "-q", "origin", loop], clone)

    # THE OPENING: the record's prose, which no script writes; then every fact, row and
    # item through the CLONE'S OWN record script; then one commit, of the run's directory.
    os.makedirs(os.path.join(clone, run_dir))
    told = {"run": run_name, "loop": loop, "candidate": candidate, "previous": args.previous, "previous_commit": previous, "door": door, "seeded": SEEDED, "block": BLOCK, "items": ", ".join("`%s` (%s)" % (row["item"], row["kind"]) for row in items)}
    opened = {"stop": "every-round", "previous": args.previous, "previous-commit": previous, "scope": "delta", "clauses": list(CLAUSES)}
    if queue is None:
        text, rows, subject = OPENING % told, [seeded_row(run_dir)], SUBJECT
    else:
        rows, subject = plant_rows(), SUBJECT_PARTS
        told.update(budget=queue["budget"], hand_on=queue["hand-on"], order=", ".join("`%s`" % named for named in queue["order"]), count=len(rows), plants=", ".join("`%s` (%s seed)" % (plant["key"], plant["kind"]) for plant in PLANTS))
        text = OPENING_PARTS % told
        # The condition's entry, the budget, the number handed on and the order: the
        # run's facts, written with the others in the one call an opening makes.
        opened.update(queue)
    with open(os.path.join(clone, run_dir, "opening.md"), "x", encoding="ascii") as file:
        file.write(text)
    record = os.path.join(clone, RECORD)
    made([record, "run-set", "--run", run_name], clone, json.dumps(opened))
    made([record, "item-set", "--run", run_name], clone, json.dumps(test_set(items, previous)))
    made([record, "ledger-add", "--run", run_name], clone, json.dumps(rows))
    made(["git", "add", "--", run_dir], clone)
    made(["git", "commit", "-q", "-m", subject % run_name], clone)
    # THE PUSH IS THE STEP TOOL'S: a record's push, every commit of it vetted first.
    made([os.path.join(clone, STEP), "push", "--branch", loop, "--run-dir", run_dir], clone)

    facts.update(
        root=root,
        clone=clone,
        origin=origin,
        scratch=scratch,
        results=results,
        run=run_name,
        loop=loop,
        run_dir=run_dir,
        candidate=candidate,
        head=made(["git", "rev-parse", "HEAD"], clone),
        previous={"version": args.previous, "commit": previous},
        door=door,
        items=[{"item": row["item"], "kind": row["kind"]} for row in items],
    )
    if queue is None:
        facts.update(seeded=SEEDED)
    else:
        facts.update(plants=[{"key": plant["key"], "class": "%s seed" % plant["kind"]} for plant in PLANTS], withheld=sorted(withheld), condition=queue["condition"], budget=queue["budget"], hand_on=queue["hand-on"], order=queue["order"])
    found, state = examined(root, facts)
    # THE RUN IS IN THE STATE A FRESH RUN HAS, as the clone's own record script reads it.
    fresh = {"next": "test", "round": 1, "attempt": 1}
    if found["state"] != fresh or found["not_ready"]:
        refuse("not-fresh", "the run `%s` is not in the state a fresh run has — `next` is `test`, round 1, attempt 1, and the opening owes nothing" % run_name, json.dumps({"state": found["state"], "not_ready": found["not_ready"]}))
    facts.update(remote_head=found["remote_head"], state=fresh)
    if queue is not None:
        # EVERY PLANT IS GRADED AT THE OPENING: a row left for a triage would have that
        # triage decide whether a plant is launched, and is no opening of the parts.
        if state.get("untriaged"):
            refuse("not-fresh", "the run `%s` holds rows a triage would be handed: every plant is graded at the opening, so that none is" % run_name, json.dumps({"untriaged": state["untriaged"]}))
        # What the run's own state says of its queue: the keys it ranks, and every row
        # that is in none, under the word that keeps it out.
        listed = {}
        for row in state.get("ledger") or []:
            if row.get("route") == "listed":
                listed.setdefault(row.get("why"), []).append(row.get("key"))
        facts.update(queue=[row.get("key") for row in (state.get("queue") or {}).get("ranked") or []], listed=listed)
    facts.update(session_cwd=clone, script_path=os.path.join(clone, HARNESS))
    if queue is None:
        facts.update(
            args={"stage": "test", "run": run_name, "scratch": scratch, "scope": {"doors": [DOOR]}},
            args_then={"stage": "test", "run": run_name, "scratch": scratch},
            returns={name: os.path.join(results, name + ".json") for name in RETURNS},
        )
    else:
        # THE ACTS, each with a prompt file of its own — written last, where everything
        # else of the canary stands: a root that holds prompts holds a run that is fresh.
        os.mkdir(os.path.join(root, PROMPTS))
        acts, rulings = acts_of(run_name, root, facts["script_path"], queue, items)
        facts.update(prompts=os.path.join(root, PROMPTS), acts=acts, rulings=rulings, guard=guard_of(run_name, root, clone, scratch))
        # WHICH TOOL WROTE THIS OPENING: the file that ran, by the sha256 of its bytes — and
        # it is the file the commit named holds at this tool's path, which is the one the
        # clone holds: a setup under the switch whose tool is another was refused before
        # anything was made (the_commits_tool).
        facts.update(tool={"sha256": wrote, "as_committed": True})
    facts.update(check="dev/%s check --root %s" % (PROG, root))
    if queue is None:
        facts.update(expect=expected(items))
    facts.update(status="ready")
    kept = os.path.join(root, KEPT)
    with open(kept, "x", encoding="ascii") as file:
        file.write(json.dumps(facts, indent=1) + "\n")


# --- check ----------------------------------------------------------------------


def not_isolated(detail, evidence=""):
    refuse("not-isolated", detail, evidence, "NO STAGE IS INVOKED ON THIS CLONE: something in it, or in the caller's git configuration, could carry a push somewhere else. A canary is set up again under another root")


# `git status` AS `check` ASKS IT: with no optional lock. A plain `git status` may take the
# index's lock for a moment to write a refreshed index back, and a commit step of a stage
# that stages at that moment is refused (`locked`) and costs its record one more gate. So
# asked, it writes nothing at all — and no other git command `check` runs takes a lock.
STATUS_READ = ("--no-optional-locks", "status", "--porcelain", "--untracked-files=all")
# The word the record script refuses a read with where one of the run's writes was killed
# between its files, as its one line on stderr opens — and what follows from that state.
INTERRUPTED = "stabilize-record: refused interrupted: "
THEN = "the next invocation of the stage finishes that write before it does anything else, by itself - an invocation that only looks (stopAfter: state) names it as owed and finishes nothing. Nothing is repaired by hand, and no setup is asked for"


def examined(root, kept, advice=SETUP_ADVICE):
    """THE CLONE CAN REACH NOTHING BUT ITS BARE REMOTE — or a refusal — and what the run
    holds, read: what `check` prints of it, and the run's state as the clone's own record
    script printed it — None where `check` finds A WRITE OF THE RUN KILLED BETWEEN ITS
    FILES, which is a state the run can be in and no failure of the canary. Every answer is
    git's own, asked under the caller's configuration. `advice` is what follows where a
    command fails: the setup's, or `check`'s."""
    origin, clone, scratch, results = (os.path.join(root, name) for name in DIRS)
    for path in (origin, clone, scratch, results):
        if os.path.islink(path) or os.path.realpath(path) != path or not os.path.isdir(path):
            refuse("link", "`%s` is not the canary's own directory: it is a link, is not there, or is no directory — nothing is read or written through it" % path)
    env, run_name, loop = callers_env(), kept["run"], kept["loop"]

    def said(*argv):
        return made(["git"] + list(argv), clone, env=env, advice=advice)

    remotes = lines(said("remote"))
    if remotes != ["origin"]:
        not_isolated("the clone has the remotes %s, and a canary's clone has ONE: `origin`" % json.dumps(remotes))
    fetch_url, push_url = lines(said("remote", "get-url", "--all", "origin")), lines(said("remote", "get-url", "--push", "--all", "origin"))
    if fetch_url != [origin] or push_url != [origin]:
        not_isolated("`origin` is not the bare repository beside the clone, as git itself answers under the caller's configuration", "it fetches from %s and pushes to %s; the bare repository is `%s`" % (json.dumps(fetch_url), json.dumps(push_url), origin))
    rewrites = run(["git", "config", "--local", "--get-regexp", r"^url\..*\.(insteadof|pushinsteadof)$"], clone, env)
    if rewrites.code != 1 or rewrites.out.strip():
        not_isolated("the clone's own configuration holds a `url.*` rewrite", rewrites.shown())
    # Every value of the clone's own configuration, as git reads it — in the file itself a
    # path may be quoted — held against what is this repository's: a URL of one of its
    # remotes, and a path that leads, by its real path, into one of its working trees.
    urls = [line.split(" ", 1)[1] for line in lines(source("config", "--get-regexp", r"^remote\..*\.(url|pushurl)$").out) if " " in line]
    named = []
    for entry in said("config", "--local", "--null", "--list").split("\0"):
        key, _, value = entry.partition("\n")
        if any(url in value for url in urls if url) or (os.path.isabs(value) and within(os.path.realpath(value), repository())):
            named.append(key)
    if named:
        not_isolated("the clone's own configuration names what is this repository's — a remote of it, or the repository itself — under %s" % ", ".join(sorted(set(named))), "`git config --local --list` in the clone")

    head = said("rev-parse", "HEAD")
    listed = run(["git", "rev-parse", "--verify", "--quiet", "refs/heads/" + loop], origin, env)
    remote_head = listed.out.strip() if listed.code == 0 else None
    asked = run([os.path.join(clone, RECORD), "state", "--run", run_name], clone, env)
    killed = advice is CHECK_ADVICE and asked.code != 0 and asked.err.startswith(INTERRUPTED)
    if asked.code != 0 and not killed:
        failed(asked, advice)
    state = None if killed else parsed(asked.out.rstrip("\n"), "the clone's `%s state`" % RECORD, advice)
    at = ((state or {}).get("position") or {}).get("test") or {}
    position = {"next": (state or {}).get("next"), "round": at.get("round"), "attempt": at.get("attempt")}
    if at.get("refused"):
        position["refused"] = at["refused"]
    if killed:
        # THE STATE IS NOT READ ACROSS A KILLED WRITE — by the record script's own rule,
        # which is said here as it said it, with what follows.
        position["refused"] = "interrupted"
    return {
        "root": root,
        "run": run_name,
        "loop": loop,
        "branch": said("branch", "--show-current"),
        "remotes": remotes,
        "fetch_url": fetch_url[0],
        "push_url": push_url[0],
        "head": head,
        "remote_head": remote_head,
        "pushed": remote_head == head,
        "records": int(said("rev-list", "--count", "%s..HEAD" % kept["head"])),
        "pending": len(lines(said(*STATUS_READ))),
        "state": position,
        **({"interrupted": {"said": " ".join(asked.err.split()), "then": THEN}} if killed else {}),
        "not_ready": (state or {}).get("not_ready"),
        "items": [{"item": row.get("item"), "kind": row.get("kind"), "selected": row.get("selected")} for row in (state or {}).get("items") or []],
        "ledger": [{name: row.get(name) for name in ("key", "grade", "disposition", "route")} for row in (state or {}).get("ledger") or []],
        "returned": {name: os.path.isfile(os.path.join(results, name + ".json")) for name in RETURNS},
    }, state


def returned(path):
    """WHAT AN ACT'S RETURN FILE SAYS: whether it is there, and — where it holds one JSON
    object — the `status` and the `next` of it, and the run and the stage it names where it
    names one. A file that holds anything else is there, and says nothing; nothing is read
    through a link."""
    if not os.path.lexists(path):
        return False, None, None, {}
    said = None
    if os.path.isfile(path) and not os.path.islink(path):
        try:
            with open(path, encoding="utf-8") as file:
                said = json.load(file)
        except (OSError, ValueError):
            said = None
    if not isinstance(said, dict):
        return True, None, None, {}
    return (True,) + tuple(said[name] if isinstance(said.get(name), str) else None for name in ("status", "next")) + ({name: said[name] for name in ("run", "stage") if name in said},)


def stands(there, shows):
    """HOW AN ACT STANDS, in one word, from the two things that are asked of it — whether
    its return file is there, and whether the run shows it:
      returned          the file is there, and the run shows the act — or cannot show one
      not-written       the run shows the act, and no file is there: IT RAN, AND ITS RETURN
                        WAS NOT WRITTEN DOWN — or it was ended before it returned
      never-ran         neither
      returned-unshown  a file is there, and the run shows nothing of the act: a refusal, a
                        halt before anything was left — or a file somebody wrote
      cannot-tell       no file is there, and the act is one the run cannot show"""
    if shows is None:
        return "returned" if there else "cannot-tell"
    if there:
        return "returned" if shows else "returned-unshown"
    return "not-written" if shows else "never-ran"


def whole(path):
    """A file of a held command, as the JSON object it is — None where it is not there,
    is a link, or holds anything else. The step tool writes each whole or not at all."""
    if os.path.islink(path) or not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as file:
            said = json.load(file)
    except (OSError, ValueError):
        return None
    return said if isinstance(said, dict) else None


def not_the_binary(scratch, asked, content_sha256):
    """The step tool's ONE predicate a build's green rests on, read as that tool reads it:
    whether the file at the path a build was asked for is NOT the read-only binary of that
    hash — another file, one that can be written, a link, or none."""
    try:
        path = os.path.join(scratch, asked["to"])
        writable = os.path.islink(path) or bool(os.stat(path).st_mode & 0o222)
        with open(path, "rb") as file:
            data = file.read()
    except (OSError, KeyError, TypeError):
        return True
    return writable or hashlib.sha256(data).hexdigest() != content_sha256


def held_jobs(scratch):
    """THE HELD COMMANDS UNDER THE SCRATCH ROOT, EACH AS THE STEP TOOL WOULD ANSWER IT — READ,
    AND NOTHING ASKED OF THAT TOOL: it has no call that only reads a job. `hold-wait`, and
    `hold-start` asked again, both answer through the one function that JUDGES a command
    that has ended — it writes `verdict.json`, and for a gate runs the record script's
    reader — and a start under a name that is not there starts a command. So `check` reads
    what that function reads, in its order, and writes nothing: the job's record, under
    the shared lock of `hold` (a start holds that lock until its record is under its name,
    so a directory found without one is no start under way); the job's lock, asked shared
    and without waiting (held: its supervisor lives); how the command ended; the kept
    verdict; and, for a build that stands green, the binary's hash again. EVERY DIRECTORY
    under `hold` is listed, in the order the jobs were started (one without a record
    first), each with:
      state    running  the supervisor holds the job's lock
               done     the command has ended, and its supervisor wrote how
               dead     why: no-record — the directory holds no record of the tool's, and
                        nothing is ever read of it (supervised: whether a supervisor
                        lives under it all the same, and its command with it) · no-exit —
                        the supervisor is gone and wrote nothing · killed — a signal
                        ended the command
               null     why: no-lock, or verdict-unread — a hand was in the job's
                        directory, and the step tool answers nothing of it
      verdict  WHAT THE STEP TOOL ANSWERS NOW: the kept verdict — or, for a build whose
               kept verdict is green and whose binary is no longer the read-only file it
               hashed, `void` (why: hash-differs). null while none is kept: the next step
               that asks after the job judges it, and none appears by itself
      kept     THE KEPT WORD, as `verdict.json` holds it — what was so when the command
               ended; null while none is kept
      why      the step tool's reason, beside `dead` and beside a verdict that has one
    WHAT IT CANNOT TELL: whether the command of a job that is `dead` still runs — a
    supervisor that was killed leaves its command running, and nothing on disk says so."""
    holds = os.path.join(scratch, "hold")
    if os.path.islink(holds) or not os.path.isdir(holds):
        return []
    mutex = os.open(holds, os.O_RDONLY)
    try:
        fcntl.flock(mutex, fcntl.LOCK_SH)
        records = [(name, whole(os.path.join(holds, name, "job.json"))) for name in os.listdir(holds) if os.path.isdir(os.path.join(holds, name)) and not os.path.islink(os.path.join(holds, name))]
    finally:
        os.close(mutex)
    found = []
    for name, job in records:
        home = os.path.join(holds, name)
        if job is not None and not all(field in job for field in ("kind", "asked", "pid")):
            job = None
        said = {"name": name, "kind": job["kind"] if job else None, "state": None, "why": None, "verdict": None, "kept": None}
        try:
            lock = os.open(os.path.join(home, "lock"), os.O_RDONLY)
        except OSError:
            lock = None
        supervised = False
        if lock is not None:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except OSError:
                supervised = True
            finally:
                os.close(lock)
        ended = whole(os.path.join(home, "exit.json"))
        kept = os.path.join(home, "verdict.json")
        if job is None:
            said.update(state="dead", why="no-record", supervised=supervised)
        elif lock is None:
            said.update(why="no-lock")
        elif supervised:
            said.update(state="running")
        elif ended is None or "exit" not in ended or "signal" not in ended:
            said.update(state="dead", why="no-exit")
        elif ended["signal"] is not None:
            said.update(state="dead", why="killed")
        elif not os.path.lexists(kept):
            said.update(state="done")
        else:
            verdict = whole(kept)
            if verdict is None or not all(field in verdict for field in ("exit", "seconds", "verdict", "why", "detail", "facts")):
                said.update(why="verdict-unread")
            else:
                said.update(state="done", why=verdict["why"], verdict=verdict["verdict"], kept=verdict["verdict"])
                # A BUILD'S GREEN IS THE DISK'S, AT EVERY ANSWER: the kept word is printed
                # as kept, and the answer is the step tool's live one.
                facts = verdict["facts"] if isinstance(verdict["facts"], dict) else {}
                if job["kind"] == "build" and verdict["verdict"] == "green" and not_the_binary(scratch, job["asked"], facts.get("content_sha256")):
                    said.update(why="hash-differs", verdict="void")
        started = job.get("started") if job else None
        found.append((started if isinstance(started, (int, float)) else 0, name, said))
    return [job for _, _, job in sorted(found, key=lambda entry: entry[:2])]


def git_blob(clone, env, spec):
    """The sha256 of the bytes git holds in the clone at `spec` — `<commit>:<path>` — or None
    where it holds none. A read: `git cat-file` takes no lock."""
    done = subprocess.run(["git", "cat-file", "blob", spec], cwd=clone, env=env, capture_output=True, stdin=subprocess.DEVNULL)
    return hashlib.sha256(done.stdout).hexdigest() if done.returncode == 0 else None


# WHAT FOLLOWS FROM A BATCH THAT IS APPLIED AND IN NO COMMIT, and from a refusal of the read
# that says what is pending — `check`'s words; the two calls are spelled whole beside them.
APPLIED_THEN = "the tables of the run in the clone hold this batch, and NO COMMIT HOLDS IT: every field named under across says what the tables say with the batch applied - what the record WILL say - and records, trail, head and pushed say what is committed. The next invocation of the stage that does not only look finishes the batch before anything else, whatever it carries: it gates it under a name of its own, commits it, pushes it and starts nothing - a ruling it carries is not recorded by it (the prompt file of part-4-act-5 holds the arguments for it). The batch is taken back instead by the one call under discard, run from the clone - the exit where a halt says that no name is left to gate it under, or where the batch is not to be recorded"
COMMITTED_THEN = "every file of this batch is in the clone's HEAD as the batch wrote it: its commit is made, and the record script has not been told so yet. The next invocation of the stage settles it at its first read"
PENDING_THEN = "the clone's record script could not say what of the run is pending, and every invocation - a stage's, a look's, a ruling's - asks it at its first read: none gets past it while this stands. Where it names a file among the filed verdicts or beside the reports, that file is set aside by the call printed beside it under filed, or by dev/stabilize-record set-aside --run %s -- PATH from the clone, with the path it names"


def applied_batch(clone, env, kept):
    """THE BATCH THAT IS APPLIED, as the clone's own record script says it (`pending`, a
    read) — None where there is none — and whether a commit holds it, asked of git as the
    step tool asks it: every file of the batch is in HEAD with the bytes the batch wrote.
    (The step tool's own read of where a batch stands, `git-state --look`, is no call that
    changes nothing: it fetches, and its `git status` may take the index's lock.) A refusal
    of `pending` is a state, and is printed as one. Returns (what `check` prints, the batch
    where no commit holds it)."""
    asked = run([os.path.join(clone, RECORD), "pending", "--run", kept["run"]], clone, env)
    try:
        answer = json.loads(asked.out) if asked.code == 0 else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        return {"refused": " ".join((asked.err or asked.out).split())[:2000], "then": PENDING_THEN % kept["run"]}, None
    batch = answer.get("batch")
    if not isinstance(batch, dict):
        return None, None
    files = batch.get("files") or {}
    committed = bool(files) and all(git_blob(clone, env, "HEAD:" + path) == digest for path, digest in files.items())
    said = {"subject": batch.get("subject"), "round": batch.get("round"), "calls": batch.get("calls"), "files": sorted(files), "filed": sorted(batch.get("filed") or {}), "altered": batch.get("altered") or [], "in_commit": committed}
    if committed:
        said.update(then=COMMITTED_THEN)
        return said, None
    said.update(then=APPLIED_THEN, discard="dev/stabilize-step discard --branch %s --run-dir %s" % (kept["loop"], kept["run_dir"]))
    return said, batch


# WHAT `check` SAYS BESIDE A RULING'S FILE, AND WHERE IT WITHHOLDS ONE.
RULING_ONLY = "a ruling is typed only while NO SESSION OF AN ACT IS OPEN. check cannot see a session: while an attempt is under way - its agents hunting or verifying between two held commands - the state reads exactly as it does once that attempt is dead. What it can see, and withholds the file for: a held command whose supervisor lives, and a batch that is applied and in no commit"


def ruling_of(kept, position, budget, queue, held, uncommitted):
    """THE RULING THAT IS THE NEXT STEP, where the run's state says that one of the rulings
    off the main line is — its prompt file, by name — or None. `ruling-again`: the stage's
    next step is the human's because two attempts in a row reached no record. `ruling-
    raise-again`: the budget part 4 raised is spent, rows are left in the queue, and the
    step is the human's. NEVER NAMED WHILE AN ACT MAY BE RUNNING, as far as `check` can see
    one (`withheld` then says what it saw): a held command whose supervisor lives, or a
    batch applied and in no commit — which the next invocation finishes, whatever it
    carries, so that no ruling is the step there."""
    files = {entry.get("ruling"): entry.get("prompt") for entry in kept.get("rulings") or []}
    limit, left = (budget or {}).get("limit"), (budget or {}).get("left")
    if position.get("next") == "rule" and position.get("refused") == "attempts-spent":
        name = "ruling-again"
    elif position.get("next") == "rule" and limit == kept["budget"] + RAISE and left == 0 and queue:
        name = "ruling-raise-again"
    else:
        return None
    if name not in files:
        return None
    runs = [job["name"] for job in held if job["state"] == "running" or job.get("supervised")]
    said = {"ruling": name, "prompt": files[name], "withheld": None, "only": RULING_ONLY}
    if runs or uncommitted:
        said.update(prompt=None, withheld="a held command still runs (%s): an act may be running, or a gate it left" % ", ".join(runs) if runs else "a batch is applied and in no commit (applied): the next invocation finishes it, and no ruling is the step")
    return said


def parts_read(root, kept, state, position):
    """WHAT A PART IS READ BY (the header: check, for a root of the parts) — from the run's
    own state as the clone's record script printed it, from what that script says is
    pending, and from git in the clone: the batch that is applied; the budget, the queue,
    what is listed and why, the human's list, every filed verdict with its hash, the
    view's standing, the attempts begun, the held commands, the records made, what is
    pending by its path; for each act its return and whether the run shows it; the ruling
    that is the next step; the three tools; the answer sheet; and what a part's reading
    has to answer."""
    clone, env = os.path.join(root, DIRS[1]), callers_env()

    def said(*argv):
        return made(["git"] + list(argv), clone, env=env, advice=CHECK_ADVICE)

    # THE RECORDS MADE: every commit on the opening, oldest first, with the attempts whose
    # marker it took — and what is pending, by its path.
    marker = re.compile(re.escape(kept["run_dir"]) + MARKER)

    def attempts(paths):
        return sorted(int(held.group(1)) for held in map(marker.fullmatch, paths) if held)

    trail = []
    for entry in lines(said("log", "--reverse", "--format=%H%x1f%an <%ae>%x1f%cn <%ce>%x1f%s", "%s..HEAD" % kept["head"])):
        commit, author, committer, subject = entry.split("\x1f", 3)
        # WHO MADE IT: a record carries the canary's identity, author and committer both.
        trail.append({"commit": commit, "subject": subject, "attempts": attempts(lines(said("diff-tree", "--no-commit-id", "--name-only", "--diff-filter=A", "-r", commit))), "author": author, "committer": committer, "canary": author == committer == IDENTITY})
    pending = [line[3:] for line in lines(said(*STATUS_READ))]
    # WHERE THE STATE WAS NOT READ — a write of the run was killed between its files —
    # nothing below that is the state's is said: each such field is null, and of no act
    # is it said whether the run shows it.
    unread, state = state is None, state or {}
    rounds = state.get("rounds") or []
    begun = rounds[-1]["test_attempt"] if rounds else 0
    budget = state.get("budget") or {}

    # THE BATCH THAT IS APPLIED, AND WHETHER A COMMIT HOLDS IT. Where none does, THE STATE
    # ABOVE WAS READ ACROSS IT: every field of this line that is the state's says what the
    # tables say with the batch applied, of a record no commit holds. `check` says so three
    # times — the batch under `applied`, with the fields it reaches (`across`); `state`
    # itself (`across`); and each filed verdict the batch takes, which is printed as one NO
    # RECORD TOOK (`recorded` is asked of what is committed) and as `applied`.
    applied, batch = applied_batch(clone, env, kept)
    takes = set(batch.get("filed") or {}) if batch else set()

    # WHAT THE RUN SHOWS OF EACH ACT — each by what that act alone leaves, as the parts are
    # run in their order from one root: an attempt that reached no record before the
    # stage's first record; that record; another order than the opening's; a record of
    # filed verdicts; a budget above the opening's; after the record that raised it, an
    # attempt that reached no record, and a record that took an attempt's marker. A LOOK
    # LEAVES NOTHING, and the record an ended act left is finished by an invocation that
    # begins no attempt: of those two the run shows nothing either way (None). A BATCH
    # THAT IS APPLIED AND IN NO COMMIT IS THE RECORD IT WILL BE: the act that reached it
    # ran — to its record's gate — so it stands here as the last record made, with the
    # markers that are pending, which its commit takes.
    made_ = trail + ([{"subject": batch.get("subject") or "", "attempts": attempts(pending)}] if batch else [])
    first = next((record for record in made_ if record["subject"].endswith(FINDINGS)), None)
    raised = budget.get("limit") is not None and budget["limit"] > kept["budget"]
    ruled = [at for at, record in enumerate(made_) if record["subject"].endswith(RULINGS)]
    later = made_[ruled[-1] + 1:] if raised and ruled else []
    took = sum(1 for record in later if record["attempts"])
    loose = (0 if batch else len(attempts(pending))) + sum(len(record["attempts"]) for record in later) - took
    shows = {
        "part-1": len(first["attempts"]) > 1 if first else begun > 0,
        "part-2": first is not None,
        "part-3-act-1": (state.get("facts") or {}).get("order") != kept["order"],
        "part-3-act-2": any(record["subject"].endswith(VERDICTS) for record in made_),
        "part-4-act-1": raised,
        "part-4-act-2": raised and loose > 0,
        "part-4-act-3": None,
        "part-4-act-4": raised and took > 0,
        "part-4-act-5": None,
    }
    own = {act: more.get("own", ()) for act, more in ACTS}
    acts = []
    for act in kept["acts"]:
        there, status, following, about = returned(act["return"])
        shown = None if unread else shows[act["act"]]
        # WHETHER THE RETURN IS ONE OF THE ACT'S OWN: its status is one the act returns on
        # the main line, and it names this run and this stage where it names one. None
        # where no file is there, or it holds no status.
        mine = None if status is None else status in own[act["act"]] and about.get("run", kept["run"]) == kept["run"] and about.get("stage", "test") == "test"
        acts.append({"act": act["act"], "returned": there, "status": status, "next": following, "own": mine, "shows": shown, "stands": stands(there, shown)})

    listed = {}
    for row in state.get("ledger") or []:
        if row.get("route") == "listed":
            listed.setdefault(row.get("why"), []).append(row.get("key"))
    view = state.get("view")
    filed = []
    for entry in state.get("filed") or []:
        said_ = {name: entry.get(name) for name in ("file", "key", "verdict", "attempt", "sha256", "counts", "why", "recorded", "handed_on")}
        if said_["file"] in takes:
            said_.update(recorded=False, applied=True)
        # A LINK OR A DIRECTORY AMONG THE FILED VERDICTS is no file a record could take, and
        # the record script refuses over it: said here, with the ONE call that sets it aside.
        at = os.path.join(clone, said_["file"]) if isinstance(said_["file"], str) else None
        if at and (os.path.islink(at) or os.path.isdir(at)):
            said_.update(no_file="link" if os.path.islink(at) else "directory", set_aside="dev/stabilize-record set-aside --run %s -- %s" % (kept["run"], said_["file"]))
        filed.append(said_)
    of_the_state = {
        "budget": state.get("budget"),
        "queue": [row.get("key") for row in (state.get("queue") or {}).get("ranked") or []],
        "listed": listed,
        "human": [{"key": row.get("key"), "why": row.get("why")} for row in state.get("human_list") or []],
        "filed": filed,
        "view": view and {name: view.get(name) for name in ("file", "sha256", "on_disk")},
        "attempts": {"begun": begun, "unrecorded": rounds[-1]["test_unrecorded"] if rounds else 0},
    }
    if batch and not unread:
        applied.update(across=["state", "not_ready", "items", "ledger"] + list(of_the_state))
        position = dict(position, across="applied")
    held = held_jobs(os.path.join(root, DIRS[2]))
    with open(os.path.realpath(__file__), "rb") as file:
        reads = hashlib.sha256(file.read()).hexdigest()
    wrote = (kept.get("tool") or {}).get("sha256")
    commit = git_blob(clone, env, "%s:dev/%s" % (kept["candidate"], PROG))
    return {
        "state": position,
        "applied": applied,
        **({name: None for name in of_the_state} if unread else of_the_state),
        "held": held,
        "trail": trail,
        "identity": {"canary": IDENTITY, "others": [record["commit"] for record in trail if not record["canary"]]},
        "pending_paths": pending,
        "acts": acts,
        "guard": guard_read(kept, clone, env, os.path.join(root, DIRS[2]), not unread and begun == 0 and not trail),
        "ruling": None if unread else ruling_of(kept, position, budget, of_the_state["queue"], held, bool(batch)),
        "tool": {"wrote": wrote, "commit": commit, "reads": reads, "same": wrote == commit == reads},
        "sheet": [{"plan": plant["plan"], "key": plant["key"], "class": "%s seed" % plant["kind"], "returns": plant["returns"]} for plant in PLANTS],
        "to_answer": questions(kept.get("withheld") or []),
    }


def questions(withheld):
    """WHAT A PART'S READING HAS TO ANSWER ABOUT THE ANSWER KEY — `check`'s `to_answer`: the
    files the clone holds withheld, each by its path; and, where a planted row cites one of
    them, that row's verifier."""
    cited = [plant["evidence"] for plant in PLANTS if plant.get("evidence") in withheld]
    return [TO_ANSWER[0] % (", ".join(withheld) or "none")] + ([TO_ANSWER[1] % ", ".join(cited)] if cited else [])


# WHAT A ROOT'S KEPT LINE MUST HOLD FOR `check` TO READ IT — by every root, and by a root of
# the parts: a kept file that lacks one is no line a setup of this tool kept.
KEPT_NEEDS = ("run", "loop", "head")
KEPT_PARTS = ("run_dir", "candidate", "budget", "order")


def check(args, facts):
    root = outside(args.root)
    kept = os.path.join(root, KEPT)
    if not os.path.isfile(kept):
        refuse("missing", "the root `%s` holds no canary: no `%s` is there — a setup that failed leaves none" % (root, KEPT), "", "`dev/stabilize-canary setup` builds one, under a root that is not there yet")
    # THE KEPT LINE, READ AS WHAT IT IS OR REFUSED IN ONE LINE: a file that is no JSON object,
    # or lacks what the root is read by, is no line a setup of this tool kept — never a
    # traceback, whatever bytes it holds.
    with open(kept, "rb") as file:
        text = file.read().decode("utf-8", "replace")
    try:
        held = json.loads(text)
    except ValueError:
        held = None
    parts = isinstance(held, dict) and held.get("acts") is not None
    lacks = ["a JSON object"] if not isinstance(held, dict) else [name for name in KEPT_NEEDS + (KEPT_PARTS if parts else ()) if name not in held]
    if parts and not (isinstance(held["acts"], list) and all(isinstance(act, dict) and isinstance(act.get("act"), str) and act["act"] in dict(ACTS) and isinstance(act.get("return"), str) for act in held["acts"])):
        lacks.append("acts, each with its act and its return")
    if lacks:
        refuse("missing", "`%s` is not the line a setup of this tool kept: it lacks %s — nothing of the root is read on a guess" % (kept, ", ".join(lacks)), "", "THE RUN IN THE CLONE IS UNTOUCHED: `check` writes nothing. The file was cut short or written by something else — or by a setup of another version of this tool, and `check` is then asked of the tool of the commit the root was set up from. No setup is asked for on this word alone")
    found, state = examined(root, held, CHECK_ADVICE)
    if parts:
        # A ROOT OF THE PARTS: the small canary's two return files are no act's of it.
        del found["returned"]
        found.update(parts_read(root, held, state, found["state"]))
    facts.update(found, status="checked")


# --- arguments ------------------------------------------------------------------


class Arguments(argparse.ArgumentParser):
    def error(self, message):
        refuse("usage", "%s — see dev/stabilize-canary --help" % message)


def grammar(pattern, what, longest=None):
    def taken(value):
        if not pattern.fullmatch(value) or (longest and len(value) > longest):
            raise argparse.ArgumentTypeError("%s is not %s" % (json.dumps(value), what))
        return value

    return taken


FLAGS = {
    "budget": grammar(NUMBER, "a positive whole number"),
    "order": grammar(CLASSES, "an order of classes (`<kind>:<origin>` words joined by `,`, as `route:seed,behaviour:seed`)"),
    "run": grammar(SLUG, "a slug (a-z0-9 words joined by single `-`, at most %d characters)" % SLUG_MAX, SLUG_MAX),
    "previous": grammar(VERSION, "a version (`1.2.3`, `1.2.3-rc.4`)"),
    "previous-commit": grammar(FULL_SHA, "a full commit sha"),
}


def arguments(argv):
    parser = Arguments(prog="dev/" + PROG, add_help=False, allow_abbrev=False)
    acts = parser.add_subparsers(dest="act", required=True, parser_class=Arguments)

    def act(name, does, flags):
        sub = acts.add_parser(name, add_help=False, allow_abbrev=False)
        sub.set_defaults(does=does)
        for flag in flags:
            sub.add_argument("--" + flag, required=True, **({"type": FLAGS[flag]} if flag in FLAGS else {}))
        return sub

    opening = act("setup", setup, ["root", "commit", "run", "previous", "previous-commit"])
    opening.add_argument("--items")
    opening.add_argument("--parts", action="store_true")
    for flag in ("budget", "order"):
        opening.add_argument("--" + flag, type=FLAGS[flag])
    act("check", check, ["root"])
    if not argv or argv[0] not in acts.choices:
        refuse("usage", "%s is not an act: the acts are %s — see dev/stabilize-canary --help" % (json.dumps(argv[0]) if argv else "nothing", ", ".join(acts.choices)))
    return parser.parse_args(argv)


# --- the line -------------------------------------------------------------------


def line_of(facts):
    """The one line an act prints: its facts as JSON, and last the sha256 of that JSON —
    as dev/stabilize-step prints its line."""
    body = json.dumps({"act": facts["act"], "status": facts["status"], **facts})
    return '%s, "sha256": "%s"}' % (body[:-1], hashlib.sha256(body.encode("utf-8")).hexdigest())


def main(argv):
    # UTF-8 out, whatever the caller's locale claims: the line is read by a script.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    if any(arg in ("-h", "--help") for arg in argv):
        usage_help()
        return 0
    facts = {"act": argv[0] if argv else None}
    try:
        args = arguments(argv)
        try:
            args.does(args, facts)
        except OSError as error:
            # What the file system refused is a refusal too: one line, never a traceback.
            refuse("tool", "the file system refused what the act would make or read: %s" % error.strerror, str(error), "read what it says; a setup that stopped here left a root that holds no canary, and is asked for again under another root")
        print(line_of(facts))
        return 0
    except Refusal as refusal:
        detail = " ".join(refusal.detail.split())
        halt = {
            "root_cause": "%s: %s" % (refusal.kind, detail),
            "evidence": " ".join(refusal.evidence.split()),
            "tree_state": "(the tool writes nothing inside the repository it is run from: no tree was read)",
            "recommendation": refusal.recommendation,
        }
        facts.update(status="halted", refused=refusal.kind, halt=halt)
        print(line_of(facts))
        sys.stderr.write("%s: refused %s: %s\n" % (PROG, refusal.kind, detail))
        return STATUS[refusal.kind]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
