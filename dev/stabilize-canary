def blob_of(commit, path):
    """The bytes the commit named holds at `path`, as git holds them — no filter of the
    caller's configuration, no newline turned."""
    done = subprocess.run(["git", "cat-file", "blob", "%s:%s" % (commit, path)], cwd=ROOT, env=callers_env(), capture_output=True, stdin=subprocess.DEVNULL)
    if done.returncode != 0:
        failed(Ran(["git", "cat-file", "blob", "%s:%s" % (commit, path)], done.returncode, "", done.stderr.decode("utf-8", "replace")), SETUP_ADVICE)
    return done.stdout


def withholding(path, data):
    """WHAT THE CLONE HOLDS IN PLACE OF A FILE OF THE ANSWER KEY — the bytes, or None where
    this tool has no withheld text for a file of its kind. The log keeps its preamble and
    every heading, so that what reads an entry by its heading — the run's condition, a fence,
    a reference — finds it: only the body of an entry that names a planted row is withheld.
    Any other file is withheld whole, in words its kind takes, so that the clone's gate reads
    it as it reads any file: a Rust file a comment, a script its first line and a comment, a
    Markdown file a line of text."""
    if path == LOG:
        entries = re.split(r"(?m)^(?=%s)" % re.escape(ENTRY), data.decode("utf-8"))
        kept = [entry.split("\n", 1)[0] + "\n\n%s\n\n" % WITHHELD if entry.startswith(ENTRY) and any(name in entry for name in NAMES) else entry for entry in entries]
        return "".join(kept).encode("utf-8")
    if path.endswith(".rs"):
        return ("// %s\n" % WITHHELD).encode("ascii")
    if data.startswith(b"#!"):
        return data.split(b"\n", 1)[0] + ("\n# %s\n" % WITHHELD).encode("ascii")
    if path.endswith(".md"):
        return ("%s\n" % WITHHELD).encode("ascii")
    return None


def answer_key(candidate):
    """THE ANSWER KEY OF THE COMMIT NAMED, AS THE CLONE IS TO HOLD IT: {path: what the clone
    holds there} for every file of that commit that names a planted row — by its key, or by
    the plan's name for it — and every file a planted row cites as its evidence. Asked before
    anything is made: a file of a kind this tool has no withheld text for is refused (unfit),
    and a setup is never made with an answer the clone would hold."""
    argv = ["grep", "-z", "-l", "-F", "--no-color"]
    for name in NAMES:
        argv += ["-e", name]
    asked = source(*(argv + [candidate, "--"]))
    if asked.code not in (0, 1):
        failed(asked, SETUP_ADVICE)
    paths = {entry[len(candidate) + 1:] for entry in asked.out.split("\0") if entry.startswith(candidate + ":")}
    paths |= {plant["evidence"] for plant in PLANTS if "evidence" in plant and holds(candidate, plant["evidence"])}
    key = {}
    for path in sorted(paths):
        key[path] = withholding(path, blob_of(candidate, path))
        if key[path] is None:
            refuse("unfit", "the commit named, %s, names a planted row in `%s`, a file of a kind this tool withholds nothing of: the clone would hold how that row falls, in the tree every verifier works in" % (candidate, path), "", "withhold that kind of file in this tool's `withholding`, or name a commit whose `%s` names no planted row" % path)
    return key


