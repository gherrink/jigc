    plants, each act's arguments and each count are this file's tables, held to the harness
    of the commit this file was committed with. A commit that lacks a repair of the tools
    lacks this file as it stands too, and is refused by the same question. The two are
    compared as git's blobs, the file hashed with no filter of the caller's configuration."""
    mine = os.path.realpath(__file__)
    with open(mine, "rb") as file:
        digest = hashlib.sha256(file.read()).hexdigest()
    at = "dev/%s" % PROG

    def blob(commit):
        asked = source("rev-parse", "--verify", "--quiet", "%s:%s" % (commit, at))
        return asked.out.strip() if asked.code == 0 else None

    own, theirs = source("hash-object", "--no-filters", "--", mine), blob(candidate)
    if own.code != 0 or own.out.strip() != theirs:
