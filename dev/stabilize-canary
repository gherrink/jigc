# What names a repository from outside a command's own directory: no child inherits it.
GIT_NAMES = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY")


def callers_env():
    """The environment a READ runs in: the caller's own configuration — what the session
    that then runs the stage has too — and no repository named from outside."""
    env = dict(os.environ)
    for name in GIT_NAMES:
        env.pop(name, None)
    env.update(GIT_TERMINAL_PROMPT="0")
    return env


def makers_env():
    """The environment everything a setup MAKES is made in: no git configuration of the
    machine's — no signing, no hook, no rewrite — and an identity of the tool's own."""
    env = callers_env()
    env.update(
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_GLOBAL=os.devnull,
        GIT_AUTHOR_NAME="The Canary",
        GIT_AUTHOR_EMAIL="canary@example.invalid",
        GIT_COMMITTER_NAME="The Canary",
        GIT_COMMITTER_EMAIL="canary@example.invalid",
    )
    return env


class Ran:
    def __init__(self, argv, code, out, err):
        self.argv = argv
        self.code = code
        self.out = out
        self.err = err

    def shown(self):
        """The command and everything it printed, for a halt's evidence."""
        said = (self.out + self.err).strip()
        return "`%s` exited %d%s" % (" ".join(self.argv), self.code, ": " + said[:2000] if said else "")


def run(argv, at, env, fed=None):
    """One command, run in `at`: its exit status and what it printed. It reads nothing,
    unless it is `fed` a text."""
    done = subprocess.run(argv, cwd=at, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace", **({"stdin": subprocess.DEVNULL} if fed is None else {"input": fed}))
    return Ran(list(argv), done.returncode, done.stdout, done.stderr)


def source(*argv):
    """A git command in THIS repository — a read, every one of them: nothing here may
    write a file of it, and `git status`, which writes the index, is not among them."""
    return run(["git"] + list(argv), ROOT, callers_env())


