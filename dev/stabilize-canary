def made(argv, at, fed=None, env=None, advice=SETUP_ADVICE):
    """A command of an act's that must succeed: what it printed, without its last line
    break."""
    ran = run(argv, at, env or makers_env(), fed)
    if ran.code != 0:
        failed(ran, advice)
    return ran.out.rstrip("\n")


def lines(text):
