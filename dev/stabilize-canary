def lines(text):
    return [line for line in text.split("\n") if line]


def parsed(text, what, advice=None):
    try:
        answer = json.loads(text)
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        refuse("tool", "%s did not print one JSON object" % what, text[:2000], *([] if advice is None else [advice]))
    return answer


