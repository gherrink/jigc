        else:
            then = "The file that runs is in no commit this checkout stands at: commit it and name that commit, or run the setup from a checkout of the commit named — by the path of the tool in that checkout"
        refuse("unfit", "the tool that runs is not the tool the commit named, %s, holds at %s: the clone would hold another tool, another table of the acts, and whatever else that commit lacks of the tools a stage runs — and a setup under --parts says `ready` only where the two are one file" % (candidate, at), "git's blob of the file that runs (%s) is %s; the commit named holds %s there; checked out is %s" % (mine, own.out.strip() if own.code == 0 else own.shown(), theirs or "no such file", here or "no commit"), "nothing was made: the root holds what it held. %s" % then)
