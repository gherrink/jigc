#!/usr/bin/env bash
#
# dev/runner-faithful — run a cargo command in a fresh container shaped like a CI runner.
#
# When the question is what the RUNNER sees, a flag on this machine is not the
# instrument: macOS git reads config no mask removes, the gecos field is populated, and
# the target directory is shared with every other build here. This tool builds an image
# faithful to a GitHub-hosted runner and runs one cargo command there, on a clean clone
# of a named commit (implementation/dev-workflow.md -> Gate; DECISIONS.md -> M54 S10).
#
# What the image is faithful TO, each a deliberate choice:
#   - ubuntu:24.04, the image `ubuntu-latest` runners track, with git from the stock apt
#     archive (whatever version 24.04 ships), build-essential (tree-sitter's grammars
#     compile C) and python3 (the dogfood apparatus and the trial driver are Python).
#   - the toolchain rust-toolchain.toml names, read from THE COMMIT THAT RUNS and passed
#     as build args, never copied here, so a toolchain bump cannot leave the image behind.
#     It is rustup's DEFAULT toolchain, because a packaged .crate carries no
#     rust-toolchain.toml.
#   - a non-root user `runner`, uid 1000, whose gecos field is EMPTY (the stock `ubuntu`
#     user is removed so `runner` takes uid 1000). git falls back to the gecos name when
#     no user.name is set; an empty one makes an unconfigured commit fail instead of
#     inventing an identity, which is the posture a fresh runner has.
#   - NO git config at any level (system, global, XDG) and no GIT_CONFIG_* variable: the
#     absence is real, not masked. A build-time assertion refuses the image otherwise.
#   - CARGO_HOME, RUSTUP_HOME and CARGO_TARGET_DIR under /home/runner, inside.
#
# The source is a git bundle of the named commit's history, docker-cp'd in and cloned
# there, so the checkout has full history (like CI's fetch-depth: 0), an empty git
# config and a detached HEAD. It is NEVER a bind mount: colima serves host mounts
# read-only, silently. So uncommitted changes are NOT what runs -- commit first.
#
# There is no teardown to get wrong: the scratch root comes from mktemp -d and the
# container goes via `docker rm`. No path built from variables is removed recursively.
#
# Usage:
#   dev/runner-faithful [--platform <os/arch>] [--commit <rev>] cargo <args...>
#   dev/runner-faithful [--platform <os/arch>] [--commit <rev>] tarball
#
#   cargo       runs the named cargo command in the clone.
#   tarball     the pre-publish install acceptance (implementation/release.md -> Verifying
#               a publish): `cargo package --workspace` in the clone, both .crate files
#               unpacked outside any workspace, then these steps, each named on failure:
#                 lock-compare     the packaged jigc lock, resolved with the install's
#                                  engine overlay, is byte-equal to itself minus the
#                                  overlay's one declared rewrite (the jigc-engine entry's
#                                  source and checksum lines) -- so no entry was missing,
#                                  stale or re-resolved;
#                 install          `cargo install --path <jigc> --locked` with that overlay;
#                 version          `jigc --version` equals `jigc <v>`, <v> being the
#                                  commit's crates/cli/Cargo.toml [package] version;
#                 setup            `jigc setup` in a mktemp repository exits 0 and leaves
#                                  .jigc/AGENT.md (identity from GIT_AUTHOR_*/GIT_COMMITTER_*
#                                  only, since the image has none);
#                 probe-override   JIGC_DOC_CODE_PROBE is unset, so the probe is the one
#                                  inside the installed binary;
#                 control-finalize an arch-doc whose implemented-by anchor resolves
#                                  finalizes with exit 0;
#                 drift-finalize   the symbol renamed away and committed, a task editing
#                                  that committed arch-doc finalizes with exit 3, naming
#                                  doc-code.symbol-exists, with HEAD unchanged.
#               version .. drift-finalize are one function, post_install, that the
#               registry mode reuses.
#
#   --platform  the docker platform (default: the docker host's own, e.g. linux/arm64);
#               passed through to `docker build` and `docker create`.
#   --commit    the commit that runs (default: HEAD). It must be reachable from HEAD, a
#               branch or a tag, because only those are bundled.
#
# It prints its header on stderr -- platform, commit, toolchain, git -- from inside the
# container, so the lines describe what actually ran.
#
# Exit status: cargo's, when cargo ran; for `tarball`, 0 when every step passed and 1 at
# the first step that failed. 2 on a usage error; 125 when the run could not be set up
# (no docker, the image build or its posture assertion failed, the commit is not
# bundleable, the clone failed).

set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
repo_root=$(dirname -- "$script_dir")

say() { printf 'runner-faithful: %s\n' "$*" >&2; }
die() { say "$*"; exit 125; }
usage_error() {
    say "$*"
    say "usage: dev/runner-faithful [--platform <os/arch>] [--commit <rev>] cargo <args...>"
    say "       dev/runner-faithful [--platform <os/arch>] [--commit <rev>] tarball"
    exit 2
}

platform=
rev=HEAD
mode=
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
        --platform) [ $# -ge 2 ] || usage_error "--platform needs a value"; platform=$2; shift 2 ;;
        --platform=*) platform=${1#--platform=}; shift ;;
        --commit) [ $# -ge 2 ] || usage_error "--commit needs a value"; rev=$2; shift 2 ;;
        --commit=*) rev=${1#--commit=}; shift ;;
        cargo) mode=cargo; shift; break ;;
        tarball) mode=tarball; shift; [ $# -eq 0 ] || usage_error "tarball takes no arguments: $*"; break ;;
        *) usage_error "unknown argument: $1" ;;
    esac
done
[ -n "$mode" ] || usage_error "name a mode: a cargo command, e.g. \`cargo test -p jigc doc_link_fence::\`, or tarball"

command -v docker >/dev/null 2>&1 || die "docker is not on PATH"
docker version >/dev/null 2>&1 || die "the docker daemon does not answer (is colima running?)"

# --- the commit -------------------------------------------------------------
sha=$(git -C "$repo_root" rev-parse --verify --quiet "$rev^{commit}") || die "not a commit: $rev"
dirty=$(git -C "$repo_root" status --porcelain)
if [ -n "$dirty" ]; then
    say "the working tree has uncommitted changes; they are NOT what runs -- commit $sha is"
else
    say "runs commit $sha; uncommitted changes are never what runs"
fi

# --- the toolchain, read from that commit -----------------------------------
toolchain_toml=$(git -C "$repo_root" show "$sha:rust-toolchain.toml") \
    || die "commit $sha has no rust-toolchain.toml to read the toolchain from"
channel=$(printf '%s\n' "$toolchain_toml" | sed -n 's/^channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p')
components=$(printf '%s\n' "$toolchain_toml" | sed -n 's/^components[[:space:]]*=[[:space:]]*\[\(.*\)\].*/\1/p' | tr -d '" ')
[ -n "$channel" ] || die "rust-toolchain.toml at $sha names no channel"

# --- the platform -----------------------------------------------------------
if [ -z "$platform" ]; then
    platform=$(docker version --format '{{.Server.Os}}/{{.Server.Arch}}') || die "cannot read the docker host's platform"
fi
image="jigc-runner-faithful:$channel-$(printf '%s' "$platform" | tr '/' '-')"

tmp_root=${TMPDIR:-/tmp}
work=$(mktemp -d "${tmp_root%/}/runner-faithful.XXXXXX") || die "mktemp failed"

# --- the image --------------------------------------------------------------
say "building $image (cached layers are reused); log: $work/build.log"
docker build --platform "$platform" \
    --build-arg "RUST_TOOLCHAIN=$channel" \
    --build-arg "RUST_COMPONENTS=$components" \
    -t "$image" - >"$work/build.log" 2>&1 <<'DOCKERFILE'
FROM ubuntu:24.04

ARG RUST_TOOLCHAIN
ARG RUST_COMPONENTS

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git build-essential python3 \
 && rm -rf /var/lib/apt/lists/*

RUN userdel --remove ubuntu 2>/dev/null || true
RUN useradd --create-home --uid 1000 --shell /bin/bash --comment '' runner

USER runner
WORKDIR /home/runner

ENV CARGO_HOME=/home/runner/.cargo \
    RUSTUP_HOME=/home/runner/.rustup \
    CARGO_TARGET_DIR=/home/runner/target \
    PATH=/home/runner/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Download, then run: a `curl | sh` reports the shell's status, so a failed download
# would read as a successful install.
RUN test -n "$RUST_TOOLCHAIN" || { echo 'no RUST_TOOLCHAIN build arg' >&2; exit 1; }; \
    curl --proto '=https' --tlsv1.2 -sSf -o /tmp/rustup-init.sh https://sh.rustup.rs \
 && sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain "$RUST_TOOLCHAIN" ${RUST_COMPONENTS:+--component "$RUST_COMPONENTS"} \
 && rm /tmp/rustup-init.sh \
 && rustc --version && cargo --version

# The posture, asserted at build time so an image that drifted from it never exists.
RUN set -e; \
    test -z "$(getent passwd runner | cut -d: -f5)" || { echo 'posture: the gecos field is not empty' >&2; exit 1; }; \
    for f in /etc/gitconfig "$HOME/.gitconfig" "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"; do \
        test ! -e "$f" || { echo "posture: git config present: $f" >&2; exit 1; }; \
    done; \
    test -z "$(git config --list --show-origin 2>&1)" || { echo 'posture: git config --list is not empty' >&2; exit 1; }; \
    if git var GIT_COMMITTER_IDENT >/dev/null 2>&1; then echo 'posture: git can invent an identity' >&2; exit 1; fi; \
    if env | grep -q '^GIT_CONFIG'; then echo 'posture: a GIT_CONFIG_* variable is set' >&2; exit 1; fi; \
    cc --version >/dev/null; python3 --version; git --version
DOCKERFILE
build_status=$?
if [ "$build_status" -ne 0 ]; then
    tail -n 30 "$work/build.log" >&2
    die "the image build failed (exit $build_status); a \`posture:\` line above is the posture assertion refusing it"
fi

# --- the source -------------------------------------------------------------
# A bare sha is not bundleable (`git bundle` wants refs), so the bundle carries HEAD,
# the branches and the tags, and the container checks the named commit out of it.
git -C "$repo_root" bundle create "$work/source.bundle" HEAD --branches --tags 2>"$work/bundle.log" \
    || { cat "$work/bundle.log" >&2; die "git bundle failed"; }

# Everything below runs inside the container, as `runner`. Single-quoted, so nothing in
# it expands here; it takes the commit as $1 and the mode's arguments after it.
steps='
set -u
say() { printf "runner-faithful: %s\n" "$*" >&2; }
step=
pass() { say "ok   $step: $*"; }
# fail <message> [<log>] -- the step that failed, named; the log tail when there is one.
fail() {
    say "FAIL $step: $1"
    if [ $# -ge 2 ] && [ -f "$2" ]; then tail -n 30 "$2" >&2; fi
    exit 1
}

# post_install <expected version> -- the checks every install mode runs against the
# jigc now on PATH: version, setup, probe-override, control-finalize, drift-finalize.
post_install() {
    local want=$1 got w log out arch id comp head ed rc
    step=version
    got=$(jigc --version 2>&1) || fail "jigc --version exited $?: $got"
    [ "$got" = "jigc $want" ] || fail "jigc --version printed \"$got\", expected \"jigc $want\""
    pass "$got ($(command -v jigc))"

    step=setup
    w=$(mktemp -d /tmp/acceptance.XXXXXX) || fail "mktemp failed"
    log=$w/jigc.log
    export GIT_AUTHOR_NAME="Runner Faithful" GIT_AUTHOR_EMAIL="runner@example.invalid"
    export GIT_COMMITTER_NAME="Runner Faithful" GIT_COMMITTER_EMAIL="runner@example.invalid"
    mkdir -p "$w/repo/src" && cd "$w/repo" || fail "cannot make the throwaway repository"
    git init -q -b main . || fail "git init exited $?"
    printf "export function pad(s: string): string {\n  return s;\n}\n" > src/pad.ts
    git add src/pad.ts && git commit -q -m "initial: pad helper" || fail "the initial commit failed"
    jigc setup >>"$log" 2>&1 || fail "jigc setup exited $?" "$log"
    [ -f .jigc/AGENT.md ] || fail "jigc setup exited 0 but left no .jigc/AGENT.md" "$log"
    pass "jigc setup exited 0; .jigc/AGENT.md present"

    step=probe-override
    [ -z "${JIGC_DOC_CODE_PROBE+set}" ] || fail "JIGC_DOC_CODE_PROBE is set, so the probe is not the installed one"
    pass "JIGC_DOC_CODE_PROBE unset"

    step=control-finalize
    j() { jigc "$@" >>"$log" 2>&1 || fail "jigc $* exited $?" "$log"; }
    slot() { jigc doc set-slot "$1" --from-file - --task "$2" <<<"$3" >>"$log" 2>&1 || fail "jigc doc set-slot $1 exited $?" "$log"; }
    mint() {
        out=$(jigc start --workflow architecture-documentation "$1" 2>>"$log") || fail "jigc start exited $?" "$log"
        printf "%s\n" "$out" >>"$log"
        out=$(printf "%s\n" "$out" | sed -n "s/^task minted: //p" | head -n 1)
        [ -n "$out" ] || fail "jigc start minted no task" "$log"
    }
    commit_doc() {
        j doc set-field "commit:$1#type" --value docs --task "$1"
        j doc set-field "commit:$1#scope" --value arch-doc --task "$1"
        slot "commit:$1#summary" "$1" "$2"
        slot "commit:$1#body" "$1" "Runner-faithful install acceptance."
    }
    mint "document the padding layer"; arch=$out
    id=$(jigc doc create arch-doc --title "Padding layer" --task "$arch" 2>>"$log") || fail "jigc doc create exited $?" "$log"
    slot "$id#overview" "$arch" "The padding layer owns string-width normalization."
    comp=$(jigc doc add-item "$id#components" --title pad --task "$arch" 2>>"$log") || fail "jigc doc add-item exited $?" "$log"
    slot "$comp/description" "$arch" "Pads a string to the requested width."
    j doc set-field "$comp/implemented-by" --value "src/pad.ts#pad" --task "$arch"
    commit_doc "$arch" "document the padding layer"
    j task finalize "$arch"
    pass "$id anchored at src/pad.ts#pad finalized with exit 0"

    step=drift-finalize
    sed -i "s/function pad(/function padString(/" src/pad.ts
    git add src/pad.ts && git commit -q -m "refactor: rename pad to padString" >>"$log" 2>&1 \
        || fail "the rename commit failed" "$log"
    mint "revise the padding layer"; ed=$out
    slot "$id#overview" "$ed" "The padding layer owns string-width normalization, revised."
    commit_doc "$ed" "revise the padding layer"
    head=$(git rev-parse HEAD)
    jigc task finalize "$ed" >"$w/drift.out" 2>&1
    rc=$?
    cat "$w/drift.out" >>"$log"
    [ "$rc" -eq 3 ] || fail "finalize over the stale anchor exited $rc, expected 3" "$w/drift.out"
    grep -q "doc-code.symbol-exists" "$w/drift.out" || fail "finalize exited 3 without naming doc-code.symbol-exists" "$w/drift.out"
    [ "$(git rev-parse HEAD)" = "$head" ] || fail "the blocked finalize moved HEAD" "$w/drift.out"
    pass "a task editing $id finalized with exit 3, naming doc-code.symbol-exists; HEAD unchanged"
}
'

# The clone and the header every mode that needs the source runs first.
clone='
sha=$1
shift
git -c advice.detachedHead=false clone -q /tmp/source.bundle "$HOME/src" || { say "the clone of the bundle failed"; exit 125; }
cd "$HOME/src" || exit 125
git -c advice.detachedHead=false checkout -q --detach "$sha" 2>/dev/null \
    || { say "commit $sha is not reachable from HEAD, a branch or a tag, so it was not bundled"; exit 125; }
say "platform  $(uname -s | tr "[:upper:]" "[:lower:]")/$(uname -m)"
say "commit    $(git log -1 --format="%H %s")"
say "toolchain $(rustc --version)"
say "git       $(git --version)"
'

run_cargo='
say "running   cargo $*"
cargo "$@"
'

run_tarball='
say "running   the pre-publish install acceptance"
manifest_version() { sed -n "/^\[package\]/,/^\[/s/^version = \"\(.*\)\"\$/\1/p" "$1"; }

step=package
v=$(manifest_version crates/cli/Cargo.toml)
ev=$(manifest_version crates/engine/Cargo.toml)
[ -n "$v" ] && [ -n "$ev" ] || fail "no [package] version in crates/cli or crates/engine Cargo.toml"
cargo package --workspace >"$HOME/package.log" 2>&1 || fail "cargo package --workspace exited $?" "$HOME/package.log"
u=$HOME/unpacked
mkdir -p "$u" || fail "mkdir $u failed"
tar -xzf "$CARGO_TARGET_DIR/package/jigc-$v.crate" -C "$u" || fail "cannot unpack jigc-$v.crate"
tar -xzf "$CARGO_TARGET_DIR/package/jigc-engine-$ev.crate" -C "$u" || fail "cannot unpack jigc-engine-$ev.crate"
pass "jigc-$v.crate and jigc-engine-$ev.crate unpacked in $u"
patch="patch.crates-io.jigc-engine.path=\"$u/jigc-engine-$ev\""

step=lock-compare
# Expected: the packaged lock minus the one rewrite the overlay declares -- the engine
# resolves to the patched path, so its entry loses its registry source and checksum.
# Exactly those two lines, or the lock is not the shape this compare was pinned on.
expected=$HOME/lock.expected
: >"$expected"
in_engine=0
dropped=0
while IFS= read -r line; do
    case "$line" in
        "[[package]]") in_engine=0 ;;
        "name = \"jigc-engine\"") in_engine=1 ;;
    esac
    if [ "$in_engine" -eq 1 ]; then
        case "$line" in "source = "*|"checksum = "*) dropped=$((dropped + 1)); continue ;; esac
    fi
    printf "%s\n" "$line" >>"$expected"
done <"$u/jigc-$v/Cargo.lock"
[ "$dropped" -eq 2 ] || fail "the jigc-engine entry of the packaged lock carried $dropped source/checksum lines, expected 2"
# Resolve a copy with the same overlay as the install, unlocked, so cargo writes what
# it resolved.
cp -R "$u/jigc-$v" "$HOME/resolved" || fail "cannot copy the unpacked jigc"
( cd "$HOME/resolved" && cargo metadata --format-version 1 --config "$patch" >/dev/null 2>"$HOME/resolve.log" ) \
    || fail "cargo metadata over the packaged lock exited $?" "$HOME/resolve.log"
if ! cmp -s "$expected" "$HOME/resolved/Cargo.lock"; then
    diff "$expected" "$HOME/resolved/Cargo.lock" | head -n 40 >&2
    fail "the packaged lock re-resolved to different bytes (< packaged, > resolved)"
fi
pass "the packaged lock resolves to itself byte-for-byte, the engine rewrite of the overlay aside"

step=install
cargo install --path "$u/jigc-$v" --locked --config "$patch" >"$HOME/install.log" 2>&1 \
    || fail "cargo install --locked exited $?" "$HOME/install.log"
pass "cargo install --path jigc-$v --locked, engine patched to the unpacked jigc-engine-$ev"

post_install "$v"
say "the pre-publish install acceptance passed"
'

case "$mode" in
    cargo) inner=$steps$clone$run_cargo ;;
    tarball) inner=$steps$clone$run_tarball ;;
esac

cid=$(docker create --platform "$platform" "$image" bash -c "$inner" runner-faithful "$sha" "$@") \
    || die "docker create failed"
trap 'docker rm -f "$cid" >/dev/null 2>&1' EXIT
docker cp "$work/source.bundle" "$cid:/tmp/source.bundle" >/dev/null || die "docker cp of the bundle failed"

docker start -a "$cid"
status=$?
say "exit $status"
exit "$status"
