# The exit status gitleaks is told to use for a finding, so that its own errors (1) can
# never read as one, nor as a clean scan.
GITLEAKS_FOUND = 97


class Refusal(Exception):
    def __init__(self, kind, detail):
        super().__init__(detail)
        self.kind = kind
        self.detail = detail


def refuse(kind, detail):
    raise Refusal(kind, detail)


def shown(value):
    """A caller's value as one printable token, whatever it holds."""
    return json.dumps(value, ensure_ascii=True)


def usage_help():
    for line in open(__file__, encoding="utf-8").read().split("\n")[1:]:
        if not line.startswith("#"):
            break
        print(re.sub(r"^# ?", "", line))


# --- identifiers and paths ----------------------------------------------------


def slug(value, what):
    if not isinstance(value, str) or len(value) > SLUG_MAX or not SLUG.fullmatch(value):
        refuse("bad-id", "%s %s is not a slug (a-z0-9 words joined by single `-`, at most %d characters)" % (what, shown(value), SLUG_MAX))
    return value


def number(value, what):
    if not isinstance(value, str) or not NUMBER.fullmatch(value):
        refuse("bad-id", "%s %s is not a positive integer" % (what, shown(value)))
    return value


def stage_of(value):
    if value not in STAGES:
        refuse("bad-id", "stage %s is not one of %s" % (shown(value), ", ".join(STAGES)))
    return value


def open_run(run):
    """The run's directory, refusing a run that was never opened."""
    slug(run, "run")
    run_dir = os.path.join(ROOT, *ARTIFACTS, run)
    if not os.path.lexists(run_dir):
        refuse("not-opened", "no run %s: %s/ does not exist" % (run, "/".join(ARTIFACTS + (run,))))
    if os.path.realpath(run_dir) != run_dir:
        refuse("outside", "the run directory of %s is a link, or lies behind one" % run)
    opening = os.path.join(run_dir, "opening.md")
    if os.path.islink(opening) or not os.path.isfile(opening):
        refuse("not-opened", "run %s has no opening record: %s is not a regular file" % (run, "/".join(ARTIFACTS + (run, "opening.md"))))
    return run_dir


def below(run_dir, parts):
    """The path `parts` name below the run directory, refusing a link on the way to it."""
    path = run_dir
    for n, part in enumerate(parts, 1):
        path = os.path.join(path, part)
        if os.path.islink(path):
            refuse("outside", "%s is a link: a write there would land outside the run directory" % "/".join(parts[:n]))
    return path


def one_writer(run_dir):
    """Hold the run directory's lock until this process ends. A table is read, changed
    and replaced, so two writers at once would each drop the other's rows. Taken once a
    writer has its input in hand, never while it waits for it."""
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_EX)


def stage_parts(args):
    """The directory of a stage's reports, as path segments below the run directory."""
    number(args.round, "round")
    stage_of(args.stage)
    if args.stage == "fix":
        if args.cycle is None:
            refuse("usage", "a fix-stage report belongs to a cycle: pass --cycle")
        number(args.cycle, "cycle")
        return ["r" + args.round, "reports", "fix", "c" + args.cycle]
    if args.cycle is not None:
        refuse("usage", "--cycle is the fix stage's: a test-stage report has none")
    return ["r" + args.round, "reports", "test"]


# --- host paths -> public placeholders -----------------------------------------

NAME = r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*"
# A root ends where a name does: /tmpfile is not the temp directory.
ROOT_ENDS = r"(?![A-Za-z0-9_-])(?!\.[A-Za-z0-9_-])"
# A root any host has — /tmp, a home under /Users — is a host path only where no path is
# already running: crates/tmp/x and docs/home/z are not. A root of this machine's own is
# one wherever it stands, so `-I<home>/include` is replaced too.
PATH_OPENS = r"(?<![A-Za-z0-9_.~>-])"
ANY_HOSTS_TMP = ("/tmp", "/var/tmp")
REPOSITORY = ""


def spellings(path):
    """A directory's path as a host may print it: as given, resolved, and on macOS with
    and without the /private its temp trees resolve to."""
    path = os.path.normpath(path)
    forms = {path, os.path.realpath(path)}
    for form in list(forms):
        if form.startswith("/private/"):
            forms.add(form[len("/private"):])
        elif form.startswith(("/tmp", "/var/")):
            forms.add("/private" + form)
    return [form for form in forms if os.path.isabs(form) and len(form) > 1]


def host_roots(scratch):
    """Every root spelling a host path can open with, and the placeholder it becomes."""
    roots = {}

    def add(path, token):
        for form in spellings(path):
            roots.setdefault(form, token)

    add(ROOT, REPOSITORY)
    for path in scratch:
        add(path, "<scratch>")
    for path in (os.environ.get("TMPDIR"), tempfile.gettempdir()) + ANY_HOSTS_TMP:
        if path:
            add(path, "<tmp>")
    add(os.path.expanduser("~"), "~")
    return roots


def public(text, scratch):
    """`text` with every host path replaced by its public placeholder."""
    roots = host_roots(scratch)
    shared = {form for path in ANY_HOSTS_TMP for form in spellings(path)}

    def longest_first(names):
        return "|".join(re.escape(name) for name in sorted(names, key=len, reverse=True))

    pattern = re.compile(
        "(?:(?P<own>" + longest_first(set(roots) - shared) + ")"
        + "|" + PATH_OPENS
        + "(?:(?P<shared>" + longest_first(shared) + ")"
        + "|(?P<tmp>(?:/private)?/var/folders/" + NAME + "/" + NAME + "/T)"
        + "|(?P<home>/(?:Users|home)/" + NAME + ")))"
        + ROOT_ENDS
        + r"(?P<into>/(?=[^\s/]))?"
    )

    def placeholder(match):
        root = match.group("own") or match.group("shared")
        if root is not None:
            token = roots[root]
        else:
            token = "<tmp>" if match.group("tmp") else "~"
        into = match.group("into") or ""
        if token == REPOSITORY:
            return "" if into else "."
        return token + into

    text = pattern.sub(placeholder, text)

    # A session's scratch area lies under the temp directory with the home directory's
    # path flattened into one segment. Replaced as a temp path it still names the home.
    for home in spellings(os.path.expanduser("~")):
        flat = re.sub(r"[^A-Za-z0-9]", "-", home)
        lines = [str(n) for n, line in enumerate(text.split("\n"), 1) if flat in line]
        if len(flat) > 3 and lines:
            refuse("host-path", "line %s still names this machine's home directory inside a path (a session's scratch area?) — pass that area's root as --scratch" % ", ".join(lines))
    return text


def scratch_roots(args):
    for path in args.scratch:
        if not os.path.isabs(path):
            refuse("bad-value", "--scratch %s is not an absolute path" % shown(path))
    return args.scratch


# --- the one write --------------------------------------------------------------


def fence_check(text):
    for name, what, reddens in FENCES:
        lines = [str(n) for n, line in enumerate(text.splitlines(), 1) if reddens(line)]
        if lines:
            refuse("fence", "line %s %s, which would redden %s — write the command inside a line" % (", ".join(lines), what, name))


def did_not_run(why):
    refuse("did-not-run", "the public-hygiene scan did not run, so nothing was written: %s" % why)


def hygiene_scan(rel, text):
    """The two scanners CI runs over a push, over `text` committed at `rel` into a
    throwaway repository. Returns only when both ran and found nothing."""
    denylist = os.environ.get("JIGC_DENYLIST_FILE") or os.path.join(os.path.expanduser("~"), ".config", "jigc", "denylist")
    if not os.path.isfile(denylist):
        did_not_run("no denylist at %s (implementation/public-hygiene.md)" % denylist)
    scanner = os.path.join(SCRIPT_DIR, "hygiene-scan")
    if not os.path.isfile(scanner):
        did_not_run("dev/hygiene-scan is missing")
    tools = {}
    for tool in ("git", "gitleaks"):
        tools[tool] = shutil.which(tool)
        if tools[tool] is None:
            did_not_run("%s is not on PATH" % tool)

    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_GLOBAL=os.devnull,
        GIT_AUTHOR_NAME=PROG,
        GIT_AUTHOR_EMAIL=PROG + "@example.invalid",
        GIT_COMMITTER_NAME=PROG,
        GIT_COMMITTER_EMAIL=PROG + "@example.invalid",
    )

    def ran(argv, what):
        try:
            return subprocess.run(argv, cwd=repo, env=env, stdin=subprocess.DEVNULL, capture_output=True)
        except OSError as err:
            did_not_run("%s could not be started (%s)" % (what, err.strerror))

    def last_line(out):
        return out.stderr.decode("utf-8", "replace").strip().split("\n")[-1] or "no message"

    with tempfile.TemporaryDirectory(prefix="jigc-stabilize-scan-") as work:
        # dev/hygiene-scan scans the repository it lies in, so it is linked into this
        # one — untracked, so it is not itself scanned.
        repo = os.path.join(work, "repo")
        os.makedirs(os.path.join(repo, "dev"))
        os.symlink(scanner, os.path.join(repo, "dev", "hygiene-scan"))
        os.makedirs(os.path.dirname(os.path.join(repo, rel)))
        with open(os.path.join(repo, rel), "w", encoding="utf-8", newline="") as copy:
            copy.write(text)
        for step, argv in (
            ("init", ["init", "-q", "--template="]),
            ("add", ["add", "--", rel]),
            # No background maintenance: it would outlive the commit, in a repository
            # that is removed as soon as the scan is done.
            ("commit", ["-c", "commit.gpgsign=false", "-c", "maintenance.auto=false", "-c", "gc.auto=0", "commit", "-q", "--no-verify", "-m", "."]),
        ):
            out = ran([tools["git"]] + argv, "git")
            if out.returncode != 0:
                did_not_run("git %s failed in the scan's repository: %s" % (step, last_line(out)))

        out = ran([os.path.join(repo, "dev", "hygiene-scan"), "--tree", denylist, "HEAD"], "dev/hygiene-scan")
        if out.returncode == 1:
            places = []
            for line in out.stdout.decode("utf-8", "replace").split("\n"):
                found = re.fullmatch(r"  (?:tree|path|added +[0-9a-f]+) +(\S.*)", line)
                if found and found.group(1) not in places:
                    places.append(found.group(1))
            refuse("hygiene", "the denylist matches at %s — by where, never by what; reword it (implementation/public-hygiene.md)" % (", ".join(places) or rel))
        if out.returncode != 0:
            did_not_run("dev/hygiene-scan exited %d: %s" % (out.returncode, last_line(out)))

        report = os.path.join(work, "gitleaks.json")
        argv = [tools["gitleaks"], "git", "--redact", "--no-banner", "--no-color", "--exit-code", str(GITLEAKS_FOUND), "--report-format", "json", "--report-path", report]
        config = os.path.join(ROOT, ".gitleaks.toml")
        if os.path.isfile(config):
            argv += ["--config", config]
        out = ran(argv + [repo], "gitleaks")
        if out.returncode == GITLEAKS_FOUND:
            try:
                found = ["rule %s at line %s" % (leak["RuleID"], leak["StartLine"]) for leak in json.load(open(report, encoding="utf-8"))]
            except (OSError, ValueError, KeyError, TypeError):
                found = []
            refuse("hygiene", "gitleaks found a secret-shaped string in %s: %s — a credential is never committed, even a revoked one" % (rel, "; ".join(found) or "no location reported"))
        if out.returncode != 0:
            did_not_run("gitleaks exited %d: %s" % (out.returncode, last_line(out)))


def publish(run_dir, parts, text, replace, taken="a re-run passes the next attempt"):
    """Write `text` at `parts` below the run directory — fenced, scanned, atomically —
    and return the path written, repository-relative. Every writer ends here."""
    target = below(run_dir, parts)
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts))
    if os.path.lexists(target) and not (replace and os.path.isfile(target)):
        refuse("exists", "%s exists — %s" % (rel, taken))
    fence_check(text)
    hygiene_scan(rel, text)

    parent = os.path.dirname(target)
    os.makedirs(parent, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=parent, prefix=".%s." % PROG, suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temporary, 0o644)
        if replace:
            os.replace(temporary, target)
            temporary = None
        else:
            try:
                os.link(temporary, target)
            except FileExistsError:
                refuse("exists", "%s exists — %s" % (rel, taken))
    finally:
        if temporary is not None:
            os.unlink(temporary)
    return rel


# --- tables ---------------------------------------------------------------------


def cell(text):
    """Free text as one table cell: no line break, no bare pipe, never empty."""
    text = re.sub(r"\s*[\r\n\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029]+\s*", "<br>", text.strip())
    text = re.sub(r"[\x00-\x1f\x7f]", " ", text)
    text = re.sub(r"\\+(?=\|)", lambda run: "&#92;" * len(run.group()), text)
    return text.replace("|", "\\|") or "-"


def header(columns):
    return ["| %s |" % " | ".join(columns), "|" + "---|" * len(columns)]


def read_table(path, rel, columns):
    """The lines above the table at `path` and its rows, each a list of raw cells — or
    None when there is no file yet. A file that is not this script's table is refused."""
    if os.path.islink(path):
        refuse("outside", "%s is a link: a write to it would land outside the run directory" % rel)
    if not os.path.lexists(path):
        return None
    try:
        lines = open(path, encoding="utf-8", newline="").read().split("\n")
    except (OSError, ValueError) as err:
        refuse("corrupt", "%s cannot be read as text (%s)" % (rel, err))
    head = header(columns)
    if head[0] not in lines:
        refuse("corrupt", "%s holds no table with this script's header; it is not rewritten on a guess" % rel)
    at = lines.index(head[0])
    if lines[at + 1 : at + 2] != head[1:]:
        refuse("corrupt", "%s line %d is not the header's rule" % (rel, at + 2))
    body = lines[at + 2 :]
    while body and body[-1] == "":
        body.pop()
    rows = []
    for n, line in enumerate(body, at + 3):
        cells = re.split(r"(?<!\\)\|", line)
        if len(cells) != len(columns) + 2 or cells[0] != "" or cells[-1] != "":
            refuse("corrupt", "%s line %d is not a row of %d cells; it is not rewritten on a guess" % (rel, n, len(columns)))
        rows.append([text.strip() for text in cells[1:-1]])
    return lines[:at], rows


def render_table(above, columns, rows):
    return "\n".join(above + header(columns) + ["| %s |" % " | ".join(row) for row in rows]) + "\n"


def tick(text):
    return "`%s`" % text


def untick(text):
    return text.strip("`")


def json_stdin():
    try:
        return json.loads(sys.stdin.buffer.read().decode("utf-8"))
    except ValueError as err:
        refuse("bad-value", "stdin is not JSON (%s)" % str(err).split("\n")[0])


def json_rows(what):
    """Stdin as a non-empty list of JSON objects."""
    rows = json_stdin()
    if isinstance(rows, dict):
        rows = [rows]
    if not isinstance(rows, list) or not rows or not all(isinstance(row, dict) for row in rows):
        refuse("bad-value", "stdin must be one %s as a JSON object, or a non-empty array of them" % what)
    return rows


def fields(row, required, optional, what):
    unknown = sorted(set(row) - set(required) - set(optional))
    if unknown:
        refuse("bad-value", "%s has no field %s; it has %s" % (what, ", ".join(shown(name) for name in unknown), ", ".join(required + optional)))
    missing = [name for name in required if name not in row]
    if missing:
        refuse("bad-value", "%s lacks %s" % (what, ", ".join(missing)))


def text_of(row, name, what, scratch):
    if not isinstance(row[name], str):
        refuse("bad-value", "%s: %s must be text, not %s" % (what, name, shown(row[name])))
    return cell(public(row[name], scratch))


def said(row, name, what, scratch):
    """A cell that must say something."""
    text = text_of(row, name, what, scratch)
    if not row[name].strip():
        refuse("bad-value", "%s: %s says nothing" % (what, name))
    return text


def one_of(value, allowed, what):
    if not isinstance(value, str) or value not in allowed:
        refuse("bad-value", "%s %s is not one of %s" % (what, shown(value), ", ".join(allowed)))
    return value


def grade_cells(row, what):
    """The `grade` and `graded by` cells a row or a patch names."""
    grade = one_of(row["grade"], ("ungraded",) + GRADERS["human"], what + ": grade")
    grader, bound = row.get("graded_by"), row.get("bound")
    if (bound is not None) != (grade == "out-of-scope"):
        refuse("bad-value", "%s: out-of-scope cites a declared bound of the opening record as `bound`, and no other grade does" % what)
    if grade == "ungraded":
        if "graded_by" in row:
            refuse("bad-value", "%s: ungraded has no grader" % what)
        return "ungraded", "-"
    one_of(grader, tuple(GRADERS), what + ": graded_by")
    one_of(grade, GRADERS[grader], "%s: a grade given by %s," % (what, grader))
    if bound is not None:
        return OUT_OF_SCOPE + slug(bound, what + ": bound"), grader
    return grade, grader


def disposition_cell(row, what, scratch):
    disposition = one_of(row["disposition"], tuple(DISPOSITIONS), what + ": disposition")
    needs, detail = DISPOSITIONS[disposition], row.get("detail")
    if detail is None:
        if needs in ("sha", "required"):
            refuse("bad-value", "%s: %s needs a detail — %s" % (what, disposition, "the fix's sha" if needs == "sha" else "the bound's reach"))
        return disposition
    if needs is None:
        refuse("bad-value", "%s: %s takes no detail" % (what, disposition))
    if not isinstance(detail, str) or not detail.strip():
        refuse("bad-value", "%s: detail must be text, not %s" % (what, shown(detail)))
    if needs == "sha":
        if not SHA.fullmatch(detail):
            refuse("bad-value", "%s: fixed names the fix's commit, 7 to 40 hex digits, not %s" % (what, shown(detail)))
        return "fixed: " + detail
    return "%s: %s" % (disposition, cell(public(detail, scratch)))


def set_cells(row, what, scratch):
    """The (column index, cell) pairs for the grade and disposition `row` names."""
    cells = []
    if "grade" in row:
        cells += zip((6, 7), grade_cells(row, what))
    elif "graded_by" in row or "bound" in row:
        refuse("bad-value", "%s: graded_by and bound belong to a grade" % what)
    if "disposition" in row:
        cells.append((8, disposition_cell(row, what, scratch)))
    elif "detail" in row:
        refuse("bad-value", "%s: a detail belongs to a disposition" % what)
    return cells


LEDGER_REQUIRED = ("key", "doctype", "round", "source", "door", "clause", "repro")
LEDGER_SET = ("grade", "graded_by", "bound", "disposition", "detail")


def ledger_row(row, scratch):
    fields(row, LEDGER_REQUIRED, LEDGER_SET, "a ledger row")
    what = "row %s" % shown(row["key"])
    key = slug(row["key"], "key")
    one_of(row["doctype"], DOCTYPES, what + ": doctype")
    if isinstance(row["round"], bool) or not isinstance(row["round"], int) or row["round"] < 0:
        refuse("bad-value", "%s: round must be a whole number, 0 for the opening, not %s" % (what, shown(row["round"])))
    cells = [tick(key), tick(row["doctype"]), str(row["round"])]
    cells += [text_of(row, name, what, scratch) for name in ("source", "door", "clause")]
    cells += ["ungraded", "-", "open", text_of(row, "repro", what, scratch)]
    for at, text in set_cells(row, what, scratch):
        cells[at] = text
    return key, cells


def table_file(run_dir, parts, columns, title, says):
    """(the table file's repository-relative path, the lines above its table, its rows).
    A file that does not exist yet opens with `title` and what the table `says`."""
    run = os.path.basename(run_dir)
    rel = "/".join(ARTIFACTS + (run,) + tuple(parts))
    table = read_table(below(run_dir, parts), rel, columns)
    if table is None:
        table = (["# %s — %s" % (run, title), "", says, ""], [])
    return (rel,) + table


