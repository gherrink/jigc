def entries_of(row, name, what, scratch):
    """The cells of a list `row` may name: each entry one line of text, none blank, none
    twice — because the entries share one cell, and are matched by their text."""
    given = row.get(name, [])
    if not isinstance(given, list) or not all(isinstance(text, str) for text in given):
        refuse("bad-value", "%s: %s must be an array of texts, not %s" % (what, name, shown(given)))
    made = []
    for text in given:
        made.append(cell(public(text, scratch)))
        if not text.strip() or made[-1] == "-" or LIST_BREAK in made[-1]:
            refuse("bad-value", "%s: an entry of %s is one line of text that says something, without `%s` — not %s" % (what, name, LIST_BREAK, shown(text)))
    distinct(made, "%s: the entry of %s" % (what, name))
    return made


def item_set(args):
    run_dir = open_run(args.run)
    scratch = scratch_roots(args)
    given = []
    for item in json_rows("test-set item"):
        fields(item, ("item", "kind", "clause", "runs", "brief"), ("doors", "registries"), "a test-set item")
        what = "item %s" % shown(item["item"])
        key = slug(item["item"], "item")
        cells = [tick(key), tick(slug(item["kind"], what + ": kind")), tick(slug(item["clause"], what + ": clause"))]
        cells.append(one_of(item["runs"], ITEM_RUNS, what + ": runs"))
        covers = [entries_of(item, name, what, scratch) for name in ("doors", "registries")]
        if item["runs"] == "in-scope" and not any(covers):
            refuse("bad-value", "%s: an in-scope item names a door or a registry it covers — without one no round's test set could ever reach it" % what)
        cells += [LIST_BREAK.join(entries) or "-" for entries in covers]
        cells.append(said(item, "brief", what, scratch))
        given.append((key, cells))
    distinct([key for key, _ in given], "item")
    one_writer(run_dir)
    hold_view(run_dir)
    facts, _, rounds = grounds(run_dir)
    rel, above, rows = read_test_set(run_dir)
    keys = unique_rows(rel, rows)
    # AN ITEM JUDGES A CLAUSE OF THE CENSUS: the derivation walks the census, so the runs of
    # an item whose clause it does not name would be asked about by nothing.
    for name, clause in off_the_census(facts["clauses"], [cells for _, cells in given]):
        refuse("bad-value", "item %s: it judges the clause %s, and the run's census (run-set: clauses) names %s — an item judges a clause of the closing condition, or nothing asks about its runs. Name a clause of the census: the census is written once, and a run whose condition changes is opened again. Nothing was written" % (name, clause, ITEMS_BREAK.join(facts["clauses"])))
    for key, cells in given:
        if key in keys:
            # WHAT THE DERIVATION READS OF AN ITEM STANDS once a round has run it or owes it
            # a run: a row that changed one of the four would take that run, or what the
            # round owes, out of every clause's status.
            held = rows[keys.index(key)]
            since = counted_since(held, rounds)
            differs = [name for at, name in enumerate(ITEM_COLUMNS) if name in ITEM_READ and read_of(held, at) != read_of(cells, at)]
            if since and differs:
                refuse("exists", "item %s: %s, and from then on its clause, when it runs, its doors and its registries stand — the derivation reads them, and no row takes a run or what a round owes back: this row would change its %s (%s holds the row). Its brief and its kind are corrected by a row that names those four as they stand; an instrument that covers something else is a new item, under its own id; and what a round owes is removed by no write — a run whose test set changes is opened again. Nothing was written" % (key, since, " and ".join(differs), rel))
            rows[keys.index(key)] = cells
        else:
            keys.append(key)
            rows.append(cells)
    publish(run_dir, ["test-set.md"], render_table(above, ITEM_COLUMNS, rows), replace=True)
    render_view(run_dir)
    say(json.dumps({"test_set": rel, "written": [key for key, _ in given]}))


def round_set(args):
    run_dir = open_run(args.run)
    round_number = number(args.round, "round")
    given = json_stdin()
    if not isinstance(given, dict) or not given:
        refuse("bad-value", "stdin must be one round record as a JSON object naming at least one of %s" % ", ".join(ROUND_FACTS))
    fields(given, (), tuple(name for name in ROUND_FACTS if name not in ROUND_COUNTED), "a round record")
    what = "round %s" % round_number
    for name, shape, means in (("candidate", FULL_SHA, "a full sha of 40 hex digits"), ("base", SHA, "a sha of 7 to 40 hex digits"), ("binary", SHA256, "a sha256 of 64 hex digits")):
        if name in given and not (isinstance(given[name], str) and shape.fullmatch(given[name])):
            refuse("bad-value", "%s: %s is %s, not %s" % (what, name, means, shown(given[name])))
    if "cycles" in given and (isinstance(given["cycles"], bool) or not isinstance(given["cycles"], int) or not NUMBER.fullmatch(str(given["cycles"]))):
        refuse("bad-value", "%s: cycles is a positive whole number, not %s" % (what, shown(given["cycles"])))
    if "outcome" in given:
        one_of(given["outcome"], OUTCOMES, what + ": outcome")
    if "granted" in given:
        slug(given["granted"], what + ": the clause granted one more re-run")
    if "reverify" in given:
        slug(given["reverify"], what + ": the finding granted one more triage")
    if "again" in given:
        one_of(given["again"], STAGES, what + ": again, the stage granted one more attempt,")
    if "go" in given and given["go"] is not True:
        refuse("bad-value", "%s: go is true — the human's go after the round's stop — or is not said at all, not %s" % (what, shown(given["go"])))
    for name in ROUND_LISTS:
        if name in given:
            if not isinstance(given[name], list):
                refuse("bad-value", "%s: %s is an array of item ids, not %s" % (what, name, shown(given[name])))
            distinct([slug(item, "%s: an item of %s" % (what, name)) for item in given[name]], "%s: the item of %s" % (what, name))
    one_writer(run_dir)
    # The state as it stands before the write: every fact is held to it (THE WRITER x STATE
    # TABLE), and a fact said again as it stands changes nothing and is taken anywhere.
    read = standing(run_dir, args.run)
    rel, above, rows = read_round(run_dir, round_number)
    facts = round_facts(rel, rows)
    before = dict(facts)
    for name, value in given.items():
        if name in ROUND_ONCE and before[name] not in (None, value):
            refuse("exists", "%s holds %s %s — it is written once; nothing was written" % (rel, name, before[name]))
        if name == "cycles" and value < before[name]:
            refuse("bad-value", "%s: %d cycles are recorded, and the count never goes down to %d; nothing was written" % (what, before[name], value))
    for name in [name for name in ROUND_FACTS if name in given]:
        value, where = given[name], "%s: %s" % (what, name)
        if name in ROUND_GRANTS:
            value = before[name] + asked_for(read, int(round_number), name, value)
        elif name == "go":
            if as_said(before)["go"]:
                continue
            asked_for(read, int(round_number), name, value)
            value = before["cycles"]
        elif before[name] == value:
            continue
        elif ROUND_TAKES[name] == "untested":
            untested(read, round_number, where)
            if name == "candidate":
                tested_on(run_dir, round_number, value)
        elif ROUND_TAKES[name] == "fix":
            at = read["position"]["fix"]
            # (While the opening is not done every stage is refused, and its order is not held.)
            if latest_tested(read, round_number, where)["facts"]["outcome"] is not None or at.get("refused", "not-ready") != "not-ready":
                not_asked(where, read, "a fix cycle is counted where a fix stage works, and the position refuses one here (%s)" % at.get("refused", "round-over"))
        elif ROUND_TAKES[name] == "tested":
            latest_tested(read, round_number, where)
        facts[name] = value
    publish(run_dir, ["r" + round_number, "round.md"], render_table(above, ROUND_COLUMNS, round_rows(facts)), replace=True)
    render_view(run_dir)
    say(json.dumps({"round": rel, "facts": as_said(facts)}))


def tested_on(run_dir, round_number, candidate):
    """Refuse a candidate for a round that cannot be a tested one: a round is tested over
    the doors its scope resolved, and on the one commit its items' results name."""
    if read_scope(run_dir, round_number) is None:
        refuse("no-scope", "round %s has no scope yet: a round is tested over the doors its scope step resolved, and which items it owes a result is computed from them; nothing was written" % round_number)
    rel, _, rows = read_results(run_dir, round_number)
    elsewhere = sorted({untick(row[2]) for row in rows} - {candidate})
    if elsewhere:
        refuse("bad-value", "round %s: its results (%s) are of runs on %s, and a round tests one candidate — not %s; nothing was written" % (round_number, rel, ", ".join(elsewhere), candidate))
    # And the gate on record as the candidate's is the candidate's: a record commit's gate
    # is held to it (gate-check), and the gate of another tree is no baseline for that.
    gate = read_gate(run_dir, round_number)
    if gate is not None and gate[1]["commit"] != candidate:
        refuse("bad-value", "round %s: %s holds the gate of %s, and a round tests one candidate — not %s: the candidate's gate is the gate of the candidate; nothing was written" % (round_number, gate[0], gate[1]["commit"], candidate))


def run_set(args):
    run_dir = open_run(args.run)
    given = json_stdin()
    if not isinstance(given, dict) or not given:
        refuse("bad-value", "stdin must be the run's facts as a JSON object naming at least one of %s" % ", ".join(RUN_FACTS))
    fields(given, (), tuple(name for name in RUN_FACTS if name not in RUN_COUNTED), "a run's facts")
    if "stop" in given:
        one_of(given["stop"], STOP_MODES, "stop")
    for name in RUN_BOUNDS:
        if name in given and (isinstance(given[name], bool) or not isinstance(given[name], int) or not NUMBER.fullmatch(str(given[name]))):
            refuse("bad-value", "%s is a positive whole number, not %s" % (name, shown(given[name])))
    for name, shape, means in (("previous", VERSION, "a released version, as `1.2.3` or `1.2.3-rc.4`"), ("previous-commit", FULL_SHA, "a full sha of 40 hex digits")):
        if name in given and not (isinstance(given[name], str) and shape.fullmatch(given[name])):
            refuse("bad-value", "%s is %s, not %s" % (name, means, shown(given[name])))
    if "scope" in given:
        one_of(given["scope"], DEFAULT_SCOPES, "scope")
    if "clauses" in given:
        if not isinstance(given["clauses"], list) or not given["clauses"]:
            refuse("bad-value", "clauses is the closing condition's clauses, a non-empty array of slugs, not %s" % shown(given["clauses"]))
        distinct([slug(clause, "a clause of the closing condition") for clause in given["clauses"]], "clause")
    one_writer(run_dir)
    read = standing(run_dir, args.run)
    rel, above, rows = read_run(run_dir)
    facts = run_facts(rel, rows)
    for name in RUN_ONCE:
        if name in given and facts[name] not in (None, given[name]):
            refuse("exists", "%s holds %s %s — when a run stops, the release it measures against, its default scope and the clauses it must satisfy are written once, at its opening; nothing was written" % (rel, name, ITEMS_BREAK.join(facts[name]) if name == "clauses" else facts[name]))
    if "clauses" in given:
        # The other order of writing: the test set first. A census is written once, so one
        # that leaves an item judging nothing is not written at all.
        items_rel, _, item_rows = read_test_set(run_dir)
        for name, clause in off_the_census(given["clauses"], item_rows):
            refuse("bad-value", "clauses: the test set (%s) holds the item %s, which judges the clause %s, and this census does not name it — an item judges a clause of the closing condition, or nothing asks about its runs. Correct the item's row first (item-set: a row no round has run or owes a run of is replaced whole), or name its clause here: the census is written once. Nothing was written" % (items_rel, name, clause))
    for name, stop in RUN_BOUNDS.items():
        # A bound only goes up. It is written at the opening — before any round is begun,
        # or while the run is not ready — and after that RAISED only at the stop that names
        # it: the raise is the human's go there, and lifts no stop nobody has seen.
        held = facts[name] if name == "rounds" else facts[name] or CYCLES
        if name not in given or given[name] == facts[name]:
            continue
        if held is not None and given[name] < held:
            refuse("bad-value", "the bound %s is %d, and it never goes down to %d: only the human raises it; nothing was written" % ("across rounds" if name == "rounds" else "on a round's fix cycles", held, given[name]))
        opening = not read["rounds"] or bool(read["not_ready"])
        if not opening and not (read["stop"] and read["stop"]["why"] == stop):
            not_asked("the bound `%s`" % name, read, "it is written at the run's opening, and raised only while the run is stopped at it (`%s`)" % stop)
    facts.update(given)
    publish(run_dir, ["run.md"], render_table(above, ROUND_COLUMNS, run_rows(facts)), replace=True)
    render_view(run_dir)
    say(json.dumps({"run": rel, "facts": facts}))


def triage_entry(entry):
    """(key, the entry's cells in the triage record after `inside`, the ledger's grade and
    grader). Nothing of an entry says where the finding was found: that is computed."""
    fields(entry, ("key", "grade"), ("bound", "verdict", "regression", "fork"), "a triage entry")
    what = "entry %s" % shown(entry["key"])
    key = slug(entry["key"], "key")
    grade = one_of(entry["grade"], TRIAGE_GRADES, what + ": grade")
    fork = "-"
    if "fork" in entry:
        # A fork rides on the verdict that raised it: the verifier's, and nobody else's.
        if "verdict" not in entry or not isinstance(entry["fork"], dict):
            refuse("bad-value", "%s: a fork is the verifier's — raised with its verdict — and is one object, {kind, case, drive}" % what)
        fields(entry["fork"], tuple(FORK_FIELDS), (), what + ": a fork")
        fork = "%s: %s, %s" % tuple(one_of(entry["fork"][name], allowed, "%s: a fork's %s" % (what, name)) for name, allowed in FORK_FIELDS.items())
    if ("bound" in entry) != (grade == "out-of-scope"):
        refuse("bad-value", "%s: out-of-scope cites a declared bound as `bound`, and no other grade does" % what)
    if "bound" in entry:
        grade = OUT_OF_SCOPE + slug(entry["bound"], what + ": bound")
    if "verdict" not in entry:
        if "regression" in entry:
            refuse("bad-value", "%s: a regression is the verifier's fact about a finding it confirmed" % what)
        return key, [grade, "-", "-", fork], (grade, "triage")
    if grade not in SENT_ON:
        refuse("bad-value", "%s: a verdict is the verifier's, and the verifier is sent %s — not %s" % (what, " and ".join(SENT_ON), grade))
    if one_of(entry["verdict"], VERDICTS, what + ": verdict") == "refuted":
        if "regression" in entry:
            refuse("bad-value", "%s: a regression is the verifier's fact about a finding it confirmed" % what)
        return key, [grade, "refuted", "-", fork], ("refuted", "verify-real")
    regression = entry.get("regression")
    if regression is not None and not isinstance(regression, bool):
        refuse("bad-value", "%s: confirmed says whether the finding is a regression where its verifier knows — `regression` is true when the repro is green on the previous release, false when it is red there too — and says nothing (the field absent, or null) where it does not: %s is none of the three" % (what, shown(regression)))
    if regression is None:
        # THE VERIFIER DOES NOT KNOW — it was handed no binary of the previous release, the
        # door is one that release does not have, its return does not back the claim. The
        # cell says so (`-` beside `confirmed`), the finding is confirmed, and the state
        # names it: never `no`, which would be a fact nobody established.
        return key, [grade, "confirmed", "-", fork], ("confirmed", "verify-real")
    if regression:
        return key, [grade, "confirmed", "yes", fork], ("regression", "verify-real")
    return key, [grade, "confirmed", "no", fork], ("confirmed", "verify-real")


def triage_set(args):
    run_dir = open_run(args.run)
    round_number = number(args.round, "round")
    given = [triage_entry(entry) for entry in json_rows("triage entry")]
    distinct([key for key, _, _ in given], "finding")
    one_writer(run_dir)
    a_round(standing(run_dir, args.run), round_number, "the triage of round %s" % round_number)
    ledger, ledger_above, ledger_rows = read_ledger(run_dir)
    keys = unique_rows(ledger, ledger_rows)
    for key, _, _ in given:
        if key not in keys:
            refuse("no-such-row", "the ledger has no row %s — a finding is added before it is triaged; nothing was written" % key)
    hold_to_the_list(run_dir, [("entry %s" % key, cells[0]) for key, cells, _ in given])
    scope = read_scope(run_dir, round_number)
    if scope is None:
        refuse("no-scope", "round %s has no scope yet: whether a finding is inside the test set is computed from the round's doors, which scope-set writes; nothing was written" % round_number)
    rel, above, rows = read_triage(run_dir, round_number)
    triaged = unique_rows(rel, rows)
    for key, cells, grade in given:
        row = ledger_rows[keys.index(key)]
        # The disposition the row carries into this round goes into the record with it:
        # a finding found again inherits it, and the record says what it inherited.
        entry = [tick(key), inside_cell(placed(row[4], scope[1]))] + cells[:3] + [row[8], cells[3]]
        if key in triaged:
            rows[triaged.index(key)] = entry
        else:
            triaged.append(key)
            rows.append(entry)
        row[6], row[7] = grade
    publish(run_dir, ["r" + round_number, "triage.md"], render_table(above, TRIAGE_COLUMNS, rows), replace=True)
    publish(run_dir, ["ledger.md"], render_table(ledger_above, LEDGER_COLUMNS, ledger_rows), replace=True)
    # THE PASSES ARE COUNTED HERE, never by an invocation: every finding this record leaves
    # without a grade or a verdict is named in the round's own record, with how many of the
    # round's triage records in a row have left it so. A finding it settles is named no more.
    left = by_name(round_facts(*read_round(run_dir, round_number)[::2])["awaiting"])
    awaiting = []
    for finding in document(run_dir, args.run)["ledger"]:
        if finding["awaits"] is not None:
            why, passes = left.get(finding["key"], (None, 0))
            awaiting.append("%s %s %d" % (finding["key"], finding["awaits"]["why"], passes + 1 if why == finding["awaits"]["why"] else 1))
    counted(run_dir, round_number, "awaiting", awaiting)
    say(json.dumps({"triage": rel, "ledger": ledger, "recorded": [key for key, _, _ in given]}))


# --- the state, and what follows from it ----------------------------------------------


def as_data(text):
    """A cell as the table holds it, its pipes unescaped."""
    return text.replace("\\|", "|")


def grade_read(rel, key, text):
    """(grade, the bound it cites) of a grade cell."""
    if text.startswith(OUT_OF_SCOPE) and SLUG.fullmatch(text[len(OUT_OF_SCOPE):]):
        return "out-of-scope", text[len(OUT_OF_SCOPE):]
    if text != "out-of-scope" and text in ("ungraded",) + GRADERS["human"]:
        return text, None
    spoiled(rel, "gives %s the grade %s, which this script does not write" % (key, shown(text)))


def stands(entry):
    """Whether a round's triage of a finding leaves it standing: confirmed, in need of a
    bound, or sent to the verifier and not refuted."""
    return entry["verdict"] == "confirmed" or (entry["verdict"] is None and entry["grade"] in SENT_ON + ("needs-bound",))


def fix_held(finding, triage):
    """Whether a row's `fixed` stands. It does not when the latest round that triaged the
    finding found it again, standing, with that same fix on its row: a fix that did not
    hold is neither a fix nor the human's ruling."""
    return not (triage is not None and stands(triage) and same_fix(triage["found_with"], finding["detail"]))


def same_fix(found_with, detail):
    """Whether the disposition a finding was found with is the fix its row names now: the
    same commit, written at whatever length — 7 to 40 hex digits of one sha are one fix."""
    found = found_with[len("fixed: "):] if found_with.startswith("fixed: ") else None
    return bool(found) and bool(detail) and (found.startswith(detail) or detail.startswith(found))


def route_of(finding, triage, listed):
    """Where one finding goes, and why: `fix` (without asking), `human` (the human's
    list), `triage` (back to the round's triage: nobody graded it, or nobody verified
    it) or `recorded` (nothing more in this run). A pure function of the row, the round's
    triage of it and the declared bounds; the header's table is this function."""
    grade, disposition = finding["grade"], finding["disposition"]
    if disposition == "fixed" and fix_held(finding, triage):
        return "recorded", "fixed"
    if disposition in ("bound", "later"):
        return "recorded", "ruled"
    if disposition == "admitted":
        return "fix", "admitted"
    # open — or no-action, which is neither a fix nor the human's ruling — or fixed by a
    # fix that did not hold: open again.
    # A FORK NOBODY RULED: the latest round that triaged the finding recorded that its
    # verdict contests a settled decision. It is the human's, whatever the verdict and
    # wherever it was found — never a fixer's unasked, and never recorded as no break.
    if triage is not None and triage["fork"] is not None:
        return "human", "fork"
    if grade == "ungraded":
        return "triage", "ungraded"
    if grade in SENT_ON:
        return "triage", "unverified"
    if grade in ("no-break", "refuted"):
        return "recorded", "not-a-break"
    if grade == "out-of-scope":
        return ("recorded", "out-of-scope") if finding["bound"] in listed else ("human", "bound-not-listed")
    if grade == "needs-bound":
        return "human", "needs-bound"
    # A verified break: confirmed, or a regression.
    if grade == "regression":
        return "fix", "regression"
    if triage is None:
        return "human", "untriaged"
    return ("fix", "inside") if triage["inside"] else ("human", "outside")


NOT_RECORDED = "not-recorded-after-retry"
AFTER_RETRY = "-after-retry"
NO_INSTRUMENT = "not-green-and-no-instrument"
NEVER_SELECTED = "judged-and-never-selected"
STILL_NOT_GREEN = "not-green-after-its-rerun"


def owed_by(facts):
    """What the run's opening still owes before any stage starts."""
    owed = []
    if not facts["clauses"]:
        owed.append("no-clause-row")
    if facts["stop"] is None:
        owed.append("no-stop-mode")
    elif facts["stop"] == "at-the-bound" and facts["rounds"] is None:
        owed.append("no-round-bound")
    if facts["previous"] is None or facts["previous-commit"] is None:
        owed.append("no-previous-release")
    if facts["scope"] is None:
        owed.append("no-default-scope")
    return owed


def fixed_in(held):
    """Whether a FIX STAGE IS ON RECORD in a round: its record counts a fix -> audit cycle,
    or says how the fix stage ended it. Such a round counts toward the bound across
    rounds, and the candidate it tested is no longer the run's: what it leaves is tested
    by the next round, or by nobody yet."""
    return held["facts"]["cycles"] >= 1 or held["facts"]["outcome"] is not None


def judged(census, item_rows, rounds):
    """THE DERIVATION: what the results of the test set's items give for each clause of the
    census — a pure function of the census, the test set, and each TESTED round's scope,
    results and record. Nothing else says what a clause's status is, and no caller does.

    An item is OWED by the latest tested round whose scope selects it — its `round` — and
    by no round when none does: then it owes nothing. Its run is the latest attempt that
    round's results hold for it, and its STANDING is `green` or `red` as that run says, and
    `void` when the run is void (`void`), when the round holds no run of it (`not-run`), or
    when a fix stage is on record in the latest tested round (`not-current`): what that
    fix stage left is tested by nobody yet, so nothing says which doors its fixes reach,
    and a check's run is of an earlier candidate. (A fix stage that a tested round has
    followed is answered by that round's scope: it selects the item, which then owes a run
    there, or it does not, and the earlier run stands.)
    An item that is not green and could be run again is owed its next attempt — `due`
    while that attempt is the stage's own or the one that is automatic, or one the human
    granted; `spent` otherwise.

    A clause is `void` while an owed item is void or it has no owed item at all, else `red`
    while one is red, else `green`."""
    tested = [held for held in rounds if held["facts"]["candidate"] is not None]
    unfollowed = bool(tested) and fixed_in(tested[-1])
    clauses = []
    for clause in census:
        entries = []
        for item in item_rows:
            if untick(item[2]) != clause:
                continue
            name = untick(item[0])
            entry = {"item": name, "runs": item[3], "round": None, "attempt": None, "commit": None, "outcome": None, "reason": None, "standing": "not-selected", "why": None, "rerun": None}
            entries.append(entry)
            selecting = [held for held in tested if selected_by(item, held["doors"])]
            if not selecting:
                continue
            at = selecting[-1]
            runs = [row for row in at["results"] if row["item"] == name]
            entry["round"] = at["round"]
            if runs:
                entry.update({name_: runs[-1][name_] for name_ in ("attempt", "commit", "outcome", "reason")})
            if unfollowed:
                entry.update(standing="void", why="not-current")
                continue
            if not runs:
                entry.update(standing="void", why="not-run")
            elif runs[-1]["outcome"] == "void":
                entry.update(standing="void", why="void")
            else:
                entry["standing"] = runs[-1]["outcome"]
            if entry["standing"] != "green":
                following = "%s a%d" % (name, len(runs) + 1)
                entry["rerun"] = "due" if len(runs) < AUTOMATIC or following in at["facts"]["granted"] else "spent"
        owed = [entry for entry in entries if entry["standing"] != "not-selected"]
        standings = {entry["standing"] for entry in owed}
        status = "void" if "void" in standings or not owed else "red" if "red" in standings else "green"
        reruns = {entry["rerun"] for entry in owed}
        ran = [entry for entry in owed if entry["attempt"] is not None]
        latest = max(ran, key=lambda entry: (entry["round"], entry["attempt"])) if ran else None
        clauses.append({
            "clause": clause,
            "instrument": LIST_BREAK.join(said_of(entry) for entry in entries) or "-",
            "commit": latest and latest["commit"],
            "scope": ITEMS_BREAK.join("round %d" % number_ for number_ in sorted({entry["round"] for entry in owed})) or "-",
            "status": status,
            "round": latest and latest["round"],
            "behind": sum(fixed_in(held) for held in rounds if held["round"] >= latest["round"]) if latest else None,
            "retry": None if status == "green" else "no-instrument" if not entries else "never-selected" if not owed else "spent" if "spent" in reruns else "due" if "due" in reruns else None,
            "items": entries,
        })
    return clauses


def said_of(entry):
    """Where one item's run stands, as its clause's row in the view says it."""
    run = "round %s, attempt %s" % (entry["round"], entry["attempt"])
    words = {
        (None, None): "not selected by any tested round: it owes nothing",
        ("green", None): "green (%s)" % run,
        ("red", None): "red (%s), filed as %s" % (run, tick(RED + entry["item"])),
        ("void", "void"): "void (%s): %s" % (run, entry["reason"]),
        ("void", "not-run"): "void: round %s selects it and holds no run of it" % entry["round"],
        ("void", "not-current"): "void: not current — round %s selected it, a fix stage is on record since, and no tested round has followed that" % entry["round"],
    }
    return "%s — %s" % (tick(entry["item"]), words[(None if entry["round"] is None else entry["standing"], entry["why"])])


def view_rows(clauses):
    """The clause table's rows, as the derivation gives them."""
    return [[tick(row["clause"]), row["instrument"], tick(row["commit"]) if row["commit"] else "-", row["scope"], row["status"]] for row in clauses]


def results_of(rel, rows):
    """A round's results as [{item, attempt, commit, outcome, reason, finding}], in the
    order they were recorded. A row that is not this script's is refused — and so is a run
    whose earlier attempt is gone: an item's attempts are numbered from 1, without a gap."""
    held, runs = [], {}
    for row in rows:
        name, commit, outcome, detail = untick(row[0]), untick(row[2]), row[3], row[4]
        runs[name] = runs.get(name, 0) + 1
        shaped = {"green": detail == "-", "red": detail == tick(RED + name), "void": detail != "-"}
        if not SLUG.fullmatch(name) or row[1] != str(runs[name]) or not FULL_SHA.fullmatch(commit) or not shaped.get(outcome):
            spoiled(rel, "holds a row for %s (attempt %s) that this script does not write, or that follows a row that is gone" % (row[0], row[1]))
        held.append({"item": name, "attempt": runs[name], "commit": commit, "outcome": outcome, "reason": detail if outcome == "void" else None, "finding": RED + name if outcome == "red" else None})
    return held


def grounds(run_dir):
    """What the derivation is computed from, read from the tables as they stand: the run's
    facts, the test set's rows, and per round with a directory its scope, its record and
    its results. A round whose record names a candidate has a scope, or is refused."""
    facts_rel, _, fact_rows = read_run(run_dir)
    facts = run_facts(facts_rel, fact_rows)
    items_rel, _, item_rows = read_test_set(run_dir)
    unique_rows(items_rel, item_rows)
    for row in item_rows:
        if row[3] not in ITEM_RUNS:
            spoiled(items_rel, "says that %s runs %s, which this script does not write" % (row[0], shown(row[3])))
    for name, clause in off_the_census(facts["clauses"], item_rows):
        spoiled(items_rel, "says that %s judges the clause %s, which the run's census (%s) does not name — no writer of this script leaves that, and the derivation would pass over the item in silence" % (name, clause, facts_rel))
    rounds = []
    for number_ in numbered(run_dir, [], "r"):
        scope = read_scope(run_dir, number_)
        record_rel, _, record_rows = read_round(run_dir, number_)
        held = {"round": number_, "doors": scope and scope[1], "facts": as_said(round_facts(record_rel, record_rows))}
        if held["facts"]["candidate"] is not None and scope is None:
            spoiled(record_rel, "names the candidate of a round that has no scope")
        results_rel, _, result_rows = read_results(run_dir, number_)
        held["results"] = results_of(results_rel, result_rows)
        # WHAT IS DELETED IS MISSED: the round's record counts the runs of each item, and
        # the results hold exactly those.
        counts, runs = by_name(held["facts"]["ran"]), {}
        for ran in held["results"]:
            runs[ran["item"]] = ran["attempt"]
        for name in sorted(set(counts) | set(runs)):
            has, said_ = runs.get(name, 0), counts.get(name, ("", 0))[1]
            if has < said_:
                spoiled(results_rel, "lacks attempt %d of %s — the round's record (%s) counts %d run(s) of it, and a result that is gone is not read as a run that never was" % (has + 1, name, record_rel, said_))
            if has > said_:
                spoiled(results_rel, "holds attempt %d of %s, a run the round's record (%s) does not count" % (has, name, record_rel))
        # — and a held check's result is the tool's verdict ON RECORD: the file that result
        # was written from is there, and says the word the result says.
        kinds = {untick(row[0]): untick(row[1]) for row in item_rows}
        for ran in held["results"]:
            if kinds.get(ran["item"], "").startswith(HELD):
                kept, word = verdict_on_record(run_dir, number_, ran["item"], ran["attempt"])
                if ran["outcome"] == "void" and (ran["reason"] or "").startswith(NO_VERDICT):
                    # A void by a word: the check left NO verdict, and none is on record.
                    if word is not None:
                        spoiled(results_rel, "says that the held check %s left no verdict in its attempt %d, and %s holds one, which says %s: a result is the tool's verdict on record, or the word that there was none" % (ran["item"], ran["attempt"], kept, word))
                    continue
                if word != ran["outcome"]:
                    spoiled(results_rel, "says that the held check %s was %s in its attempt %d, and %s — the verdict that result was written from — %s: a held check's result is the tool's verdict on record, and what is deleted is missed" % (ran["item"], ran["outcome"], ran["attempt"], kept, "is gone, or is no verdict of that run" if word is None else "says %s" % word))
        rounds.append(held)
    return facts, item_rows, rounds


def the_view(run_dir):
    """(the clause table's path, the lines above its table, the rows it holds, the rows the
    derivation gives, and the derivation itself)."""
    facts, item_rows, rounds = grounds(run_dir)
    clauses = judged(facts["clauses"] or [], item_rows, rounds)
    rel, above, rows = read_clauses(run_dir)
    return rel, above, rows, view_rows(clauses), clauses


def hold_view(run_dir):
    """Refuse a clause table that does not say what the item results give: it is rendered,
    and a row a hand changed, added or deleted is never read — and never quietly rendered
    over by the next writer either."""
    rel, _, rows, derived, clauses = the_view(run_dir)
    if rows == derived:
        return clauses
    held, given = {row[0]: row for row in rows}, {row[0]: row for row in derived}
    wrong = ["has no row for %s" % name for name in given if name not in held]
    wrong += ["holds a row for %s, which is no clause of the run" % name for name in held if name not in given]
    wrong += ["says %s of %s where the results give %s" % (shown(held[name][4]), name, shown(given[name][4])) for name in given if name in held and held[name][4] != given[name][4]]
    wrong += ["holds a row for %s whose cells are not the ones the results give" % name for name in given if name in held and held[name] != given[name] and held[name][4] == given[name][4]]
    spoiled(rel, "is not the table the item results give — it %s. It is rendered from each round's results and written by no caller: take the file back from the commit that holds it" % "; ".join(wrong or ["holds its rows in another order"]))


def render_view(run_dir):
    """Render the clause table again, where what a writer staged changes what it says."""
    rel, above, rows, derived, _ = the_view(run_dir)
    if rows != derived:
        publish(run_dir, ["clauses.md"], render_table(above, CLAUSE_COLUMNS, derived), replace=True)


def over(rounds, findings):
    """Whether the latest round is over: tested, and its outcome set or nothing open."""
    if not rounds or rounds[-1]["facts"]["candidate"] is None:
        return False
    return rounds[-1]["facts"]["outcome"] is not None or all(finding["route"] == "recorded" for finding in findings)


def next_of(findings, clauses, rounds, facts, owed):
    """What follows from the state, as the document's fields from `candidate` to `stop` —
    a pure function of the routes, the clause table, the rounds' records and the run's
    facts; the header's table is this function."""
    forbids = [{"clause": row["clause"], "status": row["status"]} for row in clauses if row["status"] != "green"]
    if not clauses:
        forbids.append({"clauses": "no row"})
    still = [finding for finding in findings if finding["route"] != "recorded"]
    forbids += [{"finding": finding["key"], "route": finding["route"]} for finding in still]
    routes = {finding["route"] for finding in still}
    last = rounds[-1] if rounds else None
    tested = bool(rounds) and last["facts"]["candidate"] is not None
    done = over(rounds, findings)
    # The candidate the latest round tested is the run's for as long as no fix stage is on
    # record in that round. Close is reachable from nothing else.
    current = tested and not fixed_in(last)
    if not current:
        forbids.append({"candidate": "not-tested", "round": last["round"] if rounds else None})
    fix_rounds = sum(fixed_in(held) for held in rounds)
    # What the clause table asks for, once it is all that is left to ask.
    left = not owed and current and not still
    asked = {word: [row["clause"] for row in clauses if left and row["retry"] == word] for word in ("spent", "no-instrument", "never-selected", "due")}
    unsettled = [{"cell": cell, "clauses": asked[word]} for cell, word in ((NO_INSTRUMENT, "no-instrument"), (NEVER_SELECTED, "never-selected")) if asked[word]]
    if owed:
        step = "not-ready"
    elif not tested or (done and fixed_in(last)):
        step = "test"
    elif "triage" in routes:
        step = "triage"
    elif "human" in routes:
        step = "rule"
    elif "fix" in routes:
        step = "fix"
    elif asked["spent"]:
        step = "rule"
    elif unsettled:
        step = "unsettled"
    elif asked["due"]:
        step = "retest"
    else:
        step = "close"
    why = None
    if step != "not-ready" and facts["stop"] == "every-round" and done:
        # After every round — until the human's go for that stop is on record: a go given
        # with fewer fix cycles on record than the round has now answered an earlier stop.
        if not last["facts"]["go"]:
            why = "every-round"
    elif step == "fix" and last["facts"]["cycles"] >= (facts["cycles"] or CYCLES):
        # The bound inside a round: as many fix -> audit cycles are recorded as it allows.
        why = "cycle-bound"
    elif step == "fix" and facts["stop"] == "at-the-bound" and not fixed_in(last) and fix_rounds >= facts["rounds"]:
        # The bound counts fix rounds: one more would start here, and it is spent.
        why = "round-bound"
    ran = [held for held in rounds if held["facts"]["candidate"] is not None]
    return {
        "candidate": {"round": ran[-1]["round"] if ran else None, "commit": ran[-1]["facts"]["candidate"] if ran else None, "current": current},
        "fix_rounds": fix_rounds,
        "untriaged": [{"key": finding["key"], "why": finding["why"]} for finding in still if finding["route"] == "triage"],
        "retest": asked["due"] if step == "retest" else [],
        "human_clauses": [{"clause": clause, "why": STILL_NOT_GREEN} for clause in asked["spent"]],
        "unsettled": unsettled,
        "forbids_close": forbids,
        "next": "stop" if why else step,
        "stop": {"why": why, "round": last["round"], "then": step} if why else None,
    }


def asked_for(read, round_number, name, value):
    """Refuse a fact that records the human's answer to something the state does not ask:
    a go where the run is not stopped after that round, one more re-run for a clause that
    is not the human's in it. `read` is the state as it stands before the write. For a
    grant, returns the runs it allows: the next attempt of every item of the clause whose
    re-run is spent in that round."""
    if name == "go":
        stop = read["stop"]
        if not (stop and stop["why"] == "every-round" and stop["round"] == round_number):
            at_bound = " at its bound across rounds, where the go is the raised bound (run-set: rounds)" if stop and stop["why"] == "round-bound" else ""
            refuse("bad-value", "round %d: the run is not stopped after this round for the human's go — its next step is `%s`%s; a go is recorded for the stop after a round, and for no other state; nothing was written" % (round_number, read["next"], at_bound))
        return None
    if name == "reverify":
        # One more triage of a finding that is still without a grade or a verdict after
        # the one that is automatic: a fact of the latest round, whose record counts them.
        awaits = [finding["awaits"] for finding in read["ledger"] if finding["key"] == value and finding["awaits"] and finding["awaits"]["retry"] == "spent"]
        if not awaits or round_number != read["round"]:
            refuse("bad-value", "round %d: the finding %s is not the human's to grant one more triage there — that is granted to a finding the state's human_list names as still ungraded or unverified after its retry, in the latest round; nothing was written" % (round_number, value))
        return ["%s p%d" % (value, awaits[0]["passes"] + 1)]
    if name == "again":
        # One more attempt of a stage that did not reach its record twice in a row.
        spent = [entry for entry in read["human_stages"] if entry["stage"] == value and entry["round"] == round_number]
        if not spent:
            refuse("bad-value", "round %d: the `%s` stage is not the human's to grant one more attempt there — that is granted to a stage the state's human_stages names: one whose attempts did not reach their record; nothing was written" % (round_number, value))
        return ["%s a%d" % (spent[0]["at"], spent[0]["attempt"])]
    spent = [entry for row in read["clauses"] if row["clause"] == value for entry in row["items"] if entry["rerun"] == "spent" and entry["round"] == round_number]
    if not any(entry["clause"] == value for entry in read["human_clauses"]) or not spent:
        refuse("bad-value", "round %d: the clause %s is not the human's there — one more re-run is granted to a clause an item of which is still not green after its re-run (the state's human_clauses), in the round that selected that item; nothing was written" % (round_number, value))
    return ["%s a%d" % (entry["item"], entry["attempt"] + 1) for entry in spent]


def numbered(run_dir, parts, letter):
    """The numbers N of the directories `<letter>N` at `parts` below the run directory."""
    directory = below(run_dir, parts) if parts else run_dir
    found = []
    for name in os.listdir(directory) if os.path.isdir(directory) else []:
        if re.fullmatch(letter + NUMBER.pattern, name) and os.path.isdir(below(run_dir, parts + [name])):
            found.append(int(name[1:]))
    return sorted(found)


def reports_in(run_dir, parts):
    """(how many reports the stage's directory holds, the highest attempt one carries)."""
    directory = below(run_dir, parts)
    names = os.listdir(directory) if os.path.isdir(directory) else []
    attempts = [int(REPORT_NAME.fullmatch(name).group(2)) for name in names if REPORT_NAME.fullmatch(name) and os.path.isfile(below(run_dir, parts + [name]))]
    return len(attempts), max(attempts, default=0)


def covered_by(item):
    """(the doors, the registries) an item's row names, each as a list of cells."""
    return [[] if text == "-" else text.split(LIST_BREAK) for text in item[4:6]]


def selected_by(item, scope_rows):
    """Whether the latest round runs an item: always, for one that runs on every
    candidate; else when one of the round's included doors is one of the item's, or comes
    from one of its registries — and None while that round has no scope to ask."""
    if item[3] == "every-candidate":
        return True
    if scope_rows is None:
        return None
    doors, registries = covered_by(item)
    return any(row[1] == "included" and (row[0] in doors or row[2] in registries) for row in scope_rows)


def off_the_census(census, item_rows):
    """The items among `item_rows` that judge no clause of `census`, as (item, clause) —
    none while there is no census: nothing holds a clause to anything yet, and a run
    without one is not ready."""
    return [(untick(row[0]), untick(row[2])) for row in item_rows if census and untick(row[2]) not in census]


def read_of(item, at):
    """One cell of an item's row as the derivation reads it: a list of doors or of
    registries is the set it names, in whatever order."""
    return sorted(covered_by(item)[at - 4]) if at in (4, 5) else item[at]


def counted_since(item, rounds):
    """Since when the derivation counts an item, in words — the first round that holds a run
    of it, or the first tested round whose scope selects it and so owes it one — or None:
    nothing has run it and nothing owes it a run, and its row is replaced whole."""
    name = untick(item[0])
    for held in rounds:
        if any(ran["item"] == name for ran in held["results"]):
            return "round %d holds a run of it" % held["round"]
        if held["facts"]["candidate"] is not None and selected_by(item, held["doors"]):
            return "round %d is tested, and its scope selects the item: the round owes it a run" % held["round"]
    return None


def unreached(item_rows, rounds):
    """WHAT CANNOT BE HELD, NAMED: (the in-scope items no TESTED round's scope has selected,
    the doors a round's scope included that no item of the test set names — by the door,
    or by the registry it comes from — each with the rounds whose test set holds it). A
    door has no list it could be held to: a round's doors are derived afresh by its scope
    step. So an item's door mistyped by one letter reads as a door the round did not
    reach, the item owes nothing, and nothing here can tell the two apart — these two
    lists are where it shows, from both sides."""
    tested = [held for held in rounds if held["facts"]["candidate"] is not None]
    never = [untick(item[0]) for item in item_rows if item[3] == "in-scope" and not any(selected_by(item, held["doors"]) for held in tested)]
    doors = {door for item in item_rows for door in covered_by(item)[0]}
    registries = {registry for item in item_rows for registry in covered_by(item)[1]}
    bare = {}
    for held in rounds:
        for row in held["doors"] or []:
            if row[1] == "included" and row[0] not in doors and row[2] not in registries:
                bare.setdefault((row[0], row[2]), []).append(held["round"])
    return never, [{"door": as_data(door), "registry": as_data(registry), "rounds": within} for (door, registry), within in bare.items()]


def position_of(rounds, findings, owed, stop, rerun):
    """What an invocation of each stage would work on — the round, the cycle and the
    attempt — or why it is refused. A pure function of the rounds' records, the routes,
    what the opening owes and the stop the next step computed from the run's facts; the
    header's table is this function. The third entry, `spent`, is no stage's position: it
    names the stages refused because their attempts are spent."""
    number_ = rounds[-1]["round"] if rounds else None
    spent = []

    def refused(word):
        return {"refused": word, "round": number_}

    def attempted(stage, held, cycle=None):
        """The next attempt of a stage in a round — or, where as many attempts in a row as
        are tried without the human left reports and no record, and the human granted no
        further one, its refusal."""
        at = "test" if stage == "test" else "fix-c%d" % cycle
        on_disk = held["test_attempt"] if stage == "test" else max([had["attempt"] for had in held["fix_cycles"] if had["cycle"] == cycle], default=0)
        unrecorded = held["test_unrecorded"] if stage == "test" else max([had["unrecorded"] for had in held["fix_cycles"] if had["cycle"] == cycle], default=0)
        if unrecorded >= AUTOMATIC and "%s a%d" % (at, on_disk + 1) not in held["facts"]["again"]:
            spent.append({"stage": stage, "round": held["round"], "cycle": cycle, "at": at, "attempt": on_disk + 1, "attempts": unrecorded, "why": NOT_RECORDED})
            return None
        return on_disk + 1

    def placed_(test, fix):
        return {"test": test, "fix": fix, "spent": spent}

    if owed:
        return placed_(refused("not-ready"), refused("not-ready"))
    if not rounds:
        return placed_({"round": 1, "attempt": 1}, refused("no-round"))
    last = rounds[-1]
    if last["facts"]["candidate"] is None:
        attempt = attempted("test", last)
        return placed_({"round": number_, "attempt": attempt} if attempt else refused("attempts-spent"), refused("not-tested"))
    # Round R+1 — which waits for the human's go where the run is stopped after R.
    onward = {"round": number_ + 1, "attempt": 1}
    if stop and stop["why"] == "every-round":
        onward = refused("stopped")
    if last["facts"]["outcome"] is not None:
        return placed_(onward, refused("round-over"))
    still = not over(rounds, findings)
    cycle = last["facts"]["cycles"] + 1
    # The fix stage's attempts may be spent too — but its position is refused for that only
    # where the step is that stage's (the state, below): a round whose last cycle left
    # nothing open still has to land, whatever halted before.
    fix = {"round": number_, "cycle": cycle, "attempt": attempted("fix", last, cycle) or 1 + max([had["attempt"] for had in last["fix_cycles"] if had["cycle"] == cycle], default=0), "land": last["facts"]["cycles"] >= 1 and not still}
    if rerun:
        # The step is an item's run again: an attempt INSIDE the round that selected it.
        within = [held for held in rounds if held["round"] == rerun["round"]][0]
        attempt = attempted("test", within)
        return placed_({"round": rerun["round"], "attempt": attempt, "rerun": rerun} if attempt else refused("attempts-spent"), fix)
    if not still:
        return placed_(onward, fix)
    test = refused("round-open")
    bound = stop["why"] if stop else None
    if bound == "round-bound":
        # One more fix round is the human's to allow.
        fix = refused("round-bound")
    elif bound == "cycle-bound":
        # And so is one more fix cycle in this round.
        fix = refused("cycle-bound")
    elif any(finding["route"] == "triage" for finding in findings):
        # The round's triage is not finished: the stage that left it finishes it — the fix
        # stage where one has left a counted cycle or a report in the round, else `test`.
        if fixed_in(last) or any(held["reports"] for held in last["fix_cycles"]):
            fix["triage"] = True
        else:
            attempt = attempted("test", last)
            test = {"round": number_, "attempt": attempt, "triage": True} if attempt else refused("attempts-spent")
    return placed_(test, fix)


def state(args):
    try:
        run_dir = open_run(args.run)
    except Refusal as refusal:
        if refusal.kind != "not-opened":
            raise
        say(json.dumps({"run": args.run, "opened": False}))
        return
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_SH)
    interrupted(run_dir, args.run)
    say(json.dumps(document(run_dir, args.run)))


def read_by_key(run):
    """(the run's directory, its state document), for a read by key: under the shared lock,
    and never across a write that was killed — as `state` reads it."""
    run_dir = open_run(run)
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_SH)
    interrupted(run_dir, run)
    return run_dir, document(run_dir, run)


def item_of(held, name):
    """The row of the test set an agent asks for by its id, as the state has it."""
    rows = [item for item in held["items"] if item["item"] == slug(name, "item")]
    if not rows:
        refuse("no-such-row", "the test set of run %s has no item %s: its items are %s" % (held["run"], shown(name), ITEMS_BREAK.join(item["item"] for item in held["items"]) or "none"))
    return rows[0]


def read_item(args):
    _, held = read_by_key(args.run)
    say(json.dumps({"run": args.run, "item": item_of(held, args.item)}))


def item_doors(args):
    """THE DOORS OF A ROUND'S TEST SET AN ITEM COVERS: its own doors, and those of its
    registries — and all of them, for an item that runs on every candidate and names
    neither. The selection the harness made of the state document (its `unitDoors`), made
    here so that no door's name or derivation passes through a relayed line."""
    run_dir, held = read_by_key(args.run)
    round_number = int(number(args.round, "round"))
    item = item_of(held, args.item)
    scope = read_scope(run_dir, round_number)
    if scope is None:
        refuse("no-scope", "round %d of run %s has no scope: its doors are written once, by its scope step (scope-set)" % (round_number, args.run))
    included = [{"door": as_data(row[0]), "registry": as_data(row[2]), "derivation": as_data(row[3])} for row in scope[1] if row[1] == "included"]
    if item["runs"] != "every-candidate" or item["doors"] or item["registries"]:
        included = [door for door in included if door["door"] in item["doors"] or door["registry"] in item["registries"]]
    say(json.dumps({"run": args.run, "round": round_number, "item": item["item"], "doors": included}))


def untriaged(args):
    _, held = read_by_key(args.run)
    rows = [finding for finding in held["ledger"] if finding["route"] == "triage"]
    say(json.dumps({"run": args.run, "count": len(rows), "untriaged": rows}))


def interrupted(run_dir, run):
    """Refuse to read a run one of whose writes was killed between its files. The reader
    holds the shared lock, so the write is not alive: its journal is what is left."""
    held = read_journal(run_dir)
    placing = held["placing"]
    if placing:
        refuse("interrupted", "a write of run %s was killed between its files — %s of its batch are journaled and may not be in place: the state is not read across it. `dev/stabilize-record recover --run %s` finishes the batch, as any writer does first" % (run, ", ".join(entry["path"] for entry in placing), run))
    if held["batch"] is not None and held["batch"].get("discarding"):
        refuse("interrupted", "the applied batch of run %s was being taken back, and that write was killed between its files — %s may be as the batch wrote them or as they were before it: the state is not read across it. `dev/stabilize-record recover --run %s` finishes taking the batch back, as any writer does first" % (run, ", ".join(held["batch"]["files"]), run))


def document(run_dir, run):
    """The state of an opened run, as the document `state` prints. It takes no lock: its
    caller holds one — `state` a shared one, a writer that asks before it writes its own."""
    bounds_rel, _, bound_rows = read_bounds(run_dir)
    listed = unique_rows(bounds_rel, bound_rows)
    facts, item_rows, grounded = grounds(run_dir)
    clauses = hold_view(run_dir)
    ledger_rel, _, ledger_rows = read_ledger(run_dir)
    keys = unique_rows(ledger_rel, ledger_rows)

    # Each round's records, and each finding's entry in the latest round that triaged it.
    rounds, doors, triage, scope = [], None, {}, None
    for held in grounded:
        number_, scope = held["round"], held["doors"]
        name = "r%d" % number_
        test_reports, test_attempt = reports_in(run_dir, [name, "reports", "test"])
        rel, _, rows = read_triage(run_dir, number_)
        reopened = []
        for key, row in zip(unique_rows(rel, rows), rows):
            if scope is None:
                spoiled(rel, "is a triage record with no scope beside it")
            if key not in keys:
                spoiled(rel, "triages %s, a finding the ledger lacks" % key)
            side = placed(ledger_rows[keys.index(key)][4], scope)
            grade, bound = grade_read(rel, key, row[2])
            fork = FORK.fullmatch(row[6])
            if row[1] != inside_cell(side) or grade not in TRIAGE_GRADES or row[3] not in VERDICTS + ("-",) or row[4] not in ("yes", "no", "-") or (fork is None) != (row[6] == "-") or (fork is not None and row[3] == "-"):
                spoiled(rel, "holds a row for %s that does not follow from the round's doors and the triage vocabulary" % key)
            triage[key] = {
                "round": number_,
                "inside": side == "included",
                "door": side,
                "grade": grade,
                "bound": bound,
                "verdict": None if row[3] == "-" else row[3],
                "regression": None if row[4] == "-" else row[4] == "yes",
                "found_with": as_data(row[5]),
                "fork": dict(zip(FORK_FIELDS, fork.groups())) if fork else None,
            }
            # Found again with a fix on its row, and standing: that fix did not hold.
            if row[5].startswith("fixed: ") and stands(triage[key]):
                reopened.append(key)
        for ran in held["results"]:
            # A red run is a finding, and its row is the ledger's to hold.
            if ran["finding"] is not None and ran["finding"] not in keys:
                spoiled(ledger_rel, "lacks %s, the finding round %d's results file the red run of %s under" % (ran["finding"], number_, ran["item"]))
        doors = None if scope is None else {side: [{"door": as_data(row[0]), "registry": as_data(row[2]), "derivation": as_data(row[3])} for row in scope if row[1] == side] for side in SIDES}
        # THE ATTEMPTS OF A STAGE: how many of them, after the last one that reached its
        # record, left reports and nothing else.
        reached = by_name(held["facts"]["recorded"])
        cycles = [dict(zip(("cycle", "reports", "attempt"), (cycle,) + reports_in(run_dir, [name, "reports", "fix", "c%d" % cycle]))) for cycle in numbered(run_dir, [name, "reports", "fix"], "c")]
        for at, on_disk in [("test", test_attempt)] + [("fix-c%d" % had["cycle"], had["attempt"]) for had in cycles]:
            if reached.get(at, ("", 0))[1] > on_disk:
                spoiled("/".join(ARTIFACTS + (run, name, "round.md")), "says that attempt %d of %s reached its record, and the reports of that attempt are gone" % (reached[at][1], at))
        for had in cycles:
            had["unrecorded"] = had["attempt"] - reached.get("fix-c%d" % had["cycle"], ("", 0))[1]
        for at in reached:
            if at != "test" and all("fix-c%d" % had["cycle"] != at for had in cycles):
                spoiled("/".join(ARTIFACTS + (run, name, "round.md")), "says that an attempt of %s reached its record, and that cycle's reports are gone" % at)
        rounds.append({
            "round": number_,
            "scope": scope is not None,
            "triage": os.path.isfile(below(run_dir, [name, "triage.md"])),
            "record": os.path.isfile(below(run_dir, [name, "round.md"])),
            "facts": held["facts"],
            "results": [dict(ran, reason=ran["reason"] and as_data(ran["reason"])) for ran in held["results"]],
            "reopened": reopened,
            "test_reports": test_reports,
            "test_attempt": test_attempt,
            "test_unrecorded": test_attempt - reached.get("test", ("", 0))[1],
            "fix_cycles": cycles,
        })

    # THE TRIAGE PASSES OF A FINDING, as the latest round's record counts them, and the
    # further ones the human granted there.
    passes = by_name(rounds[-1]["facts"]["awaiting"]) if rounds else {}
    again = rounds[-1]["facts"]["reverify"] if rounds else []
    for held in rounds:
        for key in by_name(held["facts"]["awaiting"]):
            if key not in keys:
                spoiled(ledger_rel, "lacks %s, a finding round %d's record names as left without a grade or a verdict by its triage" % (key, held["round"]))
    findings = []
    for key, row in zip(keys, ledger_rows):
        grade, bound = grade_read(ledger_rel, key, row[6])
        disposition, _, detail = row[8].partition(": ")
        if disposition not in DISPOSITIONS or not re.fullmatch(r"[0-9]{1,6}", row[2]) or row[7] not in ("-",) + tuple(GRADERS):
            spoiled(ledger_rel, "holds a row for %s with a cell this script does not write" % key)
        finding = {
            "key": key,
            "doctype": untick(row[1]),
            "round": int(row[2]),
            "source": as_data(row[3]),
            "door": as_data(row[4]),
            "clause": as_data(row[5]),
            "grade": grade,
            "bound": bound,
            "graded_by": None if row[7] == "-" else row[7],
            "disposition": disposition,
            "detail": as_data(detail) or None,
            "repro": as_data(row[9]),
            "triage": triage.get(key),
        }
        finding["reopened"] = disposition == "fixed" and not fix_held(finding, triage.get(key))
        finding["route"], finding["why"] = route_of(finding, triage.get(key), listed)
        # A finding the round's triage has not finished is tried once more without the
        # human, and then it is the human's: `awaits` says which of the two it lacks, how
        # many triage records of the latest round in a row have left it so, and whether
        # the next one is due or — spent — the human's to rule or to grant.
        finding["awaits"] = None
        if finding["route"] == "triage":
            why, count = passes.get(key, (None, 0))
            count = count if why == finding["why"] else 0
            due = count < AUTOMATIC or "%s p%d" % (key, count + 1) in again
            finding["awaits"] = {"why": finding["why"], "passes": count, "retry": "due" if due else "spent"}
            if not due:
                finding["route"], finding["why"] = "human", finding["why"] + AFTER_RETRY
        findings.append(finding)
    hold_census(run_dir, ledger_rel, keys)
    items = [
        {
            "item": untick(row[0]),
            "kind": untick(row[1]),
            "clause": untick(row[2]),
            "runs": row[3],
            "doors": [] if row[4] == "-" else [as_data(text) for text in row[4].split(LIST_BREAK)],
            "registries": [] if row[5] == "-" else [as_data(text) for text in row[5].split(LIST_BREAK)],
            "brief": as_data(row[6]),
            "selected": selected_by(row, scope if rounds else None),
        }
        for row in item_rows
    ]
    for row in clauses:
        row["instrument"] = as_data(row["instrument"])
        for entry in row["items"]:
            entry["reason"] = entry["reason"] and as_data(entry["reason"])
    never_selected, uncovered = unreached(item_rows, grounded)
    owed = owed_by(facts)
    following = next_of(findings, clauses, rounds, facts, owed)
    # A re-run, when it is the step: the first clause that is due, and of its items that
    # are due those the lowest round selected — one invocation works inside one round.
    rerun = None
    if following["next"] == "retest":
        due = [entry for row in clauses if row["clause"] == following["retest"][0] for entry in row["items"] if entry["rerun"] == "due"]
        within = min(entry["round"] for entry in due)
        inside = [held["doors"] for held in grounded if held["round"] == within][0]
        rerun = {
            "clause": following["retest"][0],
            "round": within,
            "items": [{"item": entry["item"], "attempt": (entry["attempt"] or 0) + 1} for entry in due if entry["round"] == within],
            "doors": [{"door": as_data(row[0]), "registry": as_data(row[2]), "derivation": as_data(row[3])} for row in inside if row[1] == "included"],
        }
    position = position_of(rounds, findings, owed, following["stop"], rerun)
    # THE ATTEMPTS OF A STAGE: where the step is a stage's and that stage's attempts are
    # spent, the step is the human's — who may grant one more (round-set: again).
    step = following["stop"]["then"] if following["stop"] else following["next"]
    finishing = "fix" if rounds and (fixed_in(rounds[-1]) or any(had["reports"] for had in rounds[-1]["fix_cycles"])) else "test"
    stage = {"test": "test", "retest": "test", "fix": "fix", "triage": finishing}.get(step)
    human_stages = [entry for entry in position.pop("spent") if entry["stage"] == stage and (position[stage].get("refused") == "attempts-spent" or (stage == "fix" and "refused" not in position["fix"]))]
    if human_stages:
        position[stage] = {"refused": "attempts-spent", "round": human_stages[0]["round"]}
        following.update(retest=[], **({"stop": dict(following["stop"], then="rule")} if following["stop"] else {"next": "rule"}))
    # THE ROUND A WRITE MAY BEGIN: the one a `test` stage is handed that no directory holds
    # yet — asked as if the opening were done, whose own order is not this script's to hold.
    free = position_of(rounds, findings, [], following["stop"], rerun)["test"]
    return {
        "run": run,
        "opened": True,
        "facts": facts,
        "not_ready": owed,
        "rounds": rounds,
        "round": rounds[-1]["round"] if rounds else None,
        "begins": free["round"] if "refused" not in free and all(held["round"] != free["round"] for held in rounds) else None,
        "doors": doors,
        "bounds": [dict(zip(BOUND_COLUMNS, [untick(row[0])] + [as_data(text) for text in row[1:]])) for row in bound_rows],
        "clauses": clauses,
        "items": items,
        "never_selected": never_selected,
        "uncovered": uncovered,
        "ledger": findings,
        "blockers": [finding["key"] for finding in findings if finding["route"] == "fix"],
        # Confirmed, and nobody knows whether it is a regression: named for as long as the
        # finding is not recorded, so that the missing fact is never read as `no`.
        "regression_unknown": [finding["key"] for finding in findings if finding["route"] != "recorded" and finding["triage"] is not None and finding["triage"]["verdict"] == "confirmed" and finding["triage"]["regression"] is None],
        "human_list": [{"key": finding["key"], "why": finding["why"]} for finding in findings if finding["route"] == "human"],
        "human_stages": human_stages,
        **following,
        "position": position,
    }


def distinct(names, what):
    twice = sorted({name for name in names if names.count(name) > 1})
    if twice:
        refuse("bad-value", "%s %s is given more than once" % (what, ", ".join(twice)))
    return names


def check_reports(args):
    run_dir = open_run(args.run)
    parts = stage_parts(args)
    attempt = int(number(args.attempt, "attempt"))
    launched = distinct([slug(name, "reporter") for name in args.names], "reporter")
    directory = below(run_dir, parts)
    seen, extra, other = {}, [], []
    for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
        path = os.path.join(directory, name)
        parsed = REPORT_NAME.fullmatch(name)
        if TEMPORARY.fullmatch(name) and os.path.isfile(path) and not os.path.islink(path):
            # This script's own temporary: a write in flight, or what a killed one left —
            # which the next writer removes. It is no report, and nobody launched it.
            continue
        if parsed is None or os.path.islink(path) or not os.path.isfile(path):
            extra.append(name)
        elif int(parsed.group(2)) != attempt:
            other.append(name)
        elif parsed.group(1) in launched:
            seen[parsed.group(1)] = (name, hashlib.sha256(open(path, "rb").read()).hexdigest())
        else:
            extra.append(name)
    missing = [name for name in launched if name not in seen]
    ok = not missing and not extra
    say(json.dumps({
        "check": "reports",
        "ok": ok,
        "dir": "/".join(ARTIFACTS + (args.run,) + tuple(parts)),
        "attempt": attempt,
        "missing": missing,
        "extra": extra,
        "other_attempts": other,
        "reports": dict(seen[name] for name in launched if name in seen),
    }))
    return 0 if ok else REPORTS_MISMATCH


def check_ledger(args):
    run_dir = open_run(args.run)
    wanted = distinct([slug(name, "key") for name in args.names], "key")
    keys = [untick(row[0]) for row in read_ledger(run_dir)[2]]
    missing = [key for key in wanted if key not in keys]
    duplicated = [key for key in wanted if keys.count(key) > 1]
    ok = not missing and not duplicated
    say(json.dumps({"check": "ledger", "ok": ok, "missing": missing, "duplicated": duplicated}))
    return 0 if ok else LEDGER_MISMATCH


def gate_read(path, what):
    """What ONE full `dev/gate` printed, read from the file its output was kept in: its
    verdict, its totals, the steps it names as failed and the tests it names as failing.
    Anything else — a pre-check, two runs in one file, a file cut off before the verdict,
    a red gate that stopped at its first red stage — is refused: it is not evidence about a
    tree."""
    try:
        lines = open(path, encoding="utf-8").read().split("\n")
    except (OSError, ValueError) as err:
        refuse("bad-value", "%s %s cannot be read as text (%s)" % (what, shown(path), " ".join(str(err).split())))
    verdicts = [found for found in map(GATE_VERDICT.fullmatch, lines) if found]
    totals = [found for found in map(GATE_TOTALS.fullmatch, lines) if found]
    if len(verdicts) != 1 or len(totals) != 1:
        refuse("bad-value", "%s %s is not the output of ONE full `dev/gate`: it holds %d `GATE:` verdict line(s) and %d totals line(s), and a full gate prints one of each — `--fast` and `--quick` are pre-checks, and print not both" % (what, shown(path), len(verdicts), len(totals)))
    names = []
    if GATE_NAMES in lines:
        for line in lines[lines.index(GATE_NAMES) + 1 :]:
            if not line.startswith("  ") or not line.strip():
                break
            names.append(line.strip())
    steps = (verdicts[0].group(2) or "").split()
    if steps and not any(map(GATE_KEEPS_GOING.fullmatch, lines)):
        refuse("bad-value", "%s %s says `GATE: FAIL` and is not the output of `dev/gate --keep-going`: a gate that stops at its first red stage names the first red and not all of it, and a red gate is evidence here only whole" % (what, shown(path)))
    failed = int(totals[0].group(2))
    if not steps and (failed or names):
        refuse("bad-value", "%s %s says `GATE: PASS` and names %d failed test(s): it is not a gate's output as the gate prints it" % (what, shown(path), max(failed, len(names))))
    return {"verdict": "fail" if steps else "pass", "totals": totals[0].group(0), "steps": steps, "tests": names}


def read_gate(run_dir, round_number):
    """(the file's path, {"commit", "verdict", "red": [...]}) of the candidate's gate as a
    round holds it — or None where the round holds none."""
    parts = ["r%s" % round_number, "gate.md"]
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts))
    table = read_table(below(run_dir, parts), rel, GATE_COLUMNS)
    if table is None:
        return None
    held = {"commit": None, "verdict": None, "totals": None, "red": []}
    for what, value in table[1]:
        value = as_data(untick(value))
        if what in ("step", "test"):
            held["red"].append("%s %s" % (what, value))
        elif what in held and what != "red" and held[what] is None:
            held[what] = value
        else:
            spoiled(rel, "holds a row %s, which this script does not write" % shown(what))
    if not FULL_SHA.fullmatch(held["commit"] or "") or held["verdict"] not in ("pass", "fail") or (held["verdict"] == "pass") != (not held["red"]):
        spoiled(rel, "is not a candidate's gate as this script writes it")
    return rel, held


def gate_set(args):
    run_dir = open_run(args.run)
    round_number = number(args.round, "round")
    scratch = scratch_roots(args)
    if not FULL_SHA.fullmatch(args.commit):
        refuse("bad-value", "commit %s is not a full sha of 40 hex digits: the candidate the gate ran on" % shown(args.commit))
    seen = gate_read(args.summary, "--summary")
    one_writer(run_dir)
    untested(standing(run_dir, args.run), round_number, "the candidate's gate of round %s" % round_number)
    held = read_gate(run_dir, round_number)
    if held is not None and held[1]["commit"] != args.commit:
        refuse("exists", "%s holds the gate of %s — a round tests one candidate; nothing was written" % (held[0], held[1]["commit"]))
    rows = [["commit", tick(args.commit)], ["verdict", seen["verdict"]], ["totals", tick(seen["totals"])]]
    rows += [["step", tick(step)] for step in seen["steps"]]
    rows += [["test", tick(cell(public(name, scratch)))] for name in seen["tests"]]
    above = [
        "# %s — round %s, the candidate's gate" % (args.run, round_number),
        "",
        "What the full gate showed on the candidate this round tests, before any record of the round was written: its verdict, and every step and every test it showed red. A record commit of this round is accepted when its own gate shows nothing red that is not a row here. Written by `dev/stabilize-record` from the gate's own output, and never by hand.",
        "",
    ]
    rel = publish(run_dir, ["r" + round_number, "gate.md"], render_table(above, GATE_COLUMNS, rows), replace=True)
    say(json.dumps({"gate": rel, "commit": args.commit, "verdict": seen["verdict"], "red": len(rows) - 3}))


def gate_check(args):
    """A record commit's gate, held to the candidate's (the human's ruling of 2026-10-06):
    it holds when it shows nothing red that the candidate's own gate did not show red."""
    run_dir = open_run(args.run)
    seen = gate_read(args.summary, "--summary")
    held = None
    if args.round is not None:
        held = read_gate(run_dir, number(args.round, "round"))
    known = held[1]["red"] if held else []
    # A test's name, as a row of the candidate's gate holds one.
    red = ["step " + step for step in seen["steps"]] + ["test " + as_data(cell(public(name, scratch_roots(args)))) for name in seen["tests"]]
    new = [name for name in red if name not in known]
    # A test step that failed and names no test says nothing about WHICH tests are red.
    unnamed = [step for step in seen["steps"] if step in GATE_TEST_STEPS and not seen["tests"]]
    new += ["step %s (it names no failing test)" % step for step in unnamed if "step " + step in known]
    ok = not new
    say(json.dumps({"check": "gate", "ok": ok, "verdict": seen["verdict"], "totals": seen["totals"], "red": red, "candidate": held[1]["commit"] if held else None, "known": known, "new": new}))
    return 0 if ok else GATE_MISMATCH


def apply(args):
    """A record step's writes, as ONE batch: the calls of the batch, in its order, each
    reading what the ones before it wrote — and nothing on disk until every one of them
    was taken and every check among them holds."""
    run_dir = open_run(args.run)
    round_number = None if args.round is None else int(number(args.round, "round"))
    scratch_roots(args)
    if not args.subject.strip() or "\n" in args.subject or "\r" in args.subject:
        refuse("bad-value", "--subject is one line that says something: the subject of the commit this batch is recorded by")
    given = json_stdin()
    if not isinstance(given, list) or not given:
        refuse("bad-value", "stdin must be a batch as a non-empty JSON array of calls, each {\"argv\": [...], \"stdin\": TEXT}")
    for n, call in enumerate(given, 1):
        if not isinstance(call, dict) or set(call) - {"argv", "stdin"} or not isinstance(call.get("argv"), list) or not call["argv"] or not all(isinstance(arg, str) for arg in call["argv"]) or not isinstance(call.get("stdin", ""), str):
            refuse("bad-value", "call %d of the batch is not {\"argv\": [TEXT...], \"stdin\": TEXT}" % n)
        if call["argv"][0] not in APPLICABLE:
            refuse("bad-value", "call %d of the batch is %s: a batch holds %s" % (n, shown(call["argv"][0]), ", ".join(APPLICABLE)))
    one_writer(run_dir)
    if read_journal(run_dir)["batch"] is not None:
        refuse("pending", "run %s has a batch that is applied and not settled: `dev/stabilize-step git-state` says where it stands and settles one whose commit is made; its record step commits one that is not (`dev/stabilize-step record`), or `dev/stabilize-step discard` takes it back — never `discard` of this script on a batch that may be in a commit, which reads no git; nothing was written" % args.run)
    results, checks, reached = [], [], []
    for n, call in enumerate(given, 1):
        name = call["argv"][0]
        try:
            sub = arguments(call["argv"])
            if sub.run != args.run:
                refuse("bad-value", "it names the run %s, and the batch is run %s's" % (shown(sub.run), args.run))
            INPUT.append(call.get("stdin", ""))
            mark = len(OUT)
            try:
                code = sub.act(sub) or 0
            finally:
                INPUT.pop()
            printed = json.loads(OUT[mark])
            del OUT[mark:]
        except Refusal as refusal:
            STAGED.clear()
            refuse(refusal.kind, "call %d of the batch (`%s`): %s — nothing of the batch was written" % (n, name, refusal.detail))
        if code:
            STAGED.clear()
            refuse("check", "call %d of the batch (`%s`) does not hold: %s — nothing of the batch was written" % (n, name, json.dumps(printed)))
        results.append(printed)
        if name in CHECKS:
            checks.append(printed)
        if name == "check-reports":
            reached.append((sub.round, "test" if sub.stage == "test" else "fix-c%s" % sub.cycle, int(sub.attempt)))
    # A batch that holds a stage's report check IS THE RECORD OF THAT ATTEMPT of the stage:
    # the round's record says which attempt reached it, so that the attempts after it — the
    # ones that left reports and no record — can be counted (state: THE ATTEMPTS OF A STAGE).
    for round_, stage_, attempt in reached:
        marks = by_name(round_facts(*read_round(run_dir, round_)[::2])["recorded"])
        marks[stage_] = ("", max(attempt, marks.get(stage_, ("", 0))[1]))
        counted(run_dir, round_, "recorded", ["%s a%d" % (stage, held[1]) for stage, held in marks.items()])
    files = [staged[0] for staged in STAGED.values()]
    # A BATCH THAT WOULD CHANGE NOTHING IS NO BATCH: with every file of it already what the
    # run holds, its commit step would find nothing to commit, and the journal would keep a
    # batch no commit can ever settle.
    if all(os.path.isfile(target) and not os.path.islink(target) and open(target, encoding="utf-8", newline="").read() == text for target, (rel, text, replace, taken) in STAGED.items()):
        STAGED.clear()
        refuse("no-change", "the batch of %d call(s) changes nothing: %s — what the run holds already. There is nothing to record, and nothing was written" % (len(given), ", ".join(files) or "it writes no file"))
    flush(run_dir, {"act": "record", "round": round_number, "subject": args.subject, "calls": len(given), "checks": checks, "files": {}})
    say(json.dumps({"applied": len(given), "files": files, "results": results}))


def pending(args):
    """What of the run is written and in no commit yet, as this script knows it: whether a
    write was killed between its files; the applied batch; and the files that are written
    once and never rewritten — the reports and each round's scope — that are on disk.
    Whether one of those is committed is git's to say, which this script does not read."""
    try:
        run_dir = open_run(args.run)
    except Refusal as refusal:
        if refusal.kind != "not-opened":
            raise
        say(json.dumps({"run": args.run, "opened": False, "interrupted": False, "batch": None, "once": [], "temporaries": []}))
        return
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_SH)
    held = read_journal(run_dir)
    prefix = "/".join(ARTIFACTS + (args.run,))
    once = []
    for number_ in numbered(run_dir, [], "r"):
        name = "r%d" % number_
        if os.path.isfile(below(run_dir, [name, "scope.md"])):
            once.append("%s/%s/scope.md" % (prefix, name))
        stages = [[name, "reports", "test"]] + [[name, "reports", "fix", "c%d" % cycle] for cycle in numbered(run_dir, [name, "reports", "fix"], "c")]
        for parts in stages:
            directory = below(run_dir, parts)
            for report_name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
                if REPORT_NAME.fullmatch(report_name) and os.path.isfile(below(run_dir, parts + [report_name])):
                    once.append("/".join([prefix] + parts + [report_name]))
    batch = held["batch"]
    if batch is not None:
        altered = []
        for name, entry in batch["files"].items():
            target = below(run_dir, name.split("/"))
            try:
                same = hashlib.sha256(open(target, "rb").read()).hexdigest() == entry["sha256"]
            except OSError:
                same = False
            if not same:
                altered.append("%s/%s" % (prefix, name))
        batch = {"act": batch.get("act", "record"), "round": batch["round"], "subject": batch["subject"], "calls": batch["calls"], "checks": batch["checks"], "files": {"%s/%s" % (prefix, name): entry["sha256"] for name, entry in batch["files"].items()}, "altered": altered, "discarding": batch.get("discarding", False)}
    # The reader holds the shared lock, so no write is alive: a temporary is a killed one's.
    left = ["%s/%s" % (prefix, os.path.relpath(path, run_dir)) for path in temporaries(run_dir)]
    say(json.dumps({"run": args.run, "opened": True, "journal": "%s/%s" % (prefix, JOURNAL), "interrupted": bool(held["placing"]) or bool(batch and batch["discarding"]), "batch": batch, "once": once, "temporaries": left}))


def discard(args):
    """Take the applied batch back: every file of it as it was before the batch — or gone,
    where the batch made it — and the journal with it. The reports and the scope of the
    stage are no part of a batch, and stay. It reads no git: whether the batch is in a
    commit is asked by the act that calls this (`dev/stabilize-step discard`)."""
    run_dir = open_run(args.run)
    one_writer(run_dir)
    batch = read_journal(run_dir)["batch"]
    discarded = take_back(run_dir, batch) if batch else []
    say(json.dumps({"discarded": ["/".join(ARTIFACTS + (args.run, name)) for name in discarded]}))


def settle(args):
    """Forget the applied batch: the commit that records it was made. The step that made
    the commit calls this; a batch forgotten without one leaves a tree no stage starts
    from, which is the safe side."""
    run_dir = open_run(args.run)
    one_writer(run_dir)
    batch = read_journal(run_dir)["batch"]
    write_journal(run_dir, [], None)
    say(json.dumps({"settled": sorted("/".join(ARTIFACTS + (args.run, name)) for name in (batch["files"] if batch else {}))}))


def recover_(args):
    """Settle a write that was killed, as every writer does before it writes."""
    run_dir = open_run(args.run)
    held = read_journal(run_dir)
    left = temporaries(run_dir)
    one_writer(run_dir)
    named = lambda names: ["/".join(ARTIFACTS + (args.run, name)) for name in names]
    say(json.dumps({"recovered": named(entry["path"] for entry in held["placing"]), "discarded": named(held["batch"]["files"] if held["batch"] and held["batch"].get("discarding") else []), "removed": len(left)}))


# --- vet: what a writer checks, again, where the content becomes permanent ---------------


def run_file(prefix, rel):
    """The segments of a file of the run below its directory, and whether a writer would
    have written it as a report, as a round's scope, or as neither."""
    parts = rel[len(prefix):].split("/") if isinstance(rel, str) and rel.startswith(prefix) else []
    if not parts or not all(SEGMENT.fullmatch(part) for part in parts):
        refuse("outside", "%s is not a path below the run's directory, of plain segments" % shown(rel))
    report = len(parts) > 2 and bool(ROUND_DIR.fullmatch(parts[0])) and parts[1] == "reports"
    if report and not REPORT_NAME.fullmatch(parts[-1]):
        refuse("bad-id", "%s lies beside the reports and has no report's name" % rel)
    check = len(parts) > 2 and bool(ROUND_DIR.fullmatch(parts[0])) and parts[1] == "checks"
    if check and not (len(parts) == 3 and CHECK_NAME.fullmatch(parts[2])):
        refuse("bad-id", "%s lies beside the verdicts of the held checks and has no verdict's name" % rel)
    return parts, report, len(parts) == 2 and bool(ROUND_DIR.fullmatch(parts[0])) and parts[1] == "scope.md", check


def held_to_the_rules(text, report):
    """Hold a text to what a writer holds its own to before the scan, by the writers' own
    functions: it is text; a report ends with its last line; no host path is left in it —
    it is what the placeholder replacement leaves; no line reddens a standing fence. The
    refusal is the writer's own."""
    if "\0" in text or not text.strip():
        refuse("bad-value", "it is empty, or is not text")
    if report and text.rstrip().rsplit("\n", 1)[-1].strip() != REPORT_ENDS:
        refuse("truncated", "it does not end with the line `%s`: no report as this script writes one" % REPORT_ENDS)
    replaced = public(text, [])
    if replaced != text:
        lines = [str(n) for n, (was, now) in enumerate(zip(text.split("\n"), replaced.split("\n")), 1) if was != now]
        refuse("host-path", "line %s names a host path, which a writer of this script replaces by its public placeholder" % ", ".join(lines))
    fence_check(text)


def scan_hits(files):
    """{path: the scan's refusal} for the files of `files` the public-hygiene scan refuses:
    ONE scan where it finds nothing. Where it finds something the files the scanner names
    are the ones — and the rest is scanned again, because the scan stops at its first
    scanner that finds anything; a scanner that names no file is asked file by file. A
    scanner that could not run is that refusal, never an answer."""
    def alone(some):
        try:
            hygiene_scan(some)
        except Refusal as refusal:
            if refusal.kind != "hygiene":
                raise
            return refusal
        return None

    together = alone(files) if files else None
    if together is None:
        return {}
    named = [rel for rel, _ in files if rel in together.where]
    if named:
        hits = {rel: together.detail for rel in named}
        hits.update(scan_hits([file for file in files if file[0] not in named]))
        return hits
    if len(files) == 1:
        return {files[0][0]: together.detail}
    hits = {file[0]: found.detail for file, found in ((file, alone([file])) for file in files) if found}
    return hits or {rel: together.detail for rel, _ in files}


SUBJECT = "the-subject-of-the-commit"
# Where the messages of a range's commits lie in the scan's throwaway repository: one file
# per commit, named by its sha (vet --range).
MESSAGES = "the-messages-of-the-range"


def vet_files(run_dir, run, names, subject):
    """(vetted, refused, the subject's refusal) of files of the run, read from the disk:
    {path: sha256} of each that is what a writer of this script would have left, and
    [{path, why, detail}] of each that is not."""
    prefix = "/".join(ARTIFACTS + (run,)) + "/"
    vetted, refused, clean = {}, [], []
    for rel in distinct(names, "path"):
        try:
            parts, report, _, check = run_file(prefix, rel)
            path = below(run_dir, parts)
            if not os.path.isfile(path):
                refused.append({"path": rel, "why": "gone", "detail": "no such file"})
                continue
            data = open(path, "rb").read()
            try:
                text = data.decode("utf-8")
            except ValueError:
                refuse("bad-value", "it is not UTF-8 text")
            held_to_the_rules(text, report)
            if check:
                # A HELD CHECK'S VERDICT IS VETTED AS ONE: it is the verdict the result
                # of that run of that item was written from, and says the word it says.
                found = CHECK_NAME.fullmatch(parts[2])
                results_rel, _, result_rows = read_results(run_dir, parts[0][1:])
                ran = [held for held in results_of(results_rel, result_rows) if (held["item"], held["attempt"]) == (found.group(1), int(found.group(2)))]
                _, word = verdict_on_record(run_dir, parts[0][1:], found.group(1), int(found.group(2)))
                if not ran or word != ran[0]["outcome"]:
                    refuse("bad-value", "it is not the verdict the result of attempt %s of %s was written from: %s" % (found.group(2), found.group(1), "the round's results hold no such run" if not ran else "the result says %s, and the file %s" % (ran[0]["outcome"], "is no verdict of that run" if word is None else "says %s" % word)))
        except Refusal as refusal:
            if refusal.kind in ("did-not-run", "usage"):
                raise
            refused.append({"path": rel, "why": refusal.kind, "detail": refusal.detail})
            continue
        vetted[rel] = hashlib.sha256(data).hexdigest()
        clean.append((rel, text))
    said = None
    if subject is not None:
        try:
            if not subject.strip() or "\n" in subject or "\r" in subject:
                refuse("bad-value", "it is not one line that says something")
            held_to_the_rules(subject, False)
            clean.append((SUBJECT, subject + "\n"))
        except Refusal as refusal:
            said = {"why": refusal.kind, "detail": refusal.detail}
    for rel, found in scan_hits(clean).items():
        if rel == SUBJECT:
            said = {"why": "hygiene", "detail": found}
        else:
            del vetted[rel]
            refused.append({"path": rel, "why": "hygiene", "detail": found})
    return vetted, refused, said


def stale_checks(run_dir):
    """The report checks of the applied batch that the disk no longer bears out: a report
    such a check counted is gone, or holds other bytes than it had."""
    batch = read_journal(run_dir)["batch"]
    stale = []
    for check in batch["checks"] if batch else []:
        if not (isinstance(check, dict) and check.get("check") == "reports" and isinstance(check.get("reports"), dict) and isinstance(check.get("dir"), str)):
            continue
        gone, changed = [], []
        for name, digest in check["reports"].items():
            path = os.path.join(ROOT, check["dir"], name) if REPORT_NAME.fullmatch(name) else ""
            if not os.path.isfile(path) or os.path.islink(path):
                gone.append(name)
            elif hashlib.sha256(open(path, "rb").read()).hexdigest() != digest:
                changed.append(name)
        if gone or changed:
            stale.append({"dir": check["dir"], "attempt": check.get("attempt"), "gone": gone, "changed": changed})
    return stale


def asked_of_git(argv, what):
    """A read of this repository's commits, for `vet --range` and nothing else: what git
    printed, as bytes. A git that cannot answer is a vet that DID NOT RUN."""
    try:
        out = subprocess.run(["git"] + argv, cwd=ROOT, stdin=subprocess.DEVNULL, capture_output=True)
    except OSError as err:
        did_not_run("git could not be started (%s)" % err.strerror)
    if out.returncode != 0:
        did_not_run("git could not %s: %s" % (what, out.stderr.decode("utf-8", "replace").strip().split("\n")[-1] or "no message"))
    return out.stdout


def range_scan(revs):
    """The two scanners CI runs over a push, as CI runs them (.github/workflows/ci.yml,
    `hygiene`), over the range `revs` of THIS repository: every commit message and every
    added line. The hits, each by where it is and never by what matched; a scanner that
    could not run DID NOT RUN."""
    denylist, scanner, tools = scan_tools()

    def ran(argv, what):
        try:
            return subprocess.run(argv, cwd=ROOT, stdin=subprocess.DEVNULL, capture_output=True)
        except OSError as err:
            did_not_run("%s could not be started (%s)" % (what, err.strerror))

    def last_line(out):
        return out.stderr.decode("utf-8", "replace").strip().split("\n")[-1] or "no message"

    hits = []
    out = ran([scanner, denylist] + revs, "dev/hygiene-scan")
    if out.returncode == 1:
        for line in out.stdout.decode("utf-8", "replace").split("\n"):
            message = re.fullmatch(r"  message  ([0-9a-f]+)", line)
            added = re.fullmatch(r"  added    ([0-9a-f]+)  (\S.*):([0-9]+)", line)
            if message:
                hits.append({"commit": message.group(1), "path": None, "why": "hygiene", "detail": "the denylist matches its message"})
            elif added:
                hits.append({"commit": added.group(1), "path": added.group(2), "why": "hygiene", "detail": "the denylist matches at line %s" % added.group(3)})
        if not hits:
            hits.append({"commit": None, "path": None, "why": "hygiene", "detail": "the denylist matches in the range"})
    elif out.returncode != 0:
        did_not_run("dev/hygiene-scan exited %d: %s" % (out.returncode, last_line(out)))
    with tempfile.TemporaryDirectory(prefix="jigc-stabilize-scan-") as work:
        report = os.path.join(work, "gitleaks.json")
        # A MERGE'S OWN LINES TOO: gitleaks reads what `git log -p` prints, and that prints
        # no diff for a merge unless it is asked. `--remerge-diff` shows what the merge
        # itself introduced — a line typed while a conflict was resolved — as the denylist
        # scan asks for it (dev/hygiene-scan); CI's own gitleaks step does not ask.
        argv = [tools["gitleaks"], "git", "--redact", "--no-banner", "--no-color", "--exit-code", str(GITLEAKS_FOUND), "--report-format", "json", "--report-path", report, "--log-opts", " ".join(["--remerge-diff"] + revs)]
        config = os.path.join(ROOT, ".gitleaks.toml")
        if os.path.isfile(config):
            argv += ["--config", config]
        out = ran(argv + [ROOT], "gitleaks")
        if out.returncode == GITLEAKS_FOUND:
            try:
                leaks = [{"commit": leak.get("Commit") or None, "path": leak.get("File") or None, "why": "hygiene", "detail": "gitleaks rule %s at line %s" % (leak["RuleID"], leak["StartLine"])} for leak in json.load(open(report, encoding="utf-8"))]
            except (OSError, ValueError, KeyError, TypeError, AttributeError):
                leaks = []
            for leak in leaks:
                # A file of a merge's own diff is named with the diff's `b/` before it:
                # where the commit holds no such path and holds the one after it, that one.
                commit, path = leak["commit"], leak["path"]
                if commit and FULL_SHA.fullmatch(commit) and path and path.startswith("b/") and not asked_of_git(["ls-tree", "-z", commit, "--", path], "read %s" % commit) and asked_of_git(["ls-tree", "-z", commit, "--", path[2:]], "read %s" % commit):
                    leak["path"] = path[2:]
            hits += leaks or [{"commit": None, "path": None, "why": "hygiene", "detail": "gitleaks found a secret-shaped string in the range"}]
        elif out.returncode != 0:
            did_not_run("gitleaks exited %d: %s" % (out.returncode, last_line(out)))
    return hits


RANGE_THEN = "nothing of the range is on the remote, and a commit that is refused is LOCAL: rewriting it or taking it back is the human's to confirm (implementation/public-hygiene.md — a hit is fixed before the push, not after). This read is asked again afterwards; it answers ok once nothing unvetted is left, and only then is the branch pushed"


def vet_range(revs):
    """What a push of the range would publish, vetted: the two scanners over the range, and
    — for every commit that changes a file of an opened run — the rules a writer holds its
    text to, on each such file as the commit holds it, and no host path in its message."""
    for rev in revs:
        if not REV.fullmatch(rev):
            refuse("bad-value", "%s is no argument of a range: a name, `--not`, or `--remotes=<remote>`" % shown(rev))
    if not revs:
        refuse("usage", "vet --range needs the range, as `git rev-list` takes it")
    commits = asked_of_git(["rev-list", "--reverse"] + revs + ["--"], "list the range").decode("ascii", "replace").split()
    refused = range_scan(revs) if commits else []
    for hit in refused:
        whole = [commit for commit in commits if hit["commit"] and commit.startswith(hit["commit"])]
        hit["commit"] = whole[0] if len(whole) == 1 else hit["commit"]
    # WHAT A COMMIT SAYS IS HELD TO WHAT ITS FILES ARE HELD TO. The range scan reads every
    # message against the denylist, and gitleaks reads added lines and NEVER a message — so
    # the messages of the range are scanned as the files of a batch are: each a file of ONE
    # throwaway repository, under both scanners (a message the range scan named already is
    # refused, and is not scanned twice).
    named = {hit["commit"] for hit in refused if hit["path"] is None}
    messages = []
    for commit in commits:
        message = asked_of_git(["log", "-1", "--format=%B", commit, "--"], "read %s" % commit).decode("utf-8", "replace")
        if commit not in named and message.strip() and "\0" not in message:
            messages.append(("%s/%s" % (MESSAGES, commit), message if message.endswith("\n") else message + "\n"))
    for rel in scan_hits(messages):
        refused.append({"commit": rel[len(MESSAGES) + 1:], "path": None, "why": "hygiene", "detail": "the public-hygiene scan matches its message — a secret-shaped string, or a denylisted term: what a commit says is held to what its files are held to"})
    prefix = "/".join(ARTIFACTS) + "/"
    for commit in commits:
        # What the commit ITSELF changes: for a merge, what differs from every parent —
        # what its parents brought is vetted at their own commits, or was pushed before,
        # and a file the remote already holds is not held against a later rule.
        changed = asked_of_git(["diff-tree", "-r", "-c", "--root", "--no-renames", "--no-commit-id", "--name-only", "-z", commit], "list what %s changes" % commit).decode("utf-8", "surrogateescape").split("\0")
        runs, touched = {}, False
        for name in sorted({name for name in changed if name.startswith(prefix)}):
            run = name[len(prefix):].split("/")[0]
            if run not in runs:
                runs[run] = bool(SLUG.fullmatch(run)) and bool(asked_of_git(["ls-tree", "-z", commit, "--", prefix + run + "/opening.md"], "read %s" % commit))
            listed = asked_of_git(["ls-tree", "-z", commit, "--", name], "read %s" % commit).decode("utf-8", "surrogateescape") if runs[run] else ""
            if not listed:
                # A file of no opened run, or one the commit removed: nothing it publishes.
                continue
            touched = True
            mode, kind, blob = listed.split("\t")[0].split(" ")
            try:
                _, report, _, _ = run_file(prefix + run + "/", name)
                if mode == "120000" or kind != "blob":
                    refuse("outside", "it is a link, or no file: a write there would land outside the run directory")
                try:
                    text = asked_of_git(["cat-file", "blob", blob], "read %s" % commit).decode("utf-8")
                except ValueError:
                    refuse("bad-value", "it is not UTF-8 text")
                held_to_the_rules(text, report)
            except Refusal as refusal:
                if refusal.kind in ("did-not-run", "usage"):
                    raise
                refused.append({"commit": commit, "path": name, "why": refusal.kind, "detail": refusal.detail})
        if touched:
            try:
                message = asked_of_git(["log", "-1", "--format=%B", commit, "--"], "read %s" % commit).decode("utf-8", "replace")
                replaced = public(message, [])
                if replaced != message:
                    refuse("host-path", "its message names a host path, which no record of a run does")
            except Refusal as refusal:
                if refusal.kind in ("did-not-run", "usage"):
                    raise
                refused.append({"commit": commit, "path": None, "why": refusal.kind, "detail": refusal.detail})
    ok = not refused
    say(json.dumps({"check": "vet", "ok": ok, "range": revs, "commits": commits, "refused": refused, "then": None if ok else RANGE_THEN}))
    return 0 if ok else VET_MISMATCH


def vet(args):
    """What a writer checks at its write, checked again where the content becomes
    permanent: the files of a run that are about to be committed, with the subject of
    their commit — or the commits a push would publish. It writes nothing."""
    if args.range:
        if args.run is not None or args.subject is not None:
            refuse("usage", "vet --range takes the range and nothing of a run: a push publishes commits, whatever run they are of")
        return vet_range(args.names)
    if args.run is None:
        refuse("usage", "vet takes --run and the run's files, or --range and a range")
    run_dir = open_run(args.run)
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_SH)
    vetted, refused, subject = vet_files(run_dir, args.run, args.names, args.subject)
    stale = stale_checks(run_dir)
    ok = not refused and subject is None and not stale
    say(json.dumps({"check": "vet", "ok": ok, "vetted": vetted, "refused": refused, "subject": subject, "stale": stale}))
    return 0 if ok else VET_MISMATCH


def set_aside(args):
    """A file that is no report leaves the tree: each of the named written-once files that
    `vet` refuses is moved out of the repository, and its reporter has then left none."""
    run_dir = open_run(args.run)
    prefix = "/".join(ARTIFACTS + (args.run,)) + "/"
    to = args.to
    if to is not None and (not os.path.isabs(to) or (os.path.realpath(to) + "/").startswith(os.path.realpath(ROOT) + "/")):
        refuse("bad-value", "--to %s is not an absolute directory outside the repository: what is set aside leaves the tree" % shown(to))
    for rel in args.names:
        _, report, scope, _ = run_file(prefix, rel)
        if not report and not scope:
            refuse("bad-value", "%s is no report and no round's scope: only a file that is written once is set aside — a table of a batch is taken back whole (`discard`)" % rel)
    one_writer(run_dir)
    vetted, refused, _ = vet_files(run_dir, args.run, args.names, None)
    aside = []
    for entry in refused:
        source = os.path.join(ROOT, entry["path"])
        if not os.path.lexists(source):
            continue
        if to is None:
            to = tempfile.mkdtemp(prefix="jigc-stabilize-refused-")
        os.makedirs(to, exist_ok=True)
        name, n = entry["path"][len(prefix):].replace("/", "__"), 0
        while os.path.lexists(os.path.join(to, name + (".%d" % n if n else ""))):
            n += 1
        target = os.path.join(to, name + (".%d" % n if n else ""))
        shutil.move(source, target)
        aside.append(dict(entry, to=target))
    say(json.dumps({"aside": aside, "vetted": vetted}))


class Arguments(argparse.ArgumentParser):
    def error(self, message):
        refuse("usage", "%s — see dev/stabilize-record --help" % message)


def arguments(argv):
    parser = Arguments(prog="dev/" + PROG, add_help=False, allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=Arguments)

    def command(name, act, flags, writes=False, names=False, run=True):
        sub = commands.add_parser(name, add_help=False, allow_abbrev=False)
        sub.set_defaults(act=act)
        sub.add_argument("--run", required=run)
        for flag, required in flags:
            sub.add_argument("--" + flag, required=required)
        if writes:
            sub.add_argument("--scratch", action="append", default=[])
        if names:
            sub.add_argument("names", nargs="*")
        return sub

    stage = [("round", True), ("stage", True), ("cycle", False), ("attempt", True)]
    command("report", report, stage + [("reporter", True), ("from", False)], writes=True)
    command("ledger-add", ledger_add, [], writes=True)
    command("ledger-set", ledger_set, [], writes=True)
    command("result-set", result_set, [("round", True), ("commit", True)], writes=True)
    command("check-reports", check_reports, stage, names=True)
    command("check-ledger", check_ledger, [], names=True)
    command("bound-set", bound_set, [("bound", True), ("reach", False), ("ruling", False), ("pin", False)], writes=True)
    command("scope-set", scope_set, [("round", True), ("from", False)], writes=True)
    command("triage-set", triage_set, [("round", True)])
    command("item-set", item_set, [], writes=True)
    command("round-set", round_set, [("round", True)])
    command("run-set", run_set, [])
    command("state", state, [])
    command("item", read_item, [("item", True)])
    command("item-doors", item_doors, [("round", True), ("item", True)])
    command("untriaged", untriaged, [])
    command("gate-set", gate_set, [("round", True), ("commit", True), ("summary", True)], writes=True)
    command("gate-check", gate_check, [("round", False), ("summary", True)], writes=True)
    command("apply", apply, [("round", False), ("subject", True), ("from", False), ("sha256", False)], writes=True)
    command("pending", pending, [])
    command("discard", discard, [])
    command("settle", settle, [])
    command("recover", recover_, [])
    command("vet", vet, [("subject", False)], names=True, run=False).add_argument("--range", action="store_true")
    command("set-aside", set_aside, [("to", False)], names=True)
    # THE WRITER x STATE TABLE has a row for every subcommand and for every fact: one added
    # without its row is no call this script takes.
    rows = [(set(commands.choices), set(WRITERS) | set(READERS) | set(KEEPERS), "subcommand"), (set(ROUND_FACTS), set(ROUND_TAKES), "fact of a round's record"), (set(RUN_FACTS), set(RUN_TAKES), "fact of the run")]
    for there, tabled, what in rows:
        if there != tabled:
            raise LookupError("the writer x state table and the script's own list of each %s differ in %s: where the state takes it is decided for every one, on purpose" % (what, ", ".join(sorted(there ^ tabled))))
    if not argv or argv[0] not in commands.choices:
        refuse("usage", "%s is not a subcommand: the subcommands are %s — see dev/stabilize-record --help" % (shown(argv[0]) if argv else "nothing", ", ".join(commands.choices)))
    return parser.parse_args(argv)


def main(argv):
    # UTF-8 out, whatever the caller's locale claims: a result is read by a script.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    flags = argv[: argv.index("--")] if "--" in argv else argv
    if any(arg in ("-h", "--help") for arg in flags):
        usage_help()
        return 0
    # A terminated run unwinds, so the temporary of a write in flight goes with it.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(128 + signal.SIGTERM))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(128 + signal.SIGHUP))
    try:
        for arg in argv:
            try:
                arg.encode("utf-8")
            except UnicodeEncodeError:
                refuse("bad-value", "an argument is not UTF-8 text: %s" % shown(arg))
        args = arguments(argv)
        # A WRITER FED FROM A FILE (--from): a batch names the hash it is held to, and a
        # hash names a file.
        source, wanted = getattr(args, "from", None), getattr(args, "sha256", None)
        if args.command == "apply" and (source is None) != (wanted is None):
            refuse("usage", "a batch from a file is held to its hash, and a hash is the hash of a file: pass --from and --sha256 together, or neither — see dev/stabilize-record --help")
        if wanted is not None and not SHA256.fullmatch(wanted):
            refuse("bad-value", "--sha256 %s is not a sha256 of 64 hex digits" % shown(wanted))
        if source is not None:
            FROM.append((source, wanted))
        code = args.act(args) or 0
        if STAGED:
            flush(open_run(args.run))
        sys.stdout.write("".join(line + "\n" for line in OUT))
        return code
    except Refusal as refusal:
        sys.stderr.write("%s: refused %s: %s\n" % (PROG, refusal.kind, " ".join(refusal.detail.split())))
        return STATUS[refusal.kind]
    except Exception as err:  # noqa: BLE001 — the last line of defence, by design
        # Nothing this script is handed ends in a traceback: what no refusal above names
        # is still one line and a status of its own, with where it was raised.
        at = err.__traceback__
        while at.tb_next is not None:
            at = at.tb_next
        sys.stderr.write("%s: refused fault: %s at line %d (%s) — an input this script has no refusal for, or a defect of its own; a write that was under way is settled by the next writer\n" % (PROG, type(err).__name__, at.tb_lineno, " ".join(str(err).split())[:200]))
        return STATUS["fault"]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
