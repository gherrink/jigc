            break
        print(re.sub(r"^# ?", "", line))


# --- identifiers and paths ----------------------------------------------------


def slug(value, what):
    if not isinstance(value, str) or len(value) > SLUG_MAX or not SLUG.fullmatch(value):
        refuse("bad-id", "%s %s is not a slug (a-z0-9 words joined by single `-`, at most %d characters)" % (what, shown(value), SLUG_MAX))
    return value


def number(value, what):
    if not isinstance(value, str) or not NUMBER.fullmatch(value):
        refuse("bad-id", "%s %s is not a positive integer" % (what, shown(value)))
    return value


def stage_of(value):
    if value not in STAGES:
        refuse("bad-id", "stage %s is not one of %s" % (shown(value), ", ".join(STAGES)))
    return value


def open_run(run):
    """The run's directory, refusing a run that was never opened."""
    slug(run, "run")
    run_dir = os.path.join(ROOT, *ARTIFACTS, run)
    if not os.path.lexists(run_dir):
        refuse("not-opened", "no run %s: %s/ does not exist" % (run, "/".join(ARTIFACTS + (run,))))
    if os.path.realpath(run_dir) != run_dir:
        refuse("outside", "the run directory of %s is a link, or lies behind one" % run)
    opening = os.path.join(run_dir, "opening.md")
    if os.path.islink(opening) or not os.path.isfile(opening):
        refuse("not-opened", "run %s has no opening record: %s is not a regular file" % (run, "/".join(ARTIFACTS + (run, "opening.md"))))
    return run_dir


def below(run_dir, parts):
    """The path `parts` name below the run directory, refusing a link on the way to it."""
    path = run_dir
    for n, part in enumerate(parts, 1):
        path = os.path.join(path, part)
        if os.path.islink(path):
            refuse("outside", "%s is a link: a write there would land outside the run directory" % "/".join(parts[:n]))
    return path


def one_writer(run_dir):
    """Hold the run directory's lock until this process ends. A table is read, changed
    and replaced, so two writers at once would each drop the other's rows. Taken once a
    writer has its input in hand, never while it waits for it."""
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_EX)


def stage_parts(args):
    """The directory of a stage's reports, as path segments below the run directory."""
    number(args.round, "round")
    stage_of(args.stage)
    if args.stage == "fix":
        if args.cycle is None:
            refuse("usage", "a fix-stage report belongs to a cycle: pass --cycle")
        number(args.cycle, "cycle")
        return ["r" + args.round, "reports", "fix", "c" + args.cycle]
    if args.cycle is not None:
        refuse("usage", "--cycle is the fix stage's: a test-stage report has none")
    return ["r" + args.round, "reports", "test"]


# --- host paths -> public placeholders -----------------------------------------

NAME = r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*"
# A root ends where a name does: /tmpfile is not the temp directory.
ROOT_ENDS = r"(?![A-Za-z0-9_-])(?!\.[A-Za-z0-9_-])"
# A root any host has — /tmp, a home under /Users — is a host path only where no path is
# already running: crates/tmp/x and docs/home/z are not. A root of this machine's own is
# one wherever it stands, so `-I<home>/include` is replaced too.
PATH_OPENS = r"(?<![A-Za-z0-9_.~>-])"
ANY_HOSTS_TMP = ("/tmp", "/var/tmp")
REPOSITORY = ""


def spellings(path):
    """A directory's path as a host may print it: as given, resolved, and on macOS with
    and without the /private its temp trees resolve to."""
    path = os.path.normpath(path)
    forms = {path, os.path.realpath(path)}
    for form in list(forms):
        if form.startswith("/private/"):
            forms.add(form[len("/private"):])
        elif form.startswith(("/tmp", "/var/")):
            forms.add("/private" + form)
    return [form for form in forms if os.path.isabs(form) and len(form) > 1]


def host_roots(scratch):
    """Every root spelling a host path can open with, and the placeholder it becomes."""
    roots = {}

    def add(path, token):
        for form in spellings(path):
            roots.setdefault(form, token)

    add(ROOT, REPOSITORY)
    for path in scratch:
        add(path, "<scratch>")
    for path in (os.environ.get("TMPDIR"), tempfile.gettempdir()) + ANY_HOSTS_TMP:
        if path:
            add(path, "<tmp>")
    add(os.path.expanduser("~"), "~")
    return roots


def public(text, scratch):
    """`text` with every host path replaced by its public placeholder."""
    roots = host_roots(scratch)
    shared = {form for path in ANY_HOSTS_TMP for form in spellings(path)}

    def longest_first(names):
        return "|".join(re.escape(name) for name in sorted(names, key=len, reverse=True))

    pattern = re.compile(
        "(?:(?P<own>" + longest_first(set(roots) - shared) + ")"
        + "|" + PATH_OPENS
        + "(?:(?P<shared>" + longest_first(shared) + ")"
        + "|(?P<tmp>(?:/private)?/var/folders/" + NAME + "/" + NAME + "/T)"
        + "|(?P<home>/(?:Users|home)/" + NAME + ")))"
        + ROOT_ENDS
        + r"(?P<into>/(?=[^\s/]))?"
    )

    def placeholder(match):
        root = match.group("own") or match.group("shared")
        if root is not None:
            token = roots[root]
        else:
            token = "<tmp>" if match.group("tmp") else "~"
        into = match.group("into") or ""
        if token == REPOSITORY:
            return "" if into else "."
        return token + into

    text = pattern.sub(placeholder, text)

    # A session's scratch area lies under the temp directory with the home directory's
    # path flattened into one segment. Replaced as a temp path it still names the home.
    for home in spellings(os.path.expanduser("~")):
        flat = re.sub(r"[^A-Za-z0-9]", "-", home)
        lines = [str(n) for n, line in enumerate(text.split("\n"), 1) if flat in line]
        if len(flat) > 3 and lines:
            refuse("host-path", "line %s still names this machine's home directory inside a path (a session's scratch area?) — pass that area's root as --scratch" % ", ".join(lines))
    return text


def scratch_roots(args):
    for path in args.scratch:
        if not os.path.isabs(path):
            refuse("bad-value", "--scratch %s is not an absolute path" % shown(path))
    return args.scratch


# --- the one write --------------------------------------------------------------


def fence_check(text):
    for name, what, reddens in FENCES:
        lines = [str(n) for n, line in enumerate(text.splitlines(), 1) if reddens(line)]
        if lines:
            refuse("fence", "line %s %s, which would redden %s — write the command inside a line" % (", ".join(lines), what, name))


def did_not_run(why):
    refuse("did-not-run", "the public-hygiene scan did not run, so nothing was written: %s" % why)


def hygiene_scan(rel, text):
    """The two scanners CI runs over a push, over `text` committed at `rel` into a
    throwaway repository. Returns only when both ran and found nothing."""
    denylist = os.environ.get("JIGC_DENYLIST_FILE") or os.path.join(os.path.expanduser("~"), ".config", "jigc", "denylist")
    if not os.path.isfile(denylist):
        did_not_run("no denylist at %s (implementation/public-hygiene.md)" % denylist)
    scanner = os.path.join(SCRIPT_DIR, "hygiene-scan")
    if not os.path.isfile(scanner):
        did_not_run("dev/hygiene-scan is missing")
    tools = {}
    for tool in ("git", "gitleaks"):
        tools[tool] = shutil.which(tool)
        if tools[tool] is None:
            did_not_run("%s is not on PATH" % tool)

    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_GLOBAL=os.devnull,
        GIT_AUTHOR_NAME=PROG,
        GIT_AUTHOR_EMAIL=PROG + "@example.invalid",
        GIT_COMMITTER_NAME=PROG,
        GIT_COMMITTER_EMAIL=PROG + "@example.invalid",
    )

    def ran(argv, what):
        try:
            return subprocess.run(argv, cwd=repo, env=env, stdin=subprocess.DEVNULL, capture_output=True)
        except OSError as err:
            did_not_run("%s could not be started (%s)" % (what, err.strerror))

    def last_line(out):
        return out.stderr.decode("utf-8", "replace").strip().split("\n")[-1] or "no message"

    with tempfile.TemporaryDirectory(prefix="jigc-stabilize-scan-") as work:
        # dev/hygiene-scan scans the repository it lies in, so it is linked into this
        # one — untracked, so it is not itself scanned.
        repo = os.path.join(work, "repo")
        os.makedirs(os.path.join(repo, "dev"))
        os.symlink(scanner, os.path.join(repo, "dev", "hygiene-scan"))
        os.makedirs(os.path.dirname(os.path.join(repo, rel)))
        with open(os.path.join(repo, rel), "w", encoding="utf-8", newline="") as copy:
            copy.write(text)
        for step, argv in (
            ("init", ["init", "-q", "--template="]),
            ("add", ["add", "--", rel]),
            # No background maintenance: it would outlive the commit, in a repository
            # that is removed as soon as the scan is done.
            ("commit", ["-c", "commit.gpgsign=false", "-c", "maintenance.auto=false", "-c", "gc.auto=0", "commit", "-q", "--no-verify", "-m", "."]),
        ):
            out = ran([tools["git"]] + argv, "git")
            if out.returncode != 0:
                did_not_run("git %s failed in the scan's repository: %s" % (step, last_line(out)))

        out = ran([os.path.join(repo, "dev", "hygiene-scan"), "--tree", denylist, "HEAD"], "dev/hygiene-scan")
        if out.returncode == 1:
            places = []
            for line in out.stdout.decode("utf-8", "replace").split("\n"):
                found = re.fullmatch(r"  (?:tree|path|added +[0-9a-f]+) +(\S.*)", line)
                if found and found.group(1) not in places:
                    places.append(found.group(1))
            refuse("hygiene", "the denylist matches at %s — by where, never by what; reword it (implementation/public-hygiene.md)" % (", ".join(places) or rel))
        if out.returncode != 0:
            did_not_run("dev/hygiene-scan exited %d: %s" % (out.returncode, last_line(out)))

        report = os.path.join(work, "gitleaks.json")
        argv = [tools["gitleaks"], "git", "--redact", "--no-banner", "--no-color", "--exit-code", str(GITLEAKS_FOUND), "--report-format", "json", "--report-path", report]
        config = os.path.join(ROOT, ".gitleaks.toml")
        if os.path.isfile(config):
            argv += ["--config", config]
        out = ran(argv + [repo], "gitleaks")
        if out.returncode == GITLEAKS_FOUND:
            try:
                found = ["rule %s at line %s" % (leak["RuleID"], leak["StartLine"]) for leak in json.load(open(report, encoding="utf-8"))]
            except (OSError, ValueError, KeyError, TypeError):
                found = []
            refuse("hygiene", "gitleaks found a secret-shaped string in %s: %s — a credential is never committed, even a revoked one" % (rel, "; ".join(found) or "no location reported"))
        if out.returncode != 0:
            did_not_run("gitleaks exited %d: %s" % (out.returncode, last_line(out)))


def publish(run_dir, parts, text, replace, taken="a re-run passes the next attempt"):
    """Write `text` at `parts` below the run directory — fenced, scanned, atomically —
    and return the path written, repository-relative. Every writer ends here."""
    target = below(run_dir, parts)
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts))
    if os.path.lexists(target) and not (replace and os.path.isfile(target)):
        refuse("exists", "%s exists — %s" % (rel, taken))
    fence_check(text)
    hygiene_scan(rel, text)

    parent = os.path.dirname(target)
    os.makedirs(parent, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=parent, prefix=".%s." % PROG, suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temporary, 0o644)
        if replace:
            os.replace(temporary, target)
            temporary = None
        else:
            try:
                os.link(temporary, target)
            except FileExistsError:
                refuse("exists", "%s exists — %s" % (rel, taken))
    finally:
        if temporary is not None:
            os.unlink(temporary)
    return rel


# --- tables ---------------------------------------------------------------------


def cell(text):
    """Free text as one table cell: no line break, no bare pipe, never empty."""
    text = re.sub(r"\s*[\r\n\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029]+\s*", "<br>", text.strip())
    text = re.sub(r"[\x00-\x1f\x7f]", " ", text)
    text = re.sub(r"\\+(?=\|)", lambda run: "&#92;" * len(run.group()), text)
    return text.replace("|", "\\|") or "-"


def header(columns):
    return ["| %s |" % " | ".join(columns), "|" + "---|" * len(columns)]


def read_table(path, rel, columns):
    """The lines above the table at `path` and its rows, each a list of raw cells — or
    None when there is no file yet. A file that is not this script's table is refused."""
    if os.path.islink(path):
        refuse("outside", "%s is a link: a write to it would land outside the run directory" % rel)
    if not os.path.lexists(path):
        return None
    try:
        lines = open(path, encoding="utf-8", newline="").read().split("\n")
    except (OSError, ValueError) as err:
        refuse("corrupt", "%s cannot be read as text (%s)" % (rel, err))
    head = header(columns)
    if head[0] not in lines:
        refuse("corrupt", "%s holds no table with this script's header; it is not rewritten on a guess" % rel)
    at = lines.index(head[0])
    if lines[at + 1 : at + 2] != head[1:]:
        refuse("corrupt", "%s line %d is not the header's rule" % (rel, at + 2))
    body = lines[at + 2 :]
    while body and body[-1] == "":
        body.pop()
    rows = []
    for n, line in enumerate(body, at + 3):
        cells = re.split(r"(?<!\\)\|", line)
        if len(cells) != len(columns) + 2 or cells[0] != "" or cells[-1] != "":
            refuse("corrupt", "%s line %d is not a row of %d cells; it is not rewritten on a guess" % (rel, n, len(columns)))
        rows.append([text.strip() for text in cells[1:-1]])
    return lines[:at], rows


def render_table(above, columns, rows):
    return "\n".join(above + header(columns) + ["| %s |" % " | ".join(row) for row in rows]) + "\n"


def tick(text):
    return "`%s`" % text


def untick(text):
    return text.strip("`")


def json_stdin():
    try:
        return json.loads(sys.stdin.buffer.read().decode("utf-8"))
    except ValueError as err:
        refuse("bad-value", "stdin is not JSON (%s)" % str(err).split("\n")[0])


def json_rows(what):
    """Stdin as a non-empty list of JSON objects."""
    rows = json_stdin()
    if isinstance(rows, dict):
        rows = [rows]
    if not isinstance(rows, list) or not rows or not all(isinstance(row, dict) for row in rows):
        refuse("bad-value", "stdin must be one %s as a JSON object, or a non-empty array of them" % what)
    return rows


def fields(row, required, optional, what):
    unknown = sorted(set(row) - set(required) - set(optional))
    if unknown:
        refuse("bad-value", "%s has no field %s; it has %s" % (what, ", ".join(shown(name) for name in unknown), ", ".join(required + optional)))
    missing = [name for name in required if name not in row]
    if missing:
        refuse("bad-value", "%s lacks %s" % (what, ", ".join(missing)))


def text_of(row, name, what, scratch):
    if not isinstance(row[name], str):
        refuse("bad-value", "%s: %s must be text, not %s" % (what, name, shown(row[name])))
    return cell(public(row[name], scratch))


def said(row, name, what, scratch):
    """A cell that must say something."""
    text = text_of(row, name, what, scratch)
    if not row[name].strip():
        refuse("bad-value", "%s: %s says nothing" % (what, name))
    return text


def one_of(value, allowed, what):
    if not isinstance(value, str) or value not in allowed:
        refuse("bad-value", "%s %s is not one of %s" % (what, shown(value), ", ".join(allowed)))
    return value


def grade_cells(row, what):
    """The `grade` and `graded by` cells a row or a patch names."""
    grade = one_of(row["grade"], ("ungraded",) + GRADERS["human"], what + ": grade")
    grader, bound = row.get("graded_by"), row.get("bound")
    if (bound is not None) != (grade == "out-of-scope"):
        refuse("bad-value", "%s: out-of-scope cites a declared bound of the opening record as `bound`, and no other grade does" % what)
    if grade == "ungraded":
        if "graded_by" in row:
            refuse("bad-value", "%s: ungraded has no grader" % what)
        return "ungraded", "-"
    one_of(grader, tuple(GRADERS), what + ": graded_by")
    one_of(grade, GRADERS[grader], "%s: a grade given by %s," % (what, grader))
    if bound is not None:
        return OUT_OF_SCOPE + slug(bound, what + ": bound"), grader
    return grade, grader


def disposition_cell(row, what, scratch):
    disposition = one_of(row["disposition"], tuple(DISPOSITIONS), what + ": disposition")
    needs, detail = DISPOSITIONS[disposition], row.get("detail")
    if detail is None:
        if needs in ("sha", "required"):
            refuse("bad-value", "%s: %s needs a detail — %s" % (what, disposition, "the fix's sha" if needs == "sha" else "the bound's reach"))
        return disposition
    if needs is None:
        refuse("bad-value", "%s: %s takes no detail" % (what, disposition))
    if not isinstance(detail, str) or not detail.strip():
        refuse("bad-value", "%s: detail must be text, not %s" % (what, shown(detail)))
    if needs == "sha":
        if not SHA.fullmatch(detail):
            refuse("bad-value", "%s: fixed names the fix's commit, 7 to 40 hex digits, not %s" % (what, shown(detail)))
        return "fixed: " + detail
    return "%s: %s" % (disposition, cell(public(detail, scratch)))


def set_cells(row, what, scratch):
    """The (column index, cell) pairs for the grade and disposition `row` names."""
    cells = []
    if "grade" in row:
        cells += zip((6, 7), grade_cells(row, what))
    elif "graded_by" in row or "bound" in row:
        refuse("bad-value", "%s: graded_by and bound belong to a grade" % what)
    if "disposition" in row:
        cells.append((8, disposition_cell(row, what, scratch)))
    elif "detail" in row:
        refuse("bad-value", "%s: a detail belongs to a disposition" % what)
    return cells


LEDGER_REQUIRED = ("key", "doctype", "round", "source", "door", "clause", "repro")
LEDGER_SET = ("grade", "graded_by", "bound", "disposition", "detail")


def ledger_row(row, scratch):
    fields(row, LEDGER_REQUIRED, LEDGER_SET, "a ledger row")
    what = "row %s" % shown(row["key"])
    key = slug(row["key"], "key")
    one_of(row["doctype"], DOCTYPES, what + ": doctype")
    if isinstance(row["round"], bool) or not isinstance(row["round"], int) or row["round"] < 0:
        refuse("bad-value", "%s: round must be a whole number, 0 for the opening, not %s" % (what, shown(row["round"])))
    cells = [tick(key), tick(row["doctype"]), str(row["round"])]
    cells += [text_of(row, name, what, scratch) for name in ("source", "door", "clause")]
    cells += ["ungraded", "-", "open", text_of(row, "repro", what, scratch)]
    for at, text in set_cells(row, what, scratch):
        cells[at] = text
    return key, cells


def table_file(run_dir, parts, columns, title, says):
    """(the table file's repository-relative path, the lines above its table, its rows).
    A file that does not exist yet opens with `title` and what the table `says`."""
    run = os.path.basename(run_dir)
    rel = "/".join(ARTIFACTS + (run,) + tuple(parts))
    table = read_table(below(run_dir, parts), rel, columns)
    if table is None:
        table = (["# %s — %s" % (run, title), "", says, ""], [])
    return (rel,) + table


def read_ledger(run_dir):
    return table_file(
        run_dir,
        ["ledger.md"],
        LEDGER_COLUMNS,
        "the findings ledger",
        "One row per finding of this stabilization run. Written by `dev/stabilize-record` and never by hand; its header states the columns and the vocabularies of `grade`, `graded by` and `disposition`.",
    )


def read_clauses(run_dir):
    return table_file(
        run_dir,
        ["clauses.md"],
        CLAUSE_COLUMNS,
        "the closing condition, clause by clause",
        "One row per clause of the closing condition: the instrument that judges it, the last commit that instrument ran on, the scope of that run, and `green`, `red` or `void` — not reached, or could not run. Written by `dev/stabilize-record` and never by hand. A void row, or a missing one, forbids closing.",
    )


def read_bounds(run_dir):
    return table_file(
        run_dir,
        ["bounds.md"],
        BOUND_COLUMNS,
        "the declared bounds",
        "One row per declared bound: its reach, where the human ruled it, and the test that pins it or `unpinned`. A bound is always the human's ruling, and a row is the record of one. Written by `dev/stabilize-record` and never by hand. A grade of `out-of-scope` cites a row of this list, or is refused.",
    )


def read_triage(run_dir, round_number):
    return table_file(
        run_dir,
        ["r%s" % round_number, "triage.md"],
        TRIAGE_COLUMNS,
        "round %s, the triage record" % round_number,
        "One row per finding this round triaged: whether its door is inside the round's test set (computed from `scope.md`, never supplied), triage's grade, the verifier's verdict, whether it is a regression, and the disposition its ledger row carried when the round recorded it. Written by `dev/stabilize-record` and never by hand.",
    )


def unique_rows(rel, rows):
    keys = [untick(row[0]) for row in rows]
    twice = sorted({key for key in keys if keys.count(key) > 1})
    if twice:
        refuse("corrupt", "%s holds more than one row for %s; it is not rewritten on a guess" % (rel, ", ".join(twice)))
    return keys


def spoiled(rel, what):
    refuse("corrupt", "%s %s; it is not read on a guess" % (rel, what))


def read_scope(run_dir, round_number):
    """(the scope file's repository-relative path, its rows) for a round — or None before
    the round's scope is written."""
    parts = ["r%s" % round_number, "scope.md"]
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts))
    table = read_table(below(run_dir, parts), rel, SCOPE_COLUMNS)
    if table is None:
        return None
    rows = table[1]
    for row in rows:
        if row[1] not in SIDES:
            spoiled(rel, "puts the door %s on the side %s, which this script does not write" % (row[0], shown(row[1])))
    if len({row[0] for row in rows}) != len(rows):
        spoiled(rel, "lists a door twice")
    return rel, rows


def placed(door, scope_rows):
    """Where a round's scope puts a door: `included`, `excluded` or — in neither list —
    `unlisted`. Inside the round's test set is `included`, and nothing else is."""
    for row in scope_rows:
        if row[0] == door:
            return row[1]
    return "unlisted"


def inside_cell(side):
    return "inside" if side == "included" else "outside: " + side


def hold_to_the_list(run_dir, cited):
    """Refuse an out-of-scope grade that cites no row of the declared-bounds list: it is
    the one grade that takes a finding off the human's list unseen."""
    cited = [(what, grade[len(OUT_OF_SCOPE):]) for what, grade in cited if grade.startswith(OUT_OF_SCOPE)]
    if not cited:
        return
    rel, _, rows = read_bounds(run_dir)
    listed = unique_rows(rel, rows)
    for what, bound in cited:
        if bound not in listed:
            refuse("no-such-bound", "%s: out-of-scope cites the bound %s, which the declared-bounds list (%s) lacks — a bound is the human's ruling, entered with bound-set, and without one the grade is needs-bound; nothing was written" % (what, bound, rel))


# --- the subcommands --------------------------------------------------------------


def report(args):
    run_dir = open_run(args.run)
    parts = stage_parts(args)
    name = "%s.a%s.md" % (slug(args.reporter, "reporter"), number(args.attempt, "attempt"))
    scratch = scratch_roots(args)
    # Asked before the report is read, and again by the write itself.
    if os.path.lexists(below(run_dir, parts + [name])):
        refuse("exists", "%s exists — a re-run passes the next attempt" % "/".join(ARTIFACTS + (args.run,) + tuple(parts) + (name,)))
    try:
        text = sys.stdin.buffer.read().decode("utf-8")
    except ValueError:
        refuse("bad-value", "the report on stdin is not UTF-8 text")
    if "\0" in text or not text.strip():
        refuse("bad-value", "the report on stdin is empty, or is not text")
    if text.rstrip().rsplit("\n", 1)[-1].strip() != REPORT_ENDS:
        refuse("truncated", "the report on stdin does not end with the line `%s`: it was cut off on its way, or its reporter never finished it; nothing was written" % REPORT_ENDS)
    text = public(text, scratch)
    if not text.endswith("\n"):
        text += "\n"
    print(publish(run_dir, parts + [name], text, replace=False))


def ledger_add(args):
    run_dir = open_run(args.run)
    scratch = scratch_roots(args)
    given = [ledger_row(row, scratch) for row in json_rows("ledger row")]
    one_writer(run_dir)
    hold_to_the_list(run_dir, [("row %s" % key, cells[6]) for key, cells in given])
    rel, above, rows = read_ledger(run_dir)
    keys = unique_rows(rel, rows)
    appended, existing = [], []
    for key, cells in given:
        if key in keys:
            existing.append(key)
        else:
            keys.append(key)
            rows.append(cells)
            appended.append(key)
    if appended:
        publish(run_dir, ["ledger.md"], render_table(above, LEDGER_COLUMNS, rows), replace=True)
    print(json.dumps({"ledger": rel, "appended": appended, "existing": existing}))


def ledger_set(args):
    run_dir = open_run(args.run)
    scratch = scratch_roots(args)
    patches = []
    for patch in json_rows("ledger patch"):
        fields(patch, ("key",), LEDGER_SET, "a ledger patch")
        key = slug(patch["key"], "key")
        cells = set_cells(patch, "patch %s" % key, scratch)
        if not cells:
            refuse("bad-value", "patch %s sets neither a grade nor a disposition" % key)
        patches.append((key, cells))
    one_writer(run_dir)
    hold_to_the_list(run_dir, [("patch %s" % key, text) for key, cells in patches for at, text in cells if at == 6])
    rel, above, rows = read_ledger(run_dir)
    keys = unique_rows(rel, rows)
    for key, cells in patches:
        if key not in keys:
            refuse("no-such-row", "the ledger has no row %s; nothing was written" % key)
        for at, text in cells:
            rows[keys.index(key)][at] = text
    publish(run_dir, ["ledger.md"], render_table(above, LEDGER_COLUMNS, rows), replace=True)
    print(json.dumps({"ledger": rel, "updated": [key for key, _ in patches]}))


def clause_set(args):
    run_dir = open_run(args.run)
    clause = slug(args.clause, "clause")
    scratch = scratch_roots(args)
    named = {name: getattr(args, name) for name in ("instrument", "commit", "scope", "status") if getattr(args, name) is not None}
    if not named:
        refuse("usage", "clause-set sets nothing: pass --instrument, --commit, --scope or --status")
    if "status" in named:
        one_of(named["status"], CLAUSE_STATUSES, "status")
    if "commit" in named and named["commit"] != "-" and not SHA.fullmatch(named["commit"]):
        refuse("bad-value", "commit %s is neither a sha of 7 to 40 hex digits nor `-`" % shown(named["commit"]))
    one_writer(run_dir)

    rel, above, rows = read_clauses(run_dir)
    keys = [untick(row[0]) for row in rows]
    if len(set(keys)) != len(keys):
        refuse("corrupt", "%s holds more than one row for a clause; it is not rewritten on a guess" % rel)
    if clause in keys:
        row = rows[keys.index(clause)]
    else:
        missing = [name for name in ("instrument", "scope", "status") if name not in named]
        if missing:
            refuse("bad-value", "clause %s has no row yet: its first needs --%s" % (clause, ", --".join(missing)))
        row = [tick(clause), "", "-", "", ""]
        rows.append(row)
    for at, name in ((1, "instrument"), (3, "scope")):
        if name in named:
            row[at] = cell(public(named[name], scratch))
    if "commit" in named:
        row[2] = "-" if named["commit"] == "-" else tick(named["commit"])
    if "status" in named:
        row[4] = named["status"]
    if row[4] != "void" and row[2] == "-":
        refuse("bad-value", "clause %s: %s is a verdict, and a verdict names the commit the instrument ran on — pass --commit" % (clause, row[4]))
    publish(run_dir, ["clauses.md"], render_table(above, CLAUSE_COLUMNS, rows), replace=True)
    print(json.dumps({"clauses": rel, "clause": clause, "status": row[4]}))


def bound_set(args):
    run_dir = open_run(args.run)
    bound = slug(args.bound, "bound")
    scratch = scratch_roots(args)
    named = {}
    for at, name in enumerate(BOUND_COLUMNS[1:], 1):
        text = getattr(args, name)
        if text is not None:
            if not text.strip():
                refuse("bad-value", "bound %s: --%s says nothing" % (bound, name))
            named[at] = cell(public(text, scratch))
    if not named:
        refuse("usage", "bound-set sets nothing: pass --reach, --ruling or --pin")
    one_writer(run_dir)
    rel, above, rows = read_bounds(run_dir)
    keys = unique_rows(rel, rows)
    if bound in keys:
        row = rows[keys.index(bound)]
    else:
        missing = [name for at, name in enumerate(BOUND_COLUMNS[1:], 1) if at not in named]
        if missing:
            refuse("bad-value", "bound %s has no row yet, and a row is the record of the human's ruling: its first needs --%s" % (bound, ", --".join(missing)))
        row = [tick(bound), "", "", ""]
        rows.append(row)
    for at, text in named.items():
        row[at] = text
    publish(run_dir, ["bounds.md"], render_table(above, BOUND_COLUMNS, rows), replace=True)
    print(json.dumps({"bounds": rel, "bound": bound}))


def scope_set(args):
    run_dir = open_run(args.run)
    parts = ["r" + number(args.round, "round"), "scope.md"]
    scratch = scratch_roots(args)
    given = json_stdin()
    if not isinstance(given, dict):
        refuse("bad-value", "stdin must be one scope as a JSON object: its included and its excluded doors")
    fields(given, SIDES, (), "a scope")
    rows = []
    for side in SIDES:
        if not isinstance(given[side], list) or not all(isinstance(door, dict) for door in given[side]):
            refuse("bad-value", "a scope's %s doors must be an array of JSON objects" % side)
        for door in given[side]:
            fields(door, ("door", "registry", "derivation"), (), "a door")
            what = "door %s" % shown(door["door"])
            name, registry, derivation = [said(door, field, what, scratch) for field in ("door", "registry", "derivation")]
            rows.append([name, side, registry, derivation])
    distinct([row[0] for row in rows], "door")
    above = [
        "# %s — round %s, the test set" % (args.run, args.round),
        "",
        "One row per door the round's scope step resolved: whether it is `included` in the round's test set or `excluded` from it, the registry it comes from, and how it was derived. Written once, by `dev/stabilize-record`, and never by hand. A finding is inside the test set when its door is an included row here.",
        "",
    ]
    rel = publish(run_dir, parts, render_table(above, SCOPE_COLUMNS, rows), replace=False, taken="a round's test set is written once")
    print(json.dumps({"scope": rel, "included": len(given["included"]), "excluded": len(given["excluded"])}))


def triage_entry(entry):
    """(key, the entry's cells in the triage record after `inside`, the ledger's grade and
    grader). Nothing of an entry says where the finding was found: that is computed."""
    fields(entry, ("key", "grade"), ("bound", "verdict", "regression"), "a triage entry")
    what = "entry %s" % shown(entry["key"])
    key = slug(entry["key"], "key")
    grade = one_of(entry["grade"], TRIAGE_GRADES, what + ": grade")
    if ("bound" in entry) != (grade == "out-of-scope"):
        refuse("bad-value", "%s: out-of-scope cites a declared bound as `bound`, and no other grade does" % what)
    if "bound" in entry:
        grade = OUT_OF_SCOPE + slug(entry["bound"], what + ": bound")
    if "verdict" not in entry:
        if "regression" in entry:
            refuse("bad-value", "%s: a regression is the verifier's fact about a finding it confirmed" % what)
        return key, [grade, "-", "-"], (grade, "triage")
    if grade not in SENT_ON:
        refuse("bad-value", "%s: a verdict is the verifier's, and the verifier is sent %s — not %s" % (what, " and ".join(SENT_ON), grade))
    if one_of(entry["verdict"], VERDICTS, what + ": verdict") == "refuted":
        if "regression" in entry:
            refuse("bad-value", "%s: a regression is the verifier's fact about a finding it confirmed" % what)
        return key, [grade, "refuted", "-"], ("refuted", "verify-real")
    if not isinstance(entry.get("regression"), bool):
        refuse("bad-value", "%s: confirmed says whether the finding is a regression — `regression` is true when the repro is green on the previous release, else false" % what)
    if entry["regression"]:
        return key, [grade, "confirmed", "yes"], ("regression", "verify-real")
    return key, [grade, "confirmed", "no"], ("confirmed", "verify-real")


def triage_set(args):
    run_dir = open_run(args.run)
    round_number = number(args.round, "round")
    given = [triage_entry(entry) for entry in json_rows("triage entry")]
    distinct([key for key, _, _ in given], "finding")
    one_writer(run_dir)
    ledger, ledger_above, ledger_rows = read_ledger(run_dir)
    keys = unique_rows(ledger, ledger_rows)
    for key, _, _ in given:
        if key not in keys:
            refuse("no-such-row", "the ledger has no row %s — a finding is added before it is triaged; nothing was written" % key)
    hold_to_the_list(run_dir, [("entry %s" % key, cells[0]) for key, cells, _ in given])
    scope = read_scope(run_dir, round_number)
    if scope is None:
        refuse("no-scope", "round %s has no scope yet: whether a finding is inside the test set is computed from the round's doors, which scope-set writes; nothing was written" % round_number)
    rel, above, rows = read_triage(run_dir, round_number)
    triaged = unique_rows(rel, rows)
    for key, cells, grade in given:
        row = ledger_rows[keys.index(key)]
        # The disposition the row carries into this round goes into the record with it:
        # a finding found again inherits it, and the record says what it inherited.
        entry = [tick(key), inside_cell(placed(row[4], scope[1]))] + cells + [row[8]]
        if key in triaged:
            rows[triaged.index(key)] = entry
        else:
            triaged.append(key)
            rows.append(entry)
        row[6], row[7] = grade
    publish(run_dir, ["r" + round_number, "triage.md"], render_table(above, TRIAGE_COLUMNS, rows), replace=True)
    publish(run_dir, ["ledger.md"], render_table(ledger_above, LEDGER_COLUMNS, ledger_rows), replace=True)
    print(json.dumps({"triage": rel, "ledger": ledger, "recorded": [key for key, _, _ in given]}))


# --- the state, and what follows from it ----------------------------------------------


def as_data(text):
    """A cell as the table holds it, its pipes unescaped."""
    return text.replace("\\|", "|")


def grade_read(rel, key, text):
    """(grade, the bound it cites) of a grade cell."""
    if text.startswith(OUT_OF_SCOPE) and SLUG.fullmatch(text[len(OUT_OF_SCOPE):]):
        return "out-of-scope", text[len(OUT_OF_SCOPE):]
    if text != "out-of-scope" and text in ("ungraded",) + GRADERS["human"]:
        return text, None
    spoiled(rel, "gives %s the grade %s, which this script does not write" % (key, shown(text)))


def route_of(finding, triage, listed):
    """Where one finding goes, and why: `fix` (without asking), `human` (the human's
    list), `recorded` (nothing more in this run) — or `unsettled`, where the recorded
    rulings do not say. A pure function of the row, the round's triage of it and the
    declared bounds; the header's table is this function."""
    grade, disposition = finding["grade"], finding["disposition"]
    if disposition == "fixed":
        stands = triage is not None and (triage["verdict"] == "confirmed" or (triage["verdict"] is None and triage["grade"] in SENT_ON + ("needs-bound",)))
        if stands and triage["found_with"] == "fixed: %s" % finding["detail"]:
            return "unsettled", "found-again-after-its-fix"
        return "recorded", "fixed"
    if disposition in ("bound", "later"):
        return "recorded", "ruled"
    if disposition == "admitted":
        return "fix", "admitted"
    # open — or no-action, which is neither a fix nor the human's ruling.
    if grade == "ungraded":
        return "unsettled", "ungraded"
    if grade in SENT_ON:
        return "unsettled", "unverified"
    if grade in ("no-break", "refuted"):
        return "recorded", "not-a-break"
    if grade == "out-of-scope":
        return ("recorded", "out-of-scope") if finding["bound"] in listed else ("human", "bound-not-listed")
    if grade == "needs-bound":
        return "human", "needs-bound"
    # A verified break: confirmed, or a regression.
    if grade == "regression":
        return "fix", "regression"
    if triage is None:
        return "human", "untriaged"
    return ("fix", "inside") if triage["inside"] else ("human", "outside")


UNSETTLED = ("ungraded", "unverified", "found-again-after-its-fix")
NO_STEP = "nothing-open-and-no-close"


def next_of(findings, clauses):
    """(the next step, what forbids closing, the unsettled cells) — a pure function of the
    routes and the clause table."""
    forbids = [{"clause": row["clause"], "status": row["status"]} for row in clauses if row["status"] != "green"]
    if not clauses:
        forbids.append({"clauses": "no row"})
    still = [finding for finding in findings if finding["route"] != "recorded"]
    unsettled = [
        {"cell": name, "keys": [finding["key"] for finding in still if finding["why"] == name]}
        for name in UNSETTLED
        if any(finding["route"] == "unsettled" and finding["why"] == name for finding in still)
    ]
    if forbids and not still:
        unsettled.append({"cell": NO_STEP, "keys": []})
    forbids += [{"finding": finding["key"], "route": finding["route"]} for finding in still]
    routes = {finding["route"] for finding in still}
    if "human" in routes:
        step = "rule"
    elif "unsettled" in routes:
        step = "unsettled"
    elif "fix" in routes:
        step = "fix"
    else:
        step = "unsettled" if forbids else "close"
    return step, forbids, unsettled


def numbered(run_dir, parts, letter):
    """The numbers N of the directories `<letter>N` at `parts` below the run directory."""
    directory = below(run_dir, parts) if parts else run_dir
    found = []
    for name in os.listdir(directory) if os.path.isdir(directory) else []:
        if re.fullmatch(letter + NUMBER.pattern, name) and os.path.isdir(below(run_dir, parts + [name])):
            found.append(int(name[1:]))
    return sorted(found)


def reports_in(run_dir, parts):
    directory = below(run_dir, parts)
    names = os.listdir(directory) if os.path.isdir(directory) else []
    return len([name for name in names if REPORT_NAME.fullmatch(name) and os.path.isfile(below(run_dir, parts + [name]))])


def state(args):
    try:
        run_dir = open_run(args.run)
    except Refusal as refusal:
        if refusal.kind != "not-opened":
            raise
        print(json.dumps({"run": args.run, "opened": False}))
        return
    fcntl.flock(os.open(run_dir, os.O_RDONLY), fcntl.LOCK_SH)

    bounds_rel, _, bound_rows = read_bounds(run_dir)
    listed = unique_rows(bounds_rel, bound_rows)
    clauses_rel, _, clause_rows = read_clauses(run_dir)
    unique_rows(clauses_rel, clause_rows)
    for row in clause_rows:
        if row[4] not in CLAUSE_STATUSES:
            spoiled(clauses_rel, "gives %s the status %s, which this script does not write" % (row[0], shown(row[4])))
    ledger_rel, _, ledger_rows = read_ledger(run_dir)
    keys = unique_rows(ledger_rel, ledger_rows)

    # Each round's records, and each finding's entry in the latest round that triaged it.
    rounds, doors, triage = [], None, {}
    for number_ in numbered(run_dir, [], "r"):
        name = "r%d" % number_
        scope = read_scope(run_dir, number_)
        rel, _, rows = read_triage(run_dir, number_)
        for key, row in zip(unique_rows(rel, rows), rows):
            if scope is None:
                spoiled(rel, "is a triage record with no scope beside it")
            if key not in keys:
                spoiled(rel, "triages %s, a finding the ledger lacks" % key)
            side = placed(ledger_rows[keys.index(key)][4], scope[1])
            grade, bound = grade_read(rel, key, row[2])
            if row[1] != inside_cell(side) or grade not in TRIAGE_GRADES or row[3] not in VERDICTS + ("-",) or row[4] not in ("yes", "no", "-"):
                spoiled(rel, "holds a row for %s that does not follow from the round's doors and the triage vocabulary" % key)
            triage[key] = {
                "round": number_,
                "inside": side == "included",
                "door": side,
                "grade": grade,
                "bound": bound,
                "verdict": None if row[3] == "-" else row[3],
                "regression": None if row[4] == "-" else row[4] == "yes",
                "found_with": as_data(row[5]),
            }
        doors = scope and {side: [{"door": as_data(row[0]), "registry": as_data(row[2]), "derivation": as_data(row[3])} for row in scope[1] if row[1] == side] for side in SIDES}
        rounds.append({
            "round": number_,
            "scope": scope is not None,
            "triage": os.path.isfile(below(run_dir, [name, "triage.md"])),
            "record": os.path.isfile(below(run_dir, [name, "round.md"])),
            "test_reports": reports_in(run_dir, [name, "reports", "test"]),
            "fix_cycles": [{"cycle": cycle, "reports": reports_in(run_dir, [name, "reports", "fix", "c%d" % cycle])} for cycle in numbered(run_dir, [name, "reports", "fix"], "c")],
        })

    findings = []
    for key, row in zip(keys, ledger_rows):
        grade, bound = grade_read(ledger_rel, key, row[6])
        disposition, _, detail = row[8].partition(": ")
        if disposition not in DISPOSITIONS or not row[2].isdigit() or row[7] not in ("-",) + tuple(GRADERS):
            spoiled(ledger_rel, "holds a row for %s with a cell this script does not write" % key)
        finding = {
            "key": key,
            "doctype": untick(row[1]),
            "round": int(row[2]),
            "source": as_data(row[3]),
            "door": as_data(row[4]),
            "clause": as_data(row[5]),
            "grade": grade,
            "bound": bound,
            "graded_by": None if row[7] == "-" else row[7],
            "disposition": disposition,
            "detail": as_data(detail) or None,
            "repro": as_data(row[9]),
            "triage": triage.get(key),
        }
        finding["route"], finding["why"] = route_of(finding, triage.get(key), listed)
        findings.append(finding)
    clauses = [{"clause": untick(row[0]), "instrument": as_data(row[1]), "commit": None if row[2] == "-" else untick(row[2]), "scope": as_data(row[3]), "status": row[4]} for row in clause_rows]
    step, forbids, unsettled = next_of(findings, clauses)
    print(json.dumps({
        "run": args.run,
        "opened": True,
        "rounds": rounds,
        "round": rounds[-1]["round"] if rounds else None,
        "doors": doors,
        "bounds": [dict(zip(BOUND_COLUMNS, [untick(row[0])] + [as_data(text) for text in row[1:]])) for row in bound_rows],
        "clauses": clauses,
        "ledger": findings,
        "blockers": [finding["key"] for finding in findings if finding["route"] == "fix"],
        "human_list": [{"key": finding["key"], "why": finding["why"]} for finding in findings if finding["route"] == "human"],
        "unsettled": unsettled,
        "forbids_close": forbids,
        "next": step,
    }))


def distinct(names, what):
    twice = sorted({name for name in names if names.count(name) > 1})
    if twice:
        refuse("bad-value", "%s %s is given more than once" % (what, ", ".join(twice)))
    return names


def check_reports(args):
    run_dir = open_run(args.run)
    parts = stage_parts(args)
    attempt = int(number(args.attempt, "attempt"))
    launched = distinct([slug(name, "reporter") for name in args.names], "reporter")
    directory = below(run_dir, parts)
    seen, extra, other = set(), [], []
    for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
        path = os.path.join(directory, name)
        parsed = REPORT_NAME.fullmatch(name)
        if parsed is None or os.path.islink(path) or not os.path.isfile(path):
            extra.append(name)
        elif int(parsed.group(2)) != attempt:
            other.append(name)
        elif parsed.group(1) in launched:
            seen.add(parsed.group(1))
        else:
            extra.append(name)
    missing = [name for name in launched if name not in seen]
    ok = not missing and not extra
    print(json.dumps({
        "check": "reports",
        "ok": ok,
        "dir": "/".join(ARTIFACTS + (args.run,) + tuple(parts)),
        "attempt": attempt,
        "missing": missing,
        "extra": extra,
        "other_attempts": other,
    }))
    return 0 if ok else REPORTS_MISMATCH


def check_ledger(args):
    run_dir = open_run(args.run)
    wanted = distinct([slug(name, "key") for name in args.names], "key")
    keys = [untick(row[0]) for row in read_ledger(run_dir)[2]]
    missing = [key for key in wanted if key not in keys]
    duplicated = [key for key in wanted if keys.count(key) > 1]
    ok = not missing and not duplicated
    print(json.dumps({"check": "ledger", "ok": ok, "missing": missing, "duplicated": duplicated}))
    return 0 if ok else LEDGER_MISMATCH


class Arguments(argparse.ArgumentParser):
    def error(self, message):
        refuse("usage", "%s — see dev/stabilize-record --help" % message)


def arguments(argv):
    parser = Arguments(prog="dev/" + PROG, add_help=False, allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=Arguments)

    def command(name, act, flags, writes=False, names=False):
        sub = commands.add_parser(name, add_help=False, allow_abbrev=False)
        sub.set_defaults(act=act)
        sub.add_argument("--run", required=True)
        for flag, required in flags:
            sub.add_argument("--" + flag, required=required)
        if writes:
            sub.add_argument("--scratch", action="append", default=[])
        if names:
            sub.add_argument("names", nargs="*")

    stage = [("round", True), ("stage", True), ("cycle", False), ("attempt", True)]
    command("report", report, stage + [("reporter", True)], writes=True)
    command("ledger-add", ledger_add, [], writes=True)
    command("ledger-set", ledger_set, [], writes=True)
    command("clause-set", clause_set, [("clause", True), ("instrument", False), ("commit", False), ("scope", False), ("status", False)], writes=True)
    command("check-reports", check_reports, stage, names=True)
    command("check-ledger", check_ledger, [], names=True)
    command("bound-set", bound_set, [("bound", True), ("reach", False), ("ruling", False), ("pin", False)], writes=True)
    command("scope-set", scope_set, [("round", True)], writes=True)
    command("triage-set", triage_set, [("round", True)])
    command("state", state, [])
    if not argv or argv[0] not in commands.choices:
        refuse("usage", "%s is not a subcommand: the subcommands are %s — see dev/stabilize-record --help" % (shown(argv[0]) if argv else "nothing", ", ".join(commands.choices)))
    return parser.parse_args(argv)


def main(argv):
    # UTF-8 out, whatever the caller's locale claims: a result is read by a script.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    flags = argv[: argv.index("--")] if "--" in argv else argv
    if any(arg in ("-h", "--help") for arg in flags):
        usage_help()
        return 0
    # A terminated run unwinds, so the temporary of a write in flight goes with it.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(128 + signal.SIGTERM))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(128 + signal.SIGHUP))
    try:
        args = arguments(argv)
        return args.act(args) or 0
    except Refusal as refusal:
        sys.stderr.write("%s: refused %s: %s\n" % (PROG, refusal.kind, " ".join(refusal.detail.split())))
        return STATUS[refusal.kind]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
