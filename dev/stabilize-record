def fence_check(text):
    for name, what, reddens in FENCES:
        lines = [str(n) for n, line in enumerate(text.splitlines(), 1) if reddens(line)]
        if lines:
            refuse("fence", "line %s %s, which would redden %s — write the command inside a line" % (", ".join(lines), what, name))


def did_not_run(why):
    refuse("did-not-run", "the public-hygiene scan did not run, so nothing was written: %s" % why)


def scan_tools():
    """(the denylist, the scanner, the programs a scan runs) — or the scan DID NOT RUN."""
    denylist = os.environ.get("JIGC_DENYLIST_FILE") or os.path.join(os.path.expanduser("~"), ".config", "jigc", "denylist")
    if not os.path.isfile(denylist):
        did_not_run("no denylist at %s (implementation/public-hygiene.md)" % denylist)
    scanner = os.path.join(SCRIPT_DIR, "hygiene-scan")
    if not os.path.isfile(scanner):
        did_not_run("dev/hygiene-scan is missing")
    tools = {}
    for tool in ("git", "gitleaks"):
        tools[tool] = shutil.which(tool)
        if tools[tool] is None:
            did_not_run("%s is not on PATH" % tool)
    return denylist, scanner, tools


def hygiene_scan(files):
    """The two scanners CI runs over a push, over `files` — every (path, text) of ONE
    batch — committed, each at its own path, into one throwaway repository. Returns only
    when both ran and found nothing: a batch is scanned whole before any of it is written,
    and once, however many files it holds."""
    rels = ", ".join(rel for rel, _ in files)
    denylist, scanner, tools = scan_tools()

    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_GLOBAL=os.devnull,
        GIT_AUTHOR_NAME=PROG,
        GIT_AUTHOR_EMAIL=PROG + "@example.invalid",
        GIT_COMMITTER_NAME=PROG,
        GIT_COMMITTER_EMAIL=PROG + "@example.invalid",
    )

    def ran(argv, what):
        try:
            return subprocess.run(argv, cwd=repo, env=env, stdin=subprocess.DEVNULL, capture_output=True)
        except OSError as err:
            did_not_run("%s could not be started (%s)" % (what, err.strerror))

    def last_line(out):
        return out.stderr.decode("utf-8", "replace").strip().split("\n")[-1] or "no message"

    with tempfile.TemporaryDirectory(prefix="jigc-stabilize-scan-") as work:
        # dev/hygiene-scan scans the repository it lies in, so it is linked into this
        # one — untracked, so it is not itself scanned.
        repo = os.path.join(work, "repo")
        os.makedirs(os.path.join(repo, "dev"))
        os.symlink(scanner, os.path.join(repo, "dev", "hygiene-scan"))
        for rel, text in files:
            os.makedirs(os.path.dirname(os.path.join(repo, rel)), exist_ok=True)
            with open(os.path.join(repo, rel), "w", encoding="utf-8", newline="") as copy:
                copy.write(text)
        for step, argv in (
            ("init", ["init", "-q", "--template="]),
            ("add", ["add", "--"] + [rel for rel, _ in files]),
            # No background maintenance: it would outlive the commit, in a repository
            # that is removed as soon as the scan is done.
            ("commit", ["-c", "commit.gpgsign=false", "-c", "maintenance.auto=false", "-c", "gc.auto=0", "commit", "-q", "--no-verify", "-m", "."]),
        ):
            out = ran([tools["git"]] + argv, "git")
            if out.returncode != 0:
                did_not_run("git %s failed in the scan's repository: %s" % (step, last_line(out)))

        out = ran([os.path.join(repo, "dev", "hygiene-scan"), "--tree", denylist, "HEAD"], "dev/hygiene-scan")
        if out.returncode == 1:
            places = []
            for line in out.stdout.decode("utf-8", "replace").split("\n"):
                found = re.fullmatch(r"  (?:tree|path|added +[0-9a-f]+) +(\S.*)", line)
                if found and found.group(1) not in places:
                    places.append(found.group(1))
            raise Refusal("hygiene", "the denylist matches at %s — by where, never by what; reword it (implementation/public-hygiene.md)" % (", ".join(places) or rels), {re.sub(r":[0-9]+$", "", place) for place in places})
        if out.returncode != 0:
            did_not_run("dev/hygiene-scan exited %d: %s" % (out.returncode, last_line(out)))

        report = os.path.join(work, "gitleaks.json")
        argv = [tools["gitleaks"], "git", "--redact", "--no-banner", "--no-color", "--exit-code", str(GITLEAKS_FOUND), "--report-format", "json", "--report-path", report]
        config = os.path.join(ROOT, ".gitleaks.toml")
        if os.path.isfile(config):
            argv += ["--config", config]
        out = ran(argv + [repo], "gitleaks")
        if out.returncode == GITLEAKS_FOUND:
            try:
                leaks = json.load(open(report, encoding="utf-8"))
                found = ["rule %s at line %s%s" % (leak["RuleID"], leak["StartLine"], " of %s" % leak["File"] if len(files) > 1 and leak.get("File") else "") for leak in leaks]
                where = {leak["File"] for leak in leaks if isinstance(leak.get("File"), str)}
            except (OSError, ValueError, KeyError, TypeError, AttributeError):
                found, where = [], set()
            raise Refusal("hygiene", "gitleaks found a secret-shaped string in %s: %s — a credential is never committed, even a revoked one" % (rels, "; ".join(found) or "no location reported"), where)
        if out.returncode != 0:
            did_not_run("gitleaks exited %d: %s" % (out.returncode, last_line(out)))


def publish(run_dir, parts, text, replace, taken="a re-run passes the next attempt"):
    """Stage `text` for `parts` below the run directory and return the path it will be
    written at, repository-relative. Every writer ends here; nothing is on disk until the
    call's whole batch is (flush)."""
    target = below(run_dir, parts)
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts))
    if target in STAGED:
        held = not replace
    else:
        held = os.path.lexists(target) and not (replace and os.path.isfile(target))
    if held:
        refuse("exists", "%s exists — %s" % (rel, taken))
    STAGED[target] = (rel, text, replace, taken)
    return rel


def say(line):
    """A line of the call's result. It is printed once the call's writes have landed."""
    OUT.append(line)


def journal_path(run_dir):
    return below(run_dir, [JOURNAL])


def read_journal(run_dir):
    """The run's journal as {"placing": [...], "batch": {...} or None} — both empty where
    there is no file. A file that is not this script's journal is refused."""
    path = journal_path(run_dir)
    if not os.path.lexists(path):
        return {"placing": [], "batch": None}
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir), JOURNAL))
    try:
        held = json.loads(open(path, encoding="utf-8").read())
        placing, batch = held["placing"], held["batch"]
        for entry in placing:
            if not (isinstance(entry["path"], str) and re.fullmatch(r"\.%s\.[A-Za-z0-9_]+\.tmp" % re.escape(PROG), entry["temporary"]) and isinstance(entry["replace"], bool)):
                raise ValueError("a placing entry")
        if batch is not None:
            for name, entry in batch["files"].items():
                if not (isinstance(name, str) and SHA256.fullmatch(entry["sha256"]) and (entry["before"] is None or isinstance(entry["before"], str))):
                    raise ValueError("a batch file")
            if not (isinstance(batch["subject"], str) and isinstance(batch["calls"], int) and isinstance(batch["checks"], list) and (batch["round"] is None or isinstance(batch["round"], int)) and isinstance(batch.get("act", "record"), str) and isinstance(batch.get("discarding", False), bool)):
                raise ValueError("a batch")
    except (OSError, ValueError, KeyError, TypeError, AttributeError, RecursionError) as err:
        refuse("corrupt", "%s is not the journal this script writes (%s); it is not read on a guess" % (rel, " ".join(str(err).split()) or type(err).__name__))
    return {"placing": placing, "batch": batch}


def write_journal(run_dir, placing, batch):
    """The journal, replaced atomically — or removed, once it has nothing to say."""
    path = journal_path(run_dir)
    if not placing and batch is None:
        if os.path.lexists(path):
            os.unlink(path)
        return
    handle, temporary = tempfile.mkstemp(dir=run_dir, prefix=".%s." % PROG, suffix=".tmp")
    with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
        out.write(json.dumps({"placing": placing, "batch": batch}) + "\n")
        out.flush()
        os.fsync(out.fileno())
    os.replace(temporary, path)


def place(run_dir, entry, settling=False):
    """Put one file of a batch where it belongs, if it is not there yet."""
    target = below(run_dir, entry["path"].split("/"))
    temporary = os.path.join(os.path.dirname(target), entry["temporary"])
    if not os.path.lexists(temporary):
        return
    if entry["replace"]:
        os.replace(temporary, target)
        return
    try:
        os.link(temporary, target)
    except FileExistsError:
        # Settling a killed write, the file is the one this temporary was linked to.
        if not settling:
            raise
    os.unlink(temporary)


def take_back(run_dir, batch):
    """Take an applied batch back: the journal first says that it is being taken back; then
    every file of it is written as it was before the batch — or removed, where the batch
    made it; then the journal forgets the batch. A run killed at any point leaves a journal
    from which the next writer finishes it (recover): writing a file's text before the
    batch a second time changes nothing. Returns the files, run-relative."""
    if not batch.get("discarding"):
        write_journal(run_dir, [], dict(batch, discarding=True))
    for name, entry in batch["files"].items():
        target = below(run_dir, name.split("/"))
        if entry["before"] is None:
            if os.path.lexists(target):
                os.unlink(target)
        else:
            handle, temporary = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".%s." % PROG, suffix=".tmp")
            with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
                out.write(entry["before"])
                out.flush()
                os.fsync(out.fileno())
            os.chmod(temporary, 0o644)
            os.replace(temporary, target)
    write_journal(run_dir, [], None)
    return list(batch["files"])


def recover(run_dir):
    """Settle a write that was killed, and return what was placed. A batch whose journal
    is written is COMMITTED: every file of it that is not in place yet is put there. A
    batch killed before its journal is DISCARDED: its temporaries are removed, and no file
    of it was ever in place. A batch that was being TAKEN BACK is taken back whole. Called
    under the run's exclusive lock, which every write is made under — so a temporary found
    here belongs to nobody alive."""
    held = read_journal(run_dir)
    for entry in held["placing"]:
        place(run_dir, entry, settling=True)
    if held["placing"]:
        write_journal(run_dir, [], held["batch"])
    if held["batch"] is not None and held["batch"].get("discarding"):
        take_back(run_dir, held["batch"])
    for path in temporaries(run_dir):
        os.unlink(path)
    return ["/".join(ARTIFACTS + (os.path.basename(run_dir), entry["path"])) for entry in held["placing"]]


def temporaries(run_dir):
    """This script's own temporaries below the run's directory, wherever they lie."""
    return sorted(os.path.join(directory, name) for directory, _, names in os.walk(run_dir) for name in names if TEMPORARY.fullmatch(name))


def flush(run_dir, batch=None):
    """THE ONE WRITE: everything the call staged, as one batch. Every text is fenced and
    scanned BEFORE any of them is written; then each is written to a temporary beside its
    target; then — where the batch is more than one file, or is an applied batch — the
    journal says which temporaries become which files; then each is put in place; then the
    journal forgets the placing. A run killed at any point leaves either nothing of the
    batch, or a journal from which the next writer finishes it (recover)."""
    staged = list(STAGED.items())
    STAGED.clear()
    if not staged and batch is None:
        return
    for target, (rel, text, replace, taken) in staged:
        fence_check(text)
    if staged:
        hygiene_scan([(rel, text) for target, (rel, text, replace, taken) in staged])
    one_writer(run_dir)
    held = read_journal(run_dir)
    placing, journaled = [], False
    try:
        for target, (rel, text, replace, taken) in staged:
            if os.path.lexists(target) and not (replace and os.path.isfile(target)):
                refuse("exists", "%s exists — %s" % (rel, taken))
            parent = os.path.dirname(target)
            os.makedirs(parent, exist_ok=True)
            if batch is not None:
                before = open(target, encoding="utf-8", newline="").read() if os.path.isfile(target) else None
                batch["files"][os.path.relpath(target, run_dir)] = {"sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(), "before": before}
            handle, temporary = tempfile.mkstemp(dir=parent, prefix=".%s." % PROG, suffix=".tmp")
            placing.append({"path": os.path.relpath(target, run_dir), "temporary": os.path.basename(temporary), "replace": replace})
            with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
                out.write(text)
                out.flush()
                os.fsync(out.fileno())
            os.chmod(temporary, 0o644)
        if len(placing) > 1 or batch is not None:
            write_journal(run_dir, placing, batch if batch is not None else held["batch"])
            journaled = True
        for entry, (target, (rel, text, replace, taken)) in zip(placing, staged):
            try:
                place(run_dir, entry)
            except FileExistsError:
                refuse("exists", "%s exists — %s" % (rel, taken))
        if journaled:
            write_journal(run_dir, [], batch if batch is not None else held["batch"])
    finally:
        # Before the journal names them, the temporaries are nobody's: a refusal, or a
        # terminated run, takes them with it. After it, they are the batch.
        if not journaled:
            for entry in placing:
                temporary = os.path.join(os.path.dirname(below(run_dir, entry["path"].split("/"))), entry["temporary"])
                if os.path.lexists(temporary):
                    os.unlink(temporary)


# --- tables ---------------------------------------------------------------------


def cell(text):
    """Free text as one table cell: no line break, no bare pipe, never empty."""
    text = re.sub(r"\s*[\r\n\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029]+\s*", "<br>", text.strip())
    text = re.sub(r"[\x00-\x1f\x7f]", " ", text)
    text = re.sub(r"\\+(?=\|)", lambda run: "&#92;" * len(run.group()), text)
    return text.replace("|", "\\|") or "-"


def header(columns):
    return ["| %s |" % " | ".join(columns), "|" + "---|" * len(columns)]


def read_table(path, rel, columns):
    """The lines above the table at `path` and its rows, each a list of raw cells — or
    None when there is no file yet. A file that is not this script's table is refused."""
    if os.path.islink(path):
        refuse("outside", "%s is a link: a write to it would land outside the run directory" % rel)
    if path in STAGED:
        # What an earlier call of the same batch wrote (apply): not on disk yet.
        lines = STAGED[path][1].split("\n")
    elif not os.path.lexists(path):
        return None
    else:
        try:
            lines = open(path, encoding="utf-8", newline="").read().split("\n")
        except (OSError, ValueError) as err:
            refuse("corrupt", "%s cannot be read as text (%s)" % (rel, err))
    head = header(columns)
    if head[0] not in lines:
        refuse("corrupt", "%s holds no table with this script's header; it is not rewritten on a guess" % rel)
    at = lines.index(head[0])
    if lines[at + 1 : at + 2] != head[1:]:
        refuse("corrupt", "%s line %d is not the header's rule" % (rel, at + 2))
    body = lines[at + 2 :]
    while body and body[-1] == "":
        body.pop()
    rows = []
    for n, line in enumerate(body, at + 3):
        cells = re.split(r"(?<!\\)\|", line)
        if len(cells) != len(columns) + 2 or cells[0] != "" or cells[-1] != "":
            refuse("corrupt", "%s line %d is not a row of %d cells; it is not rewritten on a guess" % (rel, n, len(columns)))
        rows.append([text.strip() for text in cells[1:-1]])
    return lines[:at], rows


def render_table(above, columns, rows):
    return "\n".join(above + header(columns) + ["| %s |" % " | ".join(row) for row in rows]) + "\n"


def tick(text):
    return "`%s`" % text


def untick(text):
    return text.strip("`")


def stdin_bytes():
    """The call's input: for a call of a batch, what the batch gives; the file its caller
    names (--from), held to the hash it is named by where one is (--sha256); else stdin."""
    if INPUT:
        return INPUT[-1].encode("utf-8", "surrogatepass")
    if not FROM:
        return sys.stdin.buffer.read()
    path, wanted = FROM[-1]
    try:
        with open(path, "rb") as file:
            data = file.read()
    except OSError as err:
        refuse("bad-value", "--from %s cannot be read as a file (%s); nothing was written" % (shown(path), " ".join(str(err).split())))
    has = hashlib.sha256(data).hexdigest()
    if wanted is not None and has != wanted:
        refuse("bad-value", "--from %s is not the file its composer hashed: its sha256 is %s, and --sha256 names %s — the text was altered on its way, or the file is another. Write the file again, exactly; nothing was written" % (shown(path), has, shown(wanted)))
    return data


def json_stdin():
    try:
        given = json.loads(stdin_bytes().decode("utf-8"))
        # A text no file can hold — a lone surrogate, which JSON can spell and UTF-8
        # cannot — is refused here, once, for every field of every body.
        json.dumps(given, ensure_ascii=False).encode("utf-8")
    except RecursionError:
        refuse("bad-value", "stdin is not JSON this script reads: it is nested too deeply")
    except UnicodeEncodeError:
        refuse("bad-value", "stdin holds a text that is not Unicode text — a lone surrogate, which no file can hold")
    except ValueError as err:
        refuse("bad-value", "stdin is not JSON (%s)" % str(err).split("\n")[0])
    return given


def json_rows(what):
    """Stdin as a non-empty list of JSON objects."""
    rows = json_stdin()
    if isinstance(rows, dict):
        rows = [rows]
    if not isinstance(rows, list) or not rows or not all(isinstance(row, dict) for row in rows):
        refuse("bad-value", "stdin must be one %s as a JSON object, or a non-empty array of them" % what)
    return rows


def fields(row, required, optional, what):
    unknown = sorted(set(row) - set(required) - set(optional))
    if unknown:
        refuse("bad-value", "%s has no field %s; it has %s" % (what, ", ".join(shown(name) for name in unknown), ", ".join(required + optional)))
    missing = [name for name in required if name not in row]
    if missing:
        refuse("bad-value", "%s lacks %s" % (what, ", ".join(missing)))


def text_of(row, name, what, scratch):
    if not isinstance(row[name], str):
        refuse("bad-value", "%s: %s must be text, not %s" % (what, name, shown(row[name])))
    return cell(public(row[name], scratch))


def said(row, name, what, scratch):
    """A cell that must say something."""
    text = text_of(row, name, what, scratch)
    if not row[name].strip():
        refuse("bad-value", "%s: %s says nothing" % (what, name))
    return text


def one_of(value, allowed, what):
    if not isinstance(value, str) or value not in allowed:
        refuse("bad-value", "%s %s is not one of %s" % (what, shown(value), ", ".join(allowed)))
    return value


def grade_cells(row, what):
    """The `grade` and `graded by` cells a row or a patch names."""
    grade = one_of(row["grade"], ("ungraded",) + GRADERS["human"], what + ": grade")
    grader, bound = row.get("graded_by"), row.get("bound")
    if (bound is not None) != (grade == "out-of-scope"):
        refuse("bad-value", "%s: out-of-scope cites a declared bound of the opening record as `bound`, and no other grade does" % what)
    if grade == "ungraded":
        if "graded_by" in row:
            refuse("bad-value", "%s: ungraded has no grader" % what)
        return "ungraded", "-"
    one_of(grader, tuple(GRADERS), what + ": graded_by")
    one_of(grade, GRADERS[grader], "%s: a grade given by %s," % (what, grader))
    if bound is not None:
        return OUT_OF_SCOPE + slug(bound, what + ": bound"), grader
    return grade, grader


def disposition_cell(row, what, scratch):
    disposition = one_of(row["disposition"], tuple(DISPOSITIONS), what + ": disposition")
    needs, detail = DISPOSITIONS[disposition], row.get("detail")
    if detail is None:
        if needs in ("sha", "required"):
            refuse("bad-value", "%s: %s needs a detail — %s" % (what, disposition, "the fix's sha" if needs == "sha" else "the bound's reach"))
        return disposition
    if needs is None:
        refuse("bad-value", "%s: %s takes no detail" % (what, disposition))
    if not isinstance(detail, str) or not detail.strip():
        refuse("bad-value", "%s: detail must be text, not %s" % (what, shown(detail)))
    if needs == "sha":
        if not SHA.fullmatch(detail):
            refuse("bad-value", "%s: fixed names the fix's commit, 7 to 40 hex digits, not %s" % (what, shown(detail)))
        return "fixed: " + detail
    return "%s: %s" % (disposition, cell(public(detail, scratch)))


def set_cells(row, what, scratch):
    """The (column index, cell) pairs for the grade and disposition `row` names."""
    cells = []
    if "grade" in row:
        cells += zip((6, 7), grade_cells(row, what))
    elif "graded_by" in row or "bound" in row:
        refuse("bad-value", "%s: graded_by and bound belong to a grade" % what)
    if "disposition" in row:
        cells.append((8, disposition_cell(row, what, scratch)))
    elif "detail" in row:
        refuse("bad-value", "%s: a detail belongs to a disposition" % what)
    return cells


LEDGER_REQUIRED = ("key", "doctype", "round", "source", "door", "clause", "repro")
LEDGER_SET = ("grade", "graded_by", "bound", "disposition", "detail")


def ledger_row(row, scratch):
    fields(row, LEDGER_REQUIRED, LEDGER_SET, "a ledger row")
    what = "row %s" % shown(row["key"])
    key = slug(row["key"], "key")
    one_of(row["doctype"], DOCTYPES, what + ": doctype")
    if isinstance(row["round"], bool) or not isinstance(row["round"], int) or row["round"] < 0:
        refuse("bad-value", "%s: round must be a whole number, 0 for the opening, not %s" % (what, shown(row["round"])))
    cells = [tick(key), tick(row["doctype"]), str(row["round"])]
    cells += [text_of(row, name, what, scratch) for name in ("source", "door", "clause")]
    cells += ["ungraded", "-", "open", text_of(row, "repro", what, scratch)]
    for at, text in set_cells(row, what, scratch):
        cells[at] = text
    return key, cells


def table_file(run_dir, parts, columns, title, says):
    """(the table file's repository-relative path, the lines above its table, its rows).
    A file that does not exist yet opens with `title` and what the table `says`."""
    run = os.path.basename(run_dir)
    rel = "/".join(ARTIFACTS + (run,) + tuple(parts))
    table = read_table(below(run_dir, parts), rel, columns)
    if table is None:
        table = (["# %s — %s" % (run, title), "", says, ""], [])
    return (rel,) + table


