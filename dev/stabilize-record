def run_facts(rel, rows):
    """The run's rows as {fact: value}, both facts named — None where the table does not
    hold it. A row that is not this script's is refused."""
    facts = dict.fromkeys(RUN_FACTS)
    for name, row in zip(unique_rows(rel, rows), rows):
        value = untick(row[1])
        listed = value.split(ITEMS_BREAK)
        slugs = all(SLUG.fullmatch(entry) for entry in listed) and len(set(listed)) == len(listed)
        holds = {
            "stop": value in STOP_MODES,
            "rounds": NUMBER.fullmatch(value),
            "cycles": NUMBER.fullmatch(value),
            "previous": VERSION.fullmatch(value),
            "previous-commit": FULL_SHA.fullmatch(value),
            "scope": value in DEFAULT_SCOPES,
            "clauses": slugs,
            "findings": slugs,
        }
        if not holds.get(name):
            spoiled(rel, "gives the fact %s the value %s, which this script does not write" % (shown(name), shown(value)))
        facts[name] = int(value) if name in RUN_BOUNDS else listed if name in RUN_LISTS else value
    return facts


def run_rows(facts):
    """The run's facts as the rows of their table."""
    return [[tick(name), tick(ITEMS_BREAK.join(facts[name]) if name in RUN_LISTS else str(facts[name]))] for name in RUN_FACTS if facts[name] is not None]


def round_facts(rel, rows):
    """A round record's rows as {fact: value}, every fact named — None where the record
    does not hold it, 0 for the cycles, [] for a list, and for the go the count of fix cycles
    it was given at. A row that is not this script's is refused."""
    facts = dict.fromkeys(ROUND_FACTS)
    for name in unique_rows(rel, rows):
        if name not in ROUND_FACTS:
            spoiled(rel, "holds the fact %s, which this script does not write" % shown(name))
    for row in rows:
        name, value = untick(row[0]), untick(row[1])
        listed = value.split(ITEMS_BREAK)
        entry = ROUND_ENTRIES.get(name, SLUG)
        holds = {
            "candidate": FULL_SHA.fullmatch(value),
            "base": SHA.fullmatch(value),
            "binary": SHA256.fullmatch(value),
            "cycles": NUMBER.fullmatch(value),
            "outcome": value in OUTCOMES,
            "go": GO.fullmatch(value),
        }.get(name, all(entry.fullmatch(said_) for said_ in listed) and len({said_.split(" ")[0] if name in ROUND_COUNTED else said_ for said_ in listed}) == len(listed))
        if not holds:
            spoiled(rel, "gives the fact %s the value %s, which this script does not write" % (name, shown(value)))
        facts[name] = int(value) if name == "cycles" else int(value[1:]) if name == "go" else value if name in ROUND_ONCE else listed
    facts["cycles"] = facts["cycles"] or 0
    for name in ROUND_FACTS:
        if name in ROUND_LISTS + ROUND_GRANTS + ROUND_COUNTED:
            facts[name] = facts[name] or []
    return facts


def as_said(facts):
    """A round's facts as the state gives them: the go as WHETHER IT STANDS — it was given
    with as many fix cycles on record as the round has now. A go answers one stop."""
    return dict(facts, go=facts["go"] is not None and facts["go"] == facts["cycles"])


def round_rows(facts):
    """A round's facts as the rows of its record."""
    rows = []
    for name in ROUND_FACTS:
        value = facts[name]
        if value is None or value == [] or (name == "cycles" and value == 0):
            continue
        rows.append([tick(name), tick("c%d" % value if name == "go" else ITEMS_BREAK.join(value) if isinstance(value, list) else str(value))])
    return rows


def counted(run_dir, round_number, name, value):
    """Stage a fact this script counts for itself into a round's record, where it changed."""
    rel, above, rows = read_round(run_dir, round_number)
    facts = round_facts(rel, rows)
    if facts[name] != value:
        facts[name] = value
        publish(run_dir, ["r%s" % round_number, "round.md"], render_table(above, ROUND_COLUMNS, round_rows(facts)), replace=True)


def by_name(entries):
    """The entries of a counted fact — `<name> … <N>` — as {name: (the words between, N)}."""
    held = {}
    for entry in entries:
        words = entry.split(" ")
        held[words[0]] = (" ".join(words[1:-1]), int(words[-1].lstrip("ap")))
    return held


def unique_rows(rel, rows):
    keys = [untick(row[0]) for row in rows]
    twice = sorted({key for key in keys if keys.count(key) > 1})
    if twice:
        refuse("corrupt", "%s holds more than one row for %s; it is not rewritten on a guess" % (rel, ", ".join(twice)))
    return keys


def spoiled(rel, what):
    refuse("corrupt", "%s %s; it is not read on a guess" % (rel, what))


def read_scope(run_dir, round_number):
    """(the scope file's repository-relative path, its rows) for a round — or None before
    the round's scope is written."""
    parts = ["r%s" % round_number, "scope.md"]
    rel = "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts))
    table = read_table(below(run_dir, parts), rel, SCOPE_COLUMNS)
    if table is None:
        return None
    rows = table[1]
    for row in rows:
        if row[1] not in SIDES:
            spoiled(rel, "puts the door %s on the side %s, which this script does not write" % (row[0], shown(row[1])))
    if len({row[0] for row in rows}) != len(rows):
        spoiled(rel, "lists a door twice")
    return rel, rows


def placed(door, scope_rows):
    """Where a round's scope puts a door: `included`, `excluded` or — in neither list —
    `unlisted`. Inside the round's test set is `included`, and nothing else is."""
    for row in scope_rows:
        if row[0] == door:
            return row[1]
    return "unlisted"


def inside_cell(side):
    return "inside" if side == "included" else "outside: " + side


def hold_to_the_list(run_dir, cited):
    """Refuse an out-of-scope grade that cites no row of the declared-bounds list: it is
    the one grade that takes a finding off the human's list unseen."""
    cited = [(what, grade[len(OUT_OF_SCOPE):]) for what, grade in cited if grade.startswith(OUT_OF_SCOPE)]
    if not cited:
        return
    rel, _, rows = read_bounds(run_dir)
    listed = unique_rows(rel, rows)
    for what, bound in cited:
        if bound not in listed:
            refuse("no-such-bound", "%s: out-of-scope cites the bound %s, which the declared-bounds list (%s) lacks — a bound is the human's ruling, entered with bound-set, and without one the grade is needs-bound; nothing was written" % (what, bound, rel))


# --- where the state takes a write ------------------------------------------------------


def standing(run_dir, run):
    """The state as it stands, for a writer that holds the run's lock and asks before it
    writes: a write killed between its files was settled when the lock was taken."""
    return document(run_dir, run)


def not_asked(what, read, why):
    refuse("bad-value", "%s: the state does not ask for it — %s; the run's next step is `%s`. Nothing was written" % (what, why, read["stop"]["then"] + "`, after the stop `" + read["stop"]["why"] if read["stop"] else read["next"]))


def a_round(read, round_number, what):
    """Refuse a write that names a round the run has not begun and the state does not hand
    to a `test` stage: a round begins where the position says so, and nowhere else — never
    past a stop nobody lifted, past a round that is still open, or two rounds ahead."""
    wanted = int(round_number)
    if wanted != read["begins"] and all(held["round"] != wanted for held in read["rounds"]):
        begun = ", ".join("round %d" % held["round"] for held in read["rounds"]) or "no round"
        not_asked(what, read, "round %d is not begun (the run has begun %s), and %s" % (wanted, begun, "the round a `test` stage would begin is round %d" % read["begins"] if read["begins"] else "the state hands no new round to a `test` stage — its position: %s" % json.dumps(read["position"]["test"])))


def untested(read, round_number, what):
    """Refuse what belongs to a round's test stage once that round is tested."""
    a_round(read, round_number, what)
    if any(held["round"] == int(round_number) and held["facts"]["candidate"] is not None for held in read["rounds"]):
        not_asked(what, read, "round %s is tested, and this is written by its test stage's record, with or before the candidate" % round_number)


def latest_tested(read, round_number, what):
    """Refuse what belongs to the fix stage, or to the human's exit from a round, anywhere
    but in the latest round once it is tested."""
    last = read["rounds"][-1] if read["rounds"] else None
    if last is None or last["round"] != int(round_number) or last["facts"]["candidate"] is None:
        not_asked(what, read, "it is a fact of the latest round, once that round is tested, and round %s is %s" % (round_number, "not that round" if last and last["round"] != int(round_number) else "not tested"))
    return last


# --- the subcommands --------------------------------------------------------------


def report(args):
    run_dir = open_run(args.run)
    parts = stage_parts(args)
    name = "%s.a%s.md" % (slug(args.reporter, "reporter"), number(args.attempt, "attempt"))
    scratch = scratch_roots(args)
    # Asked before the report is read, and again by the write itself.
    if os.path.lexists(below(run_dir, parts + [name])):
        refuse("exists", "%s exists — a re-run passes the next attempt" % "/".join(ARTIFACTS + (args.run,) + tuple(parts) + (name,)))
    # And whether the state takes a report for this round — read between two writes, and
    # let go of before the scan: reporters write side by side.
    asking = os.open(run_dir, os.O_RDONLY)
    fcntl.flock(asking, fcntl.LOCK_SH)
    try:
        killed = bool(read_journal(run_dir)["placing"])
        if not killed:
            a_round(document(run_dir, args.run), args.round, "a report of round %s" % args.round)
    finally:
        os.close(asking)
    if killed:
        # A write was killed between its files: it is settled first, as every writer does.
        one_writer(run_dir)
        a_round(document(run_dir, args.run), args.round, "a report of round %s" % args.round)
    try:
        text = stdin_bytes().decode("utf-8")
    except ValueError:
        refuse("bad-value", "the report on stdin is not UTF-8 text")
    if "\0" in text or not text.strip():
        refuse("bad-value", "the report on stdin is empty, or is not text")
    if text.rstrip().rsplit("\n", 1)[-1].strip() != REPORT_ENDS:
        refuse("truncated", "the report on stdin does not end with the line `%s`: it was cut off on its way, or its reporter never finished it; nothing was written" % REPORT_ENDS)
    text = public(text, scratch)
    if not text.endswith("\n"):
        text += "\n"
    say(publish(run_dir, parts + [name], text, replace=False))


def ledger_add(args):
    run_dir = open_run(args.run)
    scratch = scratch_roots(args)
    given = [ledger_row(row, scratch) for row in json_rows("ledger row")]
    one_writer(run_dir)
    hold_to_the_list(run_dir, [("row %s" % key, cells[6]) for key, cells in given])
    rel, above, rows = read_ledger(run_dir)
    keys = unique_rows(rel, rows)
    hold_census(run_dir, rel, keys)
    appended, existing = [], []
    for key, cells in given:
        if key in keys:
            existing.append(key)
        else:
            keys.append(key)
            rows.append(cells)
            appended.append(key)
    if appended:
        publish(run_dir, ["ledger.md"], render_table(above, LEDGER_COLUMNS, rows), replace=True)
        census(run_dir, appended)
    say(json.dumps({"ledger": rel, "appended": appended, "existing": existing}))


def hold_census(run_dir, ledger_rel, keys):
    """WHAT IS DELETED IS MISSED: every finding the run's census names has its row, and the
    ledger holds no row the census does not name — refused by `state` and by every writer
    of the ledger, before it writes."""
    named = run_facts(*read_run(run_dir)[::2])["findings"] or []
    gone, strange = [key for key in named if key not in keys], [key for key in keys if key not in named]
    if gone or strange:
        spoiled(ledger_rel, "is not the ledger the run's record (run.md) names the findings of — it %s. A row is added by this script and removed by nobody: take the file back from the commit that holds it" % "; ".join(["lacks %s" % ", ".join(gone)] * bool(gone) + ["holds %s, which the census does not name" % ", ".join(strange)] * bool(strange)))


def census(run_dir, added):
    """Name the findings a call added in the run's own record: THE LEDGER'S CENSUS. A row
    the census names is a row the ledger has, whoever deleted it (state)."""
    rel, above, rows = read_run(run_dir)
    facts = run_facts(rel, rows)
    facts["findings"] = (facts["findings"] or []) + [key for key in added if key not in (facts["findings"] or [])]
    publish(run_dir, ["run.md"], render_table(above, ROUND_COLUMNS, run_rows(facts)), replace=True)


def ledger_set(args):
    run_dir = open_run(args.run)
    scratch = scratch_roots(args)
    patches = []
    for patch in json_rows("ledger patch"):
        fields(patch, ("key",), LEDGER_SET, "a ledger patch")
        key = slug(patch["key"], "key")
        cells = set_cells(patch, "patch %s" % key, scratch)
        if not cells:
            refuse("bad-value", "patch %s sets neither a grade nor a disposition" % key)
        patches.append((key, cells))
    one_writer(run_dir)
    hold_to_the_list(run_dir, [("patch %s" % key, text) for key, cells in patches for at, text in cells if at == 6])
    rel, above, rows = read_ledger(run_dir)
    keys = unique_rows(rel, rows)
    hold_census(run_dir, rel, keys)
    for key, cells in patches:
        if key not in keys:
            refuse("no-such-row", "the ledger has no row %s; nothing was written" % key)
        for at, text in cells:
            rows[keys.index(key)][at] = text
    publish(run_dir, ["ledger.md"], render_table(above, LEDGER_COLUMNS, rows), replace=True)
    say(json.dumps({"ledger": rel, "updated": [key for key, _ in patches]}))


def result_set(args):
    run_dir = open_run(args.run)
    round_number = number(args.round, "round")
    scratch = scratch_roots(args)
    if not FULL_SHA.fullmatch(args.commit):
        refuse("bad-value", "commit %s is not a full sha of 40 hex digits: the commit the items ran on" % shown(args.commit))
    given = []
    for row in json_rows("result"):
        fields(row, ("item",), ("outcome", "reason", "verdict") + RED_FIELDS, "a result")
        what = "result %s" % shown(row["item"])
        name = slug(row["item"], "item")
        if "verdict" in row:
            # A HELD CHECK'S ROW names the file of the tool's verdict, and nothing else.
            if set(row) != {"item", "verdict"} or not isinstance(row["verdict"], str):
                refuse("bad-value", "%s: a held check's row names the item and — as `verdict` — the file dev/stabilize-step kept its verdict in, and nothing else: no outcome word is taken from a caller" % what)
            given.append((name, None, None, None, row["verdict"]))
            continue
        fields(row, ("item", "outcome"), ("reason",) + RED_FIELDS, "a result")
        outcome = one_of(row["outcome"], CLAUSE_STATUSES, what + ": outcome")
        if ("reason" in row) != (outcome == "void"):
            refuse("bad-value", "%s: void says why the item did not run to its end, as `reason`, and no other outcome does" % what)
        if any((field in row) != (outcome == "red") for field in RED_FIELDS):
            refuse("bad-value", "%s: red is filed as a finding, and brings what its ledger row needs — %s — and no other outcome does" % (what, ", ".join(RED_FIELDS)))
        detail, finding = "-", None
        if outcome == "void":
            detail = said(row, "reason", what, scratch)
        if outcome == "red":
            key = slug(RED + name, what + ": the key of its finding")
            finding = [tick(key), tick(one_of(row["doctype"], DOCTYPES, what + ": doctype"))] + [said(row, field, what, scratch) for field in ("door", "repro")]
            detail = tick(key)
        given.append((name, outcome, detail, finding, None))
    distinct([name for name, _, _, _, _ in given], "item")
    one_writer(run_dir)
    # The state as it stands before the write: what the round is, and what it asks for.
    read = standing(run_dir, args.run)
    what = "round %s" % round_number
    a_round(read, round_number, "a result of round %s" % round_number)
    scope = read_scope(run_dir, round_number)
    if scope is None:
        refuse("no-scope", "%s has no scope yet: a result is the run of an item the round's scope selected, and scope-set writes the round's doors; nothing was written" % what)
    items_rel, _, item_rows = read_test_set(run_dir)
    items = unique_rows(items_rel, item_rows)
    rel, above, rows = read_results(run_dir, round_number)
    tested = any(held["round"] == int(round_number) and held["facts"]["candidate"] is not None for held in read["rounds"])
    due = [(entry["item"], entry["round"]) for clause in read["clauses"] for entry in clause["items"] if entry["rerun"] == "due"] if read["next"] == "retest" else []
    ledger, ledger_above, ledger_rows = read_ledger(run_dir)
    keys = unique_rows(ledger, ledger_rows)
    recorded, filed, added = [], [], []
    for name, outcome, detail, finding, verdict in given:
        if name not in items:
            refuse("no-such-row", "the test set has no item %s; nothing was written" % name)
        item = item_rows[items.index(name)]
        kind = untick(item[1])
        # A SCRIPTED CHECK'S RESULT IS THE TOOL'S VERDICT: an item whose check is a held
        # command takes its result from the verdict's file and from nothing a caller says —
        # and no other item takes one from a file.
        if kind.startswith(HELD) and verdict is None and outcome != "void":
            refuse("bad-value", "%s: the item %s is a held check (kind %s) — dev/stabilize-step holds its command and judges it, and its result is written from that tool's verdict: name the file (`verdict`: <scratch>/hold/<name>/verdict.json). No outcome word is taken from a caller but `void`, for a check that left no verdict; nothing was written" % (what, name, kind))
        if kind.startswith(HELD) and verdict is None:
            # A HELD CHECK THAT LEFT NO VERDICT — its job dead, its start refused, the stage
            # over while it ran, a gate not held off the candidate's tree: it is void, and
            # void is the one word taken for it. Its reason is a word of a declared shape.
            if not HELD_VOID.fullmatch(detail) or len(detail) > HELD_VOID_MAX:
                refuse("bad-value", "%s: the item %s is a held check (kind %s), and a void that names no verdict's file says why in a word — `<word>` or `<word>:<key>`, lowercase words joined by single `-`, the key the held job's name, %d characters at most — and %s is no such word; nothing was written" % (what, name, kind, HELD_VOID_MAX, shown(detail)))
            detail = cell(NO_VERDICT + detail)
        if verdict is not None and not kind.startswith(HELD):
            refuse("bad-value", "%s: the item %s is of kind %s, which is no held check (`%s<id>`): its result is what its agents report, as `outcome`, and no verdict's file; nothing was written" % (what, name, kind, HELD))
        if not selected_by(item, scope[1]):
            refuse("bad-value", "%s: its scope does not select the item %s — an item no scope selected owes nothing, and has no result there; nothing was written" % (what, name))
        attempt = sum(untick(row[0]) == name for row in rows) + 1
        if not tested and attempt > 1:
            refuse("exists", "%s holds the result of %s's run in its test stage, and the round is not tested yet — a run again is an attempt of a round that is, and only where the state asks for it; nothing was written" % (rel, name))
        if tested and (name, int(round_number)) not in due:
            refuse("bad-value", "%s is tested, and the state does not ask for a run of %s in it again — its next step is `%s`, and a re-run is taken for an item the state lists as due while that step is `retest`, in the round that selected the item; nothing was written" % (what, name, read["next"]))
        if verdict is not None:
            # The verdict reaches the record as a file WRITTEN ONCE, in this call's batch.
            parts = ["r" + round_number, "checks", "%s.a%d.json" % (name, attempt)]
            outcome, detail, finding, text = held_result(verdict, name, kind[len(HELD):], round_number, attempt, args.commit, scratch, "/".join(ARTIFACTS + (args.run,) + tuple(parts)))
            publish(run_dir, parts, text, replace=False, taken="a held check's verdict is written once, under the attempt its run is")
        rows.append([tick(name), str(attempt), tick(args.commit), outcome, detail])
        recorded.append({"item": name, "attempt": attempt, "outcome": outcome})
        if finding is None:
            continue
        # A red run is a finding: its row in the ledger, under a key of the item's own, so
        # that the next triage grades it and it is routed like any other. A row that says
        # `fixed` does not inherit that: the item is red after its fix.
        key = untick(finding[0])
        if key in keys:
            held = ledger_rows[keys.index(key)]
            if held[8].startswith("fixed"):
                held[8] = "open"
                filed.append(key)
        else:
            source = cell("the item `%s` of the test set, red in round %s (attempt %d)" % (name, round_number, attempt))
            keys.append(key)
            ledger_rows.append(finding[:2] + [round_number, source, finding[2], untick(item[2]), "ungraded", "-", "open", finding[3]])
            filed.append(key)
            added.append(key)
    publish(run_dir, ["r" + round_number, "results.md"], render_table(above, RESULT_COLUMNS, rows), replace=True)
    # How many runs of each item the round now holds, in the round's own record: a result
    # that is gone later is missed there (state).
    runs = {}
    for row in rows:
        runs[untick(row[0])] = runs.get(untick(row[0]), 0) + 1
    counted(run_dir, round_number, "ran", ["%s a%d" % held for held in runs.items()])
    if filed:
        publish(run_dir, ["ledger.md"], render_table(ledger_above, LEDGER_COLUMNS, ledger_rows), replace=True)
    if added:
        census(run_dir, added)
    render_view(run_dir)
    say(json.dumps({"results": rel, "recorded": recorded, "findings": filed}))


def held_result(path, name, held, round_number, attempt, commit, scratch, rel):
    """A held check's result, from THE TOOL'S VERDICT and from nothing else: (outcome, the
    result row's detail, the finding a red one is filed as, the verdict as it is written on
    record). `path` is the file dev/stabilize-step kept — ONE line that ends with the sha256
    of itself — and it is that tool's verdict of a held `held` command, on this commit, or
    the call is refused."""
    what = "the verdict's file %s of the item %s" % (shown(path), name)
    try:
        with open(path, "rb") as file:
            line = file.read().decode("utf-8")
    except (OSError, ValueError) as err:
        refuse("bad-value", "%s cannot be read as text (%s); nothing was written" % (what, " ".join(str(err).split())))
    line = line[:-1] if line.endswith("\n") else line
    marker = ', "sha256": "'
    at = line.rfind(marker)
    kept = None
    if "\n" not in line and at > 0 and line.endswith('"}') and hashlib.sha256((line[:at] + "}").encode("utf-8")).hexdigest() == line[at + len(marker):-2]:
        try:
            kept = json.loads(line)
            json.dumps(kept, ensure_ascii=False).encode("utf-8")
        except (ValueError, RecursionError):
            kept = None
    if not isinstance(kept, dict):
        refuse("bad-value", "%s is not ONE line of JSON that ends with the sha256 of itself: it is not the verdict dev/stabilize-step kept, or it was altered on its way; nothing was written" % what)
    asked = kept.get("asked") if isinstance(kept.get("asked"), dict) else {}
    of = [asked[flag] for flag in ("candidate", "commit") if flag in asked]
    wrong = (
        "it is no verdict of dev/%s (its `tool` is %s)" % (HOLDER, shown(kept.get("tool"))) if kept.get("tool") != HOLDER
        else "it is the verdict of a held `%s`, and the item's kind is `%s%s`" % (kept.get("kind"), HELD, held) if kept.get("kind") != held
        else "its verdict is %s, which is none of %s" % (shown(kept.get("verdict")), ", ".join(CLAUSE_STATUSES)) if kept.get("verdict") not in CLAUSE_STATUSES
        else "it is void and does not say why" if kept["verdict"] == "void" and not (isinstance(kept.get("why"), str) and kept["why"].strip())
        else "it is the verdict of a command on %s, and the results of this call are of runs on %s" % (", ".join(map(shown, of)), commit) if any(sha != commit for sha in of)
        else None
    )
    if wrong:
        refuse("bad-value", "%s: %s; nothing was written" % (what, wrong))
    outcome, why, said_ = kept["verdict"], kept.get("why"), " ".join(str(kept.get("detail") or "").split())
    record = {"item": name, "attempt": attempt, "round": int(round_number), "commit": commit, "kind": held, "verdict": outcome, "why": why, "detail": said_}
    record.update({field: kept.get(field) for field in ("name", "asked", "exit", "seconds", "facts", "evidence", "output_sha256")})
    text = public(json.dumps(record, indent=1, ensure_ascii=False) + "\n", scratch)
    detail, finding = "-", None
    if outcome == "void":
        detail = cell(public("%s%s" % (why, ": " + said_ if said_ else ""), scratch))
    if outcome == "red":
        key = slug(RED + name, "the key of the finding of %s" % name)
        finding = [tick(key), tick(DOCTYPES[0]), cell("the held check `%s`" % name), cell(public("the held command `%s`, judged red by dev/%s from its own output%s — the verdict on record: %s" % (held, HOLDER, ": " + said_ if said_ else "", rel), scratch))]
        detail = tick(key)
    return outcome, detail, finding, text


def verdict_on_record(run_dir, round_number, name, attempt):
    """(the path of a held check's verdict on record, the word it says) — None for the word
    where the file is gone, or is not the verdict of that run of that item."""
    parts = ["r%s" % round_number, "checks", "%s.a%d.json" % (name, attempt)]
    path = below(run_dir, parts)
    try:
        text = STAGED[path][1] if path in STAGED else open(path, encoding="utf-8").read()
        kept = json.loads(text)
        word = kept["verdict"] if (kept["item"], kept["attempt"], kept["round"]) == (name, attempt, int(round_number)) and kept["verdict"] in CLAUSE_STATUSES else None
    except (OSError, ValueError, KeyError, TypeError):
        word = None
    return "/".join(ARTIFACTS + (os.path.basename(run_dir),) + tuple(parts)), word


