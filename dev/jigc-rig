gen_state_vendored() {
    cat <<'EOF'

# --- vendored -------------------------------------------------------------------
# A gitignored vendor tree PRESENT ON DISK yet absent from
# `git ls-files --cached --others --exclude-standard` (the ingest funnel's candidate
# walk), beside tracked source that is visible to it. The ignore line is APPENDED so
# whatever setup left survives, and the source is committed — an untracked file would
# also appear in the walk, making the contrast prove nothing.
printf 'node_modules/\n' >> .gitignore
mkdir -p node_modules/left-pad src tests
cat > node_modules/left-pad/index.js <<'JS'
module.exports = function pad() { return ''; };
JS
cat > src/pad.ts <<'TS'
export function pad(s: string): string {
  return s;
}
TS
cat > tests/pad_test.rs <<'RS'
#[test]
fn pads_the_input() {
    assert_eq!(pad("x"), "x");
}
RS
git add .gitignore src/pad.ts tests/pad_test.rs
git commit -q -m 'vendor the runtime, track the source'

# The code-anchored half: `symbol-exists` and `criterion-maps-to-test` are BLOCKING
# at finalize and the doc-code probe ships beside the binary, so these two finalizes
# landing at all is the resolution proof, not a claim about it. The anchors are
# deliberately different checks over different grammars — a TypeScript declaration
# and a Rust `#[test]` fn.
spec=$(mint start --workflow plan 'spec the padding helper')
spec_id=$(cap doc create spec --title Padding --task "$spec")
slot "$spec_id#goal" "$spec" 'A helper that pads a string to a fixed width.'
slot "$spec_id#context" "$spec" 'The vendored runtime shipped its own; the tracked source replaces it.'
criterion=$(item "$spec_id#criteria" 'Pads the input' "$spec")
slot "$criterion/statement" "$spec" 'Padding a string returns it unchanged when it is already wide enough.'
setf "$criterion/maps-to-test" "$spec" 'tests/pad_test.rs#pads_the_input'
finalize "$spec" spec 'spec the padding helper'

arch=$(mint start --workflow architecture-documentation 'document the padding layer')
arch_id=$(cap doc create arch-doc --title 'Padding layer' --task "$arch")
slot "$arch_id#overview" "$arch" 'The padding layer owns string-width normalization for the tracked source.'
# The component title IS the symbol, so `title-names-symbol` holds by construction.
component=$(item "$arch_id#components" pad "$arch")
slot "$component/description" "$arch" 'Pads a string to the requested width.'
setf "$component/implemented-by" "$arch" 'src/pad.ts#pad'
finalize "$arch" arch-doc 'document the padding layer'
EOF
}

# --- the git states ---------------------------------------------------------
# Each mirrors the same-named arm of `drive()` in
# crates/cli/tests/support/git_state.rs: same git commands, same order, same fixture
# paths and commit subjects. That file is the source of truth; if the two ever diverge,
# THIS is what is wrong. Nothing here writes a marker — a fixture that wrote the marker
# itself would prove a door against a state git would never produce.

gen_git_state_helpers() {
    [ -n "$git_state" ] || return 0
    local expect markers head unmerged
    expect=$(git_state_expect "$git_state") || die "no expectation row for git state \`$git_state\`"
    markers=${expect%%|*}
    head=${expect#*|}; head=${head%%|*}
    unmerged=${expect##*|}
    printf '\n# --- the git state under construction, and what it must look like ---------------\n'
    printf 'GIT_STATE=%s\n' "$(sq "$git_state")"
    printf 'GS_WANT_MARKERS=%s\n' "$(sq "$markers")"
    printf 'GS_WANT_HEAD=%s\n' "$(sq "$head")"
    printf 'GS_WANT_UNMERGED=%s\n' "$(sq "$unmerged")"
    cat <<'EOF'
# The universe, not a checklist: gs_assert asserts every member this state does not
# expect is ABSENT, so each discriminating sibling is checked by the complement rather
# than by a hand-written "must not" list that can fall behind a new member.
GS_MARKER_UNIVERSE='MERGE_HEAD MERGE_MSG SQUASH_MSG CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG BISECT_START sequencer sequencer/todo rebase-merge rebase-apply rebase-apply/onto rebase-apply/applying'
GS_BRANCH=

gs_fail() { printf 'jigc-rig: git state `%s`: %s\n' "$GIT_STATE" "$*" >&2; exit 1; }

# The worktree's OWN git dir, absolute — a linked worktree's is
# `.git/worktrees/<name>/`, which is exactly why this asks git rather than joining .git.
gs_git_dir() {
    local d
    d=$(git rev-parse --git-dir)
    case $d in /*) printf '%s' "$d" ;; *) printf '%s/%s' "$PWD" "$d" ;; esac
}

# The arm for the command whose CONFLICT is the fixture. A merge that succeeded would
# leave a clean tree, and the assertion would then look for markers git never wrote —
# so success here is the failure, named at the point it happens. `trap - ERR` because
# the ERR trap is inherited by the substitution and this status is handled out here.
gs_must_conflict() {
    local out status
    out=$(trap - ERR; git "$@" 2>&1) && status=0 || status=$?
    if [ "$status" -eq 0 ]; then
        gs_fail "\`git $*\` SUCCEEDED — the construction must leave the operation un-concluded:
$out"
    fi
}

gs_commit() { git add -- "$1"; git commit -q -m "$2"; }

# Commit the file every conflicting construction fights over, and remember the branch.
gs_seed() {
    GS_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    printf 'alpha\n' > posture-shared.txt
    gs_commit posture-shared.txt 'posture fixture: seed'
}

# A conflicting commit on posture-theirs and a different one on GS_BRANCH, so any of
# merge / rebase / pick / am over the pair conflicts.
gs_diverge() {
    git checkout -q -b posture-theirs
    printf 'theirs\n' > posture-shared.txt
    gs_commit posture-shared.txt 'posture fixture: theirs'
    git checkout -q "$GS_BRANCH"
    printf 'ours\n' > posture-shared.txt
    gs_commit posture-shared.txt 'posture fixture: ours'
}

# The half that makes a built fixture a MEASUREMENT rather than an intention: four
# facts, all read back from git or from the git dir git wrote.
gs_assert() {
    local git_dir marker sym has observed count line
    git_dir=$(gs_git_dir)
    for marker in $GS_WANT_MARKERS; do
        [ -e "$git_dir/$marker" ] || gs_fail "must carry \`$marker\` in $git_dir — git 2.54.0 writes it for this state (M52 deferral (a): another git that does not is the report that deferral waits for)"
    done
    for marker in $GS_MARKER_UNIVERSE; do
        case " $GS_WANT_MARKERS " in *" $marker "*) continue ;; esac
        if [ -e "$git_dir/$marker" ]; then
            gs_fail "must NOT carry \`$marker\`: it is the discriminating sibling of this state's marker set, and a fixture carrying both proves nothing about a door that keys on either"
        fi
    done
    if git symbolic-ref -q HEAD >/dev/null 2>&1; then sym=1; else sym=0; fi
    if git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then has=1; else has=0; fi
    if [ "$sym" = 1 ] && [ "$has" = 1 ]; then observed=attached
    elif [ "$sym" = 0 ] && [ "$has" = 1 ]; then observed=detached
    elif [ "$sym" = 1 ]; then observed=unborn
    else gs_fail 'left HEAD both unresolvable and unborn — git wrote a shape this rig has no name for'
    fi
    [ "$observed" = "$GS_WANT_HEAD" ] || gs_fail "must leave HEAD $GS_WANT_HEAD (observed: $observed)"
    count=0
    while IFS= read -r line; do
        if [ -n "$line" ]; then count=$((count + 1)); fi
    done <<< "$(git ls-files -u)"
    [ "$count" = "$GS_WANT_UNMERGED" ] || gs_fail "must leave $GS_WANT_UNMERGED unmerged index entries (observed: $count)"
    printf 'jigc-rig: git state `%s` built and asserted (markers: %s)\n' \
        "$GIT_STATE" "${GS_WANT_MARKERS:-none}" >&2
}
EOF
}

