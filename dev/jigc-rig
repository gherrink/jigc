#!/usr/bin/env bash
#
# dev/jigc-rig — build a named jigc corpus state, and/or a named un-concluded git
# state, in a throwaway repo, from bash.
#
# The states are the ones `crates/cli/tests/support/trial_corpus.rs` already builds
# for the Rust suites (and, for `--git-state`, the ones
# `crates/cli/tests/support/git_state.rs` builds). Those builders are the source of
# truth and this is a front door onto the same construction — same state names, same verbs, same order — because
# reaching it from a shell otherwise means writing a `#[test]`, registering it in one
# of twelve group roots (`autotests = false`) and running a group target, for a
# thirty-second throwaway probe. A scan of 139 subagent transcripts found 48 agents
# hand-building a rig anyway, 92 running `git init` (331 invocations), and 22 reading
# trial_corpus.rs before hand-rolling its API in bash.
#
# It prints SHELL ASSIGNMENTS to stdout and nothing else, so the caller evals it —
# in TWO steps, never as `eval "$(dev/jigc-rig X)"`:
#
#     rig=$(dev/jigc-rig committed-singletons) || exit; eval "$rig"
#     $JIGC doc show vision --format json
#
# `eval "$(…)"` reports the EVAL's status, not the construction's, so a rig that
# failed to build returns 0 and the caller's probe silently runs against whatever
# corpus the shell was already pointed at — the same "status lost through a shell
# construct" family as `cargo test | tail`, which is the rule this repo's other dev
# tool exists to enforce. The `|| exit` above is the whole fix.
#
# The eval also `cd`s into $REPO and repoints $HOME at $RIG_HOME, so every jigc call
# the caller makes afterwards is as isolated as the construction was. Everything the
# construction says goes to stderr.
#
# THERE IS NO TEARDOWN, AND THAT IS THE DESIGN. Every root comes from `mktemp -d`, a
# path that did not exist a moment ago, so there is nothing to remove. `rm -rf $V/$D`
# is refused by a static scan BEFORE it runs — it prompts a human and parks a
# delegated agent with no transcript — and 71 agents wrote that shape anyway (390
# calls, against 40 uses of the prescribed `mktemp -d`). So this tool has no --clean
# and no --reset: a reset flag is a destructive-command generator with a friendly
# name. `crates/cli/tests/dev_rig_parity.rs` fences all three halves — the corpus-state
# set, the git-state set, and the absence of a recursive removal on a variable path
# anywhere under dev/ or in anything dev/ emits.
#
# Usage:
#   dev/jigc-rig <state> [options]
#   dev/jigc-rig <state> --git-state <member> [options]
#   dev/jigc-rig --git-state <member> [options]   (standalone: no corpus, no `jigc setup`)
#   dev/jigc-rig --list-states | --list-git-states
#
# States (`State::ALL`'s set, plus the one rig-only state named below):
#   bare                  a git repo with one commit and NO `jigc setup` — the only
#                         state from which `setup` itself, the adapter install,
#                         `ingest`, `migrate-corpus` over a never-adopted corpus or
#                         the leftover classifier can be probed. RIG-ONLY: it is
#                         deliberately absent from `State::ALL`, whose consumers all
#                         presuppose a set-up corpus (see dev_rig_parity.rs).
#   fresh                 `jigc setup` only
#   committed-singletons  vision + roadmap (populated milestone) + decisions-log +
#                         changelog (staged group, cut release, nested group)
#   migrated              a foreign doc landed through `migrate … --as vision --approve`
#   refs-post-hoc         committed-singletons + research, then a LIVE task holding a
#                         staged edge on the committed vision ($RIG_TASK)
#   chatty-hooks          a foreign pre-commit hook that prints on success
#   vendored              a gitignored vendor tree beside tracked source, plus a spec
#                         and an arch-doc whose code anchors resolve
#
# Git states (`GitState::ALL`'s set — crates/cli/tests/support/git_state.rs is the
# source of truth here too). Every one is reached by running the command a user runs —
# nothing writes a marker directly — and the construction then reads ITSELF back and
# asserts the markers, HEAD shape and `git ls-files -u` count. Those facts are the
# on-disk contract of git 2.54.0 (Apple Git-157), the git they were proven on; a red
# on another git is the report M52's deferral (a) names its trigger on.
#   merge           a conflicting `git merge`           MERGE_HEAD + MERGE_MSG
#   squash-merge    a CLEAN `git merge --squash`        SQUASH_MSG, and no MERGE_HEAD
#   rebase-merge    a conflicting `git rebase`          rebase-merge/, HEAD detached
#   rebase-apply    a conflicting `git rebase --apply`  rebase-apply/onto, HEAD detached
#   am              a failing `git am`                  rebase-apply/applying, attached
#   cherry-pick     a conflicting one-commit pick       CHERRY_PICK_HEAD + MERGE_MSG
#   sequencer       a conflicting MULTI-commit pick     the same, plus sequencer/todo
#   dangling-sequencer  the same, first pick concluded  sequencer/ ALONE, attached
#   uncommitted-pick    a CLEAN `cherry-pick -n`        MERGE_MSG ALONE, no pick head
#   uncommitted-pick-range  the same over a range       the same, and no sequencer/
#   uncommitted-pick-conflicted  a conflicting `-n` pick  MERGE_MSG ALONE, 3 unmerged
#   uncommitted-pick-resolved    the same, `git add`ed    MERGE_MSG ALONE, 0 unmerged
#   revert          a conflicting `git revert`          REVERT_HEAD + MERGE_MSG
#   unmerged-index  a conflicted `git stash pop`        NO marker at all, 3 unmerged
#   bisect          `git bisect start`                  BISECT_LOG + BISECT_START
#   detached        `git switch --detach`               no operation, HEAD detached
#   unborn          `git init` with no commit           STANDALONE ONLY (below)
#
# A git state is an OVERLAY and is entered LAST — after the corpus state and after
# --start — so it refuses a dirty worktree: `git rebase` will not begin over one and
# `git stash push` would swallow the caller's edits. `unborn` has no overlay form at
# all, because every corpus state runs `jigc setup`, which BIRTHS HEAD on an unborn
# repository (driven: 0 -> 1 commits, exit 0); it is refused there and built by the
# STANDALONE form — `dev/jigc-rig --git-state <member>` with no corpus state — a
# from-scratch repo carrying a hand-made `.jigc/config/` project-layer marker and no
# setup, which is the only shape `unborn` can take. The standalone form accepts the
# pack flags (they shape JIGC_PACK_DIR, not the corpus) and refuses --start, which
# needs a set-up corpus.
#
# Options:
#   --binary <path>       jigc to drive (default <repo>/target/debug/jigc)
#   --pack-from-dev       throwaway copy of the dev pack; its freeze manifest is
#                         DROPPED, so schemas are reshapeable. Exports JIGC_PACK_DIR.
#   --schema <type> <f>   install <f> as the pack's <type>.yaml     (implies a pack copy)
#   --workflow <id> <f>   install <f> as the pack's <id>.yaml       (implies a pack copy)
#                         <type>/<id> name a pack resource, so both must be slugs
#                         (`[a-z0-9][a-z0-9-]*`) and are refused otherwise: the name
#                         is interpolated into a path in the generated script, where
#                         a `/` retargets the write and a quote or `$` would run.
#   --repin               KEEP the freeze manifest and re-pin every drifted schema-hash
#                         after the edits, then assert the pack loads clean
#                         (implies a pack copy)
#   --git-state <member>  drive the repo into the named git state, last of all
#                         (`--list-git-states` prints them all). The member selects a
#                         construction AND is spelled into the generated script, so it
#                         is checked against the closed set before any script text
#                         exists — the same fence `--schema`/`--workflow` carry.
#   --start <wf> <intent> mint a task after the state is built; sets RIG_TASK
#   --print-only          print the construction script instead of running it
#   --keep                print the root and state to stderr so nothing reaps it
#                         (nothing reaps it either way — this only says so out loud)
#
# Env in: SCRATCH if set, else TMPDIR. Either must be ABSOLUTE — a relative root is
#   refused, because with no teardown it plants a corpus under the caller's cwd (the
#   repo, usually) that nothing ever reaps.
# Exit status: 0 iff the whole construction succeeded. Read it: see the two-step eval
#   above.

set -u

# --- where are we -----------------------------------------------------------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
repo_root=$(dirname -- "$script_dir")

die() { printf 'jigc-rig: %s\n' "$*" >&2; exit 2; }

# The root must be ABSOLUTE. A relative `SCRATCH` resolves against the caller's cwd,
# so `SCRATCH=relcheck` from the repo root mints the corpus INSIDE the repo — and
# since there is no teardown by design, nothing ever reaps it. Refused rather than
# silently resolved: a corpus in the tree is the failure, not the spelling.
if [ -n "${SCRATCH:-}" ]; then
    tmp_root=$SCRATCH; tmp_var=SCRATCH
else
    tmp_root=${TMPDIR:-/tmp}; tmp_var=TMPDIR
fi
case "$tmp_root" in
    /*) ;;
    *) die "\$$tmp_var must be an absolute path (got \`$tmp_root\`) — the rig has no teardown, so a relative root plants a corpus under your cwd that nothing reaps" ;;
esac
tmp_root=${tmp_root%/}
[ -n "$tmp_root" ] || tmp_root=/

# --- the state set ----------------------------------------------------------
# One list. `--list-states` prints it, the argument check reads it, and each entry
# dispatches to `gen_state_<name-with-underscores>` — so a state declared without a
# construction path is caught here rather than by a probe that silently builds the
# wrong corpus. `crates/cli/tests/dev_rig_parity.rs` asserts this list and
# `State::ALL` are the same set, up to the rig-only states it declares by name.
#
# `bare` is the one member of this list that `State::ALL` does NOT declare, and that
# asymmetry is stated rather than silent: `dev_rig_parity.rs` carries it as a named
# rig-only allowance with the reason, so a SECOND divergence still reddens the gate.
RIG_STATES=(
    bare
    fresh
    committed-singletons
    migrated
    refs-post-hoc
    chatty-hooks
    vendored
)

state_fn() { printf 'gen_state_%s' "${1//-/_}"; }

# --- the git-state set ------------------------------------------------------
# The second builder's set, mirroring `GitState::ALL` in
# crates/cli/tests/support/git_state.rs. `--list-git-states` prints it after checking
# that every member has BOTH a construction (`gen_git_state_<name>`) and a driven
# expectation row, so a member declared with neither cannot list as buildable; the
# argument check reads the same list, and `dev_rig_parity.rs` asserts it and
# `GitState::ALL` are the same set.
GIT_STATES=(
    merge
    squash-merge
    rebase-merge
    rebase-apply
    am
    cherry-pick
    sequencer
    dangling-sequencer
    uncommitted-pick
    uncommitted-pick-range
    uncommitted-pick-conflicted
    uncommitted-pick-resolved
    revert
    unmerged-index
    bisect
    detached
    unborn
)

git_state_fn() { printf 'gen_git_state_%s' "${1//-/_}"; }

# `<markers>|<head>|<unmerged>` — the driven expectation for each member, mirroring
# `EXPECTATIONS` in crates/cli/tests/support/git_state.rs row for row. The marker list
# is a PRESENCE list; the assertion in the generated script takes its complement over
# the marker universe and asserts absence, which is where each discriminating sibling
# (`rebase-apply/onto` against `applying`, `SQUASH_MSG` against `MERGE_HEAD`,
# `sequencer/` against its absence on the one-commit pick) is actually checked.
git_state_expect() {
    case "$1" in
        merge)          printf 'MERGE_HEAD MERGE_MSG|attached|3' ;;
        squash-merge)   printf 'SQUASH_MSG|attached|0' ;;
        rebase-merge)   printf 'rebase-merge MERGE_MSG|detached|3' ;;
        rebase-apply)   printf 'rebase-apply rebase-apply/onto|detached|3' ;;
        am)             printf 'rebase-apply rebase-apply/applying|attached|0' ;;
        cherry-pick)    printf 'CHERRY_PICK_HEAD MERGE_MSG|attached|3' ;;
        sequencer)      printf 'CHERRY_PICK_HEAD MERGE_MSG sequencer sequencer/todo|attached|3' ;;
        dangling-sequencer) printf 'sequencer sequencer/todo|attached|0' ;;
        # `cherry-pick -n` writes NO CHERRY_PICK_HEAD — MERGE_MSG is the whole of git's
        # record, which the complement over the marker universe is what asserts.
        # AUTO_MERGE is written too and is deliberately outside that universe: a clean
        # `git stash apply` and a concluded rebase leave it as well.
        uncommitted-pick) printf 'MERGE_MSG|attached|0' ;;
        uncommitted-pick-range) printf 'MERGE_MSG|attached|0' ;;
        uncommitted-pick-conflicted) printf 'MERGE_MSG|attached|3' ;;
        uncommitted-pick-resolved) printf 'MERGE_MSG|attached|0' ;;
        revert)         printf 'REVERT_HEAD MERGE_MSG|attached|3' ;;
        unmerged-index) printf '|attached|3' ;;
        bisect)         printf 'BISECT_LOG BISECT_START|attached|0' ;;
        detached)       printf '|detached|0' ;;
        unborn)         printf '|unborn|0' ;;
        *) return 1 ;;
    esac
}

# A pack resource id (`--schema <type>`, `--workflow <id>`) names a FILE inside the
# throwaway pack, so it is interpolated into a path in the generated script. Quoting
# alone is not enough there: `../../../x` needs no metacharacter to write outside the
# pack. Both ids are slugs in every pack this repo ships, so anything else is refused.
is_slug() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

# Single-quote a value for safe inclusion in generated shell.
sq() {
    local s=$1
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

# ============================================================================
# Generation. The construction is ONE script text; running it and printing it are
# two dispositions of the same bytes, so --print-only cannot drift from what the
# rig actually does.
# ============================================================================

gen_header() {
    cat <<EOF
#!/usr/bin/env bash
# Generated by dev/jigc-rig — $rig_label
#
# Construction chatter goes to stderr; the block at the end goes to stdout, which is
# what \`rig=\$(dev/jigc-rig $rig_argv) || exit; eval "\$rig"\` evaluates — two steps, so a
# failed construction is not evaluated as a success. There is no teardown: the root
# is minted by \`mktemp -d\`, so nothing here removes anything.
set -eEu
trap 'code=\$?; printf "jigc-rig: FAILED (exit %s) at line %s\njigc-rig: command: %s\n" "\$code" "\$LINENO" "\$BASH_COMMAND" >&2; exit "\$code"' ERR
EOF
}

gen_preamble() {
    cat <<'EOF'

# --- helpers ----------------------------------------------------------------
# `cap` is the only command runner that hides output, so it is the only one that
# has to hand it back on failure: a rig that half-builds and exits 0 poisons every
# probe downstream. Nothing below reads an exit status through a pipe.
#
# `trap - ERR` inside the substitution because the ERR trap is INHERITED by the
# subshell (`set -eE`) and fires there even though the failure is handled out here.
# The rule, wherever this script probes: a command substitution whose status the
# script itself reads clears the trap, so the only failure report is the handler's.
cap() {
    local out status
    out=$(trap - ERR; "$JIGC" "$@") && status=0 || status=$?
    if [ "$status" -ne 0 ]; then
        printf 'jigc-rig: FAILED (exit %s): jigc %s\n--- stdout ---\n%s\n' \
            "$status" "$*" "$out" >&2
        exit "$status"
    fi
    printf '%s' "$out"
}

# Mint a task and return the id the binary PRINTED — never a reconstruction of the
# slug rule, which is the binary's and would drift silently.
mint() {
    local out line
    out=$(cap "$@")
    while IFS= read -r line; do
        case $line in 'task minted: '*) printf '%s' "${line#task minted: }"; return 0 ;; esac
    done <<< "$out"
    printf 'jigc-rig: no `task minted: <id>` line in:\n%s\n' "$out" >&2
    exit 1
}

# Add one repeatable item and return the address the binary EMITTED.
item() { cap doc add-item "$1" --title "$2" --task "$3"; }

# set-field(address, task, value) / set-slot(address, task, prose) — argument order
# mirrors trial_corpus.rs's `set_field` / `set_slot`.
setf() { "$JIGC" doc set-field "$1" --value "$3" --task "$2"; }
slot() {
    "$JIGC" doc set-slot "$1" --from-file - --task "$2" <<SLOT
$3
SLOT
}

# Author the task's commit doc and finalize. Every fixture commit is a `docs`
# change, so only scope and summary vary; pass `approve` for a destructive land.
finalize() {
    setf "commit:$1#type" "$1" docs
    setf "commit:$1#scope" "$1" "$2"
    slot "commit:$1#summary" "$1" "$3"
    slot "commit:$1#body" "$1" 'Built by the trial-corpus fixture builder.'
    if [ "${4:-}" = approve ]; then
        "$JIGC" task finalize "$1" --approve
    else
        "$JIGC" task finalize "$1"
    fi
}

sq() { local s=$1; s=${s//\'/\'\\\'\'}; printf "'%s'" "$s"; }
emit() { printf 'export %s=%s\n' "$1" "$(sq "$2")"; }
EOF
}

gen_env() {
    printf '\n# --- the root: minted, never reused, so there is nothing to tear down ---\n'
    printf 'JIGC=%s\n' "$(sq "$binary")"
    printf 'RIG=$(mktemp -d %s)\n' "$(sq "$tmp_root/jigc-rig-$rig_slug-XXXXXX")"
    cat <<'EOF'
REPO=$RIG/repo
RIG_HOME=$RIG/home
RIG_TASK=
mkdir -p "$REPO" "$RIG_HOME"
export HOME=$RIG_HOME
EOF
}

gen_pack() {
    if [ "$pack_copy" -eq 0 ]; then
        cat <<'EOF'
# No pack flag: the child composes the EMBEDDED packs. An inherited JIGC_PACK_DIR
# silently swaps the pack under every probe — it corrupted 173 of 211 Rust suites
# before M45 — so it is removed rather than trusted.
unset JIGC_PACK_DIR
EOF
        return
    fi
    printf '\n# --- a throwaway pack copy the caller may reshape ---\n'
    printf 'PACK=$RIG/pack\n'
    printf 'cp -R %s "$PACK"\n' "$(sq "$dev_pack")"
    if [ "$keep_manifest" -eq 1 ]; then
        cat <<'EOF'
# --repin keeps config/schema-manifest.yaml, so the freeze assert stays live and the
# re-pin below is a real assertion rather than a formality.
EOF
    else
        cat <<'EOF'
# Drop the copied freeze manifest: a manifest-less constituent is freeze-exempt, so
# this is a different, UNFROZEN pack rather than a forged v1 dev pack. Single file,
# literal name — never a recursive removal on a variable path.
rm -f -- "$PACK/config/schema-manifest.yaml"
EOF
    fi
    # BOTH interpolations go through `sq`, like every other one in this file. The
    # destination is spelled `"$PACK/schemas/"'<name>'".yaml"` so the expansion stays
    # an expansion while the caller's bytes stay a single-quoted literal — the name
    # is already slug-validated at parse time, and this is the second fence: a name
    # that somehow reached here could still not close the string or start a command.
    local i
    for i in "${!schema_types[@]}"; do
        printf 'cp %s "$PACK/schemas/"%s".yaml"\n' \
            "$(sq "$(abspath "${schema_files[$i]}")")" "$(sq "${schema_types[$i]}")"
    done
    for i in "${!workflow_ids[@]}"; do
        printf 'cp %s "$PACK/workflows/"%s".yaml"\n' \
            "$(sq "$(abspath "${workflow_files[$i]}")")" "$(sq "${workflow_ids[$i]}")"
    done
    printf 'export JIGC_PACK_DIR=$PACK\n'
}

gen_git() {
    cat <<'EOF'

# --- unmanaged repo furniture: a real repo, a per-repo identity, one commit ------
# `-b main` for the same reason as the identity: nothing here may come from ambient
# git config, and `trial_corpus.rs`'s `git_init` — the builder this mirrors — pins it.
cd "$REPO"
git init -q -b main .
git config user.email 'trial@example.com'
git config user.name 'Trial Corpus'
printf 'trial corpus\n' > README.md
git add .
git commit -q -m initial
EOF
    if [ "$state" = bare ]; then
        cat <<'EOF'

# --- state `bare`: `jigc setup` is DELIBERATELY NOT RUN --------------------------
# Everything above is unmanaged furniture, so this repo has no `.jigc/`, no adapter
# files and no jigc pre-commit hook. That is the point: `setup` itself, the adapter
# install, `ingest`, `migrate-corpus` over a never-adopted corpus and the leftover
# classifier are all only reachable from before the front door.
EOF
    else
        cat <<'EOF'

# --- managed state through the binary, never by writing into .jigc/ -------------
"$JIGC" setup
EOF
    fi
}

gen_repin() {
    [ "$repin" -eq 1 ] || return 0
    cat <<'EOF'

# --- --repin: re-pin the drifted schema-hashes the reshaped pack now recomputes --
# The freeze assert names exactly one doctype per pass (the first in sorted order),
# so this is a loop, and it ends by asserting the pack loads CLEAN — the half a
# hand-rolled repin usually skips.
MANIFEST=$PACK/config/schema-manifest.yaml
repin_pass=0
while :; do
    # `trap - ERR`: this is a PROBE whose failure is the loop's normal path, and the
    # inherited ERR trap would otherwise fire inside the substitution and print
    # `jigc-rig: FAILED (exit 1)` in the middle of a re-pin that goes on to succeed.
    if repin_out=$(trap - ERR; "$JIGC" describe 2>&1); then
        printf 'jigc-rig: pack loads clean after %s repin pass(es)\n' "$repin_pass" >&2
        break
    fi
    if [[ $repin_out =~ doctype\ \`([A-Za-z0-9_-]+)\`:\ schema-hash\ mismatch\ \(manifest\ declares\ \`([0-9a-f]+)\`,\ recomputed\ \`([0-9a-f]+)\`\) ]]; then
        printf 'jigc-rig: repin %s: %s -> %s\n' \
            "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" >&2
        repin_tmp=$(mktemp "$RIG/manifest-XXXXXX")
        sed "s/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}/" "$MANIFEST" > "$repin_tmp"
        mv "$repin_tmp" "$MANIFEST"
        repin_pass=$((repin_pass + 1))
        [ "$repin_pass" -le 64 ] || { printf 'jigc-rig: --repin gave up after 64 passes\n' >&2; exit 1; }
    else
        printf 'jigc-rig: --repin: pack-load failed for a reason a re-pin cannot fix:\n%s\n' \
            "$repin_out" >&2
        exit 1
    fi
done
EOF
}

# --- the states -------------------------------------------------------------
# Each mirrors the same-named `build_*` in crates/cli/tests/support/trial_corpus.rs:
# same verbs, same order, same prose. If the two ever diverge, THIS is what is
# wrong — trial_corpus.rs is the source of truth. The exception is `bare`, which has
# no counterpart there on purpose (see RIG_STATES above and dev_rig_parity.rs).

gen_state_bare() { printf '\n# state `bare`: the git furniture above and nothing else.\n'; }

gen_state_fresh() { printf '\n# state `fresh`: setup only.\n'; }

gen_committed_singletons_body() {
    cat <<'EOF'

# --- committed-singletons -------------------------------------------------------
# Each singleton created through its OWN driving workflow and finalized, so all four
# land committed at their placement homes. Two are POPULATED, not merely minted: the
# roadmap milestone is the only multi-slot repeatable either pack ships, and the
# changelog carries the only nested repeatable / id-from enum.
plan=$(mint start --workflow planning 'plan the first wave')
"$JIGC" doc create roadmap --title Roadmap --task "$plan"
milestone=$(item 'roadmap:roadmap#milestones' M-Alpha "$plan")
slot "$milestone/proves" "$plan" 'That the composed loop lands one task end to end.'
slot "$milestone/decomposition" "$plan" 'Increment 1 — the enumeration seam. Increment 2 — the fixture builder.'
"$JIGC" doc create decisions-log --title 'Decisions Log' --task "$plan"
finalize "$plan" planning 'mint the running docs'

vision=$(mint start --workflow form-vision 'form the project vision')
"$JIGC" doc create vision --title Vision --task "$vision"
slot 'vision:vision#thesis' "$vision" 'A deterministic CLI assembles exactly the context a task needs.'
slot 'vision:vision#invariants' "$vision" 'Structure belongs to the CLI; prose belongs to the model.'
slot 'vision:vision#open-questions' "$vision" 'Which domains earn a pack of their own.'
finalize "$vision" vision 'form the project vision'

changes=$(mint start --workflow record-change 'cut the first release')
"$JIGC" doc create changelog --title Changelog --task "$changes"
staged=$(item 'changelog:changelog#unreleased-changes' changed "$changes")
slot "$staged/notes" "$changes" '- the fixture builder gained shape-class coverage'
release=$(item 'changelog:changelog#releases' 1.0.0 "$changes")
setf "$release/link" "$changes" 'https://example.com/compare/0.9.0...1.0.0'
group=$(item "$release/changes" added "$changes")
slot "$group/notes" "$changes" '- the trial-shaped fixture builder'
finalize "$changes" changelog 'cut the first release'
EOF
}

gen_state_committed_singletons() { gen_committed_singletons_body; }

gen_state_migrated() {
    cat <<'EOF'

# --- migrated -------------------------------------------------------------------
# The foreign document is unmanaged furniture: written directly and committed BEFORE
# the migration, so its retirement is a real deletion rather than an untracked-file
# removal. Deliberately non-conformant, so `migrate` has real prose to route.
mkdir -p docs
cat > docs/direction.md <<'FOREIGN'
# Product Direction

We build a deterministic context compiler.

## Principles

Structure belongs to the CLI; prose belongs to the model.
FOREIGN
git add docs/direction.md
