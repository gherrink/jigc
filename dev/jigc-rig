gen_git_state_sequencer() {
    cat <<'EOF'
gs_seed
git checkout -q -b posture-theirs
printf 'theirs\n' > posture-shared.txt
gs_commit posture-shared.txt 'posture fixture: theirs one'
printf 'second\n' > posture-second.txt
gs_commit posture-second.txt 'posture fixture: theirs two'
git checkout -q "$GS_BRANCH"
printf 'ours\n' > posture-shared.txt
gs_commit posture-shared.txt 'posture fixture: ours'
# Two picks, the FIRST of which conflicts — so the second stays queued in
# `sequencer/todo` rather than being replayed, which is the whole point of the member.
gs_must_conflict cherry-pick 'posture-theirs~1' posture-theirs
EOF
}

# The same queue with its FIRST pick concluded by hand: git consumes CHERRY_PICK_HEAD
# and MERGE_MSG with that commit and leaves `sequencer/` holding the pick it never ran.
# It is the state jigc's own exit-0 `task finalize` produced at the M52 baseline (§2.7 /
# L5), and the only one in which `InProgress::Sequencer` is the operation rather than a
# property of a live pick or revert.
gen_git_state_dangling_sequencer() {
    gen_git_state_sequencer
    cat <<'EOF'
printf 'resolved\n' > posture-shared.txt
gs_commit posture-shared.txt 'posture fixture: the pick, concluded by hand'
EOF
}

# The four uncommitted-pick cells. `cherry-pick --no-commit` writes no
# CHERRY_PICK_HEAD, so every marker-keyed member of the posture family misses the
# state and MERGE_MSG is all that says the pick is un-concluded.
gen_git_state_uncommitted_pick() {
    cat <<'EOF'
gs_seed
git checkout -q -b posture-clean
printf 'other\n' > posture-other.txt
gs_commit posture-other.txt 'posture fixture: the picked commit'
git checkout -q "$GS_BRANCH"
# Clean by construction: the picked commit touches a file nothing here has.
git cherry-pick -n posture-clean
EOF
}

gen_git_state_uncommitted_pick_range() {
    cat <<'EOF'
gs_seed
git checkout -q -b posture-clean
printf 'other\n' > posture-other.txt
gs_commit posture-other.txt 'posture fixture: the first picked commit'
printf 'second\n' > posture-second.txt
gs_commit posture-second.txt 'posture fixture: the second picked commit'
git checkout -q "$GS_BRANCH"
# Two commits in one pick — and, driven, NO sequencer/: a range is applied in one go
# rather than queued, so nothing on disk distinguishes this from the cell above.
git cherry-pick -n "$GS_BRANCH..posture-clean"
EOF
}

gen_git_state_uncommitted_pick_conflicted() {
    cat <<'EOF'
gs_seed
gs_diverge
gs_must_conflict cherry-pick -n posture-theirs
EOF
}

# The same conflicting pick after the user staged their resolution and stopped: git
# clears the index and leaves MERGE_MSG, so that file alone says the pick is live.
gen_git_state_uncommitted_pick_resolved() {
    gen_git_state_uncommitted_pick_conflicted
    cat <<'EOF'
printf 'resolved\n' > posture-shared.txt
git add -- posture-shared.txt
EOF
}

