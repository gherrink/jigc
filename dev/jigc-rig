gen_git_state_unborn() {
    cat <<'EOF'
# git state `unborn`: there is no construction — it IS the absence of one. The
# standalone repo above committed nothing, so HEAD points at a branch that does not
# exist. It has no overlay form: `jigc setup` births HEAD, and deleting that commit
# afterwards would not make HEAD unborn again.
EOF
}

# The standalone form's repo furniture, mirroring `GitStateRepo::build`: a real repo
# with a per-repo identity and a HAND-MADE `.jigc/config/` project-layer marker,
# because that directory's existence is the whole of what `cli::locate` reads as the
# project cascade layer — and obtaining it by running `jigc setup` would COMMIT, which
# is exactly what `unborn` cannot survive. A door that needs a real workbench takes the
# overlay form (`<state> --git-state <member>`).
gen_standalone_repo() {
    cat <<'EOF'

# --- a from-scratch repo, deliberately NOT set up (the standalone git-state form) ---
# `-b main`, as in `git_state.rs`'s `GitStateRepo::build`: `unborn` is defined by the
# branch HEAD points at not existing, so that name must not vary by machine.
cd "$REPO"
git init -q -b main .
git config user.email 'posture@example.com'
git config user.name 'Posture Fixture'
mkdir -p .jigc/config
EOF
    if [ "$git_state" != unborn ]; then
        cat <<'EOF'
printf 'git-state fixture\n' > README.md
gs_commit README.md initial
EOF
    fi
}

gen_git_state() {
    [ -n "$git_state" ] || return 0
    printf '\n# --- the git state: entered LAST, after the corpus state and any --start ---------\n'
    if [ -n "$state" ]; then
        cat <<'EOF'
# A git state is an OVERLAY, and it refuses a dirty worktree rather than asking to be
# entered last: `git rebase` will not begin over one and `git stash push` would swallow
# the caller's edits. Increment 3 makes every acting door refuse under these postures,
# so a construction that ran a jigc door afterwards would be building against a door
# that has stopped answering.
cd "$REPO"
gs_dirty=$(git status --porcelain)
if [ -n "$gs_dirty" ]; then
    gs_fail "refusing to overlay on a DIRTY worktree; outstanding:
$gs_dirty"
fi
EOF
    fi
    "$(git_state_fn "$git_state")"
    printf 'gs_assert\n'
}

gen_start() {
    [ -n "$start_workflow" ] || return 0
    printf '\n# --- --start: mint a task over the built state ---\n'
    printf 'RIG_TASK=$(mint start --workflow %s %s)\n' \
        "$(sq "$start_workflow")" "$(sq "$start_intent")"
}

gen_exports() {
    cat <<'EOF'

# --- what the caller evaluates --------------------------------------------------
emit RIG "$RIG"
emit REPO "$REPO"
emit RIG_HOME "$RIG_HOME"
emit JIGC "$JIGC"
emit RIG_TASK "$RIG_TASK"
emit HOME "$RIG_HOME"
EOF
    if [ "$pack_copy" -eq 1 ]; then
        printf 'emit JIGC_PACK_DIR "$PACK"\n'
    else
        printf "printf 'unset JIGC_PACK_DIR\\\\n'\n"
    fi
    cat <<'EOF'
printf 'cd %s\n' "$(sq "$REPO")"
printf 'jigc-rig: %s\n' "$RIG" >&2
EOF
}

# ============================================================================
# Assemble, then either print it or run it.
# ============================================================================

# --- arguments --------------------------------------------------------------
state=""
binary=""
pack_copy=0
keep_manifest=0
repin=0
print_only=0
keep=0
start_workflow=""
start_intent=""
git_state=""
schema_types=()
schema_files=()
workflow_ids=()
workflow_files=()

while [ $# -gt 0 ]; do
    case "$1" in
        --list-states)
            for s in "${RIG_STATES[@]}"; do
                fn=$(state_fn "$s")
                declare -F "$fn" >/dev/null 2>&1 || die "state \`$s\` is listed but has no \`$fn\` builder"
                printf '%s\n' "$s"
            done
            exit 0
            ;;
        --list-git-states)
            for s in "${GIT_STATES[@]}"; do
                fn=$(git_state_fn "$s")
                declare -F "$fn" >/dev/null 2>&1 || die "git state \`$s\` is listed but has no \`$fn\` construction"
                git_state_expect "$s" >/dev/null || die "git state \`$s\` is listed but carries no driven expectation row"
                printf '%s\n' "$s"
            done
            exit 0
            ;;
        # The help text is this file's own leading comment block, read to its end
        # rather than to a hard-coded line number that silently truncates on an edit.
        -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
        --binary) [ $# -ge 2 ] || die "--binary needs a path"; binary=$2; shift 2 ;;
        --pack-from-dev) pack_copy=1; shift ;;
        --repin) pack_copy=1; keep_manifest=1; repin=1; shift ;;
        --schema)
            [ $# -ge 3 ] || die "--schema needs <doctype> <file>"
            is_slug "$2" || die "--schema doctype must be a slug matching [a-z0-9][a-z0-9-]* (got \`$2\`) — it names a file inside the throwaway pack"
            pack_copy=1; schema_types+=("$2"); schema_files+=("$3"); shift 3 ;;
        --workflow)
            [ $# -ge 3 ] || die "--workflow needs <id> <file>"
            is_slug "$2" || die "--workflow id must be a slug matching [a-z0-9][a-z0-9-]* (got \`$2\`) — it names a file inside the throwaway pack"
            pack_copy=1; workflow_ids+=("$2"); workflow_files+=("$3"); shift 3 ;;
        --git-state)
            # Checked against the CLOSED SET here, before any script text exists: the
            # member selects a construction and is spelled into the generated script,
            # which is the same seam `--schema`/`--workflow` are slug-checked for.
            [ $# -ge 2 ] || die "--git-state needs <member>; one of: ${GIT_STATES[*]} (or --list-git-states)"
            known_git_state=0
            for s in "${GIT_STATES[@]}"; do [ "$s" = "$2" ] && known_git_state=1; done
            [ "$known_git_state" -eq 1 ] || die "unknown git state \`$2\`; one of: ${GIT_STATES[*]}"
            git_state=$2; shift 2 ;;
        --start)
            [ $# -ge 3 ] || die "--start needs <workflow> <intent>"
            start_workflow=$2; start_intent=$3; shift 3 ;;
        --print-only) print_only=1; shift ;;
        --keep) keep=1; shift ;;
        --) shift ;;
        -*) die "unknown option: $1 (try --help)" ;;
        *)
            [ -z "$state" ] || die "one state at a time; got \`$state\` and \`$1\`"
            state=$1; shift ;;
    esac
done

if [ -z "$state" ] && [ -z "$git_state" ]; then
    die "which state? one of: ${RIG_STATES[*]} (or --list-states) — or a standalone git state: --git-state <member> (--list-git-states)"
fi

if [ -n "$state" ]; then
    known=0
    for s in "${RIG_STATES[@]}"; do [ "$s" = "$state" ] && known=1; done
    [ "$known" -eq 1 ] || die "unknown state \`$state\`; one of: ${RIG_STATES[*]}"
    # `unborn` is REFUSED over a corpus state rather than silently built as something
    # else — the same refusal `GitState::overlay_refusal` carries on the Rust side.
    if [ "$git_state" = unborn ]; then
        die "git state \`unborn\` cannot be overlaid on corpus state \`$state\`: every corpus state runs \`jigc setup\`, which BIRTHS HEAD on an unborn repository (driven: 0 -> 1 commits, exit 0), and deleting that commit afterwards would not make HEAD unborn again. Build it standalone: \`dev/jigc-rig --git-state unborn\`"
    fi
elif [ -n "$start_workflow" ]; then
    # The standalone form has no corpus and no `jigc setup`, so there is nothing for a
    # task to be minted against. Refused rather than attempted: a failed `jigc start`
    # deep inside the construction reads as a jigc defect, not as a rig misuse.
    die "--start needs a set-up corpus, and the standalone \`--git-state $git_state\` form deliberately runs no \`jigc setup\` — name a corpus state (one of: ${RIG_STATES[*]}) to combine the two"
fi

# --- how this invocation names itself ---------------------------------------
# One label, one root slug and one paste-runnable argv hint, so the generated header,
# the mktemp template and --keep cannot describe the invocation three different ways.
if [ -n "$state" ] && [ -n "$git_state" ]; then
    rig_label="corpus state: $state, git state: $git_state"
elif [ -n "$state" ]; then
    rig_label="corpus state: $state"
else
    rig_label="git state: $git_state (standalone — no corpus, no \`jigc setup\`)"
fi
rig_slug=${state:-standalone}
rig_argv=$state
if [ -n "$git_state" ]; then
    rig_slug=$rig_slug-$git_state
    if [ -n "$rig_argv" ]; then rig_argv="$rig_argv --git-state $git_state"; else rig_argv="--git-state $git_state"; fi
fi

# --- the binary -------------------------------------------------------------
[ -n "$binary" ] || binary=$repo_root/target/debug/jigc
case "$binary" in
    /*) ;;
    *) binary=$(CDPATH= cd -- "$(dirname -- "$binary")" 2>/dev/null && pwd -P)/$(basename -- "$binary") || die "cannot resolve --binary path" ;;
esac
# `-f` before `-x`: a DIRECTORY is executable, so `-x` alone accepts `--binary /usr/bin`
# and reads as a validation it is not — the construction then dies far downstream.
[ -f "$binary" ] || die "no jigc binary at $binary — run \`cargo build\` (or pass --binary <path>)"
[ -x "$binary" ] || die "not executable: $binary"

# --- validate the pack inputs before anything is built ----------------------
dev_pack=$repo_root/crates/cli/pack
if [ "$pack_copy" -eq 1 ]; then
    [ -d "$dev_pack" ] || die "no dev pack at $dev_pack"
fi
for f in ${schema_files[@]+"${schema_files[@]}"} ${workflow_files[@]+"${workflow_files[@]}"}; do
    [ -f "$f" ] || die "no such file: $f"
done

abspath() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *) printf '%s/%s' "$(CDPATH= cd -- "$(dirname -- "$1")" && pwd -P)" "$(basename -- "$1")" ;;
    esac
}

# The construction runs with stdout folded onto stderr so that ONLY the final export
# block reaches the caller's `eval`. It is a brace group rather than `exec 3>&1 1>&2`
# so the printed script stays paste-runnable without permanently redirecting an
# interactive shell.
emit_script() {
    gen_header
    gen_preamble
    gen_git_state_helpers
    printf '\n{\n'
    gen_env
    gen_pack
    if [ -n "$state" ]; then
        gen_git
        gen_repin
        "$(state_fn "$state")"
        gen_start
    else
        gen_standalone_repo
    fi
    gen_git_state
    printf '\n} 1>&2\n'
    gen_exports
}

script_text=$(emit_script) || exit 2

if [ "$print_only" -eq 1 ]; then
    printf '%s\n' "$script_text"
    exit 0
fi

script_file=$(mktemp "$tmp_root/jigc-rig-script-XXXXXX") || die "cannot mint a script file"
printf '%s\n' "$script_text" > "$script_file"

if [ "$keep" -eq 1 ]; then
    printf 'jigc-rig: %s — the root below is never reaped (there is no teardown)\n' "$rig_label" >&2
    printf 'jigc-rig: construction script: %s\n' "$script_file" >&2
fi

bash "$script_file"
exit $?
