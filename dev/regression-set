def one_line(text):
    return " ".join(str(text).split())


# --- git ------------------------------------------------------------------------


def git(*args):
    try:
        return subprocess.run(
            ["git", "-C", ROOT, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
    except FileNotFoundError:
        raise Void("did-not-run", "git is not on PATH")


def commit_of(sha, what):
    if not FULL_SHA.fullmatch(sha):
        refuse("commit", "%s `%s` is not a full commit sha" % (what, sha))
    found = git("rev-parse", "--verify", "--quiet", sha + "^{commit}")
    if found.returncode != 0 or found.stdout.decode().strip() != sha:
        refuse("commit", "%s `%s` is not a commit this repository holds" % (what, sha))
    return sha


def two_commits(previous, candidate, whose=("the previous release's commit",
                                            "the candidate's commit")):
    """The two commits a check compares, each resolved — and two."""
    previous = commit_of(previous, whose[0])
    candidate = commit_of(candidate, whose[1])
    if previous == candidate:
        refuse("commit", "the candidate's commit is the previous release's, `%s`: two builds"
               " of one commit can differ in their bytes, so no hash would tell, and a commit"
               " checked against itself establishes nothing" % candidate)
    return previous, candidate


def holds(descendant, ancestor, where):
    """Whether `descendant` holds the commit `ancestor`."""
    asked = git("merge-base", "--is-ancestor", ancestor, descendant)
    if asked.returncode not in (0, 1):
        refuse("list", "%s: git could not say whether `%s` holds `%s`: %s"
               % (where, descendant, ancestor, one_line(asked.stderr.decode(errors="replace"))))
    return asked.returncode == 0


# --- the list of intended changes -----------------------------------------------


def resolve(pointer, where, previous, candidate, test):
    kind, _, rest = pointer.partition(":")
    if kind == "commit":
        if not FULL_SHA.fullmatch(rest):
            refuse("list", "%s: a commit pointer is `commit:` and a full sha, not `%s`"
                   % (where, pointer))
        found = git("rev-parse", "--verify", "--quiet", rest + "^{commit}")
        if found.returncode != 0 or found.stdout.decode().strip() != rest:
            refuse("list", "%s points at nothing: `%s` is no commit of this repository"
                   % (where, rest))
        if not holds(candidate, rest, where):
            refuse("list", "%s points at nothing: the candidate does not hold the commit `%s`"
                   % (where, rest))
        if holds(previous, rest, where):
            refuse("list", "%s points at nothing: the previous release holds the commit `%s`"
                   " already, so it changed nothing since" % (where, rest))
        return
    if kind == "ruling":
        path, mark, heading = rest.partition("#")
        segments = path.split("/")
        if not mark or not heading or not all(SEGMENT.fullmatch(s) for s in segments):
            refuse("list", "%s: a ruling pointer is `ruling:<path in the repository>#<the"
                   " opening words of a heading>`, not `%s`" % (where, pointer))
        shown = git("show", "%s:%s" % (candidate, path))
        if shown.returncode != 0:
            refuse("list", "%s points at nothing: the candidate has no file `%s`" % (where, path))
        opened = 0
        for line in shown.stdout.decode("utf-8", errors="replace").split("\n"):
            found = HEADING.fullmatch(line)
            if found and found.group(1).startswith(heading):
                opened += 1
        if opened != 1:
            refuse("list", "%s points at %s: %d headings of `%s` open with `%s`, where it"
                   " names exactly one" % (where, "nothing" if opened == 0 else "more than one",
                                           opened, path, heading))
        return
    if kind == EXCLUDED:
        if not all(SEGMENT.fullmatch(segment) for segment in rest.split("/")):
            refuse("list", "%s: an exclusion pointer is `excluded:<path in the repository>`,"
                   " not `%s`" % (where, pointer))
        held = git("cat-file", "blob", "%s:%s" % (candidate, rest))
        if held.returncode != 0:
            refuse("list", "%s points at nothing: the candidate has no file `%s`" % (where, rest))
        try:
            record = json.loads(held.stdout.decode("utf-8"))
            if not isinstance(record, dict) or record.get("tool") != PROG:
                raise ValueError("it does not say `tool: %s`" % PROG)
            against = record["previous"]["commit"]
            failed = [(entry["binary"], entry["test"])
                      for field in ("excluded", "excluded_by_no_row")
                      for entry in record.get(field, [])]
        except (ValueError, KeyError, TypeError) as error:
            refuse("list", "%s points at nothing: `%s` is not the line of a run of this tool:"
                   " %s" % (where, rest, one_line(error)))
        if against != previous:
            refuse("list", "%s points at nothing: `%s` is the line of a run against `%s`, not"
                   " against the previous release" % (where, rest, against))
        if test not in failed:
            refuse("list", "%s points at nothing: `%s` does not name `%s` `%s` among the tests"
                   " that failed on their own binary" % ((where, rest) + test))
        return
    refuse("list", "%s: a pointer is `commit:<sha>`, `ruling:<path>#<heading>` or"
           " `excluded:<path>`, not `%s`" % (where, pointer))


def excludes(row):
    """Whether `row` is an exclusion row: the kind of its pointer says so."""
    return row["pointer"].partition(":")[0] == EXCLUDED


def read_list(path, previous, candidate):
    """The list at `path` in the candidate's commit — never the working tree's file."""
    if not all(SEGMENT.fullmatch(segment) for segment in path.split("/")):
        refuse("list", "the list is named by its path in the repository, as the candidate's"
               " commit holds it — not `%s`: it is read out of that commit, never from a"
               " file" % path)
    held = git("cat-file", "blob", "%s:%s" % (candidate, path))
    if held.returncode != 0:
        refuse("list", "the candidate's commit holds no file `%s`: the list is read out of"
               " the commit `%s`, never from the working tree" % (path, candidate))
    raw = held.stdout
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        refuse("list", "the list `%s` is not UTF-8" % path)
    rows = []
    lines = {}
    for number, line in enumerate(text.split("\n"), 1):
        if line == "" or line.startswith("#"):
            continue
        where = "line %d" % number
        fields = line.split("\t")
        if len(fields) != len(FIELDS):
            refuse("list", "%s has %d fields, where a row has four — binary, test, what"
                   " changed, pointer — with one tab between each" % (where, len(fields)))
        for name, value in zip(FIELDS, fields):
            if value == "" or value != value.strip():
                refuse("list", "%s: `%s` is empty or has space around it" % (where, name))
        row = dict(zip(FIELDS, fields))
        key = (row["binary"], row["test"])
        if key in lines:
            refuse("list", "%s lists a test that line %d lists already: `%s` `%s`"
                   % (where, lines[key], key[0], key[1]))
        lines[key] = number
        resolve(row["pointer"], where, previous, candidate, key)
        rows.append(row)
    return {"path": path, "commit": candidate, "sha256": hashlib.sha256(raw).hexdigest(),
            "rows": rows}


# --- the evidence, and the verdict over it ---------------------------------------


def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fact(facts, *keys, kind=str):
    at = facts
    for key in keys:
        at = at.get(key) if isinstance(at, dict) else None
    if not isinstance(at, kind) or isinstance(at, bool):
        raise Void("evidence", "`run.json` has no `%s`" % ".".join(keys))
    return at


def outcomes(path):
    """A report of the runner's, as {(binary, test): pass | flaky | fail}."""
    results = {}
    for suite in ElementTree.parse(path).getroot().iter("testsuite"):
        for case in suite.iter("testcase"):
            key = (suite.get("name"), case.get("name"))
            if None in key:
                raise ValueError("a test without a name")
            if key in results:
                raise ValueError("`%s` `%s` is reported twice" % key)
            children = {child.tag for child in case}
            failed = children & {"failure", "error"}
            again = children & {"flakyFailure", "flakyError", "rerunFailure", "rerunError"}
            results[key] = "fail" if failed else "flaky" if again else "pass"
    return results


def report(evidence, name, reason):
    path = os.path.join(evidence, name)
    try:
        return outcomes(path)
    except (OSError, ValueError, ElementTree.ParseError) as error:
        raise Void(reason, "no readable report `%s`: %s" % (name, one_line(error)))


def hold_list(facts, the_list):
    """The verdict is asked over the list the run read: the same bytes, by their hash."""
    path, sha256 = fact(facts, "list", "path"), fact(facts, "list", "sha256")
    if sha256 != the_list["sha256"]:
        raise Void("evidence", "the run read the list `%s` (sha256 %s), and the verdict is"
                   " asked over `%s` (sha256 %s): a verdict is given over the list its run"
                   " read" % (path, sha256, the_list["path"], the_list["sha256"]))


def hold_path(facts):
    """The path is one the tests name."""
    if fact(facts, "named_by", kind=int) < 1:
        raise Void("swap", "no test binary of the recorded build names the path `%s`: a"
                   " binary put there reaches no test" % fact(facts, "baked_path"))


def hold_binaries(facts):
    """The two binaries are two."""
    if fact(facts, "previous", "sha256") == fact(facts, "candidate", "sha256"):
        raise Void("swap", "the candidate's binary is byte for byte the previous release's"
                   " (sha256 %s): no hash can say which of the two a run drove"
                   % fact(facts, "candidate", "sha256"))


def hold_baseline(facts, evidence):
    """The baseline ran on the previous release's binary and can be compared against."""
    previous = fact(facts, "previous", "sha256")
    for moment in ("baseline_before", "baseline_after"):
        found = fact(facts, "at_baked_path", moment)
        if found != previous:
            raise Void("baseline", "the file at the path was not the previous release's binary"
                       " %s the baseline: sha256 %s, where that binary's is %s"
                       % (moment.split("_")[1], found, previous))
    baseline = report(evidence, "baseline-junit.xml", "baseline")
    if not baseline:
        raise Void("baseline", "the baseline ran no test")
    return baseline


def hold_swap(facts, moments=("candidate_before", "candidate_after")):
    """The file at the path was the candidate's binary at each of `moments`."""
    candidate = fact(facts, "candidate", "sha256")
    for moment in moments:
        found = fact(facts, "at_baked_path", moment)
        if found != candidate:
            what = ("the previous release's binary, put back"
                    if found == fact(facts, "previous", "sha256") else "another file")
            raise Void("swap", "the swap did not hold: %s the run the file at the path was %s"
                       " — sha256 %s, where the candidate's is %s"
                       % (moment.split("_")[1], what, found, candidate))


def named(keys):
    return [{"binary": binary, "test": test} for binary, test in sorted(keys)]


def judge(evidence, the_list):
    """The line a run ends with: the verdict over `evidence` against `the_list`."""
    line = {"tool": PROG, "status": None, "reason": None, "detail": None}
    line["list"] = dict(the_list, rows=len(the_list["rows"]))
    try:
        try:
            facts = json.load(open(os.path.join(evidence, "run.json"), encoding="utf-8"))
        except (OSError, ValueError) as error:
            raise Void("evidence", "no readable `run.json`: %s" % one_line(error))
        if not isinstance(facts, dict):
            raise Void("evidence", "`run.json` is not an object")
        for key in ("previous", "candidate", "seconds", "baseline"):
            if isinstance(facts.get(key), dict):
                line[key] = facts[key]
        if facts.get("baked_path") is not None:
            hashes = facts.get("at_baked_path")
            line["proof"] = dict(
                {"baked_path": facts["baked_path"], "named_by": facts.get("named_by")},
                **(hashes if isinstance(hashes, dict) else {})
            )
        if facts.get("failed") is not None:
            raise Void(fact(facts, "failed", "reason"), fact(facts, "failed", "detail"))
        hold_list(facts, the_list)
        hold_path(facts)
        hold_binaries(facts)
        baseline = hold_baseline(facts, evidence)
        hold_swap(facts)
        candidate = report(evidence, "candidate-junit.xml", "incomplete")
        if set(candidate) != set(baseline):
            only = sorted(set(baseline) ^ set(candidate))
            raise Void("incomplete", "the two runs did not run the same tests: %d are in one"
                       " report only, `%s` `%s` among them" % (len(only), only[0][0], only[0][1]))
    except Void as void:
        if void.reason not in VOIDS:
            void = Void("evidence", "`run.json` records a failure of no known kind: `%s`"
                        % one_line(void.reason))
        line.update(status="void", reason=void.reason, detail=one_line(void.detail))
        line["evidence"] = evidence
        return line

    failed = {key for key, outcome in baseline.items() if outcome == "fail"}
    differences = {key for key in baseline if key not in failed and candidate[key] == "fail"}
    rows = {(row["binary"], row["test"]): row for row in the_list["rows"]}
    exclusions = {key for key, row in rows.items() if excludes(row)}
    changes = set(rows) - exclusions
    stale = []
    for key, row in sorted(rows.items()):
        if key in (failed if key in exclusions else differences):
            continue
        why = (
            "no-such-test" if key not in baseline
            else "passed-on-its-own-binary" if key in exclusions
            else "failed-on-its-own-binary" if key in failed
            else "passed-on-the-candidate"
        )
        stale.append({"binary": key[0], "test": key[1], "pointer": row["pointer"], "why": why})
    unlisted = differences - changes
    unnamed = failed - exclusions
    line["excluded_by_no_row"] = named(unnamed)
    if unnamed and not unlisted:
        # Nothing is red, and a test is out of the comparison that no row says may be.
        line.update(status="void", reason="baseline", detail=(
            "%d of the %d tests failed on their own binary and no exclusion row of the list"
            " names them, `%s` `%s` among them: a test drops out of the comparison only by a"
            " row that says why" % ((len(unnamed), len(baseline)) + min(unnamed))))
        line["evidence"] = evidence
        return line
    line["status"] = "red" if unlisted else "green"
    line["counts"] = {
        "tests": len(baseline),
        "baseline_passed": len(baseline) - len(failed),
        "baseline_failed": len(failed),
        "candidate_passed": sum(1 for outcome in candidate.values() if outcome != "fail"),
        "candidate_failed": sum(1 for outcome in candidate.values() if outcome == "fail"),
        "differences": len(differences),
        "on_list": len(differences) - len(unlisted),
        "not_on_list": len(unlisted),
        "excluded": len(failed) - len(unnamed),
        "excluded_by_no_row": len(unnamed),
        "stale": len(stale),
        "fixed": sum(1 for key in failed if candidate[key] != "fail"),
    }
    line["not_on_list"] = named(unlisted)
    line["on_list"] = [rows[key] for key in sorted(differences & changes)]
    line["excluded"] = [rows[key] for key in sorted(failed & exclusions)]
    line["stale"] = stale
    line["flaky"] = {
        "baseline": named(key for key, outcome in baseline.items() if outcome == "flaky"),
        "candidate": named(key for key, outcome in candidate.items() if outcome == "flaky"),
    }
    line["evidence"] = evidence
    return line


# --- the run -------------------------------------------------------------------------


def build_environment():
    """The environment of every cargo command: on macOS the real git first on PATH and
    SDKROOT named, as dev/gate has it — the tests drive git by the hundred thousand, and
    `/usr/bin/git` is a trampoline."""
    env = dict(os.environ)
    if sys.platform == "darwin" and shutil.which("git") == "/usr/bin/git":
        real = subprocess.run(["xcrun", "--find", "git"], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL).stdout.decode().strip()
        if real and os.access(real, os.X_OK):
            env["PATH"] = os.path.dirname(real) + os.pathsep + env.get("PATH", "")
            if not env.get("SDKROOT"):
                sdk = subprocess.run(["xcrun", "--show-sdk-path"], stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL).stdout.decode().strip()
                if sdk:
                    env["SDKROOT"] = sdk
    return env


class Run:
    """One run's directory, its facts as `run.json` holds them, and its commands."""

    def __init__(self, work, previous, candidate, the_list):
        self.work = work
        self.evidence = os.path.join(work, "evidence")
        os.mkdir(self.evidence)
        self.env = build_environment()
        self.facts = {
            "previous": {"commit": previous},
            "candidate": {"commit": candidate},
            "list": {"path": the_list["path"], "sha256": the_list["sha256"]},
            "at_baked_path": {},
            "exits": {},
            "seconds": {},
            "failed": None,
        }
        self.save()

    def path(self, *parts):
        return os.path.join(self.work, *parts)

    def save(self):
        staged = os.path.join(self.evidence, "run.json.new")
        with open(staged, "w", encoding="utf-8") as handle:
            json.dump(self.facts, handle, indent=1, sort_keys=True)
            handle.write("\n")
        os.replace(staged, os.path.join(self.evidence, "run.json"))

    def command(self, step, log, argv, cwd, target=None, stdout=None):
        """One command, timed under `step`, its output in the evidence's `log`; its exit
        status."""
        env = dict(self.env)
        if target is not None:
            env["CARGO_TARGET_DIR"] = target
        began = time.time()
        with open(os.path.join(self.evidence, log), "ab") as said:
            said.write(("$ %s\n" % " ".join(argv)).encode())
            said.flush()
            if stdout is None:
                status = subprocess.run(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                        stdout=said, stderr=subprocess.STDOUT).returncode
            else:
                with open(stdout, "wb") as out:
                    status = subprocess.run(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                            stdout=out, stderr=said).returncode
        self.facts["seconds"][step] = self.facts["seconds"].get(step, 0) + round(
            time.time() - began)
        self.save()
        return status

    def timed(self, step, did, *args):
        """What `did` returns, its seconds under `step`."""
        began = time.time()
        try:
            return did(*args)
        finally:
            self.facts["seconds"][step] = self.facts["seconds"].get(step, 0) + round(
                time.time() - began)
            self.save()

    def must(self, reason, step, log, argv, cwd, **how):
        status = self.command(step, log, argv, cwd, **how)
        if status != 0:
            raise Void(reason, "`%s` exited %d — its output is `%s` of the evidence"
                       % (" ".join(argv[:4]), status, log))

    def unpack(self, reason, commit, name, home=None):
        """The tree of `commit`, from `git archive`, as the directory `name` — of the
        run's own directory, or of `home`."""
        tree = os.path.join(home or self.work, name)
        os.makedirs(tree)
        tar = self.path(name + ".tar")
        log = "build-%s.log" % name
        self.must(reason, "unpack-" + name, log,
                  ["git", "-C", ROOT, "archive", "--format=tar", "-o", tar, commit], self.work)
        self.must(reason, "unpack-" + name, log, ["tar", "-xf", tar, "-C", tree], self.work)
        os.remove(tar)
        return tree

    def suite(self, which, tree):
        """The recorded test binaries, run on whatever is at the path: the reuse-build
        path, which starts no compiler and copies no file."""
        profile = "regression-" + which
        self.facts["exits"][which] = self.command(
            which, which + ".log",
            ["cargo", "nextest", "run", "--no-fail-fast", "--retries", "1",
             "--binaries-metadata", os.path.join(self.evidence, "binaries-metadata.json"),
             "--cargo-metadata", os.path.join(self.evidence, "cargo-metadata.json"),
             "--tool-config-file", "%s:%s" % (PROG, os.path.join(self.evidence, "nextest.toml")),
             "--profile", profile],
            tree)
        junit = self.path("nextest-store", profile, "junit.xml")
        if os.path.isfile(junit):
            shutil.copyfile(junit, os.path.join(self.evidence, which + "-junit.xml"))

    def hashed(self, moment):
        self.facts["at_baked_path"][moment] = sha256_of(self.facts["baked_path"])
        self.save()


def baked_path(metadata):
    """The path the tests have compiled in, read out of the recorded build."""
    meta = metadata["rust-build-meta"]
    found = [
        binary["path"]
        for binaries in meta["non-test-binaries"].values()
        for binary in binaries
        if binary["name"] == BINARY and binary["kind"] == "bin-exe"
    ]
    if len(found) != 1:
        raise KeyError("%d binaries named `%s`" % (len(found), BINARY))
    tests = [binary["binary-path"] for binary in metadata["rust-binaries"].values()]
    return os.path.join(meta["target-directory"], found[0]), found[0], tests


def names(path, needle):
    with open(path, "rb") as handle:
        return needle in handle.read()


def unfit(line):
    """FIT TO KEEP — decided here, over the line of the run that built the baseline, and
    nowhere else. A baseline is fit where that run COMPARED AGAINST IT WHOLE: it ended
    green or red — so the baseline ran on its own binary, left a readable report, and the
    second run ran exactly its tests — and it names no test under `excluded_by_no_row`.
    Returns None, or the word and the sentence by which what was built is not kept."""
    if line["status"] == "void":
        return line["reason"], (
            "the run ended void (%s): what a run built is kept only by the run that compared"
            " against it whole, green or red — and the next run builds afresh"
            % line["reason"])
    unnamed = line["excluded_by_no_row"]
    if unnamed:
        return "baseline", (
            "the baseline holds a test that failed on its own binary and that no exclusion"
            " row names — `%s` `%s`, of %d such: every later run would be void by it for as"
            " long as it was kept, though the test passed again"
            % (unnamed[0]["binary"], unnamed[0]["test"], len(unnamed)))
    return None


class NotUsed(Exception):
    """A kept baseline that is not used: the word of what it failed on, and a sentence."""

    def __init__(self, word, detail):
        super().__init__(detail)
        self.word = word
        self.detail = detail


def digest(value):
    """The sha256 of a value's canonical JSON."""
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, ensure_ascii=False).encode("utf-8")).hexdigest()


def hash_at(path):
    """The sha256 of the file at `path`, or None where no file can be read there."""
    try:
        return sha256_of(path)
    except OSError:
        return None


class Kept:
    """The baseline kept in the directory a caller names, and the key it is held to.

    It lies in one directory the tool owns there, `KEPT`: the previous release's tree, its
    target directory, the files of `KEPT_FILES`, a copy of the baseline's own binary, and
    the record — the key, the kept files' hashes, and the two hashes taken around the
    baseline's run — WRITTEN LAST, once the run that built it has compared against it
    whole (`settle`), so that a directory without one is a baseline nobody finished, or
    one that was not fit to keep. What the line says of it is `said`, which the run's
    facts hold from the start."""

    def __init__(self, directory, run, previous, the_list):
        self.base = os.path.join(directory, KEPT)
        self.run = run
        # A row moved is no row changed: the exclusion rows are held in no order.
        rows = sorted([row[name] for name in FIELDS]
                      for row in the_list["rows"] if excludes(row))
        self.key = {"previous": previous, "exclusions": digest(rows),
                    "tool": sha256_of(os.path.realpath(__file__))}
        self.said = {"dir": directory, "used": False, "refused": None, "detail": None,
                     "sha256": None, "unkept": None}
        self.built = None
        run.facts["baseline"] = self.said
        # THE LOCK. A run swaps the candidate's binary in at a path inside the kept
        # baseline, so two runs do not share one: the lock is this process's from here to
        # its end, and a run that does not get it keeps nothing and uses nothing.
        try:
            self.lock = open(os.path.join(directory, LOCK), "a")
            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.held = True
        except OSError as error:
            self.held = False
            self.said.update(refused="locked", detail=(
                "the directory's lock, `%s`, is not this run's (%s): another run holds it,"
                " and this run keeps no baseline and uses none" % (LOCK, one_line(error))))
        run.save()

    def path(self, *parts):
        return os.path.join(self.base, *parts)

    def says(self, member, tree):
        """What a tool says of itself, as one line: asked in the previous release's tree,
        where that tree's toolchain file is what resolves a compiler."""
        argv = SAYS[member]
        asked = subprocess.run(argv, cwd=tree, env=self.run.env, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        said = one_line(asked.stdout.decode("utf-8", errors="replace"))
        if asked.returncode != 0 or not said:
            raise Void("did-not-run", "`%s` exited %d and said `%s`: a baseline is kept with"
                       " what it says of itself" % (" ".join(argv), asked.returncode, said))
        return said

    def ask(self, tree):
        """The members of the key that are asked for — before anything is built."""
        for member in SAYS:
            self.key[member] = self.says(member, tree)

    def taken(self):
        """What a run needs of the kept baseline — where one is there, and every member of
        its key is what it was kept with. What is there and is not that is REFUSED, the
        line says by which word, and REMOVED: the run builds afresh in its place."""
        if not os.path.lexists(self.base):
            return None
        try:
            return self.read()
        except NotUsed as refused:
            self.said.update(refused=refused.word, detail=one_line(refused.detail))
            self.run.save()
            try:
                shutil.rmtree(self.base)
            except OSError as error:
                raise Void("build-previous", "the kept baseline `%s` was refused (%s) and"
                           " could not be removed: %s" % (self.base, refused.word,
                                                          one_line(error)))
            return None

    def hold_tree(self, tree, commit):
        """The kept tree is the tree of the commit the baseline was kept for: every file
        that commit holds, as git holds it — by its blob's name, so by nothing kept."""
        listed = git("ls-tree", "-r", "-z", commit)
        if listed.returncode != 0:
            raise NotUsed("record", "git lists no files of the commit `%s` the baseline was"
                          " kept for" % commit)
        for entry in listed.stdout.split(b"\0")[:-1]:
            meta, name = entry.split(b"\t", 1)
            mode, kind, blob = meta.split()
            if kind != b"blob":
                continue
            at = os.path.join(os.fsencode(tree), name)
            try:
                if mode == b"120000":
                    held = os.readlink(at)
                else:
                    with open(at, "rb") as handle:
                        held = handle.read()
            except OSError:
                held = None
            if held is None or hashlib.sha1(
                    b"blob %d\0" % len(held) + held).hexdigest().encode() != blob:
                raise NotUsed("record", "the previous release's tree does not hold `%s` as"
                              " the commit `%s` holds it" % (os.fsdecode(name), commit))

    def read(self):
        # A finished record of this tool's, with a whole key.
        try:
            record = json.load(open(self.path(RECORD), encoding="utf-8"))
            if record["tool"] != PROG:
                raise ValueError("it does not say `tool: %s`" % PROG)
            then, files, around = record["key"], record["files"], record["at_baked_path"]
            if (set(then) != set(MEMBERS) or set(files) != set(KEPT_FILES)
                    or not FULL_SHA.fullmatch(then["previous"])
                    or not isinstance(then["tests"], dict)
                    or not all(isinstance(around[moment], str) for moment in AROUND)):
                raise ValueError("it is of another form")
        except (OSError, ValueError, KeyError, TypeError) as error:
            raise NotUsed("incomplete", "the directory holds no finished record `%s` of a"
                          " kept baseline — a run ended before its baseline held, or the"
                          " record is not this tool's: %s" % (RECORD, one_line(error)))

        # The tree is the commit's, and the files are the ones the record was written
        # beside, where it was written.
        tree = self.path("previous")
        self.hold_tree(tree, then["previous"])
        for name in KEPT_FILES:
            found = hash_at(self.path(name))
            if found != files[name]:
                raise NotUsed("record", "`%s` is not the file the baseline was kept with:"
                              " sha256 `%s`, kept with `%s`" % (name, found, files[name]))
        try:
            metadata = json.load(open(self.path(KEPT_FILES[0]), encoding="utf-8"))
            baked, relative, tests = baked_path(metadata)
            binaries = sorted(metadata["rust-binaries"].items())
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
            raise NotUsed("record", "the recorded build does not name the one `%s` binary:"
                          " %s" % (BINARY, one_line(error)))
        here = self.path("target-previous", relative)
        if os.path.realpath(baked) != os.path.realpath(here):
            raise NotUsed("record", "the recorded build names the path `%s`, and in this"
                          " directory it is `%s`: a kept baseline is used where it was built"
                          % (baked, here))

        # THE KEY, member by member, in its order: the first that differs refuses.
        def held(member, now, *what):
            if now != then[member]:
                raise NotUsed(member, MEMBERS[member] % (what + (now, then[member])))

        for member in ("previous", "exclusions", "tool"):
            held(member, self.key[member])
        for member in SAYS:
            held(member, self.says(member, tree))
        now = {name: hash_at(test["binary-path"]) for name, test in binaries}
        for name in sorted(set(now) | set(then["tests"])):
            if now.get(name) != then["tests"].get(name):
                raise NotUsed("tests", MEMBERS["tests"] % (name, now.get(name),
                                                           then["tests"].get(name)))
        held("jigc", hash_at(baked), "the file at the path the tests name")
        held("jigc", hash_at(self.path(BINARY)), "the kept copy of it")
        self.key = then
        return {"baked": baked, "relative": relative, "tests": tests, "around": around}

    def use(self, record):
        """The kept baseline, as this run's: what its run established in this run's facts,
        its files and its record in this run's evidence — as whole as a fresh run's."""
        run = self.run
        run.facts["baked_path"] = record["baked"]
        run.facts["named_by"] = sum(
            1 for test in record["tests"] if names(test, os.fsencode(record["baked"])))
        run.facts["previous"]["sha256"] = self.key["jigc"]
        for moment in AROUND:
            run.facts["at_baked_path"][moment] = record["around"][moment]
        for name in KEPT_FILES + (RECORD,):
            shutil.copyfile(self.path(name), os.path.join(run.evidence, name))
        self.said.update(used=True, sha256=digest(self.key))
        run.save()

    def hold(self, binaries):
        """THE BASELINE HELD — and nothing is kept yet: the copy of its own binary is taken
        now, before the swap puts the candidate's at the path, and the test binaries of the
        recorded build are remembered. Whether what this run built is kept is `settle`'s to
        say, once the run has its verdict."""
        shutil.copy2(self.run.facts["baked_path"], self.path(BINARY))
        self.built = binaries

    def settle(self, line):
        """WHAT BECOMES OF WHAT THIS RUN BUILT, once the run has its line — the ONE place a
        baseline is kept or left: kept where the line says it is fit (`unfit`), and else
        left without a record, which the next run finds unfinished and builds afresh. The
        line then says by which word, and why. A run that used the kept baseline built
        none, and settles nothing."""
        if self.said["used"]:
            return
        left = unfit(line)
        if left is None:
            self.run.timed("kept", self.keep)
        else:
            self.said["unkept"] = {"why": left[0], "detail": left[1]}
            self.run.save()

    def keep(self):
        """THE BASELINE IS KEPT: the record is written last, by a rename — after the run
        that built it compared against it whole."""
        run = self.run
        files = {}
        for name in KEPT_FILES:
            shutil.copyfile(os.path.join(run.evidence, name), self.path(name))
            files[name] = sha256_of(self.path(name))
        self.key["tests"] = {name: sha256_of(test["binary-path"]) for name, test in self.built}
        self.key["jigc"] = run.facts["previous"]["sha256"]
        staged = self.path(RECORD + ".new")
        with open(staged, "w", encoding="utf-8") as handle:
            json.dump({"tool": PROG, "key": self.key, "files": files,
                       "at_baked_path": {moment: run.facts["at_baked_path"][moment]
                                         for moment in AROUND}},
                      handle, indent=1, sort_keys=True)
            handle.write("\n")
        os.replace(staged, self.path(RECORD))
        shutil.copyfile(self.path(RECORD), os.path.join(run.evidence, RECORD))
        self.said["sha256"] = digest(self.key)
        run.save()

    def rest(self):
        """AT REST a kept baseline is as its own baseline left it: the previous release's
        binary at the path its tests name. It is put there when the run is over — after
        the last hash of the proof is taken. A run killed before that leaves the
        candidate's binary there, and the next run refuses the baseline: by `jigc` where
        it was kept before that run, by `incomplete` where that run built it. A baseline
        that was not kept is not put to rest either: it has no record, and is removed."""
        if self.said["sha256"] is None:
            return
        try:
            staged = self.run.facts["baked_path"] + ".rest"
            shutil.copy2(self.path(BINARY), staged)
            os.replace(staged, self.run.facts["baked_path"])
        except OSError:
            pass


def drive(run, previous, candidate, kept=None):
    for tool in ("cargo", "cargo-nextest", "tar") + (("rustc",) if kept else ()):
        if shutil.which(tool, path=run.env.get("PATH")) is None:
            raise Void("did-not-run", "%s is not on PATH" % tool)

    # A kept baseline that holds is used, and the previous release is not built.
    record = run.timed("kept", kept.taken) if kept else None
    home = kept.base if kept else run.work
    recorded = os.path.join(run.evidence, "binaries-metadata.json")
    if record is not None:
        old = os.path.join(home, "previous")
        baked, relative = record["baked"], record["relative"]
        kept.use(record)
    else:
        # The previous release's tests, built once and recorded.
        old = run.unpack("build-previous", previous, "previous", home)
        if kept:
            kept.ask(old)
        target = os.path.join(home, "target-previous")
        run.must("build-previous", "build-previous", "build-previous.log",
                 ["cargo", "nextest", "run", "--workspace", "--locked", "--no-run"], old,
                 target=target)
        run.must("build-previous", "build-previous", "build-previous.log",
                 ["cargo", "nextest", "list", "--workspace", "--locked", "--list-type",
                  "binaries-only", "--message-format", "json"], old, target=target,
                 stdout=recorded)
        run.must("build-previous", "build-previous", "build-previous.log",
                 ["cargo", "metadata", "--format-version=1", "--all-features", "--locked"], old,
                 target=target, stdout=os.path.join(run.evidence, "cargo-metadata.json"))
        try:
            metadata = json.load(open(recorded, encoding="utf-8"))
            baked, relative, tests = baked_path(metadata)
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
            raise Void("build-previous", "the recorded build does not name the one `%s`"
                       " binary: %s" % (BINARY, one_line(error)))
        if not os.path.isfile(baked):
            raise Void("build-previous", "the recorded build names `%s`, and no file is"
                       " there" % baked)
        run.facts["baked_path"] = baked
        run.facts["named_by"] = sum(1 for test in tests if names(test, os.fsencode(baked)))
        run.facts["previous"]["sha256"] = sha256_of(baked)
        run.save()
    hold_path(run.facts)

    # The candidate's binary, in the same profile.
    new = run.unpack("build-candidate", candidate, "candidate")
    run.must("build-candidate", "build-candidate", "build-candidate.log",
             ["cargo", "build", "-p", PACKAGE, "--locked"], new,
             target=run.path("target-candidate"))
    built = run.path("target-candidate", relative)
    if not os.path.isfile(built):
        raise Void("build-candidate", "the candidate's build left no file at `%s`" % built)
    run.facts["candidate"]["sha256"] = sha256_of(built)
    run.save()
    hold_binaries(run.facts)

    store = run.path("nextest-store").replace("\\", "\\\\").replace('"', '\\"')
    with open(os.path.join(run.evidence, "nextest.toml"), "w", encoding="utf-8") as config:
        config.write('[store]\ndir = "%s"\n' % store)
        for which in ("baseline", "candidate"):
            config.write('[profile.regression-%s.junit]\npath = "junit.xml"\n' % which)

    if record is None:
        # The baseline: the previous release's tests on the previous release's binary.
        run.hashed("baseline_before")
        run.suite("baseline", old)
        run.hashed("baseline_after")
    hold_baseline(run.facts, run.evidence)
    if record is None and kept:
        run.timed("kept", kept.hold, sorted(metadata["rust-binaries"].items()))

    # The swap: a new file renamed over the path, never a write into the old one.
    staged = baked + ".swap"
    shutil.copy2(built, staged)
    os.replace(staged, baked)
    run.hashed("candidate_before")
    hold_swap(run.facts, ("candidate_before",))
    run.suite("candidate", old)
    run.hashed("candidate_after")


def act_run(args):
    previous, candidate = two_commits(args.previous, args.candidate)
    the_list = read_list(args.list, previous, candidate)
    scratch = os.path.realpath(args.scratch)
    if not os.path.isdir(scratch):
        refuse("scratch", "the scratch directory `%s` does not exist" % args.scratch)
    if os.path.commonpath([scratch, os.path.realpath(ROOT)]) == os.path.realpath(ROOT):
        refuse("scratch", "the scratch directory `%s` lies inside the repository" % args.scratch)
    directory = None
    if args.baseline is not None:
        directory = os.path.realpath(args.baseline)
        if os.path.commonpath([directory, os.path.realpath(ROOT)]) == os.path.realpath(ROOT):
            refuse("scratch", "the directory of the kept baseline `%s` lies inside the"
                   " repository" % args.baseline)
        try:
            os.makedirs(directory, exist_ok=True)
        except OSError as error:
            refuse("scratch", "the directory of the kept baseline `%s` cannot be made: %s"
                   % (args.baseline, one_line(error)))
    work = tempfile.mkdtemp(prefix=PROG + ".", dir=scratch)
    run = Run(work, previous, candidate, the_list)
    kept = Kept(directory, run, previous, the_list) if directory else None
    if kept and not kept.held:
        kept = None
    try:
        drive(run, previous, candidate, kept)
    except Void as void:
        run.facts["failed"] = {"reason": void.reason, "detail": one_line(void.detail)}
        run.save()
    line = judge(run.evidence, the_list)
    if kept:
        # The verdict first, and only then what becomes of the baseline this run built.
        kept.settle(line)
        kept.rest()
        line["baseline"], line["seconds"] = kept.said, run.facts["seconds"]
    line["work"] = work
    if not args.keep:
        for built in ("previous", "candidate", "target-previous", "target-candidate"):
            shutil.rmtree(os.path.join(work, built), ignore_errors=True)
    return line


def act_verdict(args):
    try:
        facts = json.load(open(os.path.join(args.evidence, "run.json"), encoding="utf-8"))
        previous = facts["previous"]["commit"]
        candidate = facts["candidate"]["commit"]
    except (OSError, ValueError, KeyError, TypeError):
        # No list can be read out of a commit the evidence does not name: void, as `judge`
        # says.
        return judge(args.evidence,
                     {"path": args.list, "commit": None, "sha256": None, "rows": []})
    previous, candidate = two_commits(
        previous, candidate, ("the evidence's previous release", "the evidence's candidate"))
    return judge(args.evidence, read_list(args.list, previous, candidate))


def act_check_list(args):
    previous, candidate = two_commits(args.previous, args.candidate)
    return {"tool": PROG, "status": "listed", "list": read_list(args.list, previous, candidate)}


# --- arguments ------------------------------------------------------------------------


class Arguments(argparse.ArgumentParser):
    def error(self, message):
        refuse("usage", message)


def arguments(argv):
    parser = Arguments(prog=PROG, add_help=False)
    acts = parser.add_subparsers(dest="act", required=True, parser_class=Arguments)

    def act(name, does, *flags):
        sub = acts.add_parser(name, add_help=False)
        for flag in flags:
            sub.add_argument(flag, required=True)
        sub.set_defaults(does=does)
        return sub

    run = act("run", act_run, "--previous", "--candidate", "--list", "--scratch")
    run.add_argument("--keep", action="store_true")
    run.add_argument("--baseline")
    act("verdict", act_verdict, "--evidence", "--list")
    act("check-list", act_check_list, "--previous", "--candidate", "--list")
    return parser.parse_args(argv)


def main(argv):
    # UTF-8 out, whatever the caller's locale claims: the line is read by a script.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    if any(arg in ("-h", "--help") for arg in argv):
        usage_help()
        return 0
    try:
        args = arguments(argv)
        try:
            line = args.does(args)
        except Void as void:
            # Before any evidence exists: a tool the list could not be read without.
            line = {"tool": PROG, "status": "void", "reason": void.reason,
                    "detail": one_line(void.detail)}
        print(json.dumps(line, ensure_ascii=False))
        if line["status"] == "void":
            return VOIDS[line["reason"]]
        return RED if line["status"] == "red" else GREEN
    except Refusal as refusal:
        detail = one_line(refusal.detail)
        print(json.dumps({"tool": PROG, "status": "refused", "refused": refusal.kind,
                          "detail": detail}, ensure_ascii=False))
        sys.stderr.write("%s: refused %s: %s\n" % (PROG, refusal.kind, detail))
        return REFUSALS[refusal.kind]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
