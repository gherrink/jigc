#!/usr/bin/env bash
#
# dev/clean-litter — drop the build litter cargo never garbage-collects.
#
# Cargo cleans nothing on its own: `target/debug/deps` only grows. Every gate run
# re-links the cli test binaries under a fresh hash, and under
# `[profile.dev] split-debuginfo = "unpacked"` each link left hundreds of `*.rcgu.o`
# sidecars behind. On 2026-09-14 the directory held 1,825,219 entries (26 GB),
# 1,823,960 of them those sidecars, median age 15 days. The cost is not the disk:
# macOS syspolicyd (Gatekeeper) rescans the tree and Spotlight indexes it, and a full
# `dev/gate` measured ~20 min against ~9.5 min on the same tree with the stale
# sidecars deleted mid-run.
#
# `packed` (Cargo.toml -> [profile.dev]) stops new litter being produced. This tool is
# the reset for what is already there, and the step the milestone-completion workflow
# runs at its close so the next wave starts on a clean tree.
#
# It removes nothing itself: `cargo clean` owns the tree, so there is no `rm` here at
# all -- no path built from variables, nothing for the shell guard to refuse, and no way
# for a typo to reach outside the target directory cargo knows about.
#
# Cost: the next build is cold (~minutes). That is the point of running it AFTER a
# milestone rather than during one.
#
# Usage:
#   dev/clean-litter        # clean the target tree and report what went
#
# Exit status: 0 iff the clean exited 0.

set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
repo_root=$(dirname -- "$script_dir")
cd "$repo_root" || exit 2

case "${1:-}" in
    "") ;;
    -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
    *)
        printf 'dev/clean-litter: unknown option: %s\n' "$1" >&2
        printf 'dev/clean-litter: try --help\n' >&2
        exit 2
        ;;
esac

# One readdir, no stat: the same count `dev/gate` prints at the top of every run.
count_entries() {
    n=$(find "$1" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l)
    printf '%s' "$((n))"
}

workspace_deps="$repo_root/target/debug/deps"

before_workspace=$(count_entries "$workspace_deps")

printf 'clean-litter: workspace deps  %s entries\n' "$before_workspace"
printf '\n'

# Bare, and its own $? captured directly -- never through a pipe.
cargo clean
if [ $? -ne 0 ]; then
    printf 'clean-litter: FAILED -- the tree is not clean\n' >&2
    exit 1
fi

after_workspace=$(count_entries "$workspace_deps")

printf '\n'
printf 'clean-litter: workspace deps  %s -> %s entries\n' "$before_workspace" "$after_workspace"

printf 'clean-litter: done -- the next build is cold, which is why this runs after a milestone\n'
exit 0
