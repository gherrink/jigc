def read_bytes(path):
    with open(path, "rb") as file:
        return file.read()


def write_whole(path, text):
    """A file written whole or not at all: beside its place, then moved into it."""
    staged = path + ".writing"
    with open(staged, "w", encoding="utf-8") as file:
        file.write(text)
    os.replace(staged, path)


def taken_once(path, text):
    """A name taken ONCE, by a file that is WHOLE when it has the name: written beside its
    place under a name of this process's own, and given its name by a link — which fails
    where the name is taken (FileExistsError). Whoever finds the file finds every byte of
    it: a reader that asks the moment it is there, and one that asks after its writer was
    killed. Creating the file under its name and writing it afterwards left it there
    empty in between, and a reader of an empty record has no answer."""
    staged = "%s.%d.taking" % (path, os.getpid())
    with open(staged, "w", encoding="utf-8") as file:
        file.write(text)
    try:
        os.link(staged, path)
    finally:
        os.unlink(staged)


# --- the scratch root -----------------------------------------------------------


def identity(path):
    try:
        found = os.stat(path)
    except OSError:
        return None
    return (found.st_dev, found.st_ino)


def nearest(path):
    """The nearest ancestor of `path`, itself included, that is there."""
    while not os.path.lexists(path):
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    return path


def holds(outer, inner):
    """Whether `inner` lies at or below `outer`: by device and inode where `outer` is there —
    `inner`'s nearest ancestor that is there walked up — and by the real path where not."""
    outer, inner = os.path.realpath(outer), os.path.realpath(inner)
    if inner == outer or inner.startswith(outer.rstrip(os.sep) + os.sep):
        return True
    mark = identity(outer)
    if mark is None:
        return False
    at = nearest(inner)
    while True:
        if identity(at) == mark:
            return True
        parent = os.path.dirname(at)
        if parent == at:
            return False
        at = parent


