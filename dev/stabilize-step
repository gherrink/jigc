#!/usr/bin/env python3
#
# dev/stabilize-step — every git act of a stabilization run's harness, each as ONE
# command (DECISIONS.md -> 2026-10-06, "Every git act of the stabilization harness is one
# command"; the repair plan's change C0,
# completions/artifacts/M55/stabilization-build/repair-plan.md).
#
# The harness (.claude/workflows/stabilize.js) has no shell: every branch act of a run is
# a step it hands to a `build-git` agent. Until this script those steps were numbered
# lists of shell commands the agent followed — which nothing could execute in a test. An
# act is now a thing that can be called: the agent runs ONE command of this script and
# relays the ONE line it prints; the harness reads that line.
#
# WHAT AN ACT IS. Exactly the commands its numbered list had, in that order, with the
# checks that list had and no other — each act's comment below names them. The repair
# that follows this script changes what the acts check; this script changed nothing.
#
# WHAT IT NEVER DOES. No force of any spelling, no rebase, no reset, no pull, no stash,
# no branch or tag deletion; `main` is never switched to, merged into or pushed — the one
# thing done with it is `sync-main`, which fetches it and merges `origin/main` INTO the
# run's branch. (The one thing it takes back is its own: the paths a record's commit step
# staged, unstaged again when it does not commit them or when the batch is taken back —
# the index, never the tree.) It removes no lock of git's, and it pushes for itself only
# what is a record's (`git-state`). A branch name it is handed has a prefix
# (`fix/<run>…`), so `main` is no argument of any act. tooling-tests/dev_stabilize_step.rs reads this out of every git
# call of this source, and drives each act against real git.
#
# IT NAMES NOTHING. Every branch name, the run's directory, the product paths and the
# append-only logs are the harness's (`branchName`, `runDir`, `PRODUCT_PATHS`,
# `SYNC_LOGS`) and arrive as arguments.
#
# Usage — every act prints ONE line of JSON on stdout, whatever it exits with:
#
#   dev/stabilize-step git-state --stage test|fix --loop L --rounds P --run-dir D
#                      [--product PATH]... [--look]
#       THE STATE A STAGE STARTS FROM — AND EVERY INVOCATION RECONCILES FIRST: what an
#       earlier one left between two commands of a record is found here, by name, and
#       finished, undone or named as somebody's (THE ACTS, THEIR PHASES, AND WHAT IS
#       FOUND ON ARRIVAL, below). In this order: the branch checked out is L (`test`), or
#       L or a name that begins P (`fix`) — wrong-branch, BEFORE ANYTHING IS WRITTEN,
#       FETCHED OR PUSHED. git's own lock does not stand — locked. A write of the record
#       script that was killed is finished (`dev/stabilize-record recover`). The tree
#       holds nothing but THE RUN'S PENDING WRITES (below) — dirty — and a batch whose
#       commit is made and that was not forgotten is settled. The pushed L has no commit
#       the local one lacks — remote-ahead. THE PATH-CLASS ASSERT, from the commit that
#       added D/opening.md on: no commit on L's first-parent line changed a product path
#       outside a merge — product-path — and every merge there is a round's, its subject
#       beginning `Merge branch 'P` — foreign-merge. Without an opening the assert does
#       not run. And, for `test` on an opened run, WHAT THE REMOTE LACKS OF L: every
#       commit of it changes only D and is no merge — foreign-commit: some task's commit,
#       which its author pushes, and no stage starts over — and THE PUSH THAT IS OWED IS
#       MADE, each commit vetted as at every push (unvetted, push-rejected). Where a
#       batch is applied and not committed the push is that record's own, and is left.
#       --look: AN INVOCATION THAT ONLY LOOKS FINISHES NOTHING — no recover, no settle, no
#       push — and says what is owed. (It fetches the loop branch, as this read always has.)
#       Prints {status: ready, branch, head, loop_head, remote_head, opening, untracked,
#       pending, found, finished, owed [, vetted]} — `remote_head` is what origin's L
#       stands at (null: not pushed); `pending` is null, or the applied batch a record
#       step left uncommitted: {round, subject, calls, checks, files}; `found` names
#       every arrival state it met, in the table's order, `finished` those it finished
#       and `owed` those it left — to the stage (`applied`, `staged`: the gate, then
#       `record`), or, under --look, to the next invocation. (Under --look over a killed
#       write the tree is not read across it: `untracked` and `pending` are null.)
#
#   dev/stabilize-step state --run R --scratch DIR --tag T
#       The run's record, read: `dev/stabilize-record state --run R`, kept as
#       DIR/state/T.json. Prints {status: read, branch, file, state}.
#
#   dev/stabilize-step begin --run R --round N --stage test|fix [--cycle K] --attempt A
#                      --reporter S --commit SHA --scratch DIR
#       AN ATTEMPT OF A STAGE, BEGUN ON RECORD — the first write of every attempt, before
#       any agent of it is launched. The run's state hands the stage exactly this round
#       and this attempt (`dev/stabilize-record state`: its `position`, and for `fix` this
#       cycle) — else position: a stage begins where the state says so and nowhere else,
#       so not on a run whose opening is not done, not past a stop nobody lifted, and not
#       as an attempt another invocation holds. Then the attempt's marker is written —
#       a report under the reporter S, through `dev/stabilize-record report`, saying that
#       the attempt began and on which commit — so that an attempt whose agents all died
#       before one of them wrote is still an attempt the record script counts. A marker
#       that is there already is that script's refusal (record). Prints {status: begun,
#       round, attempt, report}.
#
#   dev/stabilize-step check-reports --run R --round N --stage test|fix [--cycle K]
#                      --attempt A [--scratch DIR] [--] [REPORTER...]
#       THE FIRST OF THE THREE BOUNDARIES (WHAT IS VETTED, AND WHERE, below). First every
#       file of the run that is written once and in no commit — the reports of every
#       attempt, each round's scope — is vetted, and ONE THAT THE RECORD SCRIPT WOULD NOT
#       HAVE WRITTEN IS NO REPORT: it is moved out of the tree (`dev/stabilize-record
#       set-aside`), to DIR/refused where a scratch root is named and to a directory that
#       script mints where none is. Then `dev/stabilize-record check-reports` with these
#       arguments: the reporter whose file left has left none, and is `missing`. A
#       missing or an extra report is the check's answer, not a refusal. Prints {status:
#       checked, check, aside: [{path, why, detail, to}]} — `aside` is what left the tree.
#
#   dev/stabilize-step find-round --prefix P
#       The branches named P*, here and on origin. Prints {status: ready, branch, head,
#       local, remote}.
#
#   dev/stabilize-step open-round --loop L --branch B --run-dir D
#       B checked out: switched to, or opened from L without an upstream. The tree as
#       for git-state, and no applied batch — dirty. Prints {status: ready, branch, head,
#       created}.
#
#   dev/stabilize-step push --branch B [--run-dir D]
#       B pushed by name. B is checked out — wrong-branch; the pushed B has no commit
#       the local one lacks — remote-ahead; EVERY COMMIT THE PUSH WOULD PUBLISH IS VETTED
#       (the third boundary, below) — unvetted, and nothing is pushed; the remote takes
#       it — push-rejected — and then stands at the local head — remote-differs. With
#       --run-dir it is A RECORD'S PUSH: every commit it would publish changes only D and
#       is no merge — foreign-commit, and nothing is pushed. Asked again, it publishes
#       nothing and says where the remote stands. Prints {status: ready, branch, head,
#       remote_head, vetted: the commits it published}.
#
#   dev/stabilize-step land --loop L --branch B --run-dir D [--product PATH]...
#                      [--log PATH]...
#       B merged into L with a merge commit, and L pushed: one act. The tree is clean,
#       untracked files included — dirty; the pushed L is not ahead — remote-ahead. A B
#       that is an ancestor of L landed before: {status: landed-before, head}, and
#       nothing else runs. A merge that stops is resolved only when every conflicted
#       path is a --log, by dev/merge-logs — else it is aborted (conflict, merge-logs;
#       unresolved when that script left a path conflicted, which is not aborted). The
#       merge commit has L's old tip and B as its parents, the tree is clean, the
#       product paths equal B's, and — when L took nothing outside D while B was out and
#       no log was resolved — so does everything outside D: else merge-differs, and
#       nothing is undone. Then the push, as `push` has it. Prints {status: merged,
#       merge_commit, head, remote_head, tip_moved, resolved_logs, moved_outside}; a
#       refusal after the merge commit exists carries merge_commit too.
#
#   dev/stabilize-step round-commits --loop L --branch B --run-dir D
#       The commits of L..B, oldest first, and which of them touch D and which a path
#       outside it. A merge among them is refused (merge-in-round). Prints {status:
#       listed, all, inside, outside}.
#
#   dev/stabilize-step carry --loop L --run-dir D [--product PATH]... [--] SHA...
#       A dropped round keeps its record: the named commits cherry-picked onto L, in
#       this order, and L pushed. The tree is clean — dirty; the pushed L is not ahead —
#       remote-ahead; a pick that stops is aborted — pick-stopped; what was carried is as
#       many commits as were named, touches only D and no product path — else
#       carry-differs, and nothing is undone. Prints {status: carried, branch, head,
#       remote_head, picked: [{from, to}]}.
#
#   dev/stabilize-step record --branch B --run-dir D --gate FILE --calls N --checks M
#                      [--head SHA] [--scratch DIR]
#       A RECORD STEP'S ONE COMMIT (DECISIONS.md -> 2026-10-06, "A stabilization run's
#       record commit under a red candidate") — AND A STEP THAT IS REPEATABLE: asked
#       again with the same arguments it goes on from where the step before it stopped,
#       and says in `found` what it met — `applied`; `staged`: its own paths in the
#       index, of a step killed after its `git add` or whose `git commit` failed, which
#       it stages again; `committed`: the batch in HEAD already, of a step killed before
#       it settled, which is taken as recorded and settled; `recorded`: the step done,
#       which answers again what it answered. B is checked out — wrong-branch — and git's
#       lock does not stand — locked. The run
#       has an applied batch (`dev/stabilize-record apply`), of N calls and M checks
#       each of which holds — no-batch — and the tree holds exactly the run's pending
#       writes — dirty; a file of the batch a hand changed is the human's, and the
#       refusal names the act that takes the batch back. --head is THE COMMIT THE STAGE
#       BEGAN ON: the record is committed on it or not at all — head-moved, nothing
#       committed or undone — so that no commit somebody made while the stage ran is
#       published beside it; and it is what lets a step that is done answer again
#       (`recorded`: HEAD is the one commit since, the tree is clean, and the answer this
#       step kept beside FILE — FILE.recorded.json, written once the commit is made and
#       before the batch is settled — names that commit and N and M; the table's `kept`
#       says where that file is believed). FILE holds the whole output of the
#       full gate that ran on this tree — as `dev/gate --keep-going`, so that what it names
#       red is all that is red — and `dev/stabilize-record gate-check` holds
#       it to the candidate's gate as the batch's round has it on record: red that the
#       candidate's gate did not show is refused — gate-red — naming it, and NOTHING IS
#       COMMITTED OR UNDONE: the batch stays applied, for this act to be asked for again
#       after another gate, or for `dev/stabilize-step discard`. Else every pending path
#       is added by name, AND WHAT IS STAGED IS VETTED (the second boundary, below): every
#       such path, the subject, and the batch's own report checks against the disk. A hit
#       — or a path that changed under the step — is refused (unvetted), and it has its
#       exit: the paths are unstaged, THE BATCH IS TAKEN BACK (`dev/stabilize-record
#       discard`), and a report or a scope that is no such file is moved out of the tree
#       (--scratch names where, as for check-reports); the tree is then one a stage starts
#       from, and the stage invoked again works the next attempt. Else ONE commit is made
#       with the subject the batch carries, and the batch is settled. Prints {status:
#       recorded, branch, commit, head, round, paths, applied: {calls, checks}, gate: <the
#       check's result>, found, finished}; a refusal carries what of these the act had
#       established — and an unvetted one {vet: <the vet's result>, discarded, aside:
#       what left the tree}.
#
#   dev/stabilize-step discard --branch B --run-dir D
#       THE APPLIED BATCH TAKEN BACK, BY THE ACT THAT ASKS GIT FIRST. B is checked out —
#       wrong-branch — and git's lock does not stand — locked. A batch whose commit is
#       made is NOT taken back — committed: `dev/stabilize-record discard` reads no git,
#       and would write every committed table as it was before the batch. Else what a
#       commit step staged of the record is unstaged, and every file of the batch is as
#       it was before the batch, or gone where the batch made it; the reports and the
#       scope stay. With no batch there is nothing to take back, and that is its answer.
#       Prints {status: discarded, branch, head, unstaged, discarded, found, finished}.
#
#   dev/stabilize-step table
#       The table of acts and arrival states, as data (below). Asks git nothing. Prints
#       {status: listed, acts: [{act, half, phases, commands, owes}], arrivals: [{state,
#       act, phase, found, answer, word, whose, leaves}], kept: [{file, act, written,
#       read, believed}]} — `kept` is every file this tool writes, both outside the
#       repository: the state document, and a commit step's answer beside its gate's file.
#
#   dev/stabilize-step sync-main --loop L [--log PATH]...
#       `origin/main` merged INTO L before its pull request, as the build harness's close
#       step has it (.claude/workflows/milestone-build.js, syncMainPrompt). L is checked
#       out — wrong-branch — and clean — dirty. An L that holds origin/main already:
#       {status: up-to-date, head, origin_main}. Conflicts as for `land`. The merge
#       commit has L's old tip and origin/main as its parents and the tree is clean —
#       else merge-differs. Nothing is pushed. Prints {status: merged, head,
#       origin_main, resolved_logs}.
#
# THE RUN'S PENDING WRITES. What `dev/stabilize-record` wrote and no commit holds yet is
# no dirty tree. This tool asks that script (`pending`) and holds `git status` to the
# answer, path by path: an UNTRACKED file that is one of the run's written-once files —
# a report, a round's scope; an untracked or modified file of THE APPLIED BATCH whose
# content is still what the batch wrote; either of them STAGED, while a batch is applied
# — what that record's own commit step staged and did not commit; and the script's own
# journal. Any other line — a tracked file changed by hand, a file of a batch changed
# after it was written, a staged path with no batch open, an untracked file anywhere
# else — is a tree no step starts from. A write of that script that was killed — between
# its files, or before its journal — is FINISHED before the tree is read
# (`dev/stabilize-record recover`), by every act that reads the pending writes.
#
# THE ACTS, THEIR PHASES, AND WHAT IS FOUND ON ARRIVAL (the second repair plan of the
# `test` half, P1; DECISIONS.md -> 2026-10-07, "A record act is repeatable, and every
# invocation reconciles first"). A record is three commands — `dev/stabilize-record
# apply`, `record`, `push` — and a kill, a `git commit` that fails or a push the remote
# does not take leaves the run BETWEEN two of them. Every such state has a name, and an
# answer, in ONE table that this script holds as data (ACTS, ARRIVALS), prints (`table`)
# and answers from:
#   an ACT     is a step that changes git or the record. Its PHASES are its sub-steps in
#              order, each with what says FROM GIT AND THE JOURNAL — never from a flag
#              alone — that it is done, and the one step that resumes it. `record` has
#              four: applied (the journal holds the batch, whole) -> committed (every
#              file of it is in HEAD as the batch wrote it) -> settled (the journal
#              holds no batch) -> pushed (the remote stands at the local head). The
#              journal names the act that is open. The acts of the `fix` half — `land`,
#              `carry`, `open-round` — are rows of the same table, marked as that half's
#              and given no phase here: its repair adds them, and no second table.
#   an ARRIVAL is a state an act can be found in, keyed by the open act and the first
#              phase of it that is not done. The tool FINISHES it (interrupted-write,
#              committed, unpushed), UNDOES it (stray-temporaries), leaves it OWED to
#              the stage (applied, staged: the gate, then `record`), ANSWERS again
#              (recorded), or REFUSES it and says whose it is and what leaves it:
#                wrong-branch    the caller's — before any write, fetch or push
#                git-lock        the orchestrator's: the tool never removes a lock
#                altered         the human's: `discard` is named, as a command
#                head-moved      the orchestrator's: the stage is invoked again
#                unvetted        the human's: a local commit is his to take back
#                foreign-commit  its author's: `git push origin <branch>`, by name
#                remote-ahead    the human's
#                dirty           the human's — anything else in the tree
# RECONCILING is: for the open act, the first phase that is not done — finish it, or say
# who does. `git-state` does it for a stage, and `record`, `discard` and the report check
# do the part of it they stand on. So a record step killed at any point between two of
# its commands ends, within two reads, in ONE OF TWO STATES and no third: where the
# journal was not yet written, the state before the batch; else the state of the record
# that was never interrupted, pushed. WHERE THIS ENDS: a kill INSIDE a git child. Its
# one common trace, `index.lock`, has its row; that git moves a ref whole or not at all
# is relied on; anything else such a kill leaves is the last row, `dirty`.
# WHAT THE TOOL PUSHES FOR ITSELF is a record's commit and nothing else: a commit on
# the loop branch that changes a path outside the run's directory is its author's to
# push, and until it is pushed no `test` stage starts.
#
# WHAT IS VETTED, AND WHERE. A reporter has a shell, so a file at a report's path is
# whatever its last writer left, and a commit is whoever made it. What the record script
# checks at a write — the path, no host path left, the fenced line, a report's last line,
# the two scanners CI runs over a push — is therefore checked again, by that script's own
# read (`dev/stabilize-record vet`), where the content becomes permanent:
#   1. the report check   every pending written-once file. A hit is no report: it leaves
#                         the tree, its reporter has left none, and the stage goes on.
#   2. the commit         every path the record's commit adds, its subject, and the
#                         batch's report checks against the disk. A hit: nothing is
#                         committed, the batch is taken back, the next attempt starts clean.
#   3. every push         of `push`, `land` and `carry` alike — one helper makes them all:
#                         every commit no branch of the remote holds yet, whoever made it.
#                         A hit: nothing is pushed, and it is the human's — the commit is
#                         local, and rewriting it is his to confirm. The refusal names
#                         the read that names every commit and place again.
# A scanner that cannot run is a refusal at each of the three (did-not-run), never a
# pass. WHAT IS NOT VETTED: a push somebody makes by hand with plain git.
#
# The line. One JSON object, `act` first, and LAST a `sha256` of the line as it stands
# without that field — `…, "sha256": "<64 hex>"}` over `…}` — so that the harness can
# tell a line an agent retyped from the one this script printed. A refusal prints its
# line too: {act, status: halted, refused: WORD, halt: {root_cause, evidence,
# tree_state, recommendation}}, with every fact the act had established.
#
# Exit status, and the word a refusal opens with — `stabilize-step: refused <word>: …`,
# one line on stderr:
#
#    0  the act is done, or the read is printed
#    2  usage          an unknown act or flag, a missing argument, a name outside its
#                      grammar — a branch name without a prefix, `main` among them
#    3  wrong-branch   the branch checked out is not the one the act names
#    4  dirty          the tree holds what the act does not admit
#    5  remote-ahead   the pushed branch has commits the local one lacks
#    6  product-path   a commit changed a product path directly on the loop branch
#    7  foreign-merge  a merge on the loop branch that is not a round's
#    8  merge-in-round a merge commit among a round's commits
#    9  conflict       a merge stopped outside the append-only logs; it is aborted
#   10  merge-logs     dev/merge-logs refused the conflict; the merge is aborted
#   11  unresolved     dev/merge-logs left a path conflicted; the merge is NOT aborted
#   12  merge-differs  the merge commit is not the one the act names; nothing is undone
#   13  pick-stopped   a cherry-pick stopped; it is aborted
#   14  carry-differs  what was carried is not what the act names; nothing is undone
#   15  push-rejected  the remote did not take the push
#   16  remote-differs after the push the remote does not stand at the local head
#   17  record         dev/stabilize-record refused, failed or printed no JSON, or its
#                      journal names an act this tool has no phases for
#   18  git            a git command failed where the act expects none to
#   19  gate-red       the gate on the tree with the records shows red that the
#                      candidate's own gate did not; nothing is committed or undone
#   20  no-batch       the run has no applied batch, or nothing pending: nothing to record
#   21  position       the run's state does not hand the stage the round and the attempt
#                      it would begin; nothing was written
#   22  unvetted       what would be committed or pushed is not what dev/stabilize-record
#                      would have written; nothing was committed, nothing pushed
#   23  did-not-run    a public-hygiene scanner could not run: never a pass; nothing was
#                      moved, committed or pushed
#   24  locked         git's own lock stands in the repository; it is named, never removed
#   25  head-moved     the branch is not at the commit the stage began on; nothing was
#                      committed or undone
#   26  foreign-commit the loop branch is ahead of its remote by a commit that is no
#                      record's: its author pushes it; the tool pushed nothing
#   27  committed      the applied batch is in a commit: it is not taken back
#
# Needs python3 and git, which the gate needs already. It finds its repository from
# where it lies, never from where it was called.
# tooling-tests/dev_stabilize_step.rs drives it.

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time

PROG = "stabilize-step"

STATUS = {
    "usage": 2,
    "wrong-branch": 3,
    "dirty": 4,
    "remote-ahead": 5,
    "product-path": 6,
    "foreign-merge": 7,
    "merge-in-round": 8,
    "conflict": 9,
    "merge-logs": 10,
    "unresolved": 11,
    "merge-differs": 12,
    "pick-stopped": 13,
    "carry-differs": 14,
    "push-rejected": 15,
    "remote-differs": 16,
    "record": 17,
    "git": 18,
    "gate-red": 19,
    "no-batch": 20,
    "position": 21,
    "unvetted": 22,
    "did-not-run": 23,
    "locked": 24,
    "head-moved": 25,
    "foreign-commit": 26,
    "committed": 27,
}
# What `git ls-remote --exit-code` exits with when no ref matches.
NO_SUCH_REF = 2
# What `dev/stabilize-record check-reports` exits with for a missing or an extra report,
# and `gate-check` for red the candidate's gate did not show.
REPORTS_MISMATCH = 20
GATE_MISMATCH = 22
# What `dev/stabilize-record` exits with for a scanner that could not run, and `vet` for
# what it would not have written.
DID_NOT_RUN = 12
VET_MISMATCH = 24

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(SCRIPT_DIR)
RECORD = os.path.join(SCRIPT_DIR, "stabilize-record")
MERGE_LOGS = os.path.join(SCRIPT_DIR, "merge-logs")

# A branch of the branch model: a prefix, a slash, a name. A name without a prefix —
# `main` — is no argument of any act.
BRANCH = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+")
SLUG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
FULL_SHA = re.compile(r"[0-9a-f]{40}")
# A path inside the repository, of plain segments: it reaches git as a pathspec.
SEGMENT = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")
# A segment of the scratch directory, as the harness takes it (its SCRATCH_RE).
PLAIN = re.compile(r"[A-Za-z0-9._-]+")
STAGES = ("test", "fix")
# git's own lock is waited for this often, this long each time, before it is named: a git
# process of somebody's — an editor's `git status` — holds it for a moment and is no state.
LOCK_WAITS, LOCK_WAIT = 10, 0.2

# THE ACTS, THEIR PHASES, AND WHAT IS FOUND ON ARRIVAL (the header's section of that name).
# ONE table, as data: `table` prints it, `git-state`, `record`, `discard` and `push` answer
# from it — a state they name is a row of ARRIVALS, and what a refusal says leaves it is
# that row's `leaves` — and tooling-tests/dev_stabilize_step.rs holds every row to a test.
#
# ACTS: every act of this tool. `half` is the half of the workflow whose repair gives the
# act its phases; `phases` is null for a read, for an act that is one command of the record
# script, and for an act whose phases its half has not built yet — `owes` says which. A
# phase is a sub-step of the act, in order, with what says FROM GIT AND THE JOURNAL that it
# is done, the one step that resumes it, and who takes that step; `commands` are the
# commands that carry the act, which is what a test kills between.
FIX_OWES = "the `fix` half's repair (the second repair plan of the `test` half, section 9, row 1): its phases, each with its predicate and its resume step, are rows of THIS table, and its arrival states rows of ARRIVALS"
ONE_COMMAND = "nothing: one command, whose repeat is refused or changes nothing"
A_READ = "nothing: a read"
ACTS = (
