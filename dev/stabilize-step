def how_many(value):
    """A list as its length: what the list holds is in the file the digest names."""
    return len(value) if isinstance(value, (list, tuple, dict)) else value


def unit_doors(item, included):
    """The doors of a round's test set an item covers — its own, and those of its
    registries; one that runs on every candidate and names neither covers them all. The
    harness's `unitDoors`, and dev/stabilize-record's `item-doors`, which is the read that
    lists them: a digest says how many."""
    if item["runs"] == "every-candidate" and not item["doors"] and not item["registries"]:
        return included
    return [door for door in included if door["door"] in item["doors"] or door["registry"] in item["registries"]]


def state_brief(document):
    """The state document as the harness ACTS on it — where a stage stands, what follows,
    the items by id with where each one's run stands, the clauses, and the rest as counts —
    and nothing an agent reads for itself: no brief, no door, no ledger row."""
    if document.get("opened") is not True:
        return {name: document[name] for name in ("run", "opened") if name in document}
    items = {item["item"]: item for item in document["items"]}
    stands = {entry["item"]: entry for clause in document["clauses"] for entry in clause["items"]}
    included = document["doors"] and document["doors"]["included"]

    def placed(at):
        """A stage's position, a re-run's items each with how many doors it covers there."""
        again = at.get("rerun")
        return at if again is None else dict(at, rerun=dict(again, items=[dict(entry, doors=len(unit_doors(items[entry["item"]], again["doors"]))) for entry in again["items"]]))

    bare = {}
    for door in document["uncovered"]:
        for within in door["rounds"]:
            bare[within] = bare.get(within, 0) + 1
    whys = [entry["why"] for entry in document["untriaged"]]
    forbids = document["forbids_close"]
    brief = {name: document[name] for name in ("run", "opened", "next", "not_ready", "stop", "round", "fix_rounds", "candidate", "facts", "never_selected", "human_clauses", "human_stages", "retest", "unsettled")}
    brief.update(
        position={stage: placed(at) for stage, at in document["position"].items()},
        rounds=[{"round": held["round"], "candidate": held["facts"]["candidate"], "cycles": held["facts"]["cycles"]} for held in document["rounds"]],
        doors=document["doors"] and {side: len(doors) for side, doors in document["doors"].items()},
        uncovered=[{"round": within, "doors": bare[within]} for within in sorted(bare)],
        # An item's entry holds, of where its own run stands, what is not null.
        items=[dict(item, doors=None if included is None else len(unit_doors(item, included)), **{name: value for name, value in stands.get(item["item"], {}).items() if name in ("round", "attempt", "standing", "why", "rerun") and value is not None}) for item in document["items"]],
        clauses=document["clauses"],
        untriaged={"count": len(whys), "why": [{"why": why, "count": whys.count(why)} for why in sorted(set(whys))]},
        ledger=len(document["ledger"]),
        blockers=len(document["blockers"]),
        human_list=len(document["human_list"]),
        # The findings the human may grant one more triage: the record script's own suffix.
        reverify=[finding["key"] for finding in document["human_list"] if finding["why"].endswith("-after-retry")],
        forbids_close={"clauses": [entry for entry in forbids if "clause" in entry], "no_clauses": any("clauses" in entry for entry in forbids), "findings": sum("finding" in entry for entry in forbids), "candidate": any("candidate" in entry for entry in forbids)},
    )
    return brief


def vet_brief(vet):
    return {"ok": vet.get("ok") is True, "refused": len(vet.get("refused") or []), "subject": bool(vet.get("subject")), "stale": len(vet.get("stale") or [])}


# BRIEF: what a fact of a line is in its digest, where that is not the fact itself — a
# list as its length, an object as the words and the counts of it.
BRIEF = {
    "branch": lambda name: name or None,
    "opening": lambda sha: sha or None,
    "untracked": how_many,
    "vetted": how_many,
    "paths": how_many,
    "moved_outside": how_many,
    "unstaged": how_many,
    "discarded": how_many,
    "kept": how_many,
    "pending": lambda batch: batch and dict(batch, checks=len(batch["checks"]), files=len(batch["files"])),
    "state": state_brief,
    "check": lambda check: dict(check, **{name: len(check[name]) for name in ("extra", "other_attempts", "reports")}),
    "applied": lambda batch: dict(batch, checks=len(batch["checks"]), failed=sum(1 for check in batch["checks"] if not (isinstance(check, dict) and check.get("ok") is True))),
    "gate": lambda gate: dict(gate, **{name: len(gate[name]) for name in ("red", "known", "new")}),
    "vet": vet_brief,
    "acts": lambda acts: [act["act"] for act in acts],
    "arrivals": lambda arrivals: [arrival["state"] for arrival in arrivals],
    "holds": lambda holds: [row["kind"] for row in holds],
}


def fit(shape, value, at, unfit):
    """`value` as the shape its field declares lets it be printed — or None, with the field
    noted in `unfit`: WHAT DOES NOT FIT IS NOT PRINTED. An object keeps the fields its shape
    names and that it has; a list of plain values is printed whole or not at all, and a list
    of objects with each object's own misfits struck."""
    if isinstance(shape, tuple):
        return None if value is None else fit(shape[1], value, at, unfit)
    if isinstance(shape, dict):
        if isinstance(value, dict):
            return {name: fit(inner, value[name], at + "." + name, unfit) for name, inner in shape.items() if name in value}
    elif isinstance(shape, list):
        if isinstance(value, (list, tuple)) and len(value) <= shape[1]:
            struck = []
            fitted = [fit(shape[0], entry, at, struck) for entry in value]
            if not struck or isinstance(shape[0], dict):
                unfit.extend(name for name in dict.fromkeys(struck) if name not in unfit)
                return fitted
    elif value is None and shape.endswith("?"):
        return None
    elif shape.rstrip("?") == "flag":
        if isinstance(value, bool):
            return value
    elif shape.rstrip("?") == "count":
        # A number an act was handed as an argument is still a number.
        value = int(value) if isinstance(value, str) and re.fullmatch(r"[0-9]{1,9}", value) else value
        if isinstance(value, int) and not isinstance(value, bool) and 0 <= value < 10**9:
            return value
    else:
        pattern, longest = PLAIN_VALUES[shape.rstrip("?")]
        if isinstance(value, str) and len(value) <= longest and pattern.fullmatch(value):
            return value
    if at not in unfit:
        unfit.append(at)
    return None


def digest_line(facts, root):
    """THE DIGEST of an act's line: what the harness acts on, each value of the shape its
    field declares — so the line is printable ASCII, and holds no backslash and no sentence —
    then `unfit`, the fields whose value did not fit and is therefore null; `file` and
    `file_sha256`, the file under `root` that holds what the digest leaves out — the state
    document for a `state` that read it, and for every other line the line itself, as the
    act prints it unasked — or null where there is no root to keep it under; and last the
    sha256 of the digest, as on every line of this tool."""
    unfit, fields = [], {}
    act = facts.get("act")
    for name, shape in dict(LINE, **(DIGEST.get(act, {}) if isinstance(act, str) else {})).items():
        if name not in facts:
            continue
        try:
            value = BRIEF[name](facts[name]) if name in BRIEF else facts[name]
        except (KeyError, TypeError, AttributeError, IndexError):
            # A fact that is not what this tool and the record script print: it does not fit.
            value = MISFIT
        fields[name] = fit(shape, value, name, unfit)
    kept = None
    if root is not None:
        try:
            if facts.get("act") == "state" and facts.get("status") == "read":
                path = facts["file"]
            else:
                whole = line_of(facts) + "\n"
                path = os.path.join(root, "lines", "%s.%s.json" % (fields.get("act") or "none", hashlib.sha256(whole.encode("utf-8")).hexdigest()[:16]))
                with open(path, "w", encoding="utf-8") as file:
                    file.write(whole)
            with open(path, "rb") as file:
                kept = (os.path.relpath(path, root), hashlib.sha256(file.read()).hexdigest())
        except OSError:
            kept = None
    fields.update(unfit=unfit, file=fit("path?", kept and kept[0], "file", unfit), file_sha256=kept and kept[1])
    # Printed close: a digest is relayed by an agent, and every byte of it is one to copy.
    body = json.dumps(fields, separators=(",", ":"))
    return '%s, "sha256": "%s"}' % (body[:-1], hashlib.sha256(body.encode("utf-8")).hexdigest())


def beneath(root, name):
    """The directory `name` under the root a digest's files lie in, made — and it IS under
    that root: a link planted there would carry the write elsewhere, and is refused."""
    directory = os.path.join(root, name)
    try:
        os.makedirs(directory, exist_ok=True)
    except OSError as err:
        refuse("usage", "the files of a digest cannot be kept under `%s`: %s" % (root, " ".join(str(err).split())), "", "hand the act a directory it can write under — the stage's scratch root")
    if os.path.realpath(directory) != os.path.join(os.path.realpath(root), name):
        refuse("usage", "`%s` is no directory under `%s`: it resolves to `%s`, and a file a digest names lies under the root the digest is asked with" % (directory, root, os.path.realpath(directory)), "", "a link beneath the root is removed by whoever planted it, or the act is handed another root")
    return directory


def digest_root(flags):
    """(whether the act is asked for its digest, the root the flag names) — read off the
    arguments before they are parsed, so that a refusal of the arguments is a digest too."""
    for at, arg in enumerate(flags):
        if arg == "--digest":
            return True, flags[at + 1] if at + 1 < len(flags) else None
        if arg.startswith("--digest="):
            return True, arg[len("--digest="):]
    return False, None


