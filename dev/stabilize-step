class Refusal(Exception):
    def __init__(self, kind, detail, evidence, recommendation):
        super().__init__(detail)
        self.kind = kind
        self.detail = detail
        self.evidence = evidence
        self.recommendation = recommendation


def refuse(kind, detail, evidence="", recommendation="the human reconciles it; the step is not repeated on a guess"):
    raise Refusal(kind, detail, evidence, recommendation)


def note(facts, state, how=None):
    """An arrival state the act met: named in the line's `found`, and — where the act
    finished it, or leaves it owed — in `finished` or `owed`."""
    for name in ("found",) + ((how,) if how else ()):
        if state not in facts.setdefault(name, []):
            facts[name].append(state)


def refuse_as(facts, state, detail, evidence="", **names):
    """Refuse an arrival state the table answers with a refusal: its word, and what leaves
    it as its row says."""
    row = next(row for row in ARRIVALS if row["state"] == state)
    note(facts, state)
    leaves = row["leaves"]
    for name, value in names.items():
        leaves = leaves.replace("<%s>" % name.replace("_", "-"), value)
    refuse(row["word"], detail, evidence, leaves)


def usage_help():
    for line in open(__file__, encoding="utf-8").read().split("\n")[1:]:
        if not line.startswith("#"):
            break
        print(re.sub(r"^# ?", "", line))


# --- running a command --------------------------------------------------------


class Ran:
    def __init__(self, argv, code, out, err):
        self.argv = argv
        self.code = code
        self.out = out
        self.err = err

    def shown(self):
        """The command and everything it printed, for a halt's evidence."""
        said = (self.out + self.err).strip()
        return "`%s` exited %d%s" % (" ".join(self.argv), self.code, ": " + said if said else "")


def run(argv, fed=None):
    """One command, from the repository's root: its exit status and what it printed. It
    reads nothing, unless it is `fed` a text."""
    done = subprocess.run(argv, cwd=ROOT, capture_output=True, text=True, encoding="utf-8", errors="replace", **({"stdin": subprocess.DEVNULL} if fed is None else {"input": fed}))
    return Ran([os.path.relpath(argv[0], ROOT) if os.path.isabs(argv[0]) else argv[0]] + list(argv[1:]), done.returncode, done.stdout, done.stderr)


def streamed(argv, cwd, out=None):
    """A LONG command, its output kept and not read: in `out`, or where this process's own
    goes. Its exit status — negative for the signal that ended it, and 127 where it could
    not be started at all."""
    try:
        return subprocess.run(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT if out else None).returncode
    except OSError:
        return 127


def git(*argv):
    """A git command whose exit status is an answer the act reads."""
    return run(["git"] + list(argv))


def said(*argv):
    """A git command that must succeed: what it printed, without its last line break."""
    ran = git(*argv)
    if ran.code != 0:
        refuse("git", "a git command the step runs failed", ran.shown())
    return ran.out.rstrip("\n")


def lines(text):
    return [line for line in text.split("\n") if line]


def answers(ran, yes=0, no=1):
    """A git command that answers yes or no by its exit status; any other status is a
    command that failed."""
    if ran.code not in (yes, no):
        refuse("git", "a git command the step runs failed", ran.shown())
    return ran.code == yes


# --- the checks several acts share --------------------------------------------


def checked_out(branch, facts):
    """THE FIRST THING AN ACT ASKS: the branch checked out is the one it names — before it
    reads anything else, and before any write, fetch or push."""
    current = said("branch", "--show-current")
    if current != branch:
        refuse_as(facts, "wrong-branch", "`%s` is checked out, and the step works on `%s`" % (current, branch), "`git branch --show-current` printed `%s`" % current)
    return current


def unlocked(facts):
    """git's own lock does not stand in the repository. A lock that is still there after a
    moment is named and left: the tool never removes one."""
    lock = said("rev-parse", "--git-path", "index.lock")
    for _ in range(LOCK_WAITS):
        if not os.path.lexists(os.path.join(ROOT, lock)):
            return
        time.sleep(LOCK_WAIT)
    refuse_as(facts, "git-lock", "git's own lock stands in the repository: %s" % lock, "`git rev-parse --git-path index.lock` printed `%s`, and that file was there for %.0f s" % (lock, LOCK_WAITS * LOCK_WAIT))


def heads(listed, branch):
    """The shas `git ls-remote --heads` listed for exactly this branch."""
    return [line.split("\t")[0] for line in lines(listed) if line.split("\t")[1:] == ["refs/heads/" + branch]]


def pushed_is_not_ahead(branch, facts):
    """A branch that is pushed has no commit the local one lacks. One that is not pushed
    yet has nothing to compare. Returns the sha the pushed branch stands at, or None."""
    listing = git("ls-remote", "--exit-code", "--heads", "origin", branch)
    if not answers(listing, no=NO_SUCH_REF):
        return None
    said("fetch", "origin", branch)
    behind = git("merge-base", "--is-ancestor", "origin/" + branch, branch)
    if not answers(behind):
        refuse_as(facts, "remote-ahead", "the pushed `%s` has commits the local one lacks" % branch, behind.shown())
    return (heads(listing.out, branch) or [None])[0]


# What the remote said it holds, the first time this act asked it: an act is one process,
# and every range of it is read against ONE answer (remote_holds).
ASKED = []


def remote_holds():
    """WHAT THE REMOTE HOLDS, ASKED OF THE REMOTE (the header: WHAT A PUSH PUBLISHES): (the
    listing of its heads, as it printed it; the commits they stand at that this clone holds
    too, sorted) — asked ONCE per act, so that which commits are no record's and which
    commits are vetted are read against the same answer; the push asks again, and is not
    made over another one. Never read off a remote-tracking ref, which says what a fetch
    once saw — or what a hand wrote there. A head whose commit this clone does not hold is
    no part of the second: nothing is left out of a range through it, so a range is the
    longer for it and never the shorter."""
    if not ASKED:
        listing = said("ls-remote", "--heads", "origin")
        stand = sorted({line.split("\t")[0] for line in lines(listing)})
        ASKED.append((listing, sorted(lines(said("rev-list", "--no-walk", "--ignore-missing", *stand))) if stand else []))
    return ASKED[0]


def lacking(tip, reach):
    """The range of what the remote lacks of a commit, as `git rev-list` takes it: the
    commit, and — after `--not` — what the remote holds."""
    return [tip] + (["--not"] + reach[1] if reach[1] else [])


def records_only(branch, run_dir, facts):
    """Every commit of the branch that no branch of the remote holds — as the remote said
    when the act asked it — is A RECORD'S: it changes nothing outside the run's
    directory, and is no merge. A commit that is not is some task's, behind that task's own
    gate — the tool pushes no such commit, and no record beside one."""
    lacks = lacking(said("rev-parse", branch), remote_holds())
    foreign = lines(said("log", "--format=%H", *lacks, "--", ".", ":(exclude)" + run_dir))
    foreign += [merge for merge in lines(said("rev-list", "--merges", *lacks)) if merge not in foreign]
    if foreign:
        refuse_as(facts, "foreign-commit", "`%s` is ahead of its remote by %d commit(s) that are no record's — each changes a path outside %s, or is a merge: %s" % (branch, len(foreign), run_dir, ", ".join(foreign)), "`git log --format=%%H %s -- . ':(exclude)%s'` and `git rev-list --merges %s` — the branch's commit, less what `git ls-remote --heads origin` listed" % (" ".join(lacks), run_dir, " ".join(lacks)), branch=branch)


def vetted(asking, undone):
    """What a vet of `dev/stabilize-record` answered — its `vet`, or its `set-aside`. A
    scanner that could not run is never a pass; `undone` says what was then not done."""
    if asking.code == DID_NOT_RUN:
        refuse("did-not-run", "a public-hygiene scanner could not run: %s" % undone, asking.shown(), "a scan that did not run is never a pass. With the denylist and gitleaks in place (implementation/public-hygiene.md -> The guard) the same step is asked for again, and nothing else is needed: it left everything as it found it")
    try:
        answer = json.loads(asking.out) if asking.code in (0, VET_MISMATCH) else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        refuse("record", "dev/stabilize-record could not vet what the step would publish", asking.shown())
    return answer


def places(refused):
    """What a vet refused, by where and never by what: each place, and the writer's word."""
    return "; ".join("%s (%s)" % (" ".join(part for part in (found.get("commit"), found.get("path") or ("its message" if found.get("commit") else "")) if part) or "the range", found.get("why")) for found in refused)


def written_once(status, pending):
    """The files of the run that are written once and that no commit holds: the untracked
    lines of `git status --porcelain` that `dev/stabilize-record pending` names."""
    once = pending.get("once") or []
    return [line[3:] for line in lines(status) if line.startswith("?? ") and line[3:] in once]


def set_aside(run_name, paths, scratch, undone):
    """THE REPORT CHECK'S VET: of `paths` — written-once files of the run — each that the
    record script would not have written is moved out of the tree by that script. What it
    answered: {aside: [{path, why, detail, to}], vetted}."""
    if not paths:
        return {"aside": [], "vetted": {}}
    return vetted(run([RECORD, "set-aside", "--run", run_name] + (["--to", scratch + "/refused"] if scratch else []) + ["--"] + paths), undone)


def push(branch, facts):
    """THE ONE PUSH OF THE TOOL (the header: WHAT A PUSH PUBLISHES): the branch's commit
    published once every commit the remote lacks of it is vetted — the remote asked what it
    holds, the vet made of that commit by its sha, and the push made only where the remote
    and the branch still stand where the vet saw them. The remote is read back: the sha it
    stands at is the commit that was vetted."""
    # 1. What the remote holds now, and THE COMMIT THIS PUSH PUBLISHES: read once, here.
    reach = remote_holds()
    tip = said("rev-parse", branch)
    lacks = lacking(tip, reach)
    # 2. Every commit of it the remote lacks, vetted — the range by the commit's sha, so
    #    that what is vetted is that commit and nothing the branch gains meanwhile.
    unpushed = lines(said("rev-list", "--reverse", *lacks))
    if unpushed:
        vet = vetted(run([RECORD, "vet", "--range", "--"] + lacks), "nothing was pushed")
        if vet.get("ok") is not True:
            facts.update(vet=vet)
            note(facts, "unvetted")
            refuse("unvetted", "`%s` would publish what dev/stabilize-record would not have written, in %d of the %d commit(s) the remote does not hold yet: %s" % (branch, len({found.get("commit") for found in vet.get("refused") or []}), len(unpushed), places(vet.get("refused") or [])), "`dev/stabilize-record vet --range` answered: %s" % json.dumps(vet.get("refused")), "nothing was pushed, and it is the human's: the commit is local, and rewriting it or taking it back is his to confirm — a hit is fixed before the push, never after (implementation/public-hygiene.md). `dev/stabilize-record vet --range -- %s` names every commit and place again — the branch, less what the remote held when this step asked it — pushes nothing, and answers ok once nothing unvetted is left; then this step is asked for again" % " ".join([branch] + lacks[1:]))
    facts.update(vetted=unpushed)
    # 3. Asked again, both: the remote holds what it held when the range was read, and the
    #    branch stands at the commit that was vetted. Else nothing is pushed.
    then = "nothing was pushed, and nothing is lost: the step is asked for again, and vets what the remote lacks then — a commit that landed meanwhile is met by its first read"
    if said("ls-remote", "--heads", "origin") != reach[0]:
        refuse("remote-differs", "the remote moved while `%s` was vetted: it no longer holds what it held when the range was read, so what a push would publish now is not the range that was vetted" % branch, "`git ls-remote --heads origin` printed another listing than before the vet", then)
    moved = said("rev-parse", branch)
    if moved != tip:
        refuse("remote-differs", "`%s` moved while it was vetted: the vet was of %s, and the branch stands at %s — a commit landed meanwhile, and nothing vetted it" % (branch, tip, moved), "`git rev-parse %s` printed %s before the vet and %s after it" % (branch, tip, moved), then)
    # 4. The push, and the remote read back: it stands at the commit that was vetted.
    pushing = git("push", "origin", branch)
    if pushing.code != 0:
        refuse("push-rejected", "the remote did not take `%s`" % branch, pushing.shown(), "the human looks at the remote; a push is never forced")
    listed = said("ls-remote", "--exit-code", "--heads", "origin", branch)
    if heads(listed, branch) != [tip]:
        refuse("remote-differs", "after the push origin's `%s` does not stand at the commit that was vetted, %s" % (branch, tip), "`git ls-remote` printed: %s" % (listed or "(nothing)"), "the human looks at the remote: where it stands at a commit past %s, that commit landed between the last read of the branch and the push, and IS PUBLISHED, vetted by nothing — it is named by `git log %s..origin/%s` after a fetch, and what it holds is his to judge (implementation/public-hygiene.md)" % (tip, tip, branch))
    facts["remote_head"] = tip


def pending_of(run_name):
    """What of the run is written and in no commit yet, as dev/stabilize-record says it."""
    asking = run([RECORD, "pending", "--run", run_name])
    try:
        pending = json.loads(asking.out) if asking.code == 0 else None
    except ValueError:
        pending = None
    if not isinstance(pending, dict):
        refuse("record", "dev/stabilize-record could not say what of the run is pending", asking.shown())
    return pending


def arrived(run_dir, facts, look=False):
    """THE RUN'S PENDING WRITES, as dev/stabilize-record says them — ONCE EVERY WRITE OF
    THAT SCRIPT THAT WAS KILLED IS FINISHED: a batch half in place is put in place, one
    half taken back is taken back, and the temporaries of a write killed before its
    journal are removed (`recover`: the arrival states `interrupted-write` and
    `stray-temporaries`). An act that only looks finishes nothing, and says what is owed."""
    run_name = os.path.basename(run_dir)
    pending = pending_of(run_name)
    killed = [state for state, there in (("interrupted-write", pending.get("interrupted")), ("stray-temporaries", pending.get("temporaries"))) if there]
    if not killed or look:
        for state in killed:
            note(facts, state, "owed")
        return pending
    recovering = run([RECORD, "recover", "--run", run_name])
    if recovering.code != 0:
        refuse("record", "a write of the run's record was killed, and dev/stabilize-record could not finish it", recovering.shown())
    for state in killed:
        note(facts, state, "finished")
    return pending_of(run_name)


def admitted(status, pending, facts):
    """(the written-once files no commit holds, the files of the applied batch that differ
    from HEAD, which of both are in the index) a tree holds — THE RUN'S PENDING WRITES, in
    the header's words. Any other line of `git status --porcelain` is a tree the step does
    not start from."""
    batch = pending.get("batch") or {}
    once, files, altered = pending.get("once") or [], batch.get("files") or {}, batch.get("altered") or []
    untracked, held, staged, other = [], [], [], []
    for line in lines(status):
        code, path = line[:2], line[3:]
        if code == "??" and (path == pending.get("journal") or path in (pending.get("temporaries") or [])):
            continue
        if code == "??" and path in once:
            untracked.append(path)
        elif batch and code in ("A ", "AM") and path in once:
            # THE ACT'S OWN STAGED LINES: what the commit step of the open record staged,
            # and did not commit. It stages them again from the tree, and vets what it staged.
            untracked.append(path)
            staged.append(path)
        elif code in ("??", " M", "A ", "M ", "AM", "MM") and path in files and path not in altered:
            held.append(path)
            staged += [path] if code[0] in "AM" else []
        else:
            other.append(line)
    if other:
        refuse_as(facts, "dirty", "the tree holds more than what dev/stabilize-record wrote and no commit holds yet: %s" % "; ".join(other), "`git status --porcelain --untracked-files=all` printed: %s" % " | ".join(lines(status)))
    return untracked, held, staged


def in_head(batch):
    """THE BATCH'S COMMIT IS MADE, asked of git and of nothing the tree holds: every file of
    the batch is in HEAD with the content the batch wrote — the sha256 the journal holds
    of it. What a hand wrote in the tree since changes nothing of that. (A table of the
    record script is UTF-8 text with no carriage return, so what git prints of one is its
    bytes; a file in HEAD that is anything else is not what the batch wrote.)"""
    for path, digest in batch["files"].items():
        held = git("show", "HEAD:" + path)
        if held.code != 0 or hashlib.sha256(held.out.encode("utf-8")).hexdigest() != digest:
            return False
    return True


def standing(pending, facts, **names):
    """WHERE THE OPEN ACT STANDS, from git and the journal and never from a flag: (the
    written-once files pending, the batch's files pending, the arrival state). The state is
    None with no batch; `applied`, or `staged` where paths of the record are in the index;
    `committed` where every file of the batch is in HEAD as the batch wrote it — none of
    them differs from HEAD, and none from what the batch wrote. A file of the batch that
    is no longer what the batch wrote is the human's (`altered`) WHILE NO COMMIT HOLDS THE
    BATCH; where HEAD holds it the commit is made — `committed`, whatever a hand wrote in
    the tree since — and the file is, once the batch is settled, a tracked file changed by
    hand like any other: the tree is read again by whoever settles it."""
    batch = pending.get("batch")
    if batch and not any(act["act"] == batch.get("act") and act["phases"] for act in ACTS):
        refuse("record", "the journal names an open act this tool has no phases for: %s" % json.dumps(batch.get("act")), "`dev/stabilize-record pending`")
    if batch and batch["altered"]:
        if in_head(batch):
            note(facts, "altered")
            return [], [], "committed"
        refuse_as(facts, "altered", "a file of the applied batch is no longer what the batch wrote: %s" % ", ".join(batch["altered"]), "`dev/stabilize-record pending` names it as altered: its content is not the one the journal holds a hash of, and HEAD does not hold the batch", **names)
    untracked, held, staged = admitted(said("status", "--porcelain", "--untracked-files=all"), pending, facts)
    return untracked, held, (("staged" if staged else "applied") if held else "committed") if batch else None


def settled(run_name, what):
    """The batch's commit is made: the record script forgets the batch."""
    settling = run([RECORD, "settle", "--run", run_name])
    if settling.code != 0:
        refuse("record", "%s, and dev/stabilize-record could not settle its batch" % what, settling.shown())


def taken_back(run_name, paths):
    """THE BATCH TAKEN BACK: what a commit step staged of it is unstaged — the index, never
    the tree, and those paths only — and then every file of it is as it was before the
    batch (`dev/stabilize-record discard`). What that script said it took back."""
    if paths:
        said("restore", "--staged", "--", *paths)
    discarding = run([RECORD, "discard", "--run", run_name])
    try:
        discarded = json.loads(discarding.out)["discarded"] if discarding.code == 0 else None
    except (ValueError, KeyError, TypeError):
        discarded = None
    if not isinstance(discarded, list):
        refuse("record", "dev/stabilize-record could not take the applied batch back", discarding.shown())
    return discarded


def clean(status, command):
    if status:
        refuse("dirty", "the tree is not clean: %s" % "; ".join(lines(status)), "`%s` printed: %s" % (command, " | ".join(lines(status))))


def merge(target, logs, facts):
    """`target` merged into the branch checked out, with a merge commit. A merge that
    stops is resolved by dev/merge-logs when every conflicted path is one of `logs`, and
    is aborted otherwise. Returns the logs it resolved."""
    merging = git("merge", "--no-ff", "--no-edit", target)
    if merging.code == 0:
        return []
    conflicted = lines(said("diff", "--name-only", "--diff-filter=U"))
    if not conflicted or any(path not in logs for path in conflicted):
        aborted = git("merge", "--abort")
        refuse("conflict", "the merge of `%s` stopped, and not on the append-only logs alone: %s" % (target, ", ".join(conflicted) or "no conflicted path"), "%s; %s" % (merging.shown(), aborted.shown()), "a conflict outside the append-only logs is the human's")
    resolving = run([MERGE_LOGS])
    if resolving.code != 0:
        aborted = git("merge", "--abort")
        refuse("merge-logs", "dev/merge-logs refused the conflict in %s" % ", ".join(conflicted), "%s; %s" % (resolving.shown(), aborted.shown()), "a hunk that is not a pure append is the human's")
    left = lines(said("diff", "--name-only", "--diff-filter=U"))
    if left:
        refuse("unresolved", "dev/merge-logs exited 0 and left conflicted: %s" % ", ".join(left), resolving.shown(), "the merge is still in progress, as the step left it")
    said("commit", "--no-edit")
    facts["resolved_logs"] = conflicted
    return conflicted


def two_parents(parents, first, second):
    """A merge commit's parents, as `git rev-list --parents -n 1 HEAD` listed them."""
    if parents.split()[1:] != [first, second]:
        refuse("merge-differs", "the merge commit's parents are not %s and %s" % (first, second), "`git rev-list --parents -n 1 HEAD` printed: %s" % parents, "nothing was undone: the merge is on the local branch")


def same(ran, what):
    """`git diff --quiet`: 0 the same, 1 different — which the step refuses."""
    if not answers(ran):
        refuse("merge-differs", what, ran.shown(), "nothing was undone: the merge is on the local branch")


# --- the acts -----------------------------------------------------------------


def git_state(args, facts):
    run_name = os.path.basename(args.run_dir)
    facts.update(found=[], finished=[], owed=[])
    # 1. The branch checked out — before anything else is read, written, fetched or pushed.
    current = said("branch", "--show-current")
    if current != args.loop and not (args.stage == "fix" and current.startswith(args.rounds)):
        refuse_as(facts, "wrong-branch", "`%s` is checked out: the `%s` stage starts from %s" % (current, args.stage, "the loop branch `%s`" % args.loop if args.stage == "test" else "`%s` or a round's branch, `%s…`" % (args.loop, args.rounds)), "`git branch --show-current` printed `%s`" % current)
    # 2. git's own lock.
    unlocked(facts)
    # 3. What a killed write of the record script left: finished first — or, by an
    #    invocation that only looks, named as owed; the tree is then not read across it.
    pending = arrived(args.run_dir, facts, args.look)
    read = not (args.look and pending.get("interrupted"))
    # 4. The tree, and where the open act stands: a batch whose commit is made is settled.
    untracked, held, state = standing(pending, facts, branch=current, run_dir=args.run_dir) if read else (None, None, None)
    batch = pending.get("batch") if read else None
    if state == "committed" and args.look:
        note(facts, state, "owed")
    elif state == "committed":
        settled(run_name, "the commit of the applied batch is made")
        note(facts, state, "finished")
        # The tree, read again without the batch: what a hand wrote in a committed table
        # is a tracked file changed by hand, and no pending write of the run.
        untracked, held, _ = standing(pending_of(run_name), facts, branch=current, run_dir=args.run_dir)
    elif state:
        note(facts, state, "owed")
    # 5. The pushed loop branch.
    remote = pushed_is_not_ahead(args.loop, facts)
    # 6. The commit that added the run's opening record.
    opening = said("log", "--diff-filter=A", "--format=%H", "-n", "1", args.loop, "--", args.run_dir + "/opening.md")
    if opening:
        # 7. The path-class assert: product paths move only through a round's merge.
        since = opening + ".." + args.loop
        direct = lines(said("log", "--first-parent", "--no-merges", "--format=%H", since, "--", *args.product))
        if direct:
            shown = [said("show", "--stat", "--format=%s", sha, "--", *args.product) for sha in direct]
            refuse("product-path", "commit(s) changed a product path directly on `%s`: %s" % (args.loop, ", ".join(direct)), " | ".join(" ".join(text.split()) for text in shown), "a product path moves only through an audited round's merge")
        foreign = [subject for subject in lines(said("log", "--first-parent", "--merges", "--format=%s", since)) if not subject.startswith("Merge branch '" + args.rounds)]
        if foreign:
            refuse("foreign-merge", "a merge on `%s` is not a round's: %s" % (args.loop, "; ".join(foreign)), "`git log --first-parent --merges --format=%%s %s`" % since)
    # 8. What the remote lacks of the `test` stage's loop branch — the last phase of a
    #    record: every commit of it is a record's, and the push that is owed is made.
    #    (A round's branch, and the loop branch under `fix`, are that half's cells.)
    if args.stage == "test" and opening and remote != said("rev-parse", args.loop):
        records_only(args.loop, args.run_dir, facts)
        if args.look or state in ("applied", "staged"):
            note(facts, "unpushed", "owed")
        else:
            note(facts, "unpushed")
            push(args.loop, facts)
            note(facts, "unpushed", "finished")
            remote = facts.pop("remote_head")
    # 9. The report.
    facts.update(status="ready", branch=current, head=said("rev-parse", "HEAD"), loop_head=said("rev-parse", args.loop), remote_head=remote, opening=opening, untracked=untracked)
    facts.update(pending={"round": batch["round"], "subject": batch["subject"], "calls": batch["calls"], "checks": batch["checks"], "files": held} if state in ("applied", "staged") else None)


def state(args, facts):
    directory = os.path.join(args.scratch, "state")
    if args.digest:
        beneath(args.scratch, "state")
    os.makedirs(directory, exist_ok=True)
    reading = run([RECORD, "state", "--run", args.run])
    if reading.code != 0:
        refuse("record", "dev/stabilize-record could not read the run's state", reading.shown())
    try:
        document = json.loads(reading.out)
    except ValueError:
        document = None
    if not isinstance(document, dict) or len(lines(reading.out)) != 1:
        refuse("record", "dev/stabilize-record state did not print one line of JSON", reading.shown())
    path = os.path.join(directory, args.tag + ".json")
    with open(path, "w", encoding="utf-8") as file:
        file.write(reading.out)
    facts.update(status="read", branch=said("branch", "--show-current"), file=path, state=document)


def stage_flags(args):
    flags = ["--run", args.run, "--round", args.round, "--stage", args.stage]
    if args.cycle is not None:
        flags += ["--cycle", args.cycle]
    return flags


def begin(args, facts):
    # 1. Where the state hands the stage: this round, this attempt — and no refusal.
    reading = run([RECORD, "state", "--run", args.run])
    try:
        document = json.loads(reading.out) if reading.code == 0 else None
    except ValueError:
        document = None
    if not isinstance(document, dict):
        refuse("record", "dev/stabilize-record could not read the run's state", reading.shown())
    at = (document.get("position") or {}).get(args.stage)
    wanted = {"round": args.round, "attempt": args.attempt}
    if args.stage == "fix":
        wanted["cycle"] = args.cycle
    if not isinstance(at, dict) or "refused" in at or any(str(at.get(name)) != value for name, value in wanted.items()):
        refuse("position", "the run's state does not hand the `%s` stage %s: its position is %s%s" % (args.stage, ", ".join("%s %s" % pair for pair in wanted.items()), json.dumps(at), " — the opening still owes %s" % ", ".join(document["not_ready"]) if document.get("not_ready") else ""), reading.shown()[:400], "nothing was written; the stage is invoked again and reads the state as it stands")
    # 2. The marker: the attempt is on record before any agent of it is launched.
    text = "# attempt %s of the `%s` stage, round %s\n\nThe harness began this attempt on the commit %s, before it launched an agent. What the attempt's agents wrote lies beside this file under the same attempt number; an attempt that reached its record is named in the round's record, and one that did not is counted from this file.\n\n<!-- end of report -->\n" % (args.attempt, args.stage if args.cycle is None else "%s (cycle %s)" % (args.stage, args.cycle), args.round, args.commit)
    writing = run([RECORD, "report"] + stage_flags(args) + ["--reporter", args.reporter, "--attempt", args.attempt, "--scratch", args.scratch], fed=text)
    if writing.code != 0 or len(lines(writing.out)) != 1:
        refuse("record", "the attempt could not be put on record", writing.shown(), "an attempt whose marker is there already was begun — by an earlier try of this step, or by another invocation: the stage is invoked again, and the state gives the next attempt")
    facts.update(status="begun", round=args.round, attempt=args.attempt, report=writing.out.strip())


def check_reports(args, facts):
    # 1. What is pending and written once, vetted: a file there that the record script
    #    would not have written is no report, and leaves the tree.
    once = written_once(said("status", "--porcelain", "--untracked-files=all"), arrived(args.run, facts))
    aside = set_aside(args.run, once, args.scratch, "no report was vetted, and none was moved")
    facts.update(aside=aside.get("aside") or [])
    # 2. The check: a reporter whose file left has left none.
    flags = stage_flags(args)
    checking = run([RECORD, "check-reports"] + flags + ["--attempt", args.attempt, "--"] + args.names)
    try:
        check = json.loads(checking.out) if checking.code in (0, REPORTS_MISMATCH) else None
    except ValueError:
        check = None
    if not isinstance(check, dict):
        refuse("record", "dev/stabilize-record could not check the stage's reports", checking.shown())
    facts.update(status="checked", check=check)


def find_round(args, facts):
    local = lines(said("branch", "--list", args.prefix + "*", "--format=%(refname:short)"))
    listed = lines(said("ls-remote", "--heads", "origin", args.prefix + "*"))
    remote = [line.split("\t")[1][len("refs/heads/"):] for line in listed]
    facts.update(status="ready", branch=said("branch", "--show-current"), head=said("rev-parse", "HEAD"), local=local, remote=remote)


def open_round(args, facts):
    _, held, _ = admitted(said("status", "--porcelain", "--untracked-files=all"), arrived(args.run_dir, facts), facts)
    if held:
        refuse("dirty", "a record's batch is applied and not committed: %s" % ", ".join(held), "`dev/stabilize-record pending`", "its record step commits it on the branch it was applied on, before any branch is opened")
    created = not answers(git("rev-parse", "--verify", "--quiet", "refs/heads/" + args.branch))
    if created:
        said("switch", args.loop)
        said("switch", "--no-track", "-c", args.branch, args.loop)
    else:
        said("switch", args.branch)
    facts.update(status="ready", branch=checked_out(args.branch, facts), head=said("rev-parse", "HEAD"), created=created)


def push_branch(args, facts):
    current = checked_out(args.branch, facts)
    pushed_is_not_ahead(args.branch, facts)
    if args.run_dir:
        # A RECORD'S PUSH publishes records, and nothing beside them.
        records_only(args.branch, args.run_dir, facts)
    push(args.branch, facts)
    facts.update(status="ready", branch=current, head=said("rev-parse", "HEAD"))


def land(args, facts):
    outside = ":(exclude)" + args.run_dir
    # 1. The tree, untracked files included.
    clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
    # 2. The round's tip, and the loop branch.
    round_head = said("rev-parse", args.branch)
    said("switch", args.loop)
    pre = said("rev-parse", "HEAD")
    # 3. The pushed loop branch.
    pushed_is_not_ahead(args.loop, facts)
    # 4. A round that landed before.
    if answers(git("merge-base", "--is-ancestor", args.branch, args.loop)):
        facts.update(status="landed-before", head=pre)
        return
    # 5. Whether the loop branch moved while the round was out, and where.
    tip_moved = not answers(git("merge-base", "--is-ancestor", args.loop, args.branch))
    fork = said("merge-base", args.loop, args.branch)
    moved_outside = lines(said("diff", "--name-only", fork, args.loop, "--", ".", outside))
    facts.update(tip_moved=tip_moved, moved_outside=moved_outside, resolved_logs=[])
    # 6-8. The merge.
    resolved = merge(args.branch, args.log, facts)
    # 9. The merge commit: its parents, the tree, and what it holds against the round's.
    merge_commit = said("rev-parse", "HEAD")
    facts.update(merge_commit=merge_commit)
    two_parents(said("rev-list", "--parents", "-n", "1", "HEAD"), pre, round_head)
    clean_after_merge = said("status", "--porcelain")
    if clean_after_merge:
        refuse("merge-differs", "the tree is not clean after the merge: %s" % "; ".join(lines(clean_after_merge)), "`git status --porcelain`", "nothing was undone: the merge is on the local branch")
    same(git("diff", "--quiet", "HEAD", args.branch, "--", *args.product), "what the merge holds on the product paths is not what `%s` holds: what lands is not exactly what was audited" % args.branch)
    if not moved_outside and not resolved:
        same(git("diff", "--quiet", "HEAD", args.branch, "--", ".", outside), "the merged tree differs from `%s` outside the run's directory" % args.branch)
    # 10-11. The push.
    push(args.loop, facts)
    # 12. The report.
    facts.update(status="merged", head=merge_commit)


def round_commits(args, facts):
    between = args.loop + ".." + args.branch
    merges = said("rev-list", "--merges", "--count", between)
    if merges != "0":
        refuse("merge-in-round", "`%s` holds %s merge commit(s)" % (between, merges), "`git rev-list --merges --count %s` printed %s" % (between, merges))
    everything = lines(said("log", "--reverse", "--format=%H", between))
    inside = lines(said("log", "--reverse", "--format=%H", between, "--", args.run_dir))
    outside = lines(said("log", "--reverse", "--format=%H", between, "--", ".", ":(exclude)" + args.run_dir))
    facts.update(status="listed", all=everything, inside=inside, outside=outside)


def carry(args, facts):
    # 1. The tree, untracked files included.
    clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
    # 2. The loop branch, and its pushed tip.
    said("switch", args.loop)
    pre = said("rev-parse", "HEAD")
    pushed_is_not_ahead(args.loop, facts)
    # 3. The commits, one by one.
    for sha in args.shas:
        picking = git("cherry-pick", "-x", sha)
        if picking.code != 0:
            aborted = git("cherry-pick", "--abort")
            refuse("pick-stopped", "the cherry-pick of %s stopped" % sha, "%s; %s" % (picking.shown(), aborted.shown()), "the commits carried before it stay on the local branch, unpushed")
    # 4. Exactly those, and nothing outside the run's directory.
    carried = pre + "..HEAD"
    count = said("rev-list", "--count", carried)
    if count != str(len(args.shas)):
        refuse("carry-differs", "%s commit(s) were carried, and %d were named" % (count, len(args.shas)), "`git rev-list --count %s` printed %s" % (carried, count), "nothing was undone")
    strays = [path for path in lines(said("diff", "--name-only", pre, "HEAD")) if not path.startswith(args.run_dir + "/")]
    if strays:
        refuse("carry-differs", "a carried commit changed a path outside the run's directory: %s" % ", ".join(strays), "`git diff --name-only %s HEAD`" % pre, "nothing was undone")
    touched = git("diff", "--quiet", pre, "HEAD", "--", *args.product)
    if not answers(touched):
        refuse("carry-differs", "a carried commit changed a product path", touched.shown(), "nothing was undone")
    # 5. The push.
    push(args.loop, facts)
    # 6. The report.
    facts.update(status="carried", branch=said("branch", "--show-current"), head=said("rev-parse", "HEAD"))
    made = lines(said("log", "--reverse", "--format=%H", carried))
    facts.update(picked=[{"from": sha, "to": to} for sha, to in zip(args.shas, made)])


def answered_before(args):
    """Where the answer of this commit step is kept once it is done: beside the file of the
    gate it was held to, which is one record step's own."""
    return args.gate + ".recorded.json"


def record(args, facts):
    run_name = os.path.basename(args.run_dir)
    facts.update(found=[], finished=[])
    # 1. The branch — before anything else is read or written.
    current = checked_out(args.branch, facts)
    # 2. git's own lock.
    unlocked(facts)
    # 3. What a killed write of the record script left, finished; then the applied batch.
    pending = arrived(args.run_dir, facts)
    batch = pending.get("batch")
    head = said("rev-parse", "HEAD")
    if not batch:
        # ASKED AGAIN AFTER IT WAS DONE: no batch, the tree clean, and HEAD the one commit
        # since the commit the stage began on — the commit this step answered with, of the
        # batch it names. Then it answers again what it answered then. Without --head
        # nothing says that the last commit is this record's, and there is nothing to record.
        try:
            kept = json.loads(open(answered_before(args), encoding="utf-8").read())
            applied = (kept["applied"]["calls"], len(kept["applied"]["checks"]))
        except (OSError, ValueError, KeyError, TypeError):
            kept, applied = {}, None
        if not (args.head is not None and applied == (int(args.calls), int(args.checks)) and (kept.get("branch"), kept.get("commit")) == (current, head) and said("rev-list", "--parents", "-n", "1", "HEAD").split()[1:] == [args.head]):
            refuse("no-batch", "run %s has no applied batch: there is nothing this step records" % run_name, "`dev/stabilize-record pending` printed no batch", "a record step applies its batch first (`dev/stabilize-record apply`)")
        clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
        note(facts, "recorded")
        facts.update(kept, status="recorded")
        return
    facts.update(round=batch["round"], applied={"calls": batch["calls"], "checks": batch["checks"]})
    failed = [check for check in batch["checks"] if not (isinstance(check, dict) and check.get("ok") is True)]
    if batch["calls"] != int(args.calls) or len(batch["checks"]) != int(args.checks) or failed:
        refuse("no-batch", "the applied batch is not the one this step records: it ran %d call(s) and %d check(s), %d of which do not hold, and the step names %s and %s" % (batch["calls"], len(batch["checks"]), len(failed), args.calls, args.checks), "`dev/stabilize-record pending` printed: %s" % json.dumps(facts["applied"]), "nothing was committed: `dev/stabilize-step discard --branch %s --run-dir %s` takes a batch back that no step of this stage applied" % (args.branch, args.run_dir))
    # 4. Where the act stands: the tree as exactly the run's pending writes — its own staged
    #    lines among them — or the batch in HEAD already.
    untracked, held, state = standing(pending, facts, branch=args.branch, run_dir=args.run_dir)
    note(facts, state)
    paths = sorted(untracked + held)
    # 5. The commit the stage began on: a record is committed on it, or not at all.
    files = sorted(batch["files"])
    commit = said("log", "-n", "1", "--format=%H", "--", *files) if state == "committed" else None
    began = said("rev-list", "--parents", "-n", "1", commit).split()[1:] if commit else [head]
    if args.head is not None and (began != [args.head] or commit not in (None, head)):
        refuse_as(facts, "head-moved", "`%s` is not at the commit the stage began on: the stage began on %s, and the branch stands at %s%s" % (args.branch, args.head, head, " — the commit that holds the batch is %s, on %s" % (commit, " and ".join(began) or "no parent") if commit else ""), "`git rev-parse HEAD` printed %s" % head)
    # 6. The gate that ran on this tree, held to the candidate's.
    flags = [] if batch["round"] is None else ["--round", str(batch["round"])]
    checking = run([RECORD, "gate-check", "--run", run_name, "--summary", args.gate] + flags)
    try:
        gate = json.loads(checking.out) if checking.code in (0, GATE_MISMATCH) else None
    except ValueError:
        gate = None
    if not isinstance(gate, dict):
        refuse("record", "dev/stabilize-record could not hold the gate's output to the candidate's gate", checking.shown(), "the batch stays applied and uncommitted: the step is asked for again once the full gate's whole output is in that file")
    facts.update(gate=gate)
    if checking.code != 0:
        refuse("gate-red", "the gate on the tree with the records shows red that the candidate's own gate did not: %s" % "; ".join(gate["new"]), checking.shown(), "nothing was committed or undone: the batch stays applied. A stage invoked again runs the gate on it once more and commits it if nothing is newly red; `dev/stabilize-step discard --branch %s --run-dir %s` takes the batch back instead" % (args.branch, args.run_dir))
    if state == "committed":
        # THE BATCH IS IN HEAD ALREADY — a commit step that was killed after its commit: it
        # is taken as recorded, and only its settling is left.
        paths = lines(said("show", "--name-only", "--format=", commit))
    else:
        facts.update(paths=paths)
        # 7. Every pending path by name, staged — again, where a step before this one
        #    staged them — and what is staged, vetted: the paths, the subject the batch
        #    carries, and the batch's report checks against the disk.
        subject = batch["subject"]
        said("add", "--", *paths)
        vetting = run([RECORD, "vet", "--run", run_name, "--subject=" + subject, "--"] + paths)
        moved = lines(git("diff", "--name-only", "--", *paths).out)
        if vetting.code != 0 or moved:
            # Nothing is committed. The step takes back what it staged, and then answers.
            said("restore", "--staged", "--", *paths)
            vet = vetted(vetting, "nothing was committed, and the batch stays applied")
            facts.update(vet=vet)
            # The exit: the batch back, and what is no report out of the tree, so that the
            # next attempt starts from a tree it can use.
            taken_back(run_name, [])
            aside = set_aside(run_name, untracked, args.scratch, "nothing was committed, and the batch is taken back")
            facts.update(aside=aside.get("aside") or [], discarded=True)
            hits = [places(vet.get("refused") or [])] if vet.get("refused") else []
            hits += ["the commit's subject (%s)" % vet["subject"].get("why")] if vet.get("subject") else []
            hits += ["the batch's report check of %s no longer holds — gone: %s; changed: %s" % (stale.get("dir"), ", ".join(stale.get("gone") or []) or "none", ", ".join(stale.get("changed") or []) or "none") for stale in vet.get("stale") or []]
            hits += ["changed while the step ran: %s" % ", ".join(moved)] if moved else []
            refuse("unvetted", "the record's commit would hold what dev/stabilize-record would not have written: %s" % "; ".join(hits), "`dev/stabilize-record vet` answered: %s" % json.dumps({name: vet.get(name) for name in ("refused", "subject", "stale")}), "nothing was committed, and nothing is left to undo: the batch is taken back (`dev/stabilize-record discard`), and what is no report was moved out of the tree (%s). `dev/stabilize-step git-state` answers for the tree, and the stage invoked again works the next attempt — the instruments run again, because their record was not made" % (", ".join(found["to"] for found in facts["aside"]) or "nothing had to be"))
        # 8. The one commit, with that subject.
        said("commit", "-q", "-m", subject)
        commit = said("rev-parse", "HEAD")
    facts.update(paths=paths, commit=commit, head=commit, branch=current)
    # 9. The answer, kept for this step asked again — BEFORE the batch is settled, so that
    #    from the commit on there is no moment at which neither the journal nor this file
    #    says what was recorded: killed before this write the step finds its batch in HEAD
    #    (`committed`), killed after it and after the settling it finds this (`recorded`).
    with open(answered_before(args), "w", encoding="utf-8") as file:
        file.write(json.dumps({name: facts[name] for name in ("branch", "commit", "head", "round", "paths", "applied", "gate")}))
    # 10. The batch is committed: the record script forgets it.
    settled(run_name, "the record commit %s is made" % commit)
    if state == "committed":
        note(facts, state, "finished")
    clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
    # 11. The report.
    facts.update(status="recorded")


def discard(args, facts):
    run_name = os.path.basename(args.run_dir)
    facts.update(found=[], finished=[])
    # 1. The branch, git's own lock, and what a killed write left — as every act of a record.
    current = checked_out(args.branch, facts)
    unlocked(facts)
    pending = arrived(args.run_dir, facts)
    batch = pending.get("batch")
    paths, taken = [], []
    if batch:
        # 2. Where the batch stands, asked of git: one whose commit is made is not taken back.
        status = [(line[:2], line[3:]) for line in lines(said("status", "--porcelain", "--untracked-files=all"))]
        ours = list(batch["files"]) + (pending.get("once") or [])
        if in_head(batch) or not any(path in batch["files"] for code, path in status):
            # ASKED OF HEAD, whatever the tree holds: a batch whose commit is made is not
            # taken back because a hand wrote in one of its tables since — and one of
            # which the tree holds nothing that HEAD does not has nothing to take back.
            note(facts, "committed")
            refuse("committed", "the applied batch of run %s is in a commit — %s: it is not taken back" % (run_name, "every file of it is in HEAD as the batch wrote it%s" % (", and a hand changed %s in the tree since" % ", ".join(batch["altered"]) if batch["altered"] else "") if in_head(batch) else "no file of it differs from HEAD"), "`git show HEAD:<file>` of each file of the batch, held to the hash the journal holds of it; `git status --porcelain --untracked-files=all`", "nothing was written. `dev/stabilize-step git-state` settles a batch whose commit is made, and says what else is owed — a file a hand changed since is then a tracked file changed by hand, the human's; what a commit holds is taken back by a commit, which is the human's to make")
        paths = sorted(path for code, path in status if code[0] in "AM" and path in ours)
        note(facts, "altered" if batch["altered"] else "staged" if paths else "applied")
        # 3. What a commit step staged of it, unstaged; then every file as before the batch.
        taken = taken_back(run_name, paths)
    facts.update(status="discarded", branch=current, head=said("rev-parse", "HEAD"), unstaged=paths, discarded=taken)


def table(args, facts):
    facts.update(status="listed", acts=ACTS, arrivals=ARRIVALS, kept=KEPT, holds=HOLDS, slice=SLICE)


def sync_main(args, facts):
    # 1. The branch and the tree.
    checked_out(args.loop, facts)
    clean(said("status", "--porcelain"), "git status --porcelain")
    pre = said("rev-parse", "HEAD")
    # 2. main, fetched.
    said("fetch", "origin", "main")
    origin_main = said("rev-parse", "origin/main")
    facts.update(origin_main=origin_main)
    # 3. A branch that holds it already.
    if answers(git("merge-base", "--is-ancestor", "origin/main", args.loop)):
        facts.update(status="up-to-date", head=said("rev-parse", "HEAD"))
        return
    # 4-6. The merge.
    facts.update(resolved_logs=[])
    merge("origin/main", args.log, facts)
    # 7. The merge commit.
    parents = said("rev-list", "--parents", "-n", "1", "HEAD")
    two_parents(parents, pre, said("rev-parse", "origin/main"))
    clean_after_merge = said("status", "--porcelain")
    if clean_after_merge:
        refuse("merge-differs", "the tree is not clean after the merge: %s" % "; ".join(lines(clean_after_merge)), "`git status --porcelain`", "nothing was undone: the merge is on the local branch")
    # 8. The report. Nothing is pushed: the gate runs on the merged tree first.
    facts.update(status="merged", head=said("rev-parse", "HEAD"))


# --- a held command -------------------------------------------------------------


def scratch_root(scratch):
    """The scratch root an act of a held command works under, RESOLVED: a directory that
    is there, and no part of the repository — judged on the real path, so a link into the
    repository is inside it."""
    real, home = os.path.realpath(scratch), os.path.realpath(ROOT)
    if real == home or real.startswith(home + os.sep):
        refuse("usage", "the scratch root `%s` lies inside the repository (it resolves to `%s`): a held command writes no file of it" % (scratch, real), "", "hand the act a directory outside the repository — the stage's scratch root")
    if not os.path.isdir(real):
        refuse("usage", "the scratch root `%s` is not there, or is no directory" % scratch, "", "hand the act the stage's scratch root, which exists before any step of the stage")
    return real


def under(root, rel):
    """The path `rel` below the resolved root — AND IT LIES BELOW IT: every directory on the
    way is made where it is missing, and one that is there is a directory and no link, so a
    link planted beneath the root carries no write elsewhere. Nothing is made past a link."""
    path, parts = root, rel.split("/")
    for at, part in enumerate(parts):
        path = os.path.join(path, part)
        last = at == len(parts) - 1
        if os.path.islink(path) or (not last and os.path.lexists(path) and not os.path.isdir(path)):
            refuse("usage", "`%s` does not lie under the scratch root `%s`: `%s` is a link, or no directory, and what the act writes lies under the root it resolved" % (rel, root, path), "", "what was planted beneath the root is removed by whoever planted it, or the act is handed another root")
        if not last and not os.path.lexists(path):
            try:
                os.mkdir(path)
            except FileExistsError:
                pass
            except OSError as err:
                refuse("usage", "`%s` cannot be made under the scratch root: %s" % (path, " ".join(str(err).split())))
    return path


def whole(found):
    """A file's bytes."""
    with open(found, "rb") as file:
        return file.read()


def kept_once(at, text):
    """A file of a held command, written by whoever is first: one that is there stands."""
    with open(at, "x", encoding="utf-8") as file:
        file.write(text)


def hashed(body):
    """A JSON object as ONE line that ends with the sha256 of itself, as every line does."""
    text = json.dumps(body)
    return '%s, "sha256": "%s"}' % (text[:-1], hashlib.sha256(text.encode("utf-8")).hexdigest())


def own_line(text):
    """The LAST line of a command's output, where it is a line as this tool and the probe
    tool print one — a JSON object that ends with the sha256 of itself — else None."""
    last = (lines(text) or [""])[-1]
    marker = ', "sha256": "'
    at = last.rfind(marker)
    if at < 0 or not last.endswith('"}') or hashlib.sha256((last[:at] + "}").encode("utf-8")).hexdigest() != last[at + len(marker):-2]:
        return None
    try:
        line = json.loads(last)
    except ValueError:
        return None
    return line if isinstance(line, dict) else None


def void(why, detail, facts=None, evidence=None):
    """A verdict that is none: the command ran to its end, and its output does not say."""
    return {"verdict": "void", "why": why, "detail": detail, "facts": facts or {}, "evidence": evidence or {}}


def judged_gate(root, name, asked, code, output):
    # The record script's own reader of ONE full gate: with no round named, nothing the
    # gate shows red is known, so its answer is the gate's verdict and all that is red.
    checking = run([RECORD, "gate-check", "--run", asked["run"], "--summary", output, "--scratch", root])
    try:
        seen = json.loads(checking.out) if checking.code in (0, GATE_MISMATCH) else None
        totals = re.fullmatch(r"tests   passed=([0-9]+) failed=([0-9]+)  \(over ([0-9]+) test binaries\)", seen["totals"])
        red, passed = seen["red"], seen["verdict"] == "pass"
    except (ValueError, KeyError, TypeError):
        totals = None
    if totals is None:
        return void("no-verdict", "the output is not that of ONE full `dev/gate`: %s" % (" ".join(checking.err.split()) or checking.shown()))
    facts = {"passed": int(totals.group(1)), "failed": int(totals.group(2)), "binaries": int(totals.group(3)), "steps": [what[len("step "):] for what in red if what.startswith("step ")], "tests": sum(1 for what in red if what.startswith("test "))}
    evidence = {"totals": seen["totals"], "red": red}
    if (code == 0) != passed:
        return void("exit-differs", "the gate's output says `%s`, and the command exited %s" % ("GATE: PASS" if passed else "GATE: FAIL", code), facts, evidence)
    return {"verdict": "green" if passed else "red", "why": None, "detail": seen["totals"], "facts": facts, "evidence": evidence}


def judged_regression(root, name, asked, code, output):
    exits = next(row for row in HOLDS if row["kind"] == "regression")["exits"]
    found = []
    for text in lines(whole(output).decode("utf-8", "replace")):
        try:
            line = json.loads(text) if text.startswith("{") else None
        except ValueError:
            line = None
        if isinstance(line, dict) and line.get("tool") == "regression-set":
            found.append(line)
    if len(found) != 1:
        return void("no-verdict", "the output holds %d line(s) of `dev/regression-set`, and a run prints ONE" % len(found))
    line = found[0]
    status = line.get("status")
    word = {"green": "green", "red": "red", "void": line.get("reason") if line.get("reason") in REGRESSION_VOID else None, "refused": line.get("refused") if line.get("refused") in REGRESSION_REFUSED else None}.get(status)
    evidence = {"line": line}
    if not isinstance(word, str):
        return void("no-verdict", "the line of `dev/regression-set` says nothing this tool reads: status %s" % json.dumps(status), None, evidence)
    if exits[word] != code:
        return void("exit-differs", "the line says `%s`, which that tool exits %d with, and the command exited %s" % (word, exits[word], code), None, evidence)
    if status == "refused":
        return void("refused", "`dev/regression-set` refused the call (%s): the check did not run" % word, None, evidence)
    if status == "void":
        return void(word, " ".join(str(line.get("detail") or "").split()), {"status": status, "reason": word}, evidence)
    listed = line.get("list") or {}
    said_ = ((line.get("previous") or {}).get("commit"), (line.get("candidate") or {}).get("commit"), listed.get("path"), listed.get("commit"))
    if said_ != (asked["previous"], asked["candidate"], asked["list"], asked["candidate"]):
        return void("not-asked", "the line is of the commits %s and %s and the list %s as %s holds it — not of what was asked" % said_, None, evidence)
    counts = line.get("counts") or {}
    facts = {"status": status, "reason": None, "previous": asked["previous"], "candidate": asked["candidate"], "list_sha256": listed.get("sha256")}
    facts.update({count: counts.get(count, 0) for count in ("differences", "not_on_list", "excluded", "excluded_by_no_row")})
    return {"verdict": status, "why": None, "detail": "%s difference(s), %s of them off the list; %s test(s) excluded by a row" % (facts["differences"], facts["not_on_list"], facts["excluded"]), "facts": facts, "evidence": evidence}


def judged_build(root, name, asked, code, output):
    line = own_line(whole(output).decode("utf-8", "replace"))
    if line is None or line.get("act") != "build":
        return void("no-verdict", "the output does not end with a line of `dev/stabilize-step build`")
    evidence = {"line": line}
    word = line.get("refused") if line.get("status") == "halted" else "green" if line.get("status") == "built" else None
    if STATUS.get(word, 0 if word == "green" else None) != code:
        return void("exit-differs", "the build's line says `%s`, and the command exited %s" % (line.get("status"), code), None, evidence)
    if word == "build":
        return {"verdict": "red", "why": "build", "detail": (line.get("halt") or {}).get("root_cause", ""), "facts": {}, "evidence": evidence}
    if word != "green":
        return void("refused", "the build refused the call (%s): nothing was built" % word, None, evidence)
    if (line.get("commit"), line.get("binary")) != (asked["commit"], asked["to"]) or asked.get("version", line.get("version")) != line.get("version"):
        return void("not-asked", "the build's line is not of the commit, the path and the version asked", None, evidence)
    # THE DISK AGAIN: the file every driving agent will run is the one the build hashed.
    path = os.path.join(root, asked["to"])
    try:
        writable = os.path.islink(path) or bool(os.stat(path).st_mode & 0o222)
        data = whole(path)
    except OSError:
        writable, data = True, b""
    if writable or hashlib.sha256(data).hexdigest() != line.get("content_sha256"):
        return void("hash-differs", "the file at %s is not the read-only binary the build wrote: its hash is not the one the build's line names, or it can be written" % asked["to"], None, evidence)
    facts = {field: line.get(field) for field in ("commit", "binary", "bytes", "content_sha256", "version", "resolves")}
    return {"verdict": "green", "why": None, "detail": "jigc %s, sha256 %s" % (facts["version"], facts["content_sha256"]), "facts": facts, "evidence": evidence}


def judged_probe(root, name, asked, code, output):
    line = own_line(whole(output).decode("utf-8", "replace"))
    if line is None or (line.get("act"), line.get("status"), line.get("name")) != ("hold", "held", name):
        return void("no-verdict", "the output does not end with the last line of `dev/stabilize-probe hold` under this name")
    evidence = {"line": line}
    if code != 0:
        return void("exit-differs", "the hold printed its last line, and the command exited %s" % code, None, evidence)
    if line.get("seconds") != int(asked["seconds"]):
        return void("not-asked", "the hold was of %s seconds, and %s were asked" % (line.get("seconds"), asked["seconds"]), None, evidence)
    return {"verdict": "green", "why": None, "detail": "held %s seconds" % asked["seconds"], "facts": {"seconds": int(asked["seconds"])}, "evidence": evidence}


JUDGES = {"gate": judged_gate, "regression": judged_regression, "build": judged_build, "probe": judged_probe}


def held_command(kind, name, asked, scratch):
    """THE COMMAND of a held kind, from what the kind takes — the tool's own argument list,
    and never a caller's text: nothing an agent types is run."""
    if kind == "gate":
        return [GATE, "--keep-going"]
    if kind == "regression":
        return [REGRESSION, "run", "--previous", asked["previous"], "--candidate", asked["candidate"], "--list", asked["list"], "--scratch", os.path.join(scratch, "hold", name, "work")]
    if kind == "build":
        return [BUILD, "build", "--scratch", scratch, "--commit", asked["commit"], "--work", "hold/%s/work" % name, "--to", asked["to"]] + (["--version", asked["version"]] if "version" in asked else [])
    return [PROBE, "hold", "--scratch", scratch, "--name", name, "--seconds", asked["seconds"]]


def supervise(home, argv):
    """THE SUPERVISOR of a held command — this process, forked: in a session of its own,
    with nothing of its starter's open but the job's lock, which it holds for as long as it
    lives. It runs the command with both streams in the job's file, writes down how the
    command ended, and is gone. IT NEVER RETURNS: no line of the act is printed twice."""
    ended = 1
    try:
        os.setsid()
        out = os.open(os.path.join(home, "output"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        null = os.open(os.devnull, os.O_RDWR)
        for kept, stream in ((null, 0), (out, 1), (out, 2)):
            os.dup2(kept, stream)
        began = time.time()
        code = streamed(argv, ROOT)
        kept_once(os.path.join(home, "exit.json"), json.dumps({"exit": code if code >= 0 else None, "signal": -code if code < 0 else None, "began": began, "ended": time.time()}))
        ended = 0
    finally:
        os._exit(ended)


def read_job(home, name):
    """A job's record, as its `hold-start` wrote it."""
    try:
        job = json.loads(whole(os.path.join(home, "job.json")).decode("utf-8"))
        job["kind"], job["asked"], job["pid"]
    except (OSError, ValueError, KeyError, TypeError):
        refuse("missing", "the held command `%s` has no record this tool wrote: %s holds no `job.json` of it" % (name, home), "", "a start that was killed before it wrote its record leaves a name nothing is started under again: the stage names the next")
    return job


def job_of(root, name):
    """The record of the held command `name` under the resolved root — read while no start
    is under way (the lock of `<root>/hold`)."""
    holds = os.path.join(root, "hold")
    home = os.path.join(holds, name)
    if os.path.islink(holds) or os.path.islink(home):
        refuse("usage", "`%s` is a link: a held command's files lie under the scratch root the act resolved" % (holds if os.path.islink(holds) else home), "", "what was planted beneath the root is removed by whoever planted it, or the act is handed another root")
    if not os.path.isdir(home):
        refuse("missing", "no held command named `%s` was started under `%s`" % (name, root), "", "`dev/stabilize-step hold-start` starts one; a wait names the job its start named")
    mutex = os.open(holds, os.O_RDONLY)
    try:
        fcntl.flock(mutex, fcntl.LOCK_SH)
        return read_job(home, name)
    finally:
        os.close(mutex)


def stands(root, name, job, wait):
    """WHAT BECAME OF A HELD COMMAND, from its own files, asked within `wait` seconds:
    `running` while its supervisor holds the job's lock; `done` once the lock is free and
    the supervisor wrote how the command ended — with the tool's verdict, read once and
    kept; `dead` where the lock is free and it did not, or a signal ended the command."""
    home = os.path.join(root, "hold", name)
    facts = {"name": name, "kind": job["kind"], "pid": job["pid"], "output": "hold/%s/output" % name}
    lock = os.open(os.path.join(home, "lock"), os.O_RDONLY)
    asked = time.monotonic()
    try:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
                break
            except OSError:
                left = wait - (time.monotonic() - asked)
                if left <= 0:
                    return dict(facts, status="running", waited=wait)
                time.sleep(min(POLL, left))
        facts.update(waited=min(int(time.monotonic() - asked), wait))
        try:
            ended = json.loads(whole(os.path.join(home, "exit.json")).decode("utf-8"))
            code, signal = ended["exit"], ended["signal"]
        except (OSError, ValueError, KeyError, TypeError):
            return dict(facts, status="dead", why="no-exit")
        if signal is not None:
            return dict(facts, status="dead", why="killed", signal=signal)
        # THE VERDICT, READ ONCE: under the job's lock, which is free now, so that a
        # second reader reads what the first one kept and never half of it.
        fcntl.flock(lock, fcntl.LOCK_EX)
        kept = os.path.join(home, "verdict.json")
        if not os.path.isfile(kept):
            output = os.path.join(home, "output")
            verdict = JUDGES[job["kind"]](root, name, job["asked"], code, output)
            kept_once(kept, hashed(dict({"tool": PROG, "name": name, "kind": job["kind"], "asked": job["asked"], "exit": code, "seconds": int(ended["ended"] - ended["began"])}, **verdict, output=facts["output"], output_sha256=hashlib.sha256(whole(output)).hexdigest())) + "\n")
        text = whole(kept)
        try:
            verdict = json.loads(text.decode("utf-8"))
            facts.update({field: verdict[field] for field in ("exit", "seconds", "verdict", "why", "detail", "facts")})
        except (ValueError, KeyError, TypeError):
            refuse("missing", "the verdict of the held command `%s` is not the line this tool kept: %s was written by something else, and is not read on a guess" % (name, kept), "", "a verdict is written once and never again: the stage that held the command is invoked again, and names the next")
        return dict(facts, status="done", verdict_file="hold/%s/verdict.json" % name, verdict_sha256=hashlib.sha256(text).hexdigest())
    finally:
        os.close(lock)


def hold_start(args, facts):
    root = scratch_root(args.scratch)
    kind = next(row for row in HOLDS if row["kind"] == args.kind)
    asked = {}
    for flag in HOLD_FLAGS:
        value = getattr(args, flag)
        if value is None and flag in kind["takes"]:
            refuse("usage", "a held `%s` takes --%s — see dev/stabilize-step --help" % (args.kind, flag))
        if value is not None and flag not in kind["takes"] + kind["may"]:
            refuse("usage", "--%s is no argument of a held `%s` — see dev/stabilize-step --help" % (flag, args.kind))
        if value is not None:
            asked[flag] = value
    if "to" in asked:
        under(root, asked["to"])
    holds = os.path.dirname(under(root, "hold/" + args.name))
    home = os.path.join(holds, args.name)
    facts.update(name=args.name, kind=args.kind, slice=SLICE)
    mutex = os.open(holds, os.O_RDONLY)
    try:
        # ONE START AT A TIME under a root, so that a name is taken once: whoever asks
        # second finds the job the first one started, whole.
        fcntl.flock(mutex, fcntl.LOCK_EX)
        if os.path.lexists(home):
            # ASKED AGAIN: the job that is there, and nothing is started.
            job = read_job(home, args.name)
            if (job["kind"], job["asked"]) != (args.kind, asked):
                refuse("taken", "a held command named `%s` was started under `%s` as a `%s` with other arguments: a name is one command's" % (args.name, root, job["kind"]), "its record: %s" % json.dumps({"kind": job["kind"], "asked": job["asked"]}), "nothing was started. The command that is there is waited for under its own arguments, or this one is started under a name of its own")
            fcntl.flock(mutex, fcntl.LOCK_UN)
            facts.update(stands(root, args.name, job, 0))
            return
        try:
            os.mkdir(home)
            os.mkdir(os.path.join(home, "work"))
            lock = os.open(os.path.join(home, "lock"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except OSError as err:
            refuse("usage", "the files of the held command `%s` cannot be made under `%s`: %s" % (args.name, root, " ".join(str(err).split())), "", "nothing was started; the act is handed a scratch root it can write under")
        # THE JOB'S LOCK, taken before the supervisor exists and handed to it by the fork:
        # from the first moment the job is there it is held, and for as long as the
        # supervisor lives.
        fcntl.flock(lock, fcntl.LOCK_EX)
        argv = held_command(args.kind, args.name, asked, args.scratch)
        pid = os.fork()
        if pid == 0:
            os.close(mutex)
            supervise(home, argv)
        os.close(lock)
        kept_once(os.path.join(home, "job.json"), json.dumps({"name": args.name, "kind": args.kind, "asked": asked, "pid": pid, "started": time.time()}))
        facts.update(status="started", pid=pid, output="hold/%s/output" % args.name)
    finally:
        fcntl.flock(mutex, fcntl.LOCK_UN)
        os.close(mutex)


def hold_wait(args, facts):
    root = scratch_root(args.scratch)
    wait = SLICE if args.slice is None else int(args.slice)
    if wait > SLICE:
        refuse("usage", "--slice %s is longer than the %d seconds a wait is bounded by: the slice is the tool's, and an agent only shortens it — see dev/stabilize-step --help" % (args.slice, SLICE))
    facts.update(slice=wait)
    facts.update(stands(root, args.name, job_of(root, args.name), wait))


def hash_file(args, facts):
    root = scratch_root(args.scratch)
    path = os.path.join(root, args.file)
    if os.path.realpath(path) != path:
        refuse("usage", "`%s` does not lie under the scratch root `%s`: a link stands on the way to it" % (args.file, root))
    if not os.path.isfile(path):
        refuse("missing", "`%s` is no file under the scratch root `%s`" % (args.file, root))
    data = whole(path)
    facts.update(status="hashed", path=args.file, bytes=len(data), content_sha256=hashlib.sha256(data).hexdigest())


def build(args, facts):
    root = scratch_root(args.scratch)
    tarball = under(root, args.work + "/source.tar")
    target = under(root, args.to)
    work = os.path.dirname(tarball)
    source, made = os.path.join(work, "source"), os.path.join(work, "target", "release", "jigc")
    facts.update(commit=args.commit, binary=args.to)
    for there in (target, tarball, source):
        if os.path.lexists(there):
            refuse("taken", "`%s` is there already: a binary is written once, and a work directory holds one build" % there, "", "nothing was built. A held build that is done answers with its verdict when it is asked for again by its name; another build takes a path of its own")
    # 1. The commit, unpacked: never the working tree.
    said("archive", "--format=tar", "-o", tarball, args.commit)
    try:
        os.mkdir(source)
        with tarfile.open(tarball) as archive:
            archive.extractall(source, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
    except (OSError, tarfile.TarError) as err:
        refuse("build", "the archive of the commit %s could not be unpacked under the scratch root: %s" % (args.commit, " ".join(str(err).split())), "", "no binary was written")
    # 2. The build, in that tree, into a target directory of its own.
    with open(os.path.join(work, "cargo.log"), "x", encoding="utf-8") as log:
        code = streamed(["cargo", "build", "--release", "--locked", "--bin", "jigc", "--target-dir", os.path.join(work, "target")], source, log)
    told = "cargo's output is %s/cargo.log, under the scratch root" % args.work
    if code != 0 or not os.path.isfile(made):
        refuse("build", "the commit %s did not build: `cargo build --release --locked --bin jigc` exited %d%s" % (args.commit, code, "" if code else ", and left no binary"), told, "a build that fails is nobody's to repair inside a stage: no instrument runs without the binary")
    # 3. The version it prints: `jigc <version>` — the one asked, where one is.
    printed = run([made, "--version"])
    version = re.fullmatch(r"jigc (%s)" % PLAIN_VALUES["version"][0].pattern, printed.out.strip()) if printed.code == 0 else None
    if version is None or args.version not in (None, version.group(1)):
        refuse("build", "the binary of the commit %s prints %s for `--version`%s" % (args.commit, json.dumps(printed.out.strip()), ", and `jigc %s` was asked" % args.version if args.version else ", which is no `jigc <version>`"), printed.shown()[:400], "a binary that is not of the version asked is not the one the run names: no binary was written")
    # 4. The binary, written once, read-only — and what a bare `jigc` resolves to with its
    #    directory first on the PATH.
    data = whole(made)
    try:
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o555), "wb") as file:
            file.write(data)
    except FileExistsError:
        refuse("taken", "`%s` is there already: a binary is written once" % target, "", "another build wrote it while this one ran: its own job answers for it")
    first = next((found for found in (os.path.join(directory, "jigc") for directory in [os.path.dirname(target)] + os.environ.get("PATH", "").split(os.pathsep)) if os.path.isfile(found) and os.access(found, os.X_OK)), None)
    if first != target:
        refuse("build", "with its directory first on the PATH, a bare `jigc` resolves to %s and not to the binary at %s" % (first, args.to), "", "the binary is at its path and nothing else was changed")
    facts.update(status="built", bytes=len(data), content_sha256=hashlib.sha256(data).hexdigest(), version=version.group(1), resolves=True)


