# --- running a command --------------------------------------------------------


class Ran:
    def __init__(self, argv, code, out, err):
        self.argv = argv
        self.code = code
        self.out = out
        self.err = err

    def shown(self):
        """The command and everything it printed, for a halt's evidence."""
        said = (self.out + self.err).strip()
        return "`%s` exited %d%s" % (" ".join(self.argv), self.code, ": " + said if said else "")


def run(argv, fed=None):
    """One command, from the repository's root: its exit status and what it printed. It
    reads nothing, unless it is `fed` a text."""
    done = subprocess.run(argv, cwd=ROOT, capture_output=True, text=True, encoding="utf-8", errors="replace", **({"stdin": subprocess.DEVNULL} if fed is None else {"input": fed}))
    return Ran([os.path.relpath(argv[0], ROOT) if os.path.isabs(argv[0]) else argv[0]] + list(argv[1:]), done.returncode, done.stdout, done.stderr)


def git(*argv):
    """A git command whose exit status is an answer the act reads."""
    return run(["git"] + list(argv))


def said(*argv):
    """A git command that must succeed: what it printed, without its last line break."""
    ran = git(*argv)
    if ran.code != 0:
        refuse("git", "a git command the step runs failed", ran.shown())
    return ran.out.rstrip("\n")


def lines(text):
    return [line for line in text.split("\n") if line]


def answers(ran, yes=0, no=1):
    """A git command that answers yes or no by its exit status; any other status is a
    command that failed."""
    if ran.code not in (yes, no):
        refuse("git", "a git command the step runs failed", ran.shown())
    return ran.code == yes


# --- the checks several acts share --------------------------------------------


def checked_out(branch, facts):
    """THE FIRST THING AN ACT ASKS: the branch checked out is the one it names — before it
    reads anything else, and before any write, fetch or push."""
    current = said("branch", "--show-current")
    if current != branch:
        refuse_as(facts, "wrong-branch", "`%s` is checked out, and the step works on `%s`" % (current, branch), "`git branch --show-current` printed `%s`" % current)
    return current


def unlocked(facts):
    """git's own lock does not stand in the repository. A lock that is still there after a
    moment is named and left: the tool never removes one."""
    lock = said("rev-parse", "--git-path", "index.lock")
    for _ in range(LOCK_WAITS):
        if not os.path.lexists(os.path.join(ROOT, lock)):
            return
        time.sleep(LOCK_WAIT)
    refuse_as(facts, "git-lock", "git's own lock stands in the repository: %s" % lock, "`git rev-parse --git-path index.lock` printed `%s`, and that file was there for %.0f s" % (lock, LOCK_WAITS * LOCK_WAIT))


def heads(listed, branch):
    """The shas `git ls-remote --heads` listed for exactly this branch."""
    return [line.split("\t")[0] for line in lines(listed) if line.split("\t")[1:] == ["refs/heads/" + branch]]


def pushed_is_not_ahead(branch, facts):
    """A branch that is pushed has no commit the local one lacks. One that is not pushed
    yet has nothing to compare. Returns the sha the pushed branch stands at, or None."""
    listing = git("ls-remote", "--exit-code", "--heads", "origin", branch)
    if not answers(listing, no=NO_SUCH_REF):
        return None
    said("fetch", "origin", branch)
    behind = git("merge-base", "--is-ancestor", "origin/" + branch, branch)
    if not answers(behind):
        refuse_as(facts, "remote-ahead", "the pushed `%s` has commits the local one lacks" % branch, behind.shown())
    return (heads(listing.out, branch) or [None])[0]


def records_only(branch, run_dir, facts):
    """Every commit of the branch that no branch of the remote holds yet is A RECORD'S: it
    changes nothing outside the run's directory, and is no merge. A commit that is not is
    some task's, behind that task's own gate — the tool pushes no such commit, and no
    record beside one."""
    foreign = lines(said("log", "--format=%H", branch, "--not", "--remotes=origin", "--", ".", ":(exclude)" + run_dir))
    foreign += [merge for merge in lines(said("rev-list", "--merges", branch, "--not", "--remotes=origin")) if merge not in foreign]
    if foreign:
        refuse_as(facts, "foreign-commit", "`%s` is ahead of its remote by %d commit(s) that are no record's — each changes a path outside %s, or is a merge: %s" % (branch, len(foreign), run_dir, ", ".join(foreign)), "`git log --format=%%H %s --not --remotes=origin -- . ':(exclude)%s'` and `git rev-list --merges %s --not --remotes=origin`" % (branch, run_dir, branch), branch=branch)


def vetted(asking, undone):
    """What a vet of `dev/stabilize-record` answered — its `vet`, or its `set-aside`. A
    scanner that could not run is never a pass; `undone` says what was then not done."""
    if asking.code == DID_NOT_RUN:
        refuse("did-not-run", "a public-hygiene scanner could not run: %s" % undone, asking.shown(), "a scan that did not run is never a pass. With the denylist and gitleaks in place (implementation/public-hygiene.md -> The guard) the same step is asked for again, and nothing else is needed: it left everything as it found it")
    try:
        answer = json.loads(asking.out) if asking.code in (0, VET_MISMATCH) else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        refuse("record", "dev/stabilize-record could not vet what the step would publish", asking.shown())
    return answer


def places(refused):
    """What a vet refused, by where and never by what: each place, and the writer's word."""
    return "; ".join("%s (%s)" % (" ".join(part for part in (found.get("commit"), found.get("path") or ("its message" if found.get("commit") else "")) if part) or "the range", found.get("why")) for found in refused)


def written_once(status, pending):
    """The files of the run that are written once and that no commit holds: the untracked
    lines of `git status --porcelain` that `dev/stabilize-record pending` names."""
    once = pending.get("once") or []
    return [line[3:] for line in lines(status) if line.startswith("?? ") and line[3:] in once]


def set_aside(run_name, paths, scratch, undone):
    """THE REPORT CHECK'S VET: of `paths` — written-once files of the run — each that the
    record script would not have written is moved out of the tree by that script. What it
    answered: {aside: [{path, why, detail, to}], vetted}."""
    if not paths:
        return {"aside": [], "vetted": {}}
    return vetted(run([RECORD, "set-aside", "--run", run_name] + (["--to", scratch + "/refused"] if scratch else []) + ["--"] + paths), undone)


def push(branch, facts):
    """The branch pushed by name — once every commit the push would publish is vetted —
    and the remote read back: the sha it stands at."""
    unpushed = lines(said("rev-list", "--reverse", branch, "--not", "--remotes=origin"))
    if unpushed:
        vet = vetted(run([RECORD, "vet", "--range", "--", branch, "--not", "--remotes=origin"]), "nothing was pushed")
        if vet.get("ok") is not True:
            facts.update(vet=vet)
            note(facts, "unvetted")
            refuse("unvetted", "`%s` would publish what dev/stabilize-record would not have written, in %d of the %d commit(s) the remote does not hold yet: %s" % (branch, len({found.get("commit") for found in vet.get("refused") or []}), len(unpushed), places(vet.get("refused") or [])), "`dev/stabilize-record vet --range` answered: %s" % json.dumps(vet.get("refused")), "nothing was pushed, and it is the human's: the commit is local, and rewriting it or taking it back is his to confirm — a hit is fixed before the push, never after (implementation/public-hygiene.md). `dev/stabilize-record vet --range -- %s --not --remotes=origin` names every commit and place again, pushes nothing, and answers ok once nothing unvetted is left; then this step is asked for again" % branch)
    facts.update(vetted=unpushed)
    pushing = git("push", "origin", branch)
    if pushing.code != 0:
        refuse("push-rejected", "the remote did not take `%s`" % branch, pushing.shown(), "the human looks at the remote; a push is never forced")
    listed = said("ls-remote", "--exit-code", "--heads", "origin", branch)
    local = said("rev-parse", branch)
    if heads(listed, branch) != [local]:
        refuse("remote-differs", "after the push origin's `%s` does not stand at the local head %s" % (branch, local), "`git ls-remote` printed: %s" % (listed or "(nothing)"))
    facts["remote_head"] = local


def pending_of(run_name):
    """What of the run is written and in no commit yet, as dev/stabilize-record says it."""
    asking = run([RECORD, "pending", "--run", run_name])
    try:
        pending = json.loads(asking.out) if asking.code == 0 else None
    except ValueError:
        pending = None
    if not isinstance(pending, dict):
        refuse("record", "dev/stabilize-record could not say what of the run is pending", asking.shown())
    return pending


def arrived(run_dir, facts, look=False):
    """THE RUN'S PENDING WRITES, as dev/stabilize-record says them — ONCE EVERY WRITE OF
    THAT SCRIPT THAT WAS KILLED IS FINISHED: a batch half in place is put in place, one
    half taken back is taken back, and the temporaries of a write killed before its
    journal are removed (`recover`: the arrival states `interrupted-write` and
    `stray-temporaries`). An act that only looks finishes nothing, and says what is owed."""
    run_name = os.path.basename(run_dir)
    pending = pending_of(run_name)
    killed = [state for state, there in (("interrupted-write", pending.get("interrupted")), ("stray-temporaries", pending.get("temporaries"))) if there]
    if not killed or look:
        for state in killed:
            note(facts, state, "owed")
        return pending
    recovering = run([RECORD, "recover", "--run", run_name])
    if recovering.code != 0:
        refuse("record", "a write of the run's record was killed, and dev/stabilize-record could not finish it", recovering.shown())
    for state in killed:
        note(facts, state, "finished")
    return pending_of(run_name)


def admitted(status, pending, facts):
    """(the written-once files no commit holds, the files of the applied batch that differ
    from HEAD, which of both are in the index) a tree holds — THE RUN'S PENDING WRITES, in
    the header's words. Any other line of `git status --porcelain` is a tree the step does
    not start from."""
    batch = pending.get("batch") or {}
    once, files, altered = pending.get("once") or [], batch.get("files") or {}, batch.get("altered") or []
    untracked, held, staged, other = [], [], [], []
    for line in lines(status):
        code, path = line[:2], line[3:]
        if code == "??" and (path == pending.get("journal") or path in (pending.get("temporaries") or [])):
            continue
        if code == "??" and path in once:
            untracked.append(path)
        elif batch and code in ("A ", "AM") and path in once:
            # THE ACT'S OWN STAGED LINES: what the commit step of the open record staged,
            # and did not commit. It stages them again from the tree, and vets what it staged.
            untracked.append(path)
            staged.append(path)
        elif code in ("??", " M", "A ", "M ", "AM", "MM") and path in files and path not in altered:
            held.append(path)
            staged += [path] if code[0] in "AM" else []
        else:
            other.append(line)
    if other:
        refuse_as(facts, "dirty", "the tree holds more than what dev/stabilize-record wrote and no commit holds yet: %s" % "; ".join(other), "`git status --porcelain --untracked-files=all` printed: %s" % " | ".join(lines(status)))
    return untracked, held, staged


def standing(pending, facts, **names):
    """WHERE THE OPEN ACT STANDS, from git and the journal and never from a flag: (the
    written-once files pending, the batch's files pending, the arrival state). The state is
    None with no batch; `applied`, or `staged` where paths of the record are in the index;
    `committed` where every file of the batch is in HEAD as the batch wrote it — none of
    them differs from HEAD, and none from what the batch wrote. A file of the batch that
    is no longer what the batch wrote is the human's (`altered`)."""
    batch = pending.get("batch")
    if batch and not any(act["act"] == batch.get("act") and act["phases"] for act in ACTS):
        refuse("record", "the journal names an open act this tool has no phases for: %s" % json.dumps(batch.get("act")), "`dev/stabilize-record pending`")
    if batch and batch["altered"]:
        refuse_as(facts, "altered", "a file of the applied batch is no longer what the batch wrote: %s" % ", ".join(batch["altered"]), "`dev/stabilize-record pending` names it as altered: its content is not the one the journal holds a hash of", **names)
    untracked, held, staged = admitted(said("status", "--porcelain", "--untracked-files=all"), pending, facts)
    return untracked, held, (("staged" if staged else "applied") if held else "committed") if batch else None


def settled(run_name, what):
    """The batch's commit is made: the record script forgets the batch."""
    settling = run([RECORD, "settle", "--run", run_name])
    if settling.code != 0:
        refuse("record", "%s, and dev/stabilize-record could not settle its batch" % what, settling.shown())


def taken_back(run_name, paths):
    """THE BATCH TAKEN BACK: what a commit step staged of it is unstaged — the index, never
    the tree, and those paths only — and then every file of it is as it was before the
    batch (`dev/stabilize-record discard`). What that script said it took back."""
    if paths:
        said("restore", "--staged", "--", *paths)
    discarding = run([RECORD, "discard", "--run", run_name])
    try:
        discarded = json.loads(discarding.out)["discarded"] if discarding.code == 0 else None
    except (ValueError, KeyError, TypeError):
        discarded = None
    if not isinstance(discarded, list):
        refuse("record", "dev/stabilize-record could not take the applied batch back", discarding.shown())
    return discarded


def clean(status, command):
    if status:
        refuse("dirty", "the tree is not clean: %s" % "; ".join(lines(status)), "`%s` printed: %s" % (command, " | ".join(lines(status))))


def merge(target, logs, facts):
    """`target` merged into the branch checked out, with a merge commit. A merge that
    stops is resolved by dev/merge-logs when every conflicted path is one of `logs`, and
    is aborted otherwise. Returns the logs it resolved."""
    merging = git("merge", "--no-ff", "--no-edit", target)
    if merging.code == 0:
        return []
    conflicted = lines(said("diff", "--name-only", "--diff-filter=U"))
    if not conflicted or any(path not in logs for path in conflicted):
        aborted = git("merge", "--abort")
        refuse("conflict", "the merge of `%s` stopped, and not on the append-only logs alone: %s" % (target, ", ".join(conflicted) or "no conflicted path"), "%s; %s" % (merging.shown(), aborted.shown()), "a conflict outside the append-only logs is the human's")
    resolving = run([MERGE_LOGS])
    if resolving.code != 0:
        aborted = git("merge", "--abort")
        refuse("merge-logs", "dev/merge-logs refused the conflict in %s" % ", ".join(conflicted), "%s; %s" % (resolving.shown(), aborted.shown()), "a hunk that is not a pure append is the human's")
    left = lines(said("diff", "--name-only", "--diff-filter=U"))
    if left:
        refuse("unresolved", "dev/merge-logs exited 0 and left conflicted: %s" % ", ".join(left), resolving.shown(), "the merge is still in progress, as the step left it")
    said("commit", "--no-edit")
    facts["resolved_logs"] = conflicted
    return conflicted


def two_parents(parents, first, second):
    """A merge commit's parents, as `git rev-list --parents -n 1 HEAD` listed them."""
    if parents.split()[1:] != [first, second]:
        refuse("merge-differs", "the merge commit's parents are not %s and %s" % (first, second), "`git rev-list --parents -n 1 HEAD` printed: %s" % parents, "nothing was undone: the merge is on the local branch")


def same(ran, what):
    """`git diff --quiet`: 0 the same, 1 different — which the step refuses."""
    if not answers(ran):
        refuse("merge-differs", what, ran.shown(), "nothing was undone: the merge is on the local branch")


# --- the acts -----------------------------------------------------------------


def git_state(args, facts):
    run_name = os.path.basename(args.run_dir)
    facts.update(found=[], finished=[], owed=[])
    # 1. The branch checked out — before anything else is read, written, fetched or pushed.
    current = said("branch", "--show-current")
    if current != args.loop and not (args.stage == "fix" and current.startswith(args.rounds)):
        refuse_as(facts, "wrong-branch", "`%s` is checked out: the `%s` stage starts from %s" % (current, args.stage, "the loop branch `%s`" % args.loop if args.stage == "test" else "`%s` or a round's branch, `%s…`" % (args.loop, args.rounds)), "`git branch --show-current` printed `%s`" % current)
    # 2. git's own lock.
    unlocked(facts)
    # 3. What a killed write of the record script left: finished first — or, by an
    #    invocation that only looks, named as owed; the tree is then not read across it.
    pending = arrived(args.run_dir, facts, args.look)
    read = not (args.look and pending.get("interrupted"))
    # 4. The tree, and where the open act stands: a batch whose commit is made is settled.
    untracked, held, state = standing(pending, facts, branch=current, run_dir=args.run_dir) if read else (None, None, None)
    batch = pending.get("batch") if read else None
    if state == "committed" and args.look:
        note(facts, state, "owed")
    elif state == "committed":
        settled(run_name, "the commit of the applied batch is made")
        note(facts, state, "finished")
    elif state:
        note(facts, state, "owed")
    # 5. The pushed loop branch.
    remote = pushed_is_not_ahead(args.loop, facts)
    # 6. The commit that added the run's opening record.
    opening = said("log", "--diff-filter=A", "--format=%H", "-n", "1", args.loop, "--", args.run_dir + "/opening.md")
    if opening:
        # 7. The path-class assert: product paths move only through a round's merge.
        since = opening + ".." + args.loop
        direct = lines(said("log", "--first-parent", "--no-merges", "--format=%H", since, "--", *args.product))
        if direct:
            shown = [said("show", "--stat", "--format=%s", sha, "--", *args.product) for sha in direct]
            refuse("product-path", "commit(s) changed a product path directly on `%s`: %s" % (args.loop, ", ".join(direct)), " | ".join(" ".join(text.split()) for text in shown), "a product path moves only through an audited round's merge")
        foreign = [subject for subject in lines(said("log", "--first-parent", "--merges", "--format=%s", since)) if not subject.startswith("Merge branch '" + args.rounds)]
        if foreign:
            refuse("foreign-merge", "a merge on `%s` is not a round's: %s" % (args.loop, "; ".join(foreign)), "`git log --first-parent --merges --format=%%s %s`" % since)
    # 8. What the remote lacks of the `test` stage's loop branch — the last phase of a
    #    record: every commit of it is a record's, and the push that is owed is made.
    #    (A round's branch, and the loop branch under `fix`, are that half's cells.)
    if args.stage == "test" and opening and remote != said("rev-parse", args.loop):
        records_only(args.loop, args.run_dir, facts)
        if args.look or state in ("applied", "staged"):
            note(facts, "unpushed", "owed")
        else:
            note(facts, "unpushed")
            push(args.loop, facts)
            note(facts, "unpushed", "finished")
            remote = facts.pop("remote_head")
    # 9. The report.
    facts.update(status="ready", branch=current, head=said("rev-parse", "HEAD"), loop_head=said("rev-parse", args.loop), remote_head=remote, opening=opening, untracked=untracked)
    facts.update(pending={"round": batch["round"], "subject": batch["subject"], "calls": batch["calls"], "checks": batch["checks"], "files": held} if state in ("applied", "staged") else None)


def state(args, facts):
    directory = os.path.join(args.scratch, "state")
    os.makedirs(directory, exist_ok=True)
    reading = run([RECORD, "state", "--run", args.run])
    if reading.code != 0:
        refuse("record", "dev/stabilize-record could not read the run's state", reading.shown())
    try:
        document = json.loads(reading.out)
    except ValueError:
        document = None
    if not isinstance(document, dict) or len(lines(reading.out)) != 1:
        refuse("record", "dev/stabilize-record state did not print one line of JSON", reading.shown())
    path = os.path.join(directory, args.tag + ".json")
    with open(path, "w", encoding="utf-8") as file:
        file.write(reading.out)
    facts.update(status="read", branch=said("branch", "--show-current"), file=path, state=document)


def stage_flags(args):
    flags = ["--run", args.run, "--round", args.round, "--stage", args.stage]
    if args.cycle is not None:
        flags += ["--cycle", args.cycle]
    return flags


def begin(args, facts):
    # 1. Where the state hands the stage: this round, this attempt — and no refusal.
    reading = run([RECORD, "state", "--run", args.run])
    try:
        document = json.loads(reading.out) if reading.code == 0 else None
    except ValueError:
        document = None
    if not isinstance(document, dict):
        refuse("record", "dev/stabilize-record could not read the run's state", reading.shown())
    at = (document.get("position") or {}).get(args.stage)
    wanted = {"round": args.round, "attempt": args.attempt}
    if args.stage == "fix":
        wanted["cycle"] = args.cycle
    if not isinstance(at, dict) or "refused" in at or any(str(at.get(name)) != value for name, value in wanted.items()):
        refuse("position", "the run's state does not hand the `%s` stage %s: its position is %s%s" % (args.stage, ", ".join("%s %s" % pair for pair in wanted.items()), json.dumps(at), " — the opening still owes %s" % ", ".join(document["not_ready"]) if document.get("not_ready") else ""), reading.shown()[:400], "nothing was written; the stage is invoked again and reads the state as it stands")
    # 2. The marker: the attempt is on record before any agent of it is launched.
    text = "# attempt %s of the `%s` stage, round %s\n\nThe harness began this attempt on the commit %s, before it launched an agent. What the attempt's agents wrote lies beside this file under the same attempt number; an attempt that reached its record is named in the round's record, and one that did not is counted from this file.\n\n<!-- end of report -->\n" % (args.attempt, args.stage if args.cycle is None else "%s (cycle %s)" % (args.stage, args.cycle), args.round, args.commit)
    writing = run([RECORD, "report"] + stage_flags(args) + ["--reporter", args.reporter, "--attempt", args.attempt, "--scratch", args.scratch], fed=text)
    if writing.code != 0 or len(lines(writing.out)) != 1:
        refuse("record", "the attempt could not be put on record", writing.shown(), "an attempt whose marker is there already was begun — by an earlier try of this step, or by another invocation: the stage is invoked again, and the state gives the next attempt")
    facts.update(status="begun", round=args.round, attempt=args.attempt, report=writing.out.strip())


def check_reports(args, facts):
    # 1. What is pending and written once, vetted: a file there that the record script
    #    would not have written is no report, and leaves the tree.
    once = written_once(said("status", "--porcelain", "--untracked-files=all"), arrived(args.run, facts))
    aside = set_aside(args.run, once, args.scratch, "no report was vetted, and none was moved")
    facts.update(aside=aside.get("aside") or [])
    # 2. The check: a reporter whose file left has left none.
    flags = stage_flags(args)
    checking = run([RECORD, "check-reports"] + flags + ["--attempt", args.attempt, "--"] + args.names)
    try:
        check = json.loads(checking.out) if checking.code in (0, REPORTS_MISMATCH) else None
    except ValueError:
        check = None
    if not isinstance(check, dict):
        refuse("record", "dev/stabilize-record could not check the stage's reports", checking.shown())
    facts.update(status="checked", check=check)


def find_round(args, facts):
    local = lines(said("branch", "--list", args.prefix + "*", "--format=%(refname:short)"))
    listed = lines(said("ls-remote", "--heads", "origin", args.prefix + "*"))
    remote = [line.split("\t")[1][len("refs/heads/"):] for line in listed]
    facts.update(status="ready", branch=said("branch", "--show-current"), head=said("rev-parse", "HEAD"), local=local, remote=remote)


def open_round(args, facts):
    _, held, _ = admitted(said("status", "--porcelain", "--untracked-files=all"), arrived(args.run_dir, facts), facts)
    if held:
        refuse("dirty", "a record's batch is applied and not committed: %s" % ", ".join(held), "`dev/stabilize-record pending`", "its record step commits it on the branch it was applied on, before any branch is opened")
    created = not answers(git("rev-parse", "--verify", "--quiet", "refs/heads/" + args.branch))
    if created:
        said("switch", args.loop)
        said("switch", "--no-track", "-c", args.branch, args.loop)
    else:
        said("switch", args.branch)
    facts.update(status="ready", branch=checked_out(args.branch, facts), head=said("rev-parse", "HEAD"), created=created)


def push_branch(args, facts):
    current = checked_out(args.branch, facts)
    pushed_is_not_ahead(args.branch, facts)
    if args.run_dir:
        # A RECORD'S PUSH publishes records, and nothing beside them.
        records_only(args.branch, args.run_dir, facts)
    push(args.branch, facts)
    facts.update(status="ready", branch=current, head=said("rev-parse", "HEAD"))


def land(args, facts):
    outside = ":(exclude)" + args.run_dir
    # 1. The tree, untracked files included.
    clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
    # 2. The round's tip, and the loop branch.
    round_head = said("rev-parse", args.branch)
    said("switch", args.loop)
    pre = said("rev-parse", "HEAD")
    # 3. The pushed loop branch.
    pushed_is_not_ahead(args.loop, facts)
    # 4. A round that landed before.
    if answers(git("merge-base", "--is-ancestor", args.branch, args.loop)):
        facts.update(status="landed-before", head=pre)
        return
    # 5. Whether the loop branch moved while the round was out, and where.
    tip_moved = not answers(git("merge-base", "--is-ancestor", args.loop, args.branch))
    fork = said("merge-base", args.loop, args.branch)
    moved_outside = lines(said("diff", "--name-only", fork, args.loop, "--", ".", outside))
    facts.update(tip_moved=tip_moved, moved_outside=moved_outside, resolved_logs=[])
    # 6-8. The merge.
    resolved = merge(args.branch, args.log, facts)
    # 9. The merge commit: its parents, the tree, and what it holds against the round's.
    merge_commit = said("rev-parse", "HEAD")
    facts.update(merge_commit=merge_commit)
    two_parents(said("rev-list", "--parents", "-n", "1", "HEAD"), pre, round_head)
    clean_after_merge = said("status", "--porcelain")
    if clean_after_merge:
        refuse("merge-differs", "the tree is not clean after the merge: %s" % "; ".join(lines(clean_after_merge)), "`git status --porcelain`", "nothing was undone: the merge is on the local branch")
    same(git("diff", "--quiet", "HEAD", args.branch, "--", *args.product), "what the merge holds on the product paths is not what `%s` holds: what lands is not exactly what was audited" % args.branch)
    if not moved_outside and not resolved:
        same(git("diff", "--quiet", "HEAD", args.branch, "--", ".", outside), "the merged tree differs from `%s` outside the run's directory" % args.branch)
    # 10-11. The push.
    push(args.loop, facts)
    # 12. The report.
    facts.update(status="merged", head=merge_commit)


def round_commits(args, facts):
    between = args.loop + ".." + args.branch
    merges = said("rev-list", "--merges", "--count", between)
    if merges != "0":
        refuse("merge-in-round", "`%s` holds %s merge commit(s)" % (between, merges), "`git rev-list --merges --count %s` printed %s" % (between, merges))
    everything = lines(said("log", "--reverse", "--format=%H", between))
    inside = lines(said("log", "--reverse", "--format=%H", between, "--", args.run_dir))
    outside = lines(said("log", "--reverse", "--format=%H", between, "--", ".", ":(exclude)" + args.run_dir))
    facts.update(status="listed", all=everything, inside=inside, outside=outside)


def carry(args, facts):
    # 1. The tree, untracked files included.
    clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
    # 2. The loop branch, and its pushed tip.
    said("switch", args.loop)
    pre = said("rev-parse", "HEAD")
    pushed_is_not_ahead(args.loop, facts)
    # 3. The commits, one by one.
    for sha in args.shas:
        picking = git("cherry-pick", "-x", sha)
        if picking.code != 0:
            aborted = git("cherry-pick", "--abort")
            refuse("pick-stopped", "the cherry-pick of %s stopped" % sha, "%s; %s" % (picking.shown(), aborted.shown()), "the commits carried before it stay on the local branch, unpushed")
    # 4. Exactly those, and nothing outside the run's directory.
    carried = pre + "..HEAD"
    count = said("rev-list", "--count", carried)
    if count != str(len(args.shas)):
        refuse("carry-differs", "%s commit(s) were carried, and %d were named" % (count, len(args.shas)), "`git rev-list --count %s` printed %s" % (carried, count), "nothing was undone")
    strays = [path for path in lines(said("diff", "--name-only", pre, "HEAD")) if not path.startswith(args.run_dir + "/")]
    if strays:
        refuse("carry-differs", "a carried commit changed a path outside the run's directory: %s" % ", ".join(strays), "`git diff --name-only %s HEAD`" % pre, "nothing was undone")
    touched = git("diff", "--quiet", pre, "HEAD", "--", *args.product)
    if not answers(touched):
        refuse("carry-differs", "a carried commit changed a product path", touched.shown(), "nothing was undone")
    # 5. The push.
    push(args.loop, facts)
    # 6. The report.
    facts.update(status="carried", branch=said("branch", "--show-current"), head=said("rev-parse", "HEAD"))
    made = lines(said("log", "--reverse", "--format=%H", carried))
    facts.update(picked=[{"from": sha, "to": to} for sha, to in zip(args.shas, made)])


def answered_before(args):
    """Where the answer of this commit step is kept once it is done: beside the file of the
    gate it was held to, which is one record step's own."""
    return args.gate + ".recorded.json"


def record(args, facts):
    run_name = os.path.basename(args.run_dir)
    facts.update(found=[], finished=[])
    # 1. The branch — before anything else is read or written.
    current = checked_out(args.branch, facts)
    # 2. git's own lock.
    unlocked(facts)
    # 3. What a killed write of the record script left, finished; then the applied batch.
    pending = arrived(args.run_dir, facts)
    batch = pending.get("batch")
    head = said("rev-parse", "HEAD")
    if not batch:
        # ASKED AGAIN AFTER IT WAS DONE: no batch, the tree clean, and HEAD the one commit
        # since the commit the stage began on — the commit this step answered with, of the
        # batch it names. Then it answers again what it answered then. Without --head
        # nothing says that the last commit is this record's, and there is nothing to record.
        try:
            kept = json.loads(open(answered_before(args), encoding="utf-8").read())
            applied = (kept["applied"]["calls"], len(kept["applied"]["checks"]))
        except (OSError, ValueError, KeyError, TypeError):
            kept, applied = {}, None
        if not (args.head is not None and applied == (int(args.calls), int(args.checks)) and (kept.get("branch"), kept.get("commit")) == (current, head) and said("rev-list", "--parents", "-n", "1", "HEAD").split()[1:] == [args.head]):
            refuse("no-batch", "run %s has no applied batch: there is nothing this step records" % run_name, "`dev/stabilize-record pending` printed no batch", "a record step applies its batch first (`dev/stabilize-record apply`)")
        clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
        note(facts, "recorded")
        facts.update(kept, status="recorded")
        return
    facts.update(round=batch["round"], applied={"calls": batch["calls"], "checks": batch["checks"]})
    failed = [check for check in batch["checks"] if not (isinstance(check, dict) and check.get("ok") is True)]
    if batch["calls"] != int(args.calls) or len(batch["checks"]) != int(args.checks) or failed:
        refuse("no-batch", "the applied batch is not the one this step records: it ran %d call(s) and %d check(s), %d of which do not hold, and the step names %s and %s" % (batch["calls"], len(batch["checks"]), len(failed), args.calls, args.checks), "`dev/stabilize-record pending` printed: %s" % json.dumps(facts["applied"]), "nothing was committed: `dev/stabilize-step discard --branch %s --run-dir %s` takes a batch back that no step of this stage applied" % (args.branch, args.run_dir))
    # 4. Where the act stands: the tree as exactly the run's pending writes — its own staged
    #    lines among them — or the batch in HEAD already.
    untracked, held, state = standing(pending, facts, branch=args.branch, run_dir=args.run_dir)
    note(facts, state)
    paths = sorted(untracked + held)
    # 5. The commit the stage began on: a record is committed on it, or not at all.
    files = sorted(batch["files"])
    commit = said("log", "-n", "1", "--format=%H", "--", *files) if state == "committed" else None
    began = said("rev-list", "--parents", "-n", "1", commit).split()[1:] if commit else [head]
    if args.head is not None and (began != [args.head] or commit not in (None, head)):
        refuse_as(facts, "head-moved", "`%s` is not at the commit the stage began on: the stage began on %s, and the branch stands at %s%s" % (args.branch, args.head, head, " — the commit that holds the batch is %s, on %s" % (commit, " and ".join(began) or "no parent") if commit else ""), "`git rev-parse HEAD` printed %s" % head)
    # 6. The gate that ran on this tree, held to the candidate's.
    flags = [] if batch["round"] is None else ["--round", str(batch["round"])]
    checking = run([RECORD, "gate-check", "--run", run_name, "--summary", args.gate] + flags)
    try:
        gate = json.loads(checking.out) if checking.code in (0, GATE_MISMATCH) else None
    except ValueError:
        gate = None
    if not isinstance(gate, dict):
        refuse("record", "dev/stabilize-record could not hold the gate's output to the candidate's gate", checking.shown(), "the batch stays applied and uncommitted: the step is asked for again once the full gate's whole output is in that file")
    facts.update(gate=gate)
    if checking.code != 0:
        refuse("gate-red", "the gate on the tree with the records shows red that the candidate's own gate did not: %s" % "; ".join(gate["new"]), checking.shown(), "nothing was committed or undone: the batch stays applied. A stage invoked again runs the gate on it once more and commits it if nothing is newly red; `dev/stabilize-step discard --branch %s --run-dir %s` takes the batch back instead" % (args.branch, args.run_dir))
    if state == "committed":
        # THE BATCH IS IN HEAD ALREADY — a commit step that was killed after its commit: it
        # is taken as recorded, and only its settling is left.
        paths = lines(said("show", "--name-only", "--format=", commit))
    else:
        facts.update(paths=paths)
        # 7. Every pending path by name, staged — again, where a step before this one
        #    staged them — and what is staged, vetted: the paths, the subject the batch
        #    carries, and the batch's report checks against the disk.
        subject = batch["subject"]
        said("add", "--", *paths)
        vetting = run([RECORD, "vet", "--run", run_name, "--subject=" + subject, "--"] + paths)
        moved = lines(git("diff", "--name-only", "--", *paths).out)
        if vetting.code != 0 or moved:
            # Nothing is committed. The step takes back what it staged, and then answers.
            said("restore", "--staged", "--", *paths)
            vet = vetted(vetting, "nothing was committed, and the batch stays applied")
            facts.update(vet=vet)
            # The exit: the batch back, and what is no report out of the tree, so that the
            # next attempt starts from a tree it can use.
            taken_back(run_name, [])
            aside = set_aside(run_name, untracked, args.scratch, "nothing was committed, and the batch is taken back")
            facts.update(aside=aside.get("aside") or [], discarded=True)
            hits = [places(vet.get("refused") or [])] if vet.get("refused") else []
            hits += ["the commit's subject (%s)" % vet["subject"].get("why")] if vet.get("subject") else []
            hits += ["the batch's report check of %s no longer holds — gone: %s; changed: %s" % (stale.get("dir"), ", ".join(stale.get("gone") or []) or "none", ", ".join(stale.get("changed") or []) or "none") for stale in vet.get("stale") or []]
            hits += ["changed while the step ran: %s" % ", ".join(moved)] if moved else []
            refuse("unvetted", "the record's commit would hold what dev/stabilize-record would not have written: %s" % "; ".join(hits), "`dev/stabilize-record vet` answered: %s" % json.dumps({name: vet.get(name) for name in ("refused", "subject", "stale")}), "nothing was committed, and nothing is left to undo: the batch is taken back (`dev/stabilize-record discard`), and what is no report was moved out of the tree (%s). `dev/stabilize-step git-state` answers for the tree, and the stage invoked again works the next attempt — the instruments run again, because their record was not made" % (", ".join(found["to"] for found in facts["aside"]) or "nothing had to be"))
        # 8. The one commit, with that subject.
        said("commit", "-q", "-m", subject)
        commit = said("rev-parse", "HEAD")
    facts.update(paths=paths, commit=commit, head=commit, branch=current)
    # 9. The answer, kept for this step asked again — BEFORE the batch is settled, so that
    #    from the commit on there is no moment at which neither the journal nor this file
    #    says what was recorded: killed before this write the step finds its batch in HEAD
    #    (`committed`), killed after it and after the settling it finds this (`recorded`).
    with open(answered_before(args), "w", encoding="utf-8") as file:
        file.write(json.dumps({name: facts[name] for name in ("branch", "commit", "head", "round", "paths", "applied", "gate")}))
    # 10. The batch is committed: the record script forgets it.
    settled(run_name, "the record commit %s is made" % commit)
    if state == "committed":
        note(facts, state, "finished")
    clean(said("status", "--porcelain", "--untracked-files=all"), "git status --porcelain --untracked-files=all")
    # 11. The report.
    facts.update(status="recorded")


def discard(args, facts):
    run_name = os.path.basename(args.run_dir)
    facts.update(found=[], finished=[])
    # 1. The branch, git's own lock, and what a killed write left — as every act of a record.
    current = checked_out(args.branch, facts)
    unlocked(facts)
    pending = arrived(args.run_dir, facts)
    batch = pending.get("batch")
    paths, taken = [], []
    if batch:
        # 2. Where the batch stands, asked of git: one whose commit is made is not taken back.
        status = [(line[:2], line[3:]) for line in lines(said("status", "--porcelain", "--untracked-files=all"))]
        ours = list(batch["files"]) + (pending.get("once") or [])
        if not batch["altered"] and not any(path in batch["files"] for code, path in status):
            note(facts, "committed")
            refuse("committed", "the applied batch of run %s is in a commit — every file of it is in HEAD as the batch wrote it: it is not taken back" % run_name, "`git status --porcelain --untracked-files=all` names no file of the batch, and `dev/stabilize-record pending` none as altered", "nothing was written. `dev/stabilize-step git-state` settles a batch whose commit is made, and says what else is owed; what a commit holds is taken back by a commit, which is the human's to make")
        paths = sorted(path for code, path in status if code[0] in "AM" and path in ours)
        note(facts, "altered" if batch["altered"] else "staged" if paths else "applied")
        # 3. What a commit step staged of it, unstaged; then every file as before the batch.
        taken = taken_back(run_name, paths)
    facts.update(status="discarded", branch=current, head=said("rev-parse", "HEAD"), unstaged=paths, discarded=taken)


def table(args, facts):
    facts.update(status="listed", acts=ACTS, arrivals=ARRIVALS, kept=KEPT)


def sync_main(args, facts):
    # 1. The branch and the tree.
    checked_out(args.loop, facts)
    clean(said("status", "--porcelain"), "git status --porcelain")
    pre = said("rev-parse", "HEAD")
    # 2. main, fetched.
    said("fetch", "origin", "main")
    origin_main = said("rev-parse", "origin/main")
    facts.update(origin_main=origin_main)
    # 3. A branch that holds it already.
    if answers(git("merge-base", "--is-ancestor", "origin/main", args.loop)):
        facts.update(status="up-to-date", head=said("rev-parse", "HEAD"))
        return
    # 4-6. The merge.
    facts.update(resolved_logs=[])
    merge("origin/main", args.log, facts)
    # 7. The merge commit.
    parents = said("rev-list", "--parents", "-n", "1", "HEAD")
    two_parents(parents, pre, said("rev-parse", "origin/main"))
    clean_after_merge = said("status", "--porcelain")
    if clean_after_merge:
        refuse("merge-differs", "the tree is not clean after the merge: %s" % "; ".join(lines(clean_after_merge)), "`git status --porcelain`", "nothing was undone: the merge is on the local branch")
    # 8. The report. Nothing is pushed: the gate runs on the merged tree first.
    facts.update(status="merged", head=said("rev-parse", "HEAD"))


# --- arguments ------------------------------------------------------------------


class Arguments(argparse.ArgumentParser):
    def error(self, message):
        refuse("usage", "%s — see dev/stabilize-step --help" % message)


def grammar(pattern, what):
    def taken(value):
        if not pattern.fullmatch(value):
            raise argparse.ArgumentTypeError("%s is not %s" % (json.dumps(value), what))
        return value

    return taken


def path_in_repository(value):
    if not value or not all(SEGMENT.fullmatch(part) for part in value.split("/")):
        raise argparse.ArgumentTypeError("%s is not a path inside the repository, of plain segments" % json.dumps(value))
    return value


def directory_outside(value):
    parts = value[1:].split("/")
    if not value.startswith("/") or not all(PLAIN.fullmatch(part) for part in parts) or "." in parts or ".." in parts:
        raise argparse.ArgumentTypeError("%s is not an absolute directory of plain segments" % json.dumps(value))
    return value


def file_outside(value):
    return directory_outside(value)


count = grammar(re.compile(r"[0-9]{1,4}"), "a count")
branch_name = grammar(BRANCH, "a branch name with a prefix (`fix/<run>…`): `main` is no argument of a step")
slug = grammar(SLUG, "a slug (a-z0-9 words joined by single `-`)")
full_sha = grammar(FULL_SHA, "a full sha")

FLAGS = {
    "loop": branch_name,
    "branch": branch_name,
    "rounds": branch_name,
    "prefix": branch_name,
    "run-dir": path_in_repository,
    "run": slug,
    "tag": slug,
    "scratch": directory_outside,
    "stage": grammar(re.compile("|".join(STAGES)), "one of " + ", ".join(STAGES)),
    "round": str,
    "attempt": str,
    "gate": file_outside,
    "calls": count,
    "checks": count,
    "reporter": slug,
    "commit": full_sha,
    "head": full_sha,
}
LISTS = {"product": path_in_repository, "log": path_in_repository}


def arguments(argv):
    parser = Arguments(prog="dev/" + PROG, add_help=False, allow_abbrev=False)
    acts = parser.add_subparsers(dest="act", required=True, parser_class=Arguments)

    def act(name, does, flags, lists=(), optional=(), names=None, switches=()):
        sub = acts.add_parser(name, add_help=False, allow_abbrev=False)
        sub.set_defaults(does=does)
        for flag in flags:
            sub.add_argument("--" + flag, required=True, type=FLAGS[flag])
        for flag in optional:
            sub.add_argument("--" + flag, type=FLAGS.get(flag, str))
        for flag in switches:
            sub.add_argument("--" + flag, action="store_true")
        for flag in lists:
            sub.add_argument("--" + flag, action="append", default=[], type=LISTS[flag])
        if names:
            sub.add_argument(names[0], nargs=names[1], type=names[2])

    act("git-state", git_state, ["stage", "loop", "rounds", "run-dir"], lists=["product"], switches=["look"])
    act("state", state, ["run", "scratch", "tag"])
    act("begin", begin, ["run", "round", "stage", "attempt", "reporter", "commit", "scratch"], optional=["cycle"])
    act("check-reports", check_reports, ["run", "round", "stage", "attempt"], optional=["cycle", "scratch"], names=("names", argparse.ZERO_OR_MORE, str))
    act("find-round", find_round, ["prefix"])
    act("open-round", open_round, ["loop", "branch", "run-dir"])
    act("push", push_branch, ["branch"], optional=["run-dir"])
    act("land", land, ["loop", "branch", "run-dir"], lists=["product", "log"])
    act("round-commits", round_commits, ["loop", "branch", "run-dir"])
    act("carry", carry, ["loop", "run-dir"], lists=["product"], names=("shas", argparse.ONE_OR_MORE, full_sha))
    act("record", record, ["branch", "run-dir", "gate", "calls", "checks"], optional=["scratch", "head"])
    act("discard", discard, ["branch", "run-dir"])
    act("table", table, [])
    act("sync-main", sync_main, ["loop"], lists=["log"])
    if not argv or argv[0] not in acts.choices:
        refuse("usage", "%s is not an act: the acts are %s — see dev/stabilize-step --help" % (json.dumps(argv[0]) if argv else "nothing", ", ".join(acts.choices)))
    return parser.parse_args(argv)


# --- the line -------------------------------------------------------------------


def line_of(facts):
    """The one line an act prints: its facts as JSON, and last the sha256 of that JSON —
    so that a line retyped on its way is told from the line printed here."""
    body = json.dumps({"act": facts["act"], "status": facts["status"], **facts})
    return '%s, "sha256": "%s"}' % (body[:-1], hashlib.sha256(body.encode("utf-8")).hexdigest())


def tree_state():
    """What a halt report says of the tree, read without changing it."""
    branch = git("branch", "--show-current")
    status = git("status", "--porcelain")
    return "on `%s`; `git status --porcelain`: %s" % (branch.out.strip() or "(no branch)", " | ".join(lines(status.out)) or "(clean)")


def main(argv):
    # UTF-8 out, whatever the caller's locale claims: the line is read by a script.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    flags = argv[: argv.index("--")] if "--" in argv else argv
    if any(arg in ("-h", "--help") for arg in flags):
        usage_help()
        return 0
    facts = {"act": argv[0] if argv else None}
    try:
        args = arguments(argv)
        args.does(args, facts)
        print(line_of(facts))
        return 0
    except Refusal as refusal:
        detail = " ".join(refusal.detail.split())
        halt = {
            "root_cause": "%s: %s" % (refusal.kind, detail),
            "evidence": " ".join(refusal.evidence.split()),
            "tree_state": "" if refusal.kind == "usage" else tree_state(),
            "recommendation": refusal.recommendation,
        }
        facts.update(status="halted", refused=refusal.kind, halt=halt)
        print(line_of(facts))
        sys.stderr.write("%s: refused %s: %s\n" % (PROG, refusal.kind, detail))
        return STATUS[refusal.kind]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
