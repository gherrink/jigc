class Refusal(Exception):
    def __init__(self, kind, detail, evidence, recommendation):
        super().__init__(detail)
        self.kind = kind
        self.detail = detail
        self.evidence = evidence
        self.recommendation = recommendation


def refuse(kind, detail, evidence="", recommendation="the human reconciles it; the step is not repeated on a guess"):
    raise Refusal(kind, detail, evidence, recommendation)


def note(facts, state, how=None):
    """An arrival state the act met: named in the line's `found`, and — where the act
    finished it, or leaves it owed — in `finished` or `owed`."""
    for name in ("found",) + ((how,) if how else ()):
        if state not in facts.setdefault(name, []):
            facts[name].append(state)


def refuse_as(facts, state, detail, evidence="", **names):
    """Refuse an arrival state the table answers with a refusal: its word, and what leaves
    it as its row says."""
    row = next(row for row in ARRIVALS if row["state"] == state)
    note(facts, state)
    leaves = row["leaves"]
    for name, value in names.items():
        leaves = leaves.replace("<%s>" % name.replace("_", "-"), value)
    refuse(row["word"], detail, evidence, leaves)


def usage_help():
    for line in open(__file__, encoding="utf-8").read().split("\n")[1:]:
        if not line.startswith("#"):
