#!/usr/bin/env bash
#
# dev/gate — run this project's dev-workflow gate and report it honestly.
#
# The gate is four commands (implementation/dev-workflow.md -> Gate). Running them
# by hand is where the two standing shell rules get broken:
#
#   * `cargo test 2>&1 | tail -5` reports *tail's* exit status, so a red gate reads
#     as green. A scan of 139 subagent transcripts in one session recorded 215
#     claude-shell-guard blocks on exactly this shape, across 117 of 137 agents.
#     Every command below is run BARE and its `$?` captured directly; nothing this
#     script reads the status of is ever on the left of a pipe.
#   * `rm -rf $V/$D` is refused before it runs. So this script has no teardown and
#     no --clean: logs go to a mktemp-minted path and stay there.
#
# It writes only to the repo's own target/ (via cargo) and to $TMPDIR. Never ~/.local.
#
# Usage:
#   dev/gate                     # full gate: fmt, clippy, build, test
#   dev/gate --quick             # fmt, clippy, build only -- a fast pre-check
#   dev/gate --private-target    # build in a private CARGO_TARGET_DIR (no lock
#                                #   contention with a concurrent gate in this tree).
#                                #   Reuse one across runs: JIGC_GATE_TARGET=<dir>
#   dev/gate --report <log>      # re-print the report for an existing log and stop.
#                                #   Runs no cargo: the report layer is pure text over
#                                #   a log, so this is also how it is TESTED
#                                #   (crates/cli/tests/dev_gate_report.rs), in
#                                #   milliseconds instead of a five-minute gate run.
#
# Every run prints `gate: deps <N> entries` for the `<target>/debug/deps` it is about to
# build into, and WARNS above JIGC_GATE_DEPS_WARN (default 100000) naming
# `dev/clean-litter`. That directory is never garbage-collected by cargo and has taken a
# full gate from ~9.5 min to ~20 min; the advisory is never a step and never fails a run.
#
# Every run also prints a `gate: hygiene` advisory (implementation/public-hygiene.md):
# the private denylist at ~/.config/jigc/denylist (or $JIGC_DENYLIST_FILE) over the
# unpushed commits and the tracked working tree, via dev/hygiene-scan, and gitleaks
# over the unpushed commits when it is installed. A hit WARNS and names the file; like
# the deps count it is never a step and never fails a run -- CI holds the hard stop.
# JIGC_GATE_HYGIENE=off skips it; JIGC_GATE_HYGIENE_RANGE=<rev-list args> scans that
# range instead of the unpushed commits.
#
# A step that exits 127 DID NOT RUN -- the command was not found -- and is reported as
# that rather than as a failure, because the two are indistinguishable otherwise and
# only one of them is a verdict about this repo.
#
# Exit status: 0 iff every step it ran exited 0.

set -u

# --- where are we -----------------------------------------------------------
# Resolve the repo root from the script's own location, so the tool works from
# the repo root and from any subdirectory, with or without git.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
repo_root=$(dirname -- "$script_dir")
cd "$repo_root" || exit 2

tmp_root=${TMPDIR:-/tmp}
tmp_root=${tmp_root%/}

# --- the report layer -------------------------------------------------------
# Pure text over a log file, in three functions, so `--report <log>` runs exactly
# what a real gate run's tail runs and a fixture log can fence it without cargo.

# `passed failed binaries`, summed over the per-target summary lines.
#
# The match is on the first two FIELDS, not on /^test result:/. Undelimited, that
# pattern also matches every test NAMED `result::...` -- cargo prints
# `test result::tests::alpha ... ok` for engine/src/result.rs's `mod tests` -- so the
# binary count read 33 for a 17-binary run (`passed=`/`failed=` were unaffected: those
# lines carry no `passed;` field). The count exists to prove the run measured
# something, so an inflated one is exactly the lie it was added to prevent.
gate_totals() {
    awk '
        $1 == "test" && $2 == "result:" {
            for (i = 2; i <= NF; i++) {
                if ($i == "passed;") p += $(i-1)
                if ($i == "failed;") f += $(i-1)
            }
            n++
        }
        END { printf "%d %d %d", p+0, f+0, n+0 }
    ' "$1"
}

# Failing test names, from the "failures:" list block cargo prints after the per-test
# stdout. The first such block is followed by "---- <name> stdout ----", which does
# not match the indented-name shape, so only the list block is read.
gate_failing_names() {
    awk '
        /^failures:$/   { inblk = 1; next }
        inblk && /^$/   { next }
        inblk && /^    [^ ]/ { print substr($0, 5); next }
        inblk           { inblk = 0 }
    ' "$1" | sort -u
}

# For a non-test failure the useful lines are the compiler's/fmt's own, not the last
# N lines of the log.
gate_errors() {
    grep -E '^(error|error\[|Diff in )' "$1" | sort -u | head -20
}

gate_report() {
    report_log=$1
    totals=$(gate_totals "$report_log")
    passed=${totals%% *}
    rest=${totals#* }
    failed=${rest%% *}
    binaries=${rest#* }
    printf 'tests   passed=%s failed=%s  (over %s test binaries)\n' \
        "$passed" "$failed" "$binaries"

    names=$(gate_failing_names "$report_log")
    if [ -n "$names" ]; then
        printf '\nfailing tests:\n'
        printf '%s\n' "$names" | sed 's/^/  /'
    fi

    errs=$(gate_errors "$report_log")
    if [ -n "$errs" ]; then
        printf '\nerrors (first 20 distinct):\n'
        printf '%s\n' "$errs" | sed 's/^/  /'
    fi
}

# --- arguments --------------------------------------------------------------
quick=0
private_target=0
report_only=""
while [ $# -gt 0 ]; do
    case "$1" in
        --quick) quick=1; shift ;;
        --private-target) private_target=1; shift ;;
        --report)
            if [ $# -lt 2 ]; then
                printf 'dev/gate: --report needs a log path\n' >&2
                exit 2
            fi
            report_only=$2; shift 2 ;;
        # The help text is this file's own leading comment block, read to its end
        # rather than to a hard-coded line number that silently truncates on an edit.
        -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
        *)
            printf 'dev/gate: unknown option: %s\n' "$1" >&2
            printf 'dev/gate: try --quick, --private-target, --report <log>, --help\n' >&2
            exit 2
            ;;
    esac
done

if [ -n "$report_only" ]; then
    if [ ! -f "$report_only" ]; then
        printf 'dev/gate: no such log: %s\n' "$report_only" >&2
        exit 2
    fi
    gate_report "$report_only"
    exit 0
fi

log=$(mktemp "$tmp_root/jigc-gate-XXXXXX") || exit 2

# An inherited CARGO_TARGET_DIR redirects every cargo step below, so the header must
# name it. It said "shared (<repo>/target)" regardless, which put a wrong tree beside a
# right number once the deps advisory started counting the tree that is actually used.
if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    target_desc=$CARGO_TARGET_DIR
else
    target_desc="shared (<repo>/target)"
fi
if [ "$private_target" -eq 1 ]; then
    if [ -n "${JIGC_GATE_TARGET:-}" ]; then
        CARGO_TARGET_DIR=$JIGC_GATE_TARGET
        mkdir -p "$CARGO_TARGET_DIR" || exit 2
    else
        CARGO_TARGET_DIR=$(mktemp -d "$tmp_root/jigc-gate-target-XXXXXX") || exit 2
    fi
    export CARGO_TARGET_DIR
    target_desc="$CARGO_TARGET_DIR"
fi

printf 'gate: repo   %s\n' "$repo_root"
printf 'gate: log    %s\n' "$log"
printf 'gate: target %s\n' "$target_desc"
if [ "$private_target" -eq 1 ] && [ -z "${JIGC_GATE_TARGET:-}" ]; then
    printf 'gate:        reuse it next run with: JIGC_GATE_TARGET=%s\n' "$CARGO_TARGET_DIR"
fi
if [ "$quick" -eq 1 ]; then
    printf 'gate: mode   quick (fmt, clippy, build -- NOT the full gate, do not commit on it)\n'
else
    printf 'gate: mode   full\n'
fi

# --- the deps advisory ------------------------------------------------------
# `<target>/debug/deps` accumulates and cargo never garbage-collects it. On
# 2026-09-14 it held 1,825,219 entries (26 GB), 1,823,960 of them `*.rcgu.o`
# split-debuginfo sidecars, median age 15 days: every gate run re-links the cli test
# binaries under a fresh hash and adds thousands more. Disk is not the cost -- macOS
# syspolicyd (Gatekeeper) rescans the tree, and a full gate measured ~20 min against
# ~9.5 min on the same tree with the stale sidecars deleted mid-run.
#
# `[profile.dev] split-debuginfo = "packed"` stops new litter at the source, so this
# line is the watch on what that cannot see: a tree that already carries it, a profile
# someone flips back, and the slow ordinary growth of the directory itself.
#
# It is an advisory and never a step: the count is printed, never judged, so nothing
# here can redden a gate whose four commands passed. `find` without -delete/-exec/-mtime
# is one readdir -- ~3s over 530 k entries, and imperceptible under 100 k.
#
# The threshold is overridable so the warning branch is reachable by a fixture the
# size of three files (crates/cli/tests/dev_gate_report.rs), and so a machine with a
# different tolerance can say so without editing the tool.
deps_warn=${JIGC_GATE_DEPS_WARN:-100000}
deps_dir=${CARGO_TARGET_DIR:-$repo_root/target}/debug/deps
deps_count=$(find "$deps_dir" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l)
deps_count=$((deps_count))
printf 'gate: deps   %s entries\n' "$deps_count"
if [ "$deps_count" -gt "$deps_warn" ]; then
    printf 'gate: WARNING  %s stale build artifacts in %s\n' "$deps_count" "$deps_dir"
    printf 'gate:          cargo never removes them and Gatekeeper rescans the tree on\n'
    printf 'gate:          every link, which is minutes per gate run. Clean them with:\n'
    printf 'gate:              dev/clean-litter\n'
fi

# --- the hygiene advisory ---------------------------------------------------
# The local half of the public-hygiene guard (implementation/public-hygiene.md): a
# name or a secret caught here costs an amend; caught by CI after the push it costs a
# history rewrite. An advisory exactly like the deps count above -- printed, never a
# step, never in the verdict -- so a hit cannot redden a gate whose steps passed, and
# the only output is WHERE a hit is, never what matched. Its alarm word is HYGIENE,
# never the deps advisory's WARNING, so neither advisory's fence reads the other's.
#
# "Unpushed" is the branch's upstream when it has one, else everything no remote has,
# else (a repo that was never pushed anywhere) the whole history of HEAD -- unless
# JIGC_GATE_HYGIENE_RANGE names the range outright.
if [ "${JIGC_GATE_HYGIENE:-on}" = off ]; then
    printf 'gate: hygiene  skipped (JIGC_GATE_HYGIENE=off)\n'
else
    if [ -n "${JIGC_GATE_HYGIENE_RANGE:-}" ]; then
        # Deliberately unquoted: the override is a rev-list argument list.
        # shellcheck disable=SC2086
        set -- $JIGC_GATE_HYGIENE_RANGE
        range_desc="$JIGC_GATE_HYGIENE_RANGE (JIGC_GATE_HYGIENE_RANGE)"
    elif upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
        set -- "$upstream..HEAD"
        range_desc="$upstream..HEAD"
    elif [ -n "$(git remote 2>/dev/null)" ]; then
        set -- HEAD --not --remotes
        range_desc="HEAD --not --remotes"
    else
        set -- HEAD
        range_desc="HEAD (no remote: the whole history)"
    fi
    printf 'gate: hygiene  range %s\n' "$range_desc"

    denylist=${JIGC_DENYLIST_FILE:-${HOME:-}/.config/jigc/denylist}
    if [ ! -f "$denylist" ]; then
        printf 'gate: hygiene  no denylist at %s -- denylist scan skipped\n' "$denylist"
    else
        hygiene_log=$(mktemp "$tmp_root/jigc-gate-hygiene-XXXXXX") || exit 2
        # Bare: no pipe, so $? is the scan's own status (0 clean, 1 hit, 2 error).
        "$script_dir/hygiene-scan" --tree "$denylist" "$@" >"$hygiene_log" 2>&1
        hygiene_code=$?
        if [ "$hygiene_code" -eq 0 ]; then
            printf 'gate: hygiene  denylist clean (%s)\n' "$denylist"
        elif [ "$hygiene_code" -eq 1 ]; then
            printf 'gate: HYGIENE  denylist hit(s) -- terms from %s are in this change:\n' "$denylist"
            sed -n 's/^  /gate:            /p' "$hygiene_log"
            printf 'gate:          fix before pushing (implementation/public-hygiene.md)\n'
        else
            printf 'gate: HYGIENE  the denylist scan could not run (exit %s): %s\n' \
                "$hygiene_code" "$hygiene_log"
        fi
    fi

    if command -v gitleaks >/dev/null 2>&1; then
        leaks_log=$(mktemp "$tmp_root/jigc-gate-gitleaks-XXXXXX") || exit 2
        gitleaks git --redact --no-banner --log-opts="$*" "$repo_root" >"$leaks_log" 2>&1
        leaks_code=$?
        if [ "$leaks_code" -eq 0 ]; then
            printf 'gate: hygiene  gitleaks clean\n'
        else
            printf 'gate: HYGIENE  gitleaks exit %s over %s -- read %s\n' \
                "$leaks_code" "$range_desc" "$leaks_log"
        fi
    else
        printf 'gate: hygiene  gitleaks not installed -- secret scan skipped\n'
    fi
    set --
fi
printf '\n'

# --- step runner ------------------------------------------------------------
# Every step appends to $log and its own exit code is captured from the bare
# command. Steps are recorded as "<name> <code>" lines in $results.
results=$(mktemp "$tmp_root/jigc-gate-steps-XXXXXX") || exit 2
failed_steps=""
unrun_steps=""

run_step() {
    name=$1
    shift
    printf '\n===== STEP %s =====\n$ %s\n' "$name" "$*" >>"$log"
    started=$(date +%s)
    # Bare: no pipe, so $? is this command's own status.
    "$@" >>"$log" 2>&1
    code=$?
    elapsed=$(( $(date +%s) - started ))
    printf '%s %s\n' "$name" "$code" >>"$results"
    if [ "$code" -eq 0 ]; then
        printf '==> %-7s ok        (%ss)\n' "$name" "$elapsed"
    elif [ "$code" -eq 127 ]; then
        # 127 is the shell's "command not found", not a verdict about this repo. A
        # bare `FAILED 127 (0s)` with no error detail is indistinguishable from a
        # real red gate, so it is named for what it is and the missing binary said.
        printf '==> %-7s DID NOT RUN -- `%s` not found on PATH (%ss)\n' "$name" "$1" "$elapsed"
        failed_steps="$failed_steps $name"
        unrun_steps="$unrun_steps $name"
    else
        printf '==> %-7s FAILED %-3s (%ss)\n' "$name" "$code" "$elapsed"
        failed_steps="$failed_steps $name"
    fi
    return 0
}

# The gate, in order.
run_step fmt cargo fmt --check
run_step clippy cargo clippy --all-targets -- -D warnings
run_step build cargo build
if [ "$quick" -eq 0 ]; then
    run_step test cargo test
fi

# --- what the run actually measured ----------------------------------------
printf '\n--- summary ---\n'
while read -r sname scode; do
    if [ "$scode" = 127 ]; then
        printf '%-7s exit=%s  (did not run: command not found)\n' "$sname" "$scode"
    else
        printf '%-7s exit=%s\n' "$sname" "$scode"
    fi
done <"$results"

# Sum the per-target summary lines, so a run that compiled nothing is
# distinguishable from a run that passed.
if [ "$quick" -eq 0 ]; then
    totals=$(gate_totals "$log")
    passed=${totals%% *}
    rest=${totals#* }
    failed=${rest%% *}
    binaries=${rest#* }
    printf 'tests   passed=%s failed=%s  (over %s test binaries)\n' \
        "$passed" "$failed" "$binaries"
fi

# --- failure detail: named, never a blind tail ------------------------------
# The named failures and the error lines come from the report layer above -- the same
# functions `--report <log>` runs, which is what makes them fenceable without cargo.
if [ -n "$failed_steps" ]; then
    first_failed=${failed_steps# }
    first_failed=${first_failed%% *}
    printf '\nGATE: FAIL (step:%s)\n' "$failed_steps"

    if [ -n "$unrun_steps" ]; then
        printf '\nthese steps DID NOT RUN (exit 127 -- the command was not found, so\n'
        printf 'this is not a verdict about the code):%s\n' "$unrun_steps"
        printf 'nothing was measured for them -- is cargo on PATH?\n'
    fi

    names=$(gate_failing_names "$log")
    if [ -n "$names" ]; then
        printf '\nfailing tests:\n'
        printf '%s\n' "$names" | sed 's/^/  /'
    fi

    errs=$(gate_errors "$log")
    if [ -n "$errs" ]; then
        printf '\nerrors (first 20 distinct):\n'
        printf '%s\n' "$errs" | sed 's/^/  /'
    fi

    printf '\nfull output: %s\n' "$log"
    printf 'the failing step is %s -- read its "===== STEP %s =====" block in that log\n' \
        "$first_failed" "$first_failed"
    exit 1
fi

printf '\nGATE: PASS\n'
printf 'full output: %s\n' "$log"
exit 0
