{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$JIGC_DOGFOOD_HOME/log-event.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$JIGC_DOGFOOD_HOME/log-event.py\""
          }
        ]
      }
    ]
  }
}
